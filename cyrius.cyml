[package]
name = "agora"
version = "${file:VERSION}"
description = "agora — BBS userland for AGNOS. Telnet-served bulletin board: posts, messages, file-share. Greek ἀγορά (civic-marketplace / public-assembly) + Doja Cat 'Agora Hills' (Scarlet, 2023). Consumes kernel tcp_listen/accept (agnos 1.32.0 bite A) + ext4 (1.31.5 Phase 1-5 read; 1.33.x WRITE for posts). Companion to the MUD userland on a separate repo."
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.6.2"

[build]
entry = "src/main.cyr"
test = "src/test.cyr"
output = "agora"

[deps]
# Pre-1.0 stdlib surface. M0 (0.1.0) scaffolded the binary; M1 (0.2.0)
# landed the cross-platform telnet listener on lib/net.cyr; M2 is the
# ANSI BBS aesthetic — M2-A consumes bannermanor (rendered offline),
# M2-B consumes darshana for SGR / cursor primitives (git dep below).
stdlib = ["string", "fmt", "alloc", "io", "syscalls", "assert", "args", "net", "result", "tagged", "vec", "fnptr", "bench", "str", "fs", "chrono", "random", "sigil", "freelist", "ct", "bayan", "thread_local", "keccak", "hashmap", "thread"]

[deps.darshana]
# SGR primitives for the ANSI BBS aesthetic at M2-B. agora consumes
# exactly two functions — `tty_sgr_buf` and `tty_sgr_reset_buf`, three
# call sites each (verified 1.6.7 by grepping `tty_` across src/). Both
# are `_buf` composers: they write the ANSI escape into a caller-provided
# buffer instead of to fd 1, so the rendered bytes go out over the telnet
# socket via send_buf. (`tty_fg_rgb_buf` / `tty_fg_256_buf` were listed
# here as "what we need" through 1.6.6 and have never been called.)
#
# Pinned at 0.9.0 (current tip) — pre-1.0 by version label but the
# functional surface we need is stable: agora only consumes the `_buf`
# SGR composers (tty_sgr_buf / tty_sgr_reset_buf), whose signatures are
# unchanged across 0.5.3→0.9.0. Everything since 0.7.0 has been AGNOS
# parity work on the termios/signalfd surface agora does not touch —
# 0.8.0 tty_winsize, 0.8.2 tty_isatty/tty_raw/tty_cooked, 0.9.0
# tty_open_signalfd/tty_close_signalfd + TTY_SIGMASK_* — all additive
# `#ifdef CYRIUS_TARGET_AGNOS` peers with no Linux-path or API change.
# (0.7.0 was the pre-freeze hardening sweep and carried breaking renames
# — tty_cooked/tty_itoa/tty_clear_to_end/tty_apply_raw_flags — that
# agora was likewise unaffected by.)
# Both will re-pin at darshana 1.0 when the API surface freezes.
git = "https://github.com/MacCracken/darshana.git"
tag = "0.9.0"
modules = ["dist/darshana.cyr"]

# AGNOS first-party deps deferred until needed:
#   - kii (image → ASCII for MOTD banners + post inline-images at M3+)
#   - sankoch (lossless compression for stored-file deltas at M4+)
#
# (darshana was listed here as "deferred" through 1.6.6 while being a live
# [deps.darshana] git dep declared 20 lines above and called from
# src/main.cyr — removed 1.6.7. bannermanor is likewise not deferred: its
# banners were rendered offline at M2-A and the bytes are baked into the
# MOTD, so agora consumes its OUTPUT, not the crate.)
