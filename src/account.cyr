# account.cyr — per-user identity primitives (M6-B, ADR 0006).
#
# Storage layout (per ADR 0006 § Specifics):
#
#   <store>/.users/<fp16>/
#     public_key.bin     # 32 raw bytes (Ed25519 pubkey)
#     handle             # the handle + one LF (readers strip trailing CR/LF)
#     created.iso8601    # iso8601 timestamp at registration
#
# The dot-prefix `.users/` dodges board_name_valid (which rejects
# leading-dot names) and parse_post_id (which rejects non-`.txt`
# suffixes) — same precedent as `.lock` from ADR 0004.
#
# Server holds only public keys. Secret keys live in the user's
# keyfile (default `~/.agora/key`) and never touch the server —
# lost the keyfile = lost the identity, by design (see ADR 0006
# § Consequences / Negative).
#
# Cross-platform: piggybacks on board.cyr's permission constants
# (PERM_DIR, PERM_FILE) and store_ensure, and lib/io.cyr for
# file_open / file_read_all / file_write / file_close. The handle scan
# lists `.users/` through board.cyr's allocation-free store_dir_scan.

# === Constants ===

enum AccountCap {
    ACCOUNT_PK_BYTES        = 32;    # Ed25519 public key
    ACCOUNT_SK_BYTES        = 64;    # Ed25519 secret_key (seed || pk)
    ACCOUNT_SEED_BYTES      = 32;    # Ed25519 seed (first half of SK)
    ACCOUNT_SIG_BYTES       = 64;    # Ed25519 signature
    ACCOUNT_FP_HEX_BYTES    = 16;    # fingerprint = 16 lowercase hex chars
    ACCOUNT_FP_BUF_BYTES    = 17;    # +1 for NUL terminator
    ACCOUNT_HANDLE_MAX      = 32;    # handle string max bytes (UTF-8)
    ACCOUNT_HANDLE_BUF      = 33;    # +1 for NUL terminator
    ACCOUNT_NONCE_BYTES     = 32;    # random nonce raw byte count
    ACCOUNT_NONCE_HEX_BYTES = 64;    # nonce hex-encoded length
    ACCOUNT_NONCE_BUF_BYTES = 65;    # +1 for NUL
    ACCOUNT_PERM_KEYFILE    = 0x180; # rw- --- ---  (0o600) for secret-key files
}

# === Fingerprint computation ===
#
# fp = first 8 bytes of sha256(public_key), hex-encoded as 16
# lowercase chars. 64 bits of fingerprint — comfortable at ~10s of
# users per deployment (ADR 0006 § Consequences). Extension to 32
# hex chars is non-breaking forward-compat.
#
# Writes ACCOUNT_FP_HEX_BYTES (=16) lowercase hex chars + NUL into
# `out_buf`. Caller must provide ≥ ACCOUNT_FP_BUF_BYTES bytes.
fn compute_fingerprint(pk_buf, out_buf): i64 {
    var digest[32];
    sha256(pk_buf, ACCOUNT_PK_BYTES, &digest);
    var i = 0;
    while (i < 8) {
        var b = load8((&digest) + i) & 0xFF;
        var hi = (b >> 4) & 0xF;
        var lo = b & 0xF;
        if (hi < 10) { store8(out_buf + i * 2, 48 + hi); }
        else         { store8(out_buf + i * 2, 87 + hi); }
        if (lo < 10) { store8(out_buf + i * 2 + 1, 48 + lo); }
        else         { store8(out_buf + i * 2 + 1, 87 + lo); }
        i = i + 1;
    }
    store8(out_buf + ACCOUNT_FP_HEX_BYTES, 0);
    return ACCOUNT_FP_HEX_BYTES;
}

# === Handle validation ===
#
# Per ADR 0006: same alphabet as board names — lowercase ASCII +
# digits + `-` + `_`, first char letter or digit, 1-32 bytes — but
# different reserved set: `anonymous`, `system`, `admin` are
# reserved (those are display labels for unauthenticated /
# server-generated / per-board-admin lines, not user handles).
#
# Returns 1 if valid, 0 if invalid.
fn handle_valid(name): i64 {
    if (name == 0) { return 0; }
    var len = strlen(name);
    if (len < 1)                  { return 0; }
    if (len > ACCOUNT_HANDLE_MAX) { return 0; }

    # Reserved handles
    if (streq(name, "anonymous") != 0) { return 0; }
    if (streq(name, "system")    != 0) { return 0; }
    if (streq(name, "admin")     != 0) { return 0; }

    # First byte: lowercase letter or digit
    var c0 = load8(name) & 0xFF;
    var c0_ok = 0;
    if (c0 >= 97) { if (c0 <= 122) { c0_ok = 1; } }   # a-z
    if (c0 >= 48) { if (c0 <= 57)  { c0_ok = 1; } }   # 0-9
    if (c0_ok == 0) { return 0; }

    # Rest: a-z, 0-9, '-', '_'
    var i = 1;
    while (i < len) {
        var c = load8(name + i) & 0xFF;
        var ok = 0;
        if (c >= 97) { if (c <= 122) { ok = 1; } }
        if (c >= 48) { if (c <= 57)  { ok = 1; } }
        if (c == 45) { ok = 1; }                       # '-'
        if (c == 95) { ok = 1; }                       # '_'
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# === Path resolution ===
#
# Writes `<store>/.users` (NUL-terminated) into out_buf. Returns
# length excluding NUL. out_buf must be ≥ PATH_MAX_BYTES.
fn build_users_dir(store, out_buf): i64 {
    var slen = strlen(store);
    memcpy(out_buf, store, slen);
    var pos = slen;
    store8(out_buf + pos, 47); pos = pos + 1;             # '/'
    memcpy(out_buf + pos, ".users", 6); pos = pos + 6;
    store8(out_buf + pos, 0);
    return pos;
}

# Writes `<store>/.users/<fp16>` (NUL-terminated) into out_buf.
# Returns length excluding NUL.
fn build_user_dir(store, fp16, out_buf): i64 {
    var pos = build_users_dir(store, out_buf);
    store8(out_buf + pos, 47); pos = pos + 1;             # '/'
    var flen = strlen(fp16);
    memcpy(out_buf + pos, fp16, flen); pos = pos + flen;
    store8(out_buf + pos, 0);
    return pos;
}

# Writes `<store>/.users/<fp16>/<file_name>` (NUL-terminated) into
# out_buf. `file_name` is one of "public_key.bin" / "handle" /
# "created.iso8601" per ADR 0006. Returns length excluding NUL.
fn build_user_file(store, fp16, file_name, out_buf): i64 {
    var pos = build_user_dir(store, fp16, out_buf);
    store8(out_buf + pos, 47); pos = pos + 1;             # '/'
    var nlen = strlen(file_name);
    memcpy(out_buf + pos, file_name, nlen); pos = pos + nlen;
    store8(out_buf + pos, 0);
    return pos;
}

# === Directory ensure ===
#
# mkdir <store> + <store>/.users + <store>/.users/<fp16>.
# Treats EEXIST (-17 on Linux) as success at every level. Returns
# 0 on success, negative errno on failure.
# 1.8.1 (audit S8) — serialize `agora register`'s check-then-write. Two
# concurrent registrations of one handle with different keys both passed the
# uniqueness check and both wrote (28 of 30 trials), leaving the handle to
# whichever directory readdir happens to list first. A blocking flock on
# `<store>/.users/.lock` (5 bytes, so the 16-hex handle scan skips it).
# Returns the held fd, or -1.
fn account_register_lock(store): i64 {
    if (store_ensure(store) != 0) { return 0 - 1; }
    var path = cmd_alloc(PATH_MAX_BYTES);
    var pos = build_users_dir(store, path);
    if (store_ensure(path) != 0) { return 0 - 1; }
    memcpy(path + pos, "/.lock", 7);
    return store_lock_open(path);             # 1.9.0: no symlink, no FIFO (arena.cyr)
}

# mkdir-ladder <store> -> .users -> .users/<fp16> (EEXIST is success); returns 0 or the failing rc.
fn account_dir_ensure(store, fp16): i64 {
    var rc = store_ensure(store);
    if (rc != 0) { return rc; }

    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    build_users_dir(store, path_buf);
    rc = store_ensure(path_buf);
    if (rc != 0) { return rc; }

    build_user_dir(store, fp16, path_buf);
    return store_ensure(path_buf);
}

# === Registration ===
#
# Writes the three per-user files for (pk, handle):
#   public_key.bin    32 raw bytes
#   handle            <handle string> + LF
#   created.iso8601   iso8601_into(now) + LF
#
# Computes the fingerprint from pk and writes it into fp_out (which
# must be ≥ ACCOUNT_FP_BUF_BYTES). Returns 0 on success, negative
# on failure (mkdir / open / write errors). Does NOT validate
# handle uniqueness — caller (M6 register CLI / wire flow) must
# pre-check via account_resolve_handle, holding account_register_lock,
# which also guards the handle index this maintains (1.9.0).
fn account_register(store, pk_buf, handle, fp_out): i64 {
    compute_fingerprint(pk_buf, fp_out);

    var rc = account_dir_ensure(store, fp_out);
    if (rc != 0) { return rc; }

    var path_buf = cmd_alloc(PATH_MAX_BYTES);

    # 1.9.0 — the handle index: claim the new handle FIRST and release the old
    # one LAST (see the index section), so a crash leaves a stale claim, which a
    # lookup detects, and never a missing one, which it would trust.
    var old = cmd_alloc(ACCOUNT_HANDLE_BUF);
    var oldlen = account_lookup_handle(store, fp_out, old, ACCOUNT_HANDLE_BUF);
    if (account_index_claim(store, handle, fp_out, 1) != 0) { return 0 - 1; }

    # Registration is idempotent by design (same key, same fingerprint
    # directory), so each file is REPLACED whole. 1.6.3 added O_TRUNC because a
    # shorter handle left the old tail behind ("qix\nylonghandle\n"); 1.9.0 makes
    # each write a store_write_atomic (temp, fsync, rename): a crash mid-write
    # leaves the old file or the new one, never a truncated handle, and the rename
    # replaces a planted symlink instead of writing through it (audit 1.8.1 I11 —
    # O_TRUNC through a link emptied and refilled whatever it pointed at).
    build_user_file(store, fp_out, "public_key.bin", path_buf);
    if (store_write_atomic(path_buf, pk_buf, ACCOUNT_PK_BYTES) != 0) { return 0 - 1; }

    # handle — UTF-8 bytes + LF
    var line = cmd_alloc(ACCOUNT_HANDLE_BUF + 32);
    var hlen = strlen(handle);
    memcpy(line, handle, hlen);
    store8(line + hlen, 10);
    build_user_file(store, fp_out, "handle", path_buf);
    if (store_write_atomic(path_buf, line, hlen + 1) != 0) { return 0 - 1; }

    # created.iso8601 — the registration time + LF
    var ilen = iso8601_into(clock_epoch_secs(), line);
    store8(line + ilen, 10);
    build_user_file(store, fp_out, "created.iso8601", path_buf);
    if (store_write_atomic(path_buf, line, ilen + 1) != 0) { return 0 - 1; }

    if (oldlen > 0) {
        if (streq(old, handle) == 0) { account_index_release(store, old, fp_out); }
    }
    return 0;
}

# === Lookups ===
#
# Read the 32-byte public key for (store, fp16) into pk_out.
# Returns 0 on success, negative on file-not-found / read error.
#
# 1.8.1 (audit S4) — the key must HASH to the directory it sits in. Wire login
# verified a signature against whatever `public_key.bin` held, so anyone able to
# write the store could copy their own key over qix's, `login qix`, sign with
# their own key and post as `qix <qix's real fingerprint>` — contradicting ADR
# 0006's "a store compromise cannot impersonate the original user". (The CLI
# `--as` path was safe: it derives the fingerprint from the keyfile.) This is
# also POLICY_KNOWN's check, so a swapped key fails there too.
fn account_lookup_pubkey(store, fp16, pk_out): i64 {
    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    build_user_file(store, fp16, "public_key.bin", path_buf);
    var n = store_read_all(path_buf, pk_out, ACCOUNT_PK_BYTES);  # callers hold exactly 32
    if (n != ACCOUNT_PK_BYTES) { return 0 - 1; }
    var fpk[24];
    compute_fingerprint(pk_out, &fpk);
    if (memeq(&fpk, fp16, ACCOUNT_FP_HEX_BYTES) == 0) { return 0 - 1; }
    return 0;
}

# Read the handle for (store, fp16) into out_buf, strip trailing
# CR/LF, NUL-terminate. Returns handle length (excluding NUL), or
# -1 on file-not-found / read error. out_buf must be ≥
# ACCOUNT_HANDLE_BUF.
fn account_lookup_handle(store, fp16, out_buf, out_max): i64 {
    # 1.8.1 (audit H3) — stack, not arena: account_resolve_handle calls this
    # once PER USER, so 1,000 users spilled the arena on every `login x`.
    var pathb[512];   # PATH_MAX_BYTES
    var path_buf = &pathb;
    build_user_file(store, fp16, "handle", path_buf);
    var raw[34];
    memset(&raw, 0, 34);
    var read_cap = ACCOUNT_HANDLE_MAX + 2;
    var n = store_read_all(path_buf, &raw, read_cap);
    if (n < 0) { return 0 - 1; }
    # Trim trailing CR/LF via flag + continue (CLAUDE.md: no `break`
    # in while loops with `var` declarations).
    var trimming = 1;
    while (trimming == 1) {
        if (n <= 0) { trimming = 0; continue; }
        var last = load8((&raw) + n - 1) & 0xFF;
        if (last == 10) { n = n - 1; continue; }
        if (last == 13) { n = n - 1; continue; }
        trimming = 0;
    }
    var copy_len = n;
    if (copy_len > out_max - 1) { copy_len = out_max - 1; }
    if (copy_len > 0) { memcpy(out_buf, &raw, copy_len); }
    store8(out_buf + copy_len, 0);
    # 1.8.1 (audit storage I2) — re-validate on read, as post_from has since the
    # 0.7.0 audit (H3). The bound session handle goes out in `welcome,` and
    # `whoami`, so a tampered handle file must not carry arbitrary bytes there.
    if (copy_len > 0) {
        if (handle_valid(out_buf) == 0) { store8(out_buf, 0); return 0 - 1; }
    }
    return copy_len;
}

# === From-header parsing (M6-E, ADR 0006) ===
#
# `From: <handle> <fp16>\r\n` in the RFC-822 header block. Handle
# and fp are split on the first space. Either field absent (or the
# whole header absent) means anonymous — caller renders "[anon]".

# Extract handle + fp from a post file's `From:` header. Writes
# NUL-terminated handle into handle_out (caller supplies h_max ≥
# ACCOUNT_HANDLE_BUF) and fp into fp_out (caller supplies
# ACCOUNT_FP_BUF_BYTES). Returns 1 on success, 0 if no From header
# or malformed (no space separator).
fn post_from(buf, len, handle_out, h_max, fp_out, fp_max): i64 {
    # 1.8.1 (audit H3) — stack, not arena: `list` calls this once per post (see
    # post_read). Callers pass ACCOUNT_HANDLE_BUF + ACCOUNT_FP_BUF_BYTES = 50.
    var rawb[128];
    if (h_max + fp_max + 8 > 128) { store8(handle_out, 0); store8(fp_out, 0); return 0; }
    var raw_buf = &rawb;
    var raw_len = header_get(buf, len, "From", raw_buf, h_max + fp_max + 4);
    if (raw_len <= 0) {
        store8(handle_out, 0);
        store8(fp_out, 0);
        return 0;
    }
    # Find the space separator
    var i = 0;
    var space = 0 - 1;
    while (i < raw_len) {
        if ((load8(raw_buf + i) & 0xFF) == 32) {
            space = i;
            i = raw_len;
            continue;
        }
        i = i + 1;
    }
    if (space < 0) {
        # No space — malformed, treat as anonymous.
        store8(handle_out, 0);
        store8(fp_out, 0);
        return 0;
    }
    # Copy handle [0..space) → handle_out (clamped to h_max - 1)
    var hlen = space;
    if (hlen > h_max - 1) { hlen = h_max - 1; }
    if (hlen > 0) { memcpy(handle_out, raw_buf, hlen); }
    store8(handle_out + hlen, 0);
    # Copy fp [space+1..raw_len) → fp_out (clamped to fp_max - 1)
    var flen = raw_len - space - 1;
    if (flen > fp_max - 1) { flen = fp_max - 1; }
    if (flen > 0) { memcpy(fp_out, raw_buf + space + 1, flen); }
    store8(fp_out + flen, 0);
    # 0.7.0 audit H3 — re-validate both fields against the same
    # alphabet the wire / CLI write paths enforce. Defense-in-depth
    # against a tampered .users/<fp>/handle file (operator side or a
    # future federated-import path landing un-validated bytes). On
    # invalid: emit anonymous so the renderer doesn't smuggle CR/LF/
    # ESC bytes through `send_buf` into every reader's terminal.
    if (handle_valid(handle_out) == 0) {
        store8(handle_out, 0);
        store8(fp_out, 0);
        return 0;
    }
    if (fp16_valid(fp_out) == 0) {
        store8(handle_out, 0);
        store8(fp_out, 0);
        return 0;
    }
    return 1;
}

# === Keyfile primitives (M6-D, ADR 0006) ===
#
# Keyfile is 32 raw bytes — the Ed25519 seed. sigil's
# ed25519_keypair(seed, sk_out, pk_out) derives the 64-byte sk
# (= seed||pk) and 32-byte pk from the seed on every load. The
# secret never crosses the wire.

# 0.8.1 audit L1 — mode-bit check helper. A keyfile is "loose" if
# any group / other permission bit is set (mode & 0o077 != 0). Pure
# bit math so the test suite can exercise it without touching files.
#
# Tight: 0o600 (rw- --- ---) → 0; 0o400 (r-- --- ---) → 0; 0o700 → 0.
# Loose: 0o644 (rw- r-- r--) → 1; 0o604 (rw- --- r--) → 1; 0o660 → 1.
fn mode_is_loose(mode): i64 {
    if ((mode & 0x3F) != 0) { return 1; }     # 0x3F = 0o077
    return 0;
}

# fstat the open keyfile and warn to stderr if mode is loose. Doesn't
# refuse the load — containerized deployments may legitimately use
# world-readable mounts. Returns 1 if a warning fired, 0 otherwise.
# Silent on fstat errors (no useful action; the caller's read will
# surface any real fd problem).
fn keyfile_warn_loose_mode(path, fd): i64 {
    var st[144];                              # STAT_BUFSZ
    if (sys_fstat(fd, &st) != 0) { return 0; }
    # st_mode is a 4-byte field at STAT_MODE; permission bits live in
    # the low 16. Load 2 bytes is sufficient — type/special-bits sit
    # above 0o7777 and we only care about g+o here.
    var lo = load8((&st) + STAT_MODE)     & 0xFF;
    var hi = load8((&st) + STAT_MODE + 1) & 0xFF;
    var mode = lo | (hi << 8);
    if (mode_is_loose(mode) == 0) { return 0; }
    syscall(1, 2, "agora: warning: keyfile ", 24);
    syscall(1, 2, path, strlen(path));
    syscall(1, 2, " has loose permissions (group/other readable); recommend chmod 600\n", 67);
    return 1;
}

# Read the 32-byte seed from a keyfile into seed_out. Returns 0 on
# success, -1 on missing file / wrong size / read error.
#
# 0.8.1: opens + fstat-warns (audit L1, ADR 0006-adjacent — see
# docs/audit/2026-05-23-audit.md § L1) + reads + closes. The warning
# is informational; loose-mode keyfiles still load so containerized
# operators can override their mount strategy.
fn keyfile_load_seed(path, seed_out): i64 {
    var fd = file_open(path, 0, 0);           # O_RDONLY
    if (fd < 0) { return 0 - 1; }
    keyfile_warn_loose_mode(path, fd);
    var n = file_read(fd, seed_out, ACCOUNT_SEED_BYTES);
    file_close(fd);
    if (n != ACCOUNT_SEED_BYTES) { return 0 - 1; }
    return 0;
}

# Derive the 32-byte public key from a 32-byte seed via sigil's
# ed25519_keypair. Writes pk into pk_out (32 bytes). Returns 0.
fn seed_to_pk(seed_buf, pk_out): i64 {
    var sk[64];
    ed25519_keypair(seed_buf, &sk, pk_out);
    return 0;
}

# Convenience: keyfile path → fingerprint. Reads seed, derives pk,
# computes fp. Returns 0 on success (writes fp_out), -1 on keyfile
# error. fp_out must be ≥ ACCOUNT_FP_BUF_BYTES.
fn keyfile_to_fingerprint(path, fp_out): i64 {
    var seed[32];
    if (keyfile_load_seed(path, &seed) != 0) { return 0 - 1; }
    var pk[32];
    seed_to_pk(&seed, &pk);
    compute_fingerprint(&pk, fp_out);
    return 0;
}

# Write a freshly-generated 32-byte seed to `path` with O_CREAT |
# O_EXCL + mode 0o600. Refuses to overwrite (-1 on EEXIST). Returns
# 0 on success, -1 on entropy / file / write error.
fn keyfile_generate(path): i64 {
    var seed[32];
    if (nonce_random_into(&seed, ACCOUNT_SEED_BYTES) != 0) { return 0 - 1; }
    # O_WRONLY | O_CREAT | O_EXCL with mode 0o600 = PERM_KEYFILE
    # 1.6.4 (audit M4) — see board.cyr: the hand-rolled BO_EXCL was dropped on
    # agnos, so `keygen` would OVERWRITE an existing identity seed there —
    # silent, unrecoverable loss of a user's key. `file_create_exclusive` is the
    # portable primitive.
    var fd = file_create_exclusive(path, ACCOUNT_PERM_KEYFILE);
    if (fd < 0) { return 0 - 1; }
    var n = file_write(fd, &seed, ACCOUNT_SEED_BYTES);
    file_close(fd);
    if (n != ACCOUNT_SEED_BYTES) { return 0 - 1; }
    return 0;
}

# Internal: read `want` bytes from /dev/urandom into out_buf. Same
# shape as nonce_random but with a caller-chosen byte count (so the
# keygen path can share the entropy reader with the login-flow
# nonce reader). Returns 0 on success, -1 on entropy failure.
fn nonce_random_into(out_buf, want): i64 {
    var fd = file_open("/dev/urandom", 0, 0);
    if (fd < 0) { return 0 - 1; }
    var got = 0;
    while (got < want) {
        var n = file_read(fd, out_buf + got, want - got);
        if (n <= 0) { file_close(fd); return 0 - 1; }
        got = got + n;
    }
    file_close(fd);
    return 0;
}

# === Login flow primitives (M6-C, ADR 0006) ===
#
# Domain-separation prefix for the challenge signature input. See
# ADR 0006 § Specifics — prevents the user's keypair being tricked
# into signing payloads for other protocols. 12 bytes literal.
#
# Challenge message = "agora-login:" + nonce_hex (64 chars) = 76 bytes.

enum AccountLogin {
    LOGIN_PREFIX_LEN  = 12;       # strlen("agora-login:")
    LOGIN_MSG_LEN     = 76;       # 12 + 64-hex nonce
}

# Read ACCOUNT_NONCE_BYTES (=32) raw bytes from /dev/urandom into
# out_buf. Returns 0 on success, -1 on entropy failure (open or
# short read). Same /dev/urandom shape sigil's generate_keypair
# uses internally.
fn nonce_random(out_buf): i64 {
    return nonce_random_into(out_buf, ACCOUNT_NONCE_BYTES);
}

# Hex-encode the 32 raw nonce bytes from in_buf into out_buf as 64
# lowercase hex chars + NUL. out_buf must be ≥ ACCOUNT_NONCE_BUF_BYTES.
# Returns ACCOUNT_NONCE_HEX_BYTES (=64).
fn nonce_to_hex(in_buf, out_buf): i64 {
    var i = 0;
    while (i < ACCOUNT_NONCE_BYTES) {
        var b = load8(in_buf + i) & 0xFF;
        var hi = (b >> 4) & 0xF;
        var lo = b & 0xF;
        if (hi < 10) { store8(out_buf + i * 2, 48 + hi); }
        else         { store8(out_buf + i * 2, 87 + hi); }
        if (lo < 10) { store8(out_buf + i * 2 + 1, 48 + lo); }
        else         { store8(out_buf + i * 2 + 1, 87 + lo); }
        i = i + 1;
    }
    store8(out_buf + ACCOUNT_NONCE_HEX_BYTES, 0);
    return ACCOUNT_NONCE_HEX_BYTES;
}

# Compose the signed-message payload for the login challenge:
# `"agora-login:" + nonce_hex` (76 bytes, NOT NUL-terminated — the
# caller passes the byte length to ed25519_sign / ed25519_verify).
# nonce_hex is the 64-char hex-encoded nonce from nonce_to_hex.
# Writes LOGIN_MSG_LEN bytes into out_buf; returns LOGIN_MSG_LEN.
fn format_challenge_msg(nonce_hex, out_buf): i64 {
    memcpy(out_buf, "agora-login:", LOGIN_PREFIX_LEN);
    memcpy(out_buf + LOGIN_PREFIX_LEN, nonce_hex, ACCOUNT_NONCE_HEX_BYTES);
    return LOGIN_MSG_LEN;
}

# Parse an `auth: <128-hex>` line into the raw 64-byte signature.
# Tolerates leading "auth:" or "auth: " (one optional space). Returns
# the byte length copied into sig_out (= ACCOUNT_SIG_BYTES on success)
# or -1 on malformed input (wrong prefix / wrong hex length / non-hex
# chars). sig_out must be ≥ ACCOUNT_SIG_BYTES.
fn parse_auth_sig(line, line_len, sig_out): i64 {
    if (line == 0)   { return 0 - 1; }
    if (line_len < 5) { return 0 - 1; }
    if ((load8(line + 0) & 0xFF) != 97)  { return 0 - 1; }  # 'a'
    if ((load8(line + 1) & 0xFF) != 117) { return 0 - 1; }  # 'u'
    if ((load8(line + 2) & 0xFF) != 116) { return 0 - 1; }  # 't'
    if ((load8(line + 3) & 0xFF) != 104) { return 0 - 1; }  # 'h'
    if ((load8(line + 4) & 0xFF) != 58)  { return 0 - 1; }  # ':'
    var off = 5;
    if (off < line_len) {
        if ((load8(line + off) & 0xFF) == 32) { off = off + 1; }
    }
    var hex_len = line_len - off;
    var want_hex = ACCOUNT_SIG_BYTES * 2;       # 128
    if (hex_len != want_hex) { return 0 - 1; }
    if (hex_is_valid(line + off, hex_len) == 0) { return 0 - 1; }
    # 1.8.1 (audit H1) — decode straight into the caller's buffer. sigil's
    # `hex_decode` takes its 64-byte output from the bump heap, which the ADR
    # 0021 arena never reclaims: 64 B per `auth:` attempt, with no login needed
    # (any handle shown by `list` will do) — the half of 2026-07-26 H2's "login
    # path" leak that the 1.6.3 arena work could not see. sig_out holds
    # ACCOUNT_SIG_BYTES.
    if (hex_decode_into(line + off, hex_len, sig_out) == 0) { return 0 - 1; }
    return ACCOUNT_SIG_BYTES;
}

# === Handle index (1.9.0) ===
#
#   <store>/.users/.by-handle/<handle>      "<fp16>\n" — the user who holds it
#   <store>/.users/.by-handle/.complete     the index covers every user
#
# Why. account_resolve_handle read EVERY user's `handle` file on every `login`
# (audit 1.8.1 H1 / L4): at 301 users one 4 KB packet of `login x` lines held a
# 1.8.0 poll sweep 626 ms, and an UNKNOWN handle — the case an attacker picks —
# always paid the whole scan, since nothing lets a miss stop early. With the
# index a login is one open: a claim, verified against the user's own `handle`
# file (which stays the source of truth), or — once `.complete` exists — an
# authoritative "unknown". A handle is a file name here, which is why
# account_resolve_handle now validates it before building any path.
#
# Maintenance, always under `.users/.lock` (account_register_lock):
#   - account_index_ensure builds it once for a store that predates it (the first
#     `serve` or `register` after the upgrade): one claim per user in scan order —
#     the first directory listing a duplicated handle keeps it, as the scan
#     always answered — then `.complete`;
#   - account_register claims the new handle BEFORE writing the user's files and
#     releases the old one AFTER, so a crash in between leaves a STALE claim
#     (verification fails and the lookup falls back to the scan), never a
#     missing one.
# Claims are written by store_publish: whole or absent, never replaced in place.
# An operator who edits `.users/` by hand deletes `.by-handle/`; the next `serve`
# or `register` rebuilds it.
enum AccountIndex {
    ACCOUNT_CLAIM_CAP = 32;      # bytes of a claim read (16 hex + LF, with room)
}

# Writes `<store>/.users/.by-handle` (NUL-terminated) into out_buf; returns its length.
fn account_index_dir(store, out_buf): i64 {
    var pos = build_users_dir(store, out_buf);
    memcpy(out_buf + pos, "/.by-handle", 12);   # incl. NUL
    return pos + 11;
}

# Writes `<store>/.users/.by-handle/<leaf>` into out_buf; returns its length.
# `leaf` is a handle_valid handle or ".complete" — never raw client bytes.
fn account_index_file(store, leaf, out_buf): i64 {
    var pos = account_index_dir(store, out_buf);
    store8(out_buf + pos, 47); pos = pos + 1;             # '/'
    var l = strlen(leaf);
    memcpy(out_buf + pos, leaf, l); pos = pos + l;
    store8(out_buf + pos, 0);
    return pos;
}

# Read `handle`'s claim into fp_out (ACCOUNT_FP_BUF_BYTES): 1 if it names a valid
# fingerprint, 0 if there is no claim, -1 if one exists but is unreadable or
# malformed (a symlink, a FIFO, a truncated file).
fn account_claim_read(store, handle, fp_out): i64 {
    var path[512];   # PATH_MAX_BYTES
    account_index_file(store, handle, &path);
    var raw[40];
    var n = store_read_all(&path, &raw, ACCOUNT_CLAIM_CAP);
    if (n < 0) {
        if (store_read_missing(n) == 1) { return 0; }
        return 0 - 1;
    }
    if (n < ACCOUNT_FP_HEX_BYTES) { return 0 - 1; }
    memcpy(fp_out, &raw, ACCOUNT_FP_HEX_BYTES);
    store8(fp_out + ACCOUNT_FP_HEX_BYTES, 0);
    if (fp16_valid(fp_out) == 0) { store8(fp_out, 0); return 0 - 1; }
    return 1;
}

# 1 if user `fp16`'s own `handle` file names `handle` — what verifies a claim.
fn account_holds_handle(store, fp16, handle): i64 {
    var hb[40];
    if (account_lookup_handle(store, fp16, &hb, ACCOUNT_HANDLE_BUF) <= 0) { return 0; }
    if (streq(&hb, handle) != 0) { return 1; }
    return 0;
}

# The index's answer for a VALID handle: 1 = found (fp_out set and verified),
# 0 = an authoritative unknown (no claim, index complete), -1 = no answer the
# caller may trust (no complete index, or a stale or broken claim) — scan.
fn account_index_lookup(store, handle, fp_out): i64 {
    var c = account_claim_read(store, handle, fp_out);
    if (c == 1) {
        if (account_holds_handle(store, fp_out, handle) == 1) { return 1; }
        return 0 - 1;
    }
    if (c == 0) {
        var mk[512];   # PATH_MAX_BYTES
        account_index_file(store, ".complete", &mk);
        if (store_name_exists(&mk) == 1) { return 0; }
    }
    return 0 - 1;
}

# Claim `handle` for `fp16` (the caller holds `.users/.lock`). Returns 0 — also
# when the claim already names fp16 — or -1 when another user really holds the
# handle or the write fails. A claim naming a user who no longer holds the handle,
# or an unreadable one, is replaced. `durable` is store_publish's: 1 for a
# registration, 0 inside account_index_ensure, which syncs the batch itself.
fn account_index_claim(store, handle, fp16, durable): i64 {
    var dir[512];   # PATH_MAX_BYTES
    account_index_dir(store, &dir);
    if (store_ensure(&dir) != 0) { return 0 - 1; }
    var path[512];
    account_index_file(store, handle, &path);
    var line[24];
    memcpy(&line, fp16, ACCOUNT_FP_HEX_BYTES);
    store8((&line) + ACCOUNT_FP_HEX_BYTES, 10);
    if (store_publish(&dir, &path, &line, ACCOUNT_FP_HEX_BYTES + 1, durable) == 0) { return 0; }
    var cur[24];
    if (account_claim_read(store, handle, &cur) == 1) {
        if (streq(&cur, fp16) != 0) { return 0; }
        if (account_holds_handle(store, &cur, handle) == 1) { return 0 - 1; }
    }
    xunlink(&path);
    if (store_publish(&dir, &path, &line, ACCOUNT_FP_HEX_BYTES + 1, durable) == 0) { return 0; }
    return 0 - 1;
}

# Drop `handle`'s claim if it names `fp16` (the caller holds `.users/.lock`).
fn account_index_release(store, handle, fp16): i64 {
    var cur[24];
    if (account_claim_read(store, handle, &cur) != 1) { return 0; }
    if (streq(&cur, fp16) == 0) { return 0; }
    var path[512];   # PATH_MAX_BYTES
    account_index_file(store, handle, &path);
    xunlink(&path);
    return 0;
}

# Build the index for a store that predates it (the caller holds `.users/.lock`);
# a no-op once `.complete` exists. Returns 0, or -1 if it could not be completed —
# lookups then keep scanning, which is slow but right.
fn account_index_ensure(store): i64 {
    var mk[512];   # PATH_MAX_BYTES
    account_index_file(store, ".complete", &mk);
    if (store_name_exists(&mk) == 1) { return 0; }
    var users[512];
    build_users_dir(store, &users);
    if (store_ensure(&users) != 0) { return 0 - 1; }
    var dir[512];
    account_index_dir(store, &dir);
    if (store_ensure(&dir) != 0) { return 0 - 1; }
    var n = store_dir_scan(&users);
    var ok = 1;
    var hb[40];
    var cur[24];
    var i = 0;
    while (i < n) {
        var entry = store_dir_name(i);
        if (strlen(entry) == ACCOUNT_FP_HEX_BYTES) {
            if (fp16_valid(entry) == 1) {
                if (account_lookup_handle(store, entry, &hb, ACCOUNT_HANDLE_BUF) > 0) {
                    # Not yet claimed (or left broken by a crashed build): claim it.
                    # A valid claim stays — the first user listed keeps a handle.
                    if (account_claim_read(store, &hb, &cur) != 1) {
                        if (account_index_claim(store, &hb, entry, 0) != 0) { ok = 0; }
                    }
                }
            }
        }
        i = i + 1;
    }
    if (ok == 0) { return 0 - 1; }
    # The claims were written without fsync; make them all durable at once, then
    # the marker that vouches for them (store_publish's `durable`).
    sys_sync();
    if (store_publish(&dir, &mk, "complete\n", 9, 1) != 0) {
        if (store_name_exists(&mk) == 0) { return 0 - 1; }
    }
    return 0;
}

# Take `.users/.lock`, build the index if the store predates it, release.
# `serve` runs this once before it listens. Returns account_index_ensure's result.
# A store with no `.users/` has no one to index, and is left untouched: the lock
# would create the store and `.users/` just because a server started (the first
# `register` builds the index under its own lock).
fn account_index_prepare(store): i64 {
    var users[512];   # PATH_MAX_BYTES
    build_users_dir(store, &users);
    if (store_name_exists(&users) == 0) { return 0; }
    var lk = account_register_lock(store);
    if (lk < 0) { return 0 - 1; }
    var r = account_index_ensure(store);
    store_lock_release(lk);
    return r;
}

# Scan `<store>/.users/` for a user whose `handle` file equals `handle`. On a
# match, writes that user's fingerprint into fp_out (NUL-terminated; >=
# ACCOUNT_FP_BUF_BYTES) and returns 1; 0 if none (or the directory cannot be
# listed). O(n) in registered users — a `.users/.by-handle/<handle>` index is
# roadmap § 1.9.0. (1.8.2: this comment sat orphaned ~265 lines away.)
fn account_resolve_handle(store, handle, fp_out): i64 {
    # 1.9.0 — a handle is a file name in the index, so validate it before any
    # path is built: the wire `login` passes the client's raw bytes. No valid
    # registration ever produced an invalid handle, so nothing is lost.
    store8(fp_out, 0);
    if (handle_valid(handle) == 0) { return 0; }
    var r = account_index_lookup(store, handle, fp_out);
    if (r >= 0) { return r; }
    store8(fp_out, 0);

    # The scan: a store whose index is incomplete, or a stale / broken claim.
    var users_path = cmd_alloc(PATH_MAX_BYTES);
    build_users_dir(store, users_path);

    # 1.8.1 (audit H1 / S8) — the allocation-free workspace scan (board.cyr),
    # and no 1,024-entry scan cap: a user past entry 1,024 was invisible here,
    # so `register` let a second key claim their handle.
    var n = store_dir_scan(users_path);
    if (n <= 0) { return 0; }

    var handle_buf = cmd_alloc(ACCOUNT_HANDLE_BUF);
    var i = 0;
    var found = 0;
    while (i < n) {
        var entry = store_dir_name(i);
        # Entry must look like a 16-char hex fingerprint. Quick
        # length check — skip dotfiles + index sidecars + anything
        # not the right shape.
        var elen = strlen(entry);
        if (elen == ACCOUNT_FP_HEX_BYTES) {
            if (found == 0) {
                var hlen = account_lookup_handle(store, entry, handle_buf, ACCOUNT_HANDLE_BUF);
                if (hlen > 0) {
                    if (streq(handle_buf, handle) != 0) {
                        memcpy(fp_out, entry, elen);
                        store8(fp_out + elen, 0);
                        found = 1;
                    }
                }
            }
        }
        i = i + 1;
    }
    return found;
}
