# board.cyr — post storage primitives (M5-A).
#
# One file per post per ADR 0002: <store>/<id>.txt where <id> is a
# monotonic integer. RFC-822-shaped headers (Subject / Date / Reply-To /
# From) were added at M5-D and are parsed by post_body_offset below
# (ADR 0003); a headerless M5-A/B/C post still reads correctly.
#
# Storage root is caller-provided (defaults wired in main.cyr via
# --store <path>, default `./agora-data/`). The trust boundary is the
# operator's CLI; the storage layer treats paths as opaque cstrings.
#
# Cross-platform: built on lib/io.cyr (file_open / file_read /
# file_write / file_read_all) plus lib/fs.cyr (dir_list_into, is_dir). Per the
# M1-and-onward cross-platform stance (ADR 0001), AGNOS is one
# target among many — same source builds on every platform the
# cyrius stdlib reaches.

# 1.6.2 — the local `enum BoardSys { SYS_MKDIR = 83; }` is GONE. 83 is mkdir
# only on Linux x86_64; the constant collided by NAME with the stdlib's agnos
# `SYS_MKDIR = 9`, so an `--agnos` build warned `duplicate symbol 'SYS_MKDIR'
# redefined with conflicting value (last definition wins)` and one of the two
# callers got the wrong number. That went from latent to dangerous when the
# cyrius 6.4.6x GPU syscall band landed: agnos 83 is now `SYS_GPU_DISPATCH_F64`
# (its own table comment reads "MKDIR on Linux"), so `store_ensure` would have
# handed a path pointer to a GPU matmul. `store_ensure` now calls the stdlib
# `sys_mkdir` wrapper, which is per-target — see the note there about its arity.

# 1.6.4 — the local `enum BoardOpen { BO_EXCL = 128; }` is GONE. It hardcoded
# the Linux O_EXCL bit, which agnos silently ignores; both call sites now use
# the stdlib's `file_create_exclusive` (lib/io.cyr), which is per-target. The
# comment it carried is also no longer true: lib/io.cyr DOES expose O_EXCL now.

# Filesystem permission constants (octal 0755 for directories,
# 0644 for files). Encoded as i64 because cyrius enums require
# positive integer literals.
enum BoardPerm {
    PERM_DIR  = 0x1ED;   # rwx r-x r-x  (0o755)
    PERM_FILE = 0x1A4;   # rw- r-- r--  (0o644)
}

# Per-post maximums. Conservative ceilings — bumping them is a
# named bite, not a silent change. A BBS post is usually < 4 KB
# of text; the 64 KB ceiling absorbs ASCII-art posts and inline
# images-as-text (M3's eventual workload).
enum BoardCap {
    POST_MAX_BYTES = 65536;
    PATH_MAX_BYTES = 512;
    DIRENT_ID_MAX  = 4096;   # max post IDs returned by post_list at once (the newest)
    POST_HEAD_SCAN = 2048;   # 1.8.1 — bytes replies_to reads per post (headers only)
    BOARD_NAME_MAX = 32;     # ADR 0004 validation: ≤ 32 bytes
    BOARD_LIST_MAX = 256;    # max named boards listed at once
    BOARD_ADMINS_CHUNK = 4096;      # .admins read window (1.9.0: was the whole cap)
    BOARD_ADMINS_FILE_CAP = 1048576; # 1 MiB of .admins read; past it, ignored (fails closed)
}

# === M6-F: per-board posting policy (ADR 0006 § Specifics) ===
#
# `<store>/<board>/.policy` is one of `open` / `known` / `admin`.
# (`<store>/.policy` for the main board.) Missing file = `open`.
#
#   open   — any authenticated session may post. At M6, since every
#            login binds to a locally-registered handle, this is
#            equivalent to `known`; the distinction is forward-compat
#            for federation (v2.x pillar 1), where `open` would also
#            accept federated identities not registered locally.
#   known  — authenticated AND fingerprint resolves to a local
#            registration in `<store>/.users/`. At M6 this is true
#            whenever the session is non-anonymous (login always goes
#            through local resolution).
#   admin  — authenticated AND handle appears in `<store>/<board>/.admins`
#            (one handle per line; blank + leading-`#` lines ignored).
#
# Operator sets policy by editing the files directly (`echo known >
# <store>/<board>/.policy`); no CLI verb at first-cut M6-F. A future
# bite (roadmap § 1.9.2, "Operator CLI") may add `agora policy set <board> <mode>`
# if real deployments demand it.

enum BoardPolicy {
    POLICY_OPEN  = 0;
    POLICY_KNOWN = 1;
    POLICY_ADMIN = 2;
    POLICY_INVALID = 3;   # 1.8.1 — parse result only; board_policy_get maps it to ADMIN
}

# === ADR 0004: per-board layout ===
#
# "main" = flat-root (free backwards compat with 0.4.0 stores).
# Named boards = `<store>/<name>/`. Each board has its own monotonic
# ID counter + its own lockfile. The board name "main" is reserved
# — it's the implicit flat root, NOT a literal subdir.

# Validate a board name per ADR 0004:
#   - 1 to BOARD_NAME_MAX bytes
#   - bytes are lowercase ASCII (a-z), digits (0-9), `-`, or `_`
#   - first byte is a letter or digit (no leading dash/underscore — dodges
#     the "starts-with-dot" sniffer for hidden files)
#   - the literal name "main" is reserved
#   - the literal name ".lock" (and anything starting with `.`) is
#     impossible per the leading-letter-or-digit rule
#
# Returns 1 if valid, 0 if invalid. Caller surfaces user-facing
# error message.
fn board_name_valid(name): i64 {
    if (name == 0) { return 0; }
    var len = strlen(name);
    if (len < 1)              { return 0; }
    if (len > BOARD_NAME_MAX) { return 0; }
    # Reserved: "main" is the implicit flat root
    if (streq(name, "main") != 0) { return 0; }
    # First byte must be lowercase letter or digit
    var c0 = load8(name) & 0xFF;
    var c0_ok = 0;
    if (c0 >= 97) { if (c0 <= 122) { c0_ok = 1; } }   # a-z
    if (c0 >= 48) { if (c0 <= 57)  { c0_ok = 1; } }   # 0-9
    if (c0_ok == 0) { return 0; }
    # Rest: a-z, 0-9, '-', '_'
    var i = 1;
    while (i < len) {
        var c = load8(name + i) & 0xFF;
        var ok = 0;
        if (c >= 97) { if (c <= 122) { ok = 1; } }    # a-z
        if (c >= 48) { if (c <= 57)  { ok = 1; } }    # 0-9
        if (c == 45) { ok = 1; }                       # '-'
        if (c == 95) { ok = 1; }                       # '_'
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Resolve a (store, board) pair into a filesystem path. Writes the
# NUL-terminated path into out_buf; returns the length.
#
#   board == "main"  → `<store>`              (flat root, ADR 0004 § Decision)
#   board == "art"   → `<store>/art`
#
# out_buf must be ≥ PATH_MAX_BYTES.
fn board_path(store, board, out_buf): i64 {
    var slen = strlen(store);
    memcpy(out_buf, store, slen);
    var pos = slen;
    if (streq(board, "main") == 0) {
        # Named board: append "/<board>"
        store8(out_buf + pos, 47); pos = pos + 1;          # '/'
        var blen = strlen(board);
        memcpy(out_buf + pos, board, blen);
        pos = pos + blen;
    }
    store8(out_buf + pos, 0);
    return pos;
}

# M5-H input filter — return 1 if byte is allowed into a post body,
# 0 to drop silently. Telnet bytes from a connected client are
# adversarial-by-default; we drop two classes:
#
#   - **NUL (0x00)** — terminates cstring downstream tools (cat,
#     grep, `agora read` output, the `list` numeric formatter); a
#     post containing NUL would render as truncated everywhere.
#   - **ESC (0x1B)** — terminal-control injection. A post containing
#     ESC sequences (cursor moves, color changes, screen clears,
#     keyboard reprogramming on old VT terminals) executes in the
#     viewer's terminal when another user reads it. The classic
#     "embed ESC sequences in chat to wreck the viewer's session"
#     attack. We strip at ingress; future operator config may add
#     an opt-in flag for raw-mode posts.
#
# Passthrough is TAB, CR, LF, printable ASCII and the high bytes
# 128-254. Everything else in C0, plus DEL and IAC, is dropped — see
# the per-byte reasoning in the body below. (This header said the
# opposite until 1.6.5 corrected the body and left the summary behind;
# BS/DEL no longer reach a post. Making BS *edit* the line for
# non-LINEMODE clients is still open — roadmap § 1.10.0.)
#
# ⚠ This filter is per BYTE, so it cannot tell UTF-8 text from the C1
# controls that share the 128-159 range (0x9B is the 8-bit CSI; C2 9B is
# the same control UTF-8-encoded). Those are stored, and neutralized at
# EGRESS by `text_sanitize` below (1.8.0, ADR 0024) — which also covers
# everything this filter never sees: CLI-written posts and old files.
fn input_byte_ok(b): i64 {
    if (b == 0)    { return 0; }
    if (b == 0x1B) { return 0; }
    # 1.6.4 (audit M2) — drop IAC (0xFF) at ingress.
    #
    # A byte that reaches here has already passed the telnet state machine, so a
    # literal 0xFF at this point came from a client that sent `IAC IAC` — the
    # escape for "I mean a data 0xFF". Storing it verbatim let a registered user
    # put raw telnet COMMANDS into a post: `FF FA 18` is `IAC SB TERMINAL-TYPE`
    # with no `IAC SE`, which wedges a conforming client — and every later reader
    # of that post gets it, with no removal path short of the operator editing
    # the file. It is the ESC problem above with a worse blast radius.
    #
    # 0xFF is never valid in well-formed UTF-8, so nothing legitimate is lost.
    # This is the ingress half; `send_text` (main.cyr) is the egress half that
    # RFC 854 § "the IAC" actually requires, and which also protects content
    # stored before this filter existed.
    if (b == 0xFF) { return 0; }
    # 1.6.5 (audit L2) — drop the remaining C0 controls and DEL. (This said
    # "so the wire body matches what the CLI already refuses". The CLI refuses
    # them in `--subject` only; a CLI post BODY is stored unfiltered, which is
    # one reason 1.8.0 sanitizes at egress — ADR 0024.) TAB (9), CR (13) and LF (10)
    # stay: CR/LF are load-bearing here, because this filter runs BEFORE the
    # EOL detection in process_rx — dropping them would break line dispatch
    # entirely. What goes is BEL (7), BS (8), VT/FF (11/12), the rest of C0,
    # and DEL (127).
    #
    # BS deserves a word: it used to land in the post body as a literal 0x08,
    # which renders as garbage for every later reader. Dropping it does not give
    # char-mode clients line editing — that is still the open INFO item in the
    # 2026-07-26 audit — but "nothing happens" beats "invisible byte stored in
    # everyone's copy of the post".
    if (b == 127) { return 0; }
    if (b < 32) {
        if (b == 9)  { return 1; }
        if (b == 10) { return 1; }
        if (b == 13) { return 1; }
        return 0;
    }
    return 1;
}

# Header-context byte filter (0.7.0 audit H1, audit doc 2026-05-23).
#
# Subject / handle / fp values are written into the RFC-822 header
# block via `post_format_with_headers` — each as `Name: <value>\r\n`.
# A value containing CR or LF would terminate the header line early
# and inject arbitrary new headers (forge Reply-To / From / etc.) on
# the next read. NUL truncates `strlen`-based downstream tooling;
# ESC injects terminal control sequences into every reader's screen.
# Other C0 control bytes (0x01-0x08, 0x0B-0x1F) are non-printable
# junk in subjects — reject to keep stored posts grep-able.
#
# Allowed: TAB (0x09), printable ASCII (0x20-0x7E), DEL (0x7F is
# unusual but renders as a glyph in modern terminals; not a security
# hazard), and UTF-8 high bytes (0x80-0xFF) for non-ASCII subjects.
#
# Returns 1 if byte is safe in a header value, 0 to reject.
fn header_text_ok(b): i64 {
    if (b == 9)         { return 1; }     # TAB
    if (b < 32)         { return 0; }     # C0 control (NUL, CR, LF, ESC, etc.)
    return 1;
}

# Scan `[buf, buf+len)` and return 1 if every byte is `header_text_ok`,
# 0 if any byte would inject. Caller surfaces user-visible error.
fn header_text_buf_ok(buf, len): i64 {
    var i = 0;
    var ok = 1;
    while (i < len) {
        if (header_text_ok(load8(buf + i) & 0xFF) == 0) {
            ok = 0;
            i = len;
            continue;
        }
        i = i + 1;
    }
    return ok;
}

# cstring variant — accepts a NUL-terminated string.
fn header_text_cstr_ok(s): i64 {
    if (s == 0) { return 1; }
    return header_text_buf_ok(s, strlen(s));
}

# === Egress text sanitization (1.8.0, ADR 0024) ===
#
# The filters above run at INGRESS and are not enough on their own. Stored text
# reaches other users' terminals, and until 1.8.0 two classes got through:
#
#   - C1 controls. `input_byte_ok` passes every byte 0x80-0xFE so UTF-8 text can
#     be posted, and that range holds the C1 controls — raw (0x9B is the 8-bit
#     CSI) and UTF-8-encoded (C2 9B is U+009B — a CSI to a C1-honouring terminal). A
#     registered user could post `C2 9B 2 J` and clear every reader's screen, or
#     an OSC 52 and write their clipboard. Subjects (`header_text_ok`) likewise.
#   - Anything the CLI stored. `agora post` keeps its stdin body unfiltered, so
#     a CLI-authored post could carry a plain ESC sequence to every wire
#     reader. The same holds for posts written before a filter existed and for
#     any file edited on disk.
#
# So stored text is neutralized on the way OUT, where it leaves: darshana's
# `tty_sanitize_buf` in UTF-8 mode. Every control byte or sequence becomes one
# '?'; well-formed UTF-8 passes byte-for-byte, so ordinary posts — accents, €,
# em dashes — read exactly as before. UTF-8 and not Latin-1 because a session
# IS UTF-8: agora negotiates no CHARSET option and its own output (the MOTD,
# the help text) is UTF-8, while Latin-1 mode would turn the continuation bytes
# of most non-ASCII characters into '?'. The stored post is not rewritten — the
# artifact stays what its author wrote, and fixing the display covers old
# posts too.

enum TextEgress {
    TEXT_KEEP_CR   = 0x2000;   # tty_sanitize_buf `keep` bit 13 = CR (darshana names only TAB / LF)
    TEXT_CHUNK_MAX = 504;      # input bytes per egress pass; callers size their buffers from it
}

# The C0 bytes kept: TAB, LF and CR. CR LF is the NVT newline (RFC 854) every
# stored body is written with, so dropping either would turn each line end
# into '?'. Every other C0 byte is neutralized, and ESC can never be kept,
# whatever this says.
fn text_sanitize_keep(): i64 {
    return TTY_KEEP_TAB | TTY_KEEP_LF | TEXT_KEEP_CR;
}

# Sanitize `len` bytes at `src` into `out` under agora's egress rule. Returns
# the number of bytes written — never more than `len` — or -1 if `len` is
# negative. Pure: no allocation, no syscall.
fn text_sanitize(out, src, len): i64 {
    return tty_sanitize_buf(out, 0, src, len, TTY_SANITIZE_UTF8, text_sanitize_keep());
}

# End (exclusive) of the next egress chunk of `src[i..len)`, at most `cap` bytes
# long (`cap` >= 4), chosen so that sanitizing chunk by chunk gives exactly the
# bytes sanitizing the whole input at once would.
#
# A cut inside a UTF-8 sequence would hand the sanitizer a truncated sequence,
# and it would emit '?' for a character that is perfectly valid. The rule: if
# any of the last three bytes before the cut is a lead byte (>= 0xC0), cut at
# the earliest such byte instead, so that sequence starts the next chunk whole.
# That is sufficient because a well-formed sequence is at most four bytes and
# holds no byte >= 0xC0 after its lead: a sequence that starts earlier ends at
# or before the cut, and one that would have crossed the cut is malformed
# either way, so the sanitizer's answer for it does not depend on where the
# input stops. Returns `len` for the last chunk, and always a value > `i`.
fn text_chunk_end(src, i, len, cap): i64 {
    var e = i + cap;
    if (e >= len) { return len; }
    var j = e - 3;
    if (j <= i) { j = i + 1; }
    var cut = e;
    var scanning = 1;
    while (scanning == 1) {
        if (j >= e) { scanning = 0; continue; }
        if ((load8(src + j) & 0xFF) >= 0xC0) { cut = j; scanning = 0; continue; }
        j = j + 1;
    }
    return cut;
}

# Copy `n` bytes from `src` to `out`, doubling every 0xFF (RFC 854: a data byte
# of 255 goes on the wire as IAC IAC). Returns the bytes written, at most 2·n.
# After `text_sanitize` in UTF-8 mode no 0xFF can remain — it is never valid
# UTF-8 — so this is defence in depth, kept so that a change of sanitizing mode
# cannot quietly re-open the 1.6.4 telnet-command injection.
fn text_iac_double(out, src, n): i64 {
    var o = 0;
    var i = 0;
    while (i < n) {
        var b = load8(src + i) & 0xFF;
        store8(out + o, b);
        o = o + 1;
        if (b == 0xFF) { store8(out + o, 0xFF); o = o + 1; }
        i = i + 1;
    }
    return o;
}

# Re-validate a 16-char lowercase-hex fingerprint cstring. Used by
# `post_from` to harden against tampered handle files. Returns 1 if
# `fp` is exactly 16 bytes of [0-9a-f], 0 otherwise.
fn fp16_valid(fp): i64 {
    if (fp == 0) { return 0; }
    var len = strlen(fp);
    if (len != 16) { return 0; }
    var i = 0;
    while (i < 16) {
        var c = load8(fp + i) & 0xFF;
        var ok = 0;
        if (c >= 48) { if (c <= 57)  { ok = 1; } }   # 0-9
        if (c >= 97) { if (c <= 102) { ok = 1; } }   # a-f
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Create a directory if it doesn't exist. Treats EEXIST (-17 on
# Linux) as success. Returns 0 on success or already-exists;
# negative errno otherwise.
#
# 1.6.2 — routed through the stdlib `sys_mkdir` instead of a raw syscall, per
# CLAUDE.md's "use lib primitives, not raw syscalls". The branch is unavoidable:
# `sys_mkdir` is NOT arity-compatible across targets — Linux/macOS take
# `(path, mode)` (lib/syscalls_x86_64_linux.cyr:350) while agnos takes
# `(path, pathlen)` (lib/syscalls_x86_64_agnos.cyr:452), because the agnos
# kernel has no permission model to pass a mode to. Passing PERM_DIR as a length
# would ask agnos to read 493 bytes of path. agnos's mkdir reports success
# unconditionally, so the EEXIST arm below is a Linux/macOS concern only and
# costs nothing there.
fn store_ensure(path): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var rc = sys_mkdir(path, strlen(path));
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var rc = sys_mkdir(path, PERM_DIR);
    #endif
    if (rc == 0) { return 0; }
    if (rc == (0 - 17)) { return 0; }
    return rc;
}

# Existence check for the (store, board) pair (0.8.3 audit M4).
# Used by the wire-side `enter` command to gate auto-create on the
# session's auth state — anonymous sessions can enter existing
# boards but cannot create new ones. CLI verbs route through
# board_can_post which already denies anon before any mkdir runs.
#
# "main" is the implicit flat root — always counts as existing
# (a fresh store's main board materializes at first post). For a
# named board, builds the directory path and runs is_dir.
#
# Returns 1 if the board exists (or is "main"), 0 otherwise.
fn board_exists(store, board): i64 {
    if (streq(board, "main") != 0) { return 1; }
    var path = cmd_alloc(PATH_MAX_BYTES);
    board_path(store, board, path);
    return is_dir(path_str(path));
}

# Ensure the (store, board) path exists. For board == "main" this
# is equivalent to store_ensure(store); for named boards it ensures
# `<store>` first, then `<store>/<name>` second (one-level mkdir,
# no recursive needed).
fn board_ensure(store, board): i64 {
    var rc = store_ensure(store);
    if (rc != 0) { return rc; }
    if (streq(board, "main") != 0) { return 0; }
    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    board_path(store, board, path_buf);
    return store_ensure(path_buf);
}

# Build the on-disk path for a given (board, id) into `out_buf`:
#   board == "main"  →  <store>/<id>.txt
#   else             →  <store>/<board>/<id>.txt
# Returns the length (excluding NUL). out_buf must be ≥ PATH_MAX_BYTES.
fn build_post_path(store, board, id, out_buf): i64 {
    var pos = board_path(store, board, out_buf);  # writes path + NUL
    # board_path's NUL is at pos; overwrite with '/'
    store8(out_buf + pos, 47); pos = pos + 1;   # '/'

    var idbuf[24];
    var idlen = fmt_int_buf(id, &idbuf);
    memcpy(out_buf + pos, &idbuf, idlen);
    pos = pos + idlen;

    store8(out_buf + pos, 46); pos = pos + 1;   # '.'
    store8(out_buf + pos, 116); pos = pos + 1;  # 't'
    store8(out_buf + pos, 120); pos = pos + 1;  # 'x'
    store8(out_buf + pos, 116); pos = pos + 1;  # 't'
    store8(out_buf + pos, 0);                   # NUL
    return pos;
}

# Parse "<digits>.txt" → integer id, or 0 if the name doesn't match.
# Used by post_max_id and post_list to filter directory entries.
# Returns 0 for any name that isn't a positive-integer post id.
fn parse_post_id(name): i64 {
    var len = strlen(name);
    if (len < 5) { return 0; }
    # Suffix must be ".txt"
    if ((load8(name + len - 4) & 0xFF) != 46)  { return 0; }
    if ((load8(name + len - 3) & 0xFF) != 116) { return 0; }
    if ((load8(name + len - 2) & 0xFF) != 120) { return 0; }
    if ((load8(name + len - 1) & 0xFF) != 116) { return 0; }
    # Cap digit-prefix length to keep `n * 10 + (c - 48)` arithmetic
    # bounded — 0.7.0 audit finding M3. i64 holds 18 full digits
    # (9.22e18 max); 19+ digits can wrap. A filename with a 19-digit
    # numeric prefix isn't a legitimate agora post (post_new monotonic
    # IDs start at 1) — reject as not-a-post-id rather than risk a
    # negative / small overflow value silently passing through.
    var prefix_len = len - 4;
    if (prefix_len > 18) { return 0; }
    # Prefix must be all digits and > 0. Iterate over every prefix
    # byte regardless of validity — we always advance `i`, and the
    # `ok` flag short-circuits the arithmetic. This shape avoids the
    # cyrius-classic "continue without incrementing i = infinite loop"
    # trap that early drafts of this fn hit.
    var i = 0;
    var n = 0;
    var ok = 1;
    while (i < prefix_len) {
        var c = load8(name + i) & 0xFF;
        if (ok != 0) {
            if (c < 48) { ok = 0; }
            if (c > 57) { ok = 0; }
            if (ok != 0) {
                n = n * 10 + (c - 48);
            }
        }
        i = i + 1;
    }
    if (ok == 0) { return 0; }
    if (n <= 0)  { return 0; }
    return n;
}

# Find the highest existing post ID in `(store, board)`. Returns 0
# if the board is empty / non-existent. Per ADR 0004 each board has
# its own monotonic counter — listing scans only that board's dir.
# === 1.8.1 (audit H1): directory listing without bump-heap residue ===
#
# `dir_list` builds a vec plus one `Str` per entry on the bump heap, which the
# ADR 0021 arena reset never reclaims: ~170 B per call plus ~75 B per entry,
# reachable WITHOUT login and pipelinable (`login x` scans `.users/`; `list`,
# `read` and `boards` scan boards). Measured at 1.8.0 under poll: +2.5 MB/s from
# one anonymous connection on an EMPTY store, +15 MB/s with 301 users. Every
# listing now goes through `dir_list_into` (cyrius 6.5.12), which allocates
# nothing, into ONE process-lifetime workspace. The workspace doubles when a
# directory outgrows it (`dir_list_into`'s -3 / -4), so its total size is
# bounded by about twice the largest directory ever listed — never by the
# number of calls. Results live in the workspace until the next
# `store_dir_scan`: consume or copy them before scanning again.
enum DirScan {
    DIR_SCRATCH_BYTES = 32768;     # getdents batch buffer
    DIR_INIT_ENTRIES  = 4608;      # DIRENT_ID_MAX + boards + dotfiles, first size
    DIR_NAME_AVG      = 24;        # names-buffer bytes budgeted per entry
    DIR_MAX_ENTRIES   = 1048576;   # growth ceiling — a bigger directory fails the scan
}

var g_dir_scratch = 0;   # getdents scratch
var g_dir_names   = 0;   # NUL-terminated names, packed
var g_dir_offs    = 0;   # per-entry offset into g_dir_names
var g_dir_ids     = 0;   # i64 scratch with the same capacity (post_list's sort)
var g_dir_cap     = 0;   # entry capacity of g_dir_offs / g_dir_ids

# (Re)size the workspace to `want` entries. The superseded buffers are not
# reclaimed — the bump heap cannot — which is why it only ever doubles.
fn store_dir_grow(want): i64 {
    if (g_dir_scratch == 0) { g_dir_scratch = alloc(DIR_SCRATCH_BYTES); }
    var nm = alloc(want * DIR_NAME_AVG);
    var of = alloc(want * 8);
    var ids = alloc(want * 8);
    if (g_dir_scratch == 0) { return 0 - 1; }
    if (nm == 0) { return 0 - 1; }
    if (of == 0) { return 0 - 1; }
    if (ids == 0) { return 0 - 1; }
    g_dir_names = nm;
    g_dir_offs = of;
    g_dir_ids = ids;
    g_dir_cap = want;
    return 0;
}

# A `Str` header for a NUL-terminated path, in the per-command arena. The
# stdlib's directory calls take a `Str`, and `str_from` takes its 16 bytes from
# the bump heap — 16 B per `enter` and per `boards` entry, never reclaimed.
fn path_str(cstr): i64 {
    var s = cmd_alloc(16);
    store64(s, cstr);
    store64(s + 8, strlen(cstr));
    return s;
}

# List the directory `path` (NUL-terminated) into the workspace. Returns the
# entry count (`.` and `..` skipped), or -1 if it could not be opened or read
# (or outgrew DIR_MAX_ENTRIES). Entries: store_dir_name(0 .. count-1).
fn store_dir_scan(path): i64 {
    if (g_dir_cap == 0) {
        if (store_dir_grow(DIR_INIT_ENTRIES) < 0) { return 0 - 1; }
    }
    var p = path_str(path);
    var result = 0 - 1;
    var going = 1;
    while (going == 1) {
        var r = dir_list_into(p, g_dir_scratch, DIR_SCRATCH_BYTES,
          g_dir_names, g_dir_cap * DIR_NAME_AVG, g_dir_offs, g_dir_cap);
        var full = 0;
        if (r == (0 - 3)) { full = 1; }
        if (r == (0 - 4)) { full = 1; }
        if (full == 0) {
            if (r >= 0) { result = r; }
            going = 0;
            continue;
        }
        if (g_dir_cap * 2 > DIR_MAX_ENTRIES) { going = 0; continue; }
        if (store_dir_grow(g_dir_cap * 2) < 0) { going = 0; continue; }
    }
    return result;
}

# Entry `i` of the last store_dir_scan, NUL-terminated.
fn store_dir_name(i): i64 {
    return g_dir_names + load64(g_dir_offs + i * 8);
}

# Highest post id in (store, board), 0 if none — the next post is this + 1 (under store_lock).
fn post_max_id(store, board): i64 {
    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    board_path(store, board, path_buf);
    var n = store_dir_scan(path_buf);
    var max_id = 0;
    var i = 0;
    while (i < n) {
        var id = parse_post_id(store_dir_name(i));
        if (id > max_id) { max_id = id; }
        i = i + 1;
    }
    return max_id;
}

# === M5-G: per-store single-writer lock ===
#
# Two concurrent writers (CLI + telnet, two CLI processes, etc.) can
# both read `post_max_id` and try to claim the same next-ID. The EXCL
# flag (ADR 0002 § Positive consequences) means one wins and one
# fails with -1 from post_new — no corruption, but the loser's post
# is dropped. M5-G upgrades this to "both succeed, with distinct IDs"
# by serializing the claim+write critical section through a per-store
# flock.
#
# The lockfile is `<store>/.lock`. Created lazily on first acquire;
# operators can delete it between runs. parse_post_id rejects
# `.lock` (no `.txt` suffix) so it doesn't show up in `list`.

# Acquire the per-board write lock. Lockfile is `<board-path>/.lock`.
# Per ADR 0004 each board has its own lock — concurrent writers to
# different boards never contend with each other.
#
# Returns lockfile fd on success (caller must `store_lock_release`
# to release + close), or -1 on failure.
fn store_lock_acquire(store, board): i64 {
    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    var blen = board_path(store, board, path_buf);
    store8(path_buf + blen, 47);              # '/'
    store8(path_buf + blen + 1, 46);          # '.'
    memcpy(path_buf + blen + 2, "lock", 4);
    store8(path_buf + blen + 6, 0);           # NUL

    return store_lock_open(path_buf);         # 1.9.0: no symlink, no FIFO (arena.cyr)
}

# Release the per-board write lock. Closing the fd also releases
# the kernel-side flock.
fn store_lock_release(fd): i64 {
    file_close(fd);
    return 0;
}

# Read a post by (board, id) into the caller-allocated buffer.
# Returns the number of bytes read, or negative on error.
#
# 1.8.1 (audit H3, found re-measuring H1) — the path lives on the STACK. It
# came from the per-command arena, and `list` and `replies_to` call this once
# PER POST: on a ~1,500-post board that is ~770 KB of 512-byte paths in one
# command, past the 512 KB arena, after which EVERY cmd_alloc in the command
# silently fell back to a never-reclaimed bare alloc() — ~400 KB leaked per
# anonymous `list` or `read` under poll. (1.8.0 hid it: a `list` that size
# overflowed the tx queue and the session was dropped first.)
fn post_read(store, board, id, out_buf, out_cap): i64 {
    var path_buf[512];   # PATH_MAX_BYTES
    build_post_path(store, board, id, &path_buf);
    return store_read_all(&path_buf, out_buf, out_cap);   # 1.9.0: regular files only
}

# Write "YYYY-MM-DDTHH:MM:SSZ" for `epoch` (seconds, >= 0) into `out`, which
# must hold 21 bytes; NUL-terminated. Returns 20. 1.8.1 (audit H1) — replaces
# chrono's `iso8601_now()` in post_format, which took 72 bytes of bump heap per
# post (a 48-byte date struct plus the string) that the per-command arena never
# reclaims, and whose 0 return on a refused allocation would have reached
# `strlen`. Civil-from-days per H. Hinnant; no allocation. Pure.
fn iso8601_into(epoch, out): i64 {
    var days = epoch / 86400;
    var rem = epoch % 86400;
    var z = days + 719468;
    var era = z / 146097;
    var doe = z - era * 146097;
    var yoe = (doe - (doe / 1460) + (doe / 36524) - (doe / 146096)) / 365;
    var y = yoe + era * 400;
    var doy = doe - ((365 * yoe) + (yoe / 4) - (yoe / 100));
    var mp = ((5 * doy) + 2) / 153;
    var d = doy - (((153 * mp) + 2) / 5) + 1;
    var m = mp + 3;
    if (m > 12) { m = m - 12; }
    if (m <= 2) { y = y + 1; }
    iso_put_digits(out, 0, y, 4);
    store8(out + 4, 45);                  # '-'
    iso_put_digits(out, 5, m, 2);
    store8(out + 7, 45);
    iso_put_digits(out, 8, d, 2);
    store8(out + 10, 84);                 # 'T'
    iso_put_digits(out, 11, rem / 3600, 2);
    store8(out + 13, 58);                 # ':'
    iso_put_digits(out, 14, (rem % 3600) / 60, 2);
    store8(out + 16, 58);
    iso_put_digits(out, 17, rem % 60, 2);
    store8(out + 19, 90);                 # 'Z'
    store8(out + 20, 0);
    return 20;
}

# Write `val` as exactly `width` zero-padded decimal digits at out+pos.
fn iso_put_digits(out, pos, val, width): i64 {
    var k = width - 1;
    var v = val;
    while (k >= 0) {
        store8(out + pos + k, 48 + (v % 10));
        v = v / 10;
        k = k - 1;
    }
    return 0;
}

# === RFC 822-shaped headers (ADR 0003) ===

# Per-post max for hand-typed subjects. Conservative; tighter than
# POST_MAX_BYTES since subjects are single-line UI strings.
enum HeaderCap {
    SUBJECT_MAX_BYTES = 256;
}

# Locate the start of the body within a post file. Returns 0 if the
# file has no headers (whole file is body — M5-A/B/C backwards-
# compat), else the byte offset past the blank line that terminates
# the header block.
#
# Sniffer: first byte must be ASCII uppercase letter (A-Z, 65-90)
# for headers to be present. Body-starting-with-`Subject:` (no
# leading uppercase by coincidence) is therefore safe to leave
# headerless. The blank-line terminator is `\n\n` or `\r\n\r\n`;
# mixed line endings inside the header block are tolerated.
fn post_body_offset(buf, len): i64 {
    if (len == 0) { return 0; }
    var c0 = load8(buf) & 0xFF;
    if (c0 < 65) { return 0; }
    if (c0 > 90) { return 0; }

    var i = 0;
    var body_off = 0;
    var done = 0;
    while (done == 0) {
        if (i + 1 >= len) {
            done = 1;
            continue;
        }
        # `\n\n`
        if ((load8(buf + i) & 0xFF) == 10) {
            if ((load8(buf + i + 1) & 0xFF) == 10) {
                body_off = i + 2;
                done = 1;
                continue;
            }
        }
        # `\r\n\r\n`
        if (i + 3 < len) {
            if ((load8(buf + i) & 0xFF) == 13) {
                if ((load8(buf + i + 1) & 0xFF) == 10) {
                    if ((load8(buf + i + 2) & 0xFF) == 13) {
                        if ((load8(buf + i + 3) & 0xFF) == 10) {
                            body_off = i + 4;
                            done = 1;
                            continue;
                        }
                    }
                }
            }
        }
        i = i + 1;
    }
    return body_off;
}

# Look for a `Name: value\r\n` (or `Name: value\n`) line in the
# header block. Copies the value into out_buf and returns its length.
# Returns -1 if not found, 0 if found with an empty value.
#
# Match is byte-for-byte on the name + `:` + optional space. Header
# block is the region from buf[0] up to `post_body_offset(buf, len)`;
# if the file has no headers (body_off == 0), the lookup falls
# through to -1 immediately.
fn header_get(buf, len, name, out_buf, out_max): i64 {
    var body_off = post_body_offset(buf, len);
    if (body_off == 0) { return 0 - 1; }
    var nlen = strlen(name);

    var i = 0;
    var found = 0 - 1;
    var fval_start = 0;
    var fval_end = 0;

    var scanning = 1;
    while (scanning == 1) {
        if (i >= body_off) { scanning = 0; continue; }
        if (i + nlen + 1 >= body_off) { scanning = 0; continue; }
        # Match `name:` at start of line (line-start is either i==0
        # or the byte before is `\n`)
        var at_line_start = 0;
        if (i == 0) { at_line_start = 1; }
        else {
            if ((load8(buf + i - 1) & 0xFF) == 10) { at_line_start = 1; }
        }
        if (at_line_start != 0) {
            if (memeq(buf + i, name, nlen) == 1) {
                if ((load8(buf + i + nlen) & 0xFF) == 58) {  # ':'
                    var vs = i + nlen + 1;
                    # Skip a single optional space
                    if (vs < body_off) {
                        if ((load8(buf + vs) & 0xFF) == 32) { vs = vs + 1; }
                    }
                    # Read until \r or \n
                    var ve = vs;
                    var eat = 1;
                    while (eat == 1) {
                        if (ve >= body_off) { eat = 0; }
                        else {
                            var b = load8(buf + ve) & 0xFF;
                            if (b == 13) { eat = 0; }
                            else { if (b == 10) { eat = 0; }
                                else         { ve = ve + 1; } }
                        }
                    }
                    found = 1;
                    fval_start = vs;
                    fval_end = ve;
                    scanning = 0;
                    continue;
                }
            }
        }
        i = i + 1;
    }

    if (found < 0) { return 0 - 1; }
    var vlen = fval_end - fval_start;
    if (vlen > out_max) { vlen = out_max; }
    if (vlen > 0) {
        memcpy(out_buf, buf + fval_start, vlen);
    }
    return vlen;
}

# === Post header parameter struct (0.9.0 ABI freeze, ADR 0008) ===
#
# Replaces the M5-D / M5-F / M6-E positional-arg accretion (5 → 6 → 8
# args) with a single struct pointer. Adding a new header (federated
# Origin, content-addressed Content-Hash, etc.) is a new `PH_*` offset
# + new setter; existing callers don't change.
#
# Field semantics — same as the pre-0.9.0 8-arg shape; only the call
# shape changes. Wire format is byte-identical.
#
#   PH_SUBJECT     = 0  → no Subject line written
#   PH_REPLY_TO    = 0  → no Reply-To line written (per ADR 0005)
#   PH_FROM_*      either null → anonymous post (no From line)
#                  both non-null → "From: <handle> <fp16>" line
enum PH {
    PH_SUBJECT     = 0;     # cstring ptr (or 0 for empty)
    PH_REPLY_TO    = 8;     # i64 parent ID (or 0 for non-reply)
    PH_FROM_HANDLE = 16;    # cstring ptr (or 0 for anonymous)
    PH_FROM_FP     = 24;    # cstring ptr (or 0 for anonymous, paired with FROM_HANDLE)
    PH_SIZE        = 32;
}

# Allocate a fresh zero-initialized PostHeaders block. All fields
# default to 0 (= empty Subject, no Reply-To, anonymous From).
fn post_headers_new(): i64 {
    var ph = cmd_alloc(PH_SIZE);
    memset(ph, 0, PH_SIZE);
    return ph;
}

# Set the Subject header (NUL-terminated; 0 = none).
fn post_headers_set_subject(ph, subject_cstr): i64 {
    store64(ph + PH_SUBJECT, subject_cstr);
    return 0;
}

# Set the Reply-To parent id (0 = not a reply).
fn post_headers_set_reply_to(ph, parent_id): i64 {
    store64(ph + PH_REPLY_TO, parent_id);
    return 0;
}

# Both nullable; the formatter only emits the From line when both are
# non-null + non-empty (preserves the M6-E anonymous-by-default shape).
fn post_headers_set_from(ph, handle_cstr, fp_cstr): i64 {
    store64(ph + PH_FROM_HANDLE, handle_cstr);
    store64(ph + PH_FROM_FP, fp_cstr);
    return 0;
}

# Compose a post file with Subject + Date + optional Reply-To +
# optional From headers + blank line + body. Writes into out_buf at
# offset 0; returns total bytes written, or -1 if it wouldn't fit
# in out_cap.
#
# 0.9.0 ABI freeze (ADR 0008): replaces the M6-E 8-arg shape with a
# single PostHeaders struct ptr. Wire output byte-identical.
fn post_format(ph, body, body_len, out_buf, out_cap): i64 {
    var subject     = load64(ph + PH_SUBJECT);
    var reply_to    = load64(ph + PH_REPLY_TO);
    var from_handle = load64(ph + PH_FROM_HANDLE);
    var from_fp     = load64(ph + PH_FROM_FP);

    var pos = 0;
    var slen = 0;
    if (subject != 0) { slen = strlen(subject); }
    if (slen > SUBJECT_MAX_BYTES) { slen = SUBJECT_MAX_BYTES; }

    # Worst-case header overhead: Subject 9+slen+2, Date 6+20+2,
    # Reply-To 10+24+2 (24 = max digits of int64), From 6+32+1+16+2,
    # blank 2. ~140 + slen.
    if (pos + 9 + slen + 140 + body_len > out_cap) { return 0 - 1; }

    # "Subject: <subject>\r\n"
    memcpy(out_buf + pos, "Subject: ", 9); pos = pos + 9;
    if (slen > 0) { memcpy(out_buf + pos, subject, slen); pos = pos + slen; }
    store8(out_buf + pos, 13); pos = pos + 1;
    store8(out_buf + pos, 10); pos = pos + 1;

    # "Date: <iso8601>\r\n"
    memcpy(out_buf + pos, "Date: ", 6); pos = pos + 6;
    pos = pos + iso8601_into(clock_epoch_secs(), out_buf + pos);
    store8(out_buf + pos, 13); pos = pos + 1;
    store8(out_buf + pos, 10); pos = pos + 1;

    # "Reply-To: <id>\r\n"  (M5-F / ADR 0005, only if reply_to > 0)
    if (reply_to > 0) {
        memcpy(out_buf + pos, "Reply-To: ", 10); pos = pos + 10;
        var idbuf[24];
        var idlen = fmt_int_buf(reply_to, &idbuf);
        memcpy(out_buf + pos, &idbuf, idlen); pos = pos + idlen;
        store8(out_buf + pos, 13); pos = pos + 1;
        store8(out_buf + pos, 10); pos = pos + 1;
    }

    # "From: <handle> <fp16>\r\n"  (M6-E / ADR 0006, only if both
    # from_handle and from_fp are non-null cstrings)
    if (from_handle != 0) { if (from_fp != 0) {
            var hlen = strlen(from_handle);
            var flen = strlen(from_fp);
            if (hlen > 0) { if (flen > 0) {
                    memcpy(out_buf + pos, "From: ", 6); pos = pos + 6;
                    memcpy(out_buf + pos, from_handle, hlen); pos = pos + hlen;
                    store8(out_buf + pos, 32); pos = pos + 1;            # ' '
                    memcpy(out_buf + pos, from_fp, flen); pos = pos + flen;
                    store8(out_buf + pos, 13); pos = pos + 1;
                    store8(out_buf + pos, 10); pos = pos + 1;
                } }
        } }

    # Blank line — header/body separator
    store8(out_buf + pos, 13); pos = pos + 1;
    store8(out_buf + pos, 10); pos = pos + 1;

    # Body
    if (body_len > 0) {
        memcpy(out_buf + pos, body, body_len);
        pos = pos + body_len;
    }
    return pos;
}

# Write a new post via the PostHeaders struct (0.9.0 ABI shape, ADR 0008).
# Same EXCL + flock semantics as the M5-G claim+write path; format
# happens outside the lock (pure per-call work), claim+write inside.
# Returns the assigned ID on success, negative on error.
#
# 1.9.0 — "posts are durable artifacts" (CLAUDE.md) was not backed: a post was
# `file_create_exclusive` + `file_write` straight into its final name, so a crash
# (or power loss) mid-write left a TRUNCATED post under its id — listed, readable,
# attributed. (1.8.1 S6 removed it on a write failure the code could see; a crash
# is a failure it cannot.) `store_publish` (arena.cyr) writes a temp, fsyncs it,
# and only then links it to `N.txt` — refusing an existing name, so the exclusive
# id claim of 1.6.4 (audit M4) is kept. A post is either absent or whole.
fn post_new(store, board, ph, body, body_len): i64 {
    if (body_len <= 0) { return 0 - 1; }
    if (body_len > POST_MAX_BYTES) { return 0 - 1; }

    var rc = board_ensure(store, board);
    if (rc != 0) { return 0 - 1; }

    var fcap = POST_MAX_BYTES + 1024;
    var fbuf = cmd_alloc(fcap);
    var flen = post_format(ph, body, body_len, fbuf, fcap);
    if (flen < 0) { return 0 - 1; }

    var lock_fd = store_lock_acquire(store, board);
    if (lock_fd < 0) { return 0 - 1; }

    var id = post_max_id(store, board) + 1;
    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    build_post_path(store, board, id, path_buf);
    var dir = cmd_alloc(PATH_MAX_BYTES);
    board_path(store, board, dir);
    var prc = store_publish(dir, path_buf, fbuf, flen, 1);   # crash-safe, exclusive (arena.cyr)
    store_lock_release(lock_fd);
    if (prc != 0) { return 0 - 1; }
    return id;
}

# Convenience for `list` display — extract Subject from a post file's
# in-memory buffer. Returns the byte length copied into out_buf, or
# 0 if the post has no Subject header (headerless post or missing
# field). Never returns negative; caller can always render the
# empty case.
fn post_subject(buf, len, out_buf, out_max): i64 {
    var n = header_get(buf, len, "Subject", out_buf, out_max);
    if (n < 0) { return 0; }
    return n;
}

# === M5-F threading helpers (ADR 0005) ===

# Extract the Reply-To parent ID from a post file buffer. Returns
# the parent ID (positive integer), or 0 if the post has no
# Reply-To header / has an unparseable value / is headerless.
fn post_reply_to(buf, len): i64 {
    var raw[24];
    var n = header_get(buf, len, "Reply-To", &raw, 24);
    if (n <= 0) { return 0; }
    # Parse integer from raw[0..n]. atoi expects NUL-termination;
    # store one past last digit, then atoi.
    if (n >= 24) { n = 23; }
    store8(&raw + n, 0);
    var id = atoi(&raw);
    if (id <= 0) { return 0; }
    return id;
}

# Find every reply (in `board`) whose Reply-To header equals
# `parent_id`. Writes child IDs (sorted ascending) into out_ids;
# returns count. O(n) in the board's post count per ADR 0005.
#
# 1.8.1 (audit S3) — reads only each post's first POST_HEAD_SCAN bytes. It read
# up to POST_MAX_BYTES + 1 KB of EVERY post to parse one header, on every
# anonymous `read`: ~20 ms per `read` on a 2,000 × 16 KB board, so one
# pipelined 4 KB packet of `read 1` stalled the whole poll process for ~10 s.
# An agora-written header block is under ~450 bytes; a post whose header
# terminator is not inside the scan simply has no Reply-To here (header_get
# finds no body offset), which is the right answer for a hand-made file.
fn replies_to(store, board, parent_id, out_ids, max_ids): i64 {
    var ids = cmd_alloc(DIRENT_ID_MAX * 8);
    var count = post_list(store, board, ids, DIRENT_ID_MAX);
    var fbuf = cmd_alloc(POST_HEAD_SCAN);
    var out_count = 0;
    var i = 0;
    while (i < count) {
        if (out_count >= max_ids) { i = count; continue; }
        var id = load64(ids + i * 8);
        var flen = post_read(store, board, id, fbuf, POST_HEAD_SCAN);
        if (flen > 0) {
            if (post_reply_to(fbuf, flen) == parent_id) {
                store64(out_ids + out_count * 8, id);
                out_count = out_count + 1;
            }
        }
        i = i + 1;
    }
    # post_list already returns sorted; replies preserve that order.
    return out_count;
}

# Apply RFC 5322 § 3.6.5 "Re:" subject prefix rules:
#   - if `parent_subject` starts with "Re: " (case-insensitive),
#     return parent_subject verbatim
#   - else return "Re: " + parent_subject
#
# Writes result into out_buf as NUL-terminated; returns length
# (excluding NUL).
fn subject_reply_prefix(parent_subject, parent_len, out_buf, out_max): i64 {
    var has_re = 0;
    if (parent_len >= 4) {
        var b0 = load8(parent_subject) & 0xFF;
        var b1 = load8(parent_subject + 1) & 0xFF;
        var b2 = load8(parent_subject + 2) & 0xFF;
        var b3 = load8(parent_subject + 3) & 0xFF;
        # "Re: " — either R (0x52) or r (0x72) for first byte;
        # E (0x45) or e (0x65) for second; ':' (0x3A); ' ' (0x20).
        var is_r = 0;
        if (b0 == 82) { is_r = 1; }
        if (b0 == 114) { is_r = 1; }
        var is_e = 0;
        if (b1 == 69) { is_e = 1; }
        if (b1 == 101) { is_e = 1; }
        if (is_r != 0) {
            if (is_e != 0) {
                if (b2 == 58) {
                    if (b3 == 32) {
                        has_re = 1;
                    }
                }
            }
        }
    }
    var pos = 0;
    if (has_re == 0) {
        if (pos + 4 + parent_len + 1 > out_max) {
            # Truncate: ensure we always NUL-terminate
            parent_len = out_max - 5;
            if (parent_len < 0) { parent_len = 0; }
        }
        memcpy(out_buf + pos, "Re: ", 4); pos = pos + 4;
    } else {
        if (pos + parent_len + 1 > out_max) {
            parent_len = out_max - 1;
            if (parent_len < 0) { parent_len = 0; }
        }
    }
    if (parent_len > 0) {
        memcpy(out_buf + pos, parent_subject, parent_len);
        pos = pos + parent_len;
    }
    store8(out_buf + pos, 0);
    return pos;
}

# Heapsort an i64 array ascending, in place. 1.8.1 — was an O(n²) insertion
# sort, run on every `list` and every reply scan; now that post_list sorts the
# WHOLE board before keeping the newest DIRENT_ID_MAX (audit S10), the board
# size is unbounded and the sort has to be O(n log n). No allocation.
fn sort_sift_down(arr, start, end): i64 {
    var root = start;
    var going = 1;
    while (going == 1) {
        var child = root * 2 + 1;
        if (child >= end) { going = 0; continue; }
        var big = root;
        if (load64(arr + big * 8) < load64(arr + child * 8)) { big = child; }
        if (child + 1 < end) {
            if (load64(arr + big * 8) < load64(arr + (child + 1) * 8)) { big = child + 1; }
        }
        if (big == root) { going = 0; continue; }
        var t = load64(arr + root * 8);
        store64(arr + root * 8, load64(arr + big * 8));
        store64(arr + big * 8, t);
        root = big;
    }
    return 0;
}

# Sort arr[0..count) ascending in place (heapsort; see sort_sift_down above).
fn sort_i64_asc(arr, count): i64 {
    if (count < 2) { return 0; }
    var start = (count - 2) / 2;
    while (start >= 0) {
        sort_sift_down(arr, start, count);
        start = start - 1;
    }
    var end = count - 1;
    while (end > 0) {
        var t = load64(arr);
        store64(arr, load64(arr + end * 8));
        store64(arr + end * 8, t);
        sort_sift_down(arr, 0, end);
        end = end - 1;
    }
    return 0;
}

# List all post IDs in the store. Writes IDs as i64s into out_ids,
# up to max_ids entries. Returns the count of IDs written.
# IDs are returned in **ascending order** (M5-C); the underlying
# dir_list returns directory-iteration order which we then sort.
fn post_list(store, board, out_ids, max_ids): i64 {
    var path_buf = cmd_alloc(PATH_MAX_BYTES);
    board_path(store, board, path_buf);
    var n = store_dir_scan(path_buf);
    # 1.8.1 (audit S10) — sort the WHOLE board, then keep the newest max_ids.
    # This used to stop collecting at max_ids and return BEFORE sorting, so a
    # board past 4,096 posts listed an arbitrary readdir-order subset, unsorted,
    # with posts silently missing — and replies_to, which relies on the order,
    # missed replies outside the subset.
    var c = 0;
    var i = 0;
    while (i < n) {
        var id = parse_post_id(store_dir_name(i));
        if (id > 0) {
            store64(g_dir_ids + c * 8, id);
            c = c + 1;
        }
        i = i + 1;
    }
    sort_i64_asc(g_dir_ids, c);
    var first = 0;
    if (c > max_ids) { first = c - max_ids; }
    var k = 0;
    while (first + k < c) {
        store64(out_ids + k * 8, load64(g_dir_ids + (first + k) * 8));
        k = k + 1;
    }
    return k;
}

# List all named boards in the store. Writes NUL-terminated name pointers into
# out_names (8 bytes each); returns the count. The names are copies in the
# per-command arena, so they survive further listings in the same command.
#
# "main" is implicit — never returned by this function. Callers render "main"
# themselves alongside the named-board list. Per ADR 0004, named boards are
# subdirectories of `<store>`.
#
# 1.8.1 (audit S7) — only directories whose name passes `board_name_valid`. A
# name read off the disk used to be memcpy'd into a PATH_MAX_BYTES path with no
# bound (a 250-byte name under a 417-byte `--store` wrote 157 bytes past it),
# and a board with an invalid name could never be `enter`ed anyway. This also
# skips post files, the lockfile and every dot-directory without special cases.
fn boards_list(store, out_names, max_boards): i64 {
    var n = store_dir_scan(store);
    var full = cmd_alloc(PATH_MAX_BYTES);
    var slen = strlen(store);
    var count = 0;
    var i = 0;
    while (i < n) {
        if (count >= max_boards) { i = n; continue; }
        var name_cstr = store_dir_name(i);
        if (board_name_valid(name_cstr) == 1) {
            var nlen = strlen(name_cstr);
            memcpy(full, store, slen);
            store8(full + slen, 47);     # '/'
            memcpy(full + slen + 1, name_cstr, nlen);
            store8(full + slen + 1 + nlen, 0);
            if (is_dir(path_str(full)) == 1) {
                var copy = cmd_alloc(nlen + 1);
                memcpy(copy, name_cstr, nlen + 1);
                store64(out_names + count * 8, copy);
                count = count + 1;
            }
        }
        i = i + 1;
    }
    return count;
}

# === Per-board policy primitives (M6-F, ADR 0006) ===

# Build `<board-path>/.policy` or `<board-path>/.admins` into out_buf.
# Returns length excluding NUL.
fn board_policy_path(store, board, out_buf): i64 {
    var pos = board_path(store, board, out_buf);
    store8(out_buf + pos, 47); pos = pos + 1;          # '/'
    memcpy(out_buf + pos, ".policy", 7); pos = pos + 7;
    store8(out_buf + pos, 0);
    return pos;
}

# `<board path>/.admins` into out_buf; returns its length.
fn board_admins_path(store, board, out_buf): i64 {
    var pos = board_path(store, board, out_buf);
    store8(out_buf + pos, 47); pos = pos + 1;          # '/'
    memcpy(out_buf + pos, ".admins", 7); pos = pos + 7;
    store8(out_buf + pos, 0);
    return pos;
}

# 1.8.1 — does a negative `file_read_all` return mean "the file is not there"?
# Linux and macOS return -errno, so only -ENOENT (-2) counts. agnos returns -1
# for EVERY error, so there "missing" and "unreadable" cannot be told apart and
# -1 has to count as missing — the common case (a board with no `.policy`) must
# keep working. Every other negative is a file that exists and could not be
# read, which a caller deciding an ACCESS question must not mistake for absent.
fn store_read_missing(n): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    if (n == (0 - 1)) { return 1; }
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    if (n == (0 - 2)) { return 1; }
    #endif
    return 0;
}

enum PolicyFile {
    POLICY_FILE_CAP = 256;     # bytes of `.policy` parsed (a token + a comment)
}

# 1 if `c` is whitespace inside a `.policy` line (SP, TAB, CR). Pure.
fn policy_ws(c): i64 {
    if (c == 32) { return 1; }
    if (c == 9)  { return 1; }
    if (c == 13) { return 1; }
    return 0;
}

# Locate a `.policy` file's deciding token: the first line that still holds
# one after a `#` comment is cut and whitespace trimmed. Writes the token's
# [start, end) to out+0 / out+8 and, at out+16, 1 if that line runs to the end
# of the buffer (a truncated read may have cut it). Returns 1 if found, 0 if no
# line holds a token. Pure.
fn policy_token(buf, n, out): i64 {
    var found = 0;
    var i = 0;
    while (i < n) {
        var le = i;
        var scan = 1;
        while (scan == 1) {
            if (le >= n) { scan = 0; continue; }
            if ((load8(buf + le) & 0xFF) == 10) { scan = 0; continue; }
            le = le + 1;
        }
        var te = i;
        var cscan = 1;
        while (cscan == 1) {
            if (te >= le) { cscan = 0; continue; }
            if ((load8(buf + te) & 0xFF) == 35) { cscan = 0; continue; }   # '#'
            te = te + 1;
        }
        var ts = i;
        var tl = 1;
        while (tl == 1) {
            if (ts >= te) { tl = 0; continue; }
            if (policy_ws(load8(buf + ts) & 0xFF) == 0) { tl = 0; continue; }
            ts = ts + 1;
        }
        var tr = 1;
        while (tr == 1) {
            if (te <= ts) { tr = 0; continue; }
            if (policy_ws(load8(buf + te - 1) & 0xFF) == 0) { tr = 0; continue; }
            te = te - 1;
        }
        if (found == 0) {
            if (te > ts) {
                found = 1;
                store64(out, ts);
                store64(out + 8, te);
                store64(out + 16, 0);
                if (le >= n) { store64(out + 16, 1); }
            }
        }
        i = le + 1;
    }
    return found;
}

# Parse a `.policy` file's bytes (1.8.1, audit S1). The deciding token
# (policy_token) must be exactly `open`, `known` or `admin`. A file that is
# empty or all whitespace is ADR 0006's default, POLICY_OPEN. ANYTHING ELSE is
# POLICY_INVALID — an unknown or mis-cased token, a comment-only file, a BOM, or
# a deciding line that a truncated read (`truncated` = the file was longer than
# the buffer) may have cut. Before 1.8.1 every one of those silently meant
# open, so `admin # ops only` or `Admin` let any registered user post. Pure.
fn board_policy_parse(buf, n, truncated): i64 {
    var tok[24];
    if (policy_token(buf, n, &tok) == 0) {
        var k = 0;
        while (k < n) {
            var c = load8(buf + k) & 0xFF;
            if (c != 10) { if (policy_ws(c) == 0) { return POLICY_INVALID; } }
            k = k + 1;
        }
        return POLICY_OPEN;
    }
    if (load64((&tok) + 16) == 1) { if (truncated == 1) { return POLICY_INVALID; } }
    var ts = load64(&tok);
    var tlen = load64((&tok) + 8) - ts;
    if (tlen == 4) { if (memeq(buf + ts, "open", 4)  == 1) { return POLICY_OPEN;  } }
    if (tlen == 5) { if (memeq(buf + ts, "known", 5) == 1) { return POLICY_KNOWN; } }
    if (tlen == 5) { if (memeq(buf + ts, "admin", 5) == 1) { return POLICY_ADMIN; } }
    return POLICY_INVALID;
}

# Read `<store>/<board>/.policy` and return its POLICY_* mode. A MISSING file
# is POLICY_OPEN (ADR 0006). A file that exists but cannot be read (EACCES — a
# root-owned 0600 file — EISDIR, EIO) or does not parse fails CLOSED to
# POLICY_ADMIN, so only `.admins` can post, and warns on stderr so the operator
# learns why posting stopped. (1.8.1, audit S1 — both used to mean open.)
fn board_policy_get(store, board): i64 {
    var path = cmd_alloc(PATH_MAX_BYTES);
    board_policy_path(store, board, path);
    var buf = cmd_alloc(POLICY_FILE_CAP + 1);
    var n = store_read_all(path, buf, POLICY_FILE_CAP + 1);
    var pol = POLICY_INVALID;
    if (n < 0) {
        if (store_read_missing(n) == 1) { return POLICY_OPEN; }
    } else {
        var trunc = 0;
        if (n > POLICY_FILE_CAP) { trunc = 1; }
        pol = board_policy_parse(buf, n, trunc);
    }
    if (pol == POLICY_INVALID) {
        eprint("agora: unreadable or unrecognised .policy, board is admin-only: ", 64);
        eprint(path, strlen(path));
        eprint("\n", 1);
        return POLICY_ADMIN;
    }
    return pol;
}

# Does `handle` appear as an entry in an `.admins` buffer? One handle per line;
# blank and `#`-comment lines ignored; leading and trailing whitespace (and a
# CR) trimmed per line. Returns 1 if present, else 0. Pure.
fn board_admins_scan(buf, n, handle): i64 {
    var hlen = strlen(handle);
    if (hlen == 0) { return 0; }

    # Scan line by line. Track line start; on '\n' (or EOF), compare.
    var i = 0;
    var line_start = 0;
    var found = 0;
    var scanning = 1;
    while (scanning == 1) {
        var at_eol = 0;
        if (i >= n) { at_eol = 1; }
        else {
            if ((load8(buf + i) & 0xFF) == 10) { at_eol = 1; }
        }
        if (at_eol != 0) {
            var line_end = i;
            # Trim trailing CR + whitespace
            var trim = 1;
            while (trim == 1) {
                if (line_end <= line_start) { trim = 0; continue; }
                var c = load8(buf + line_end - 1) & 0xFF;
                if (c == 13) { line_end = line_end - 1; continue; }
                if (c == 32) { line_end = line_end - 1; continue; }
                if (c == 9)  { line_end = line_end - 1; continue; }
                trim = 0;
            }
            # Trim leading whitespace
            var ls = line_start;
            var trim_l = 1;
            while (trim_l == 1) {
                if (ls >= line_end) { trim_l = 0; continue; }
                var c2 = load8(buf + ls) & 0xFF;
                if (c2 == 32) { ls = ls + 1; continue; }
                if (c2 == 9)  { ls = ls + 1; continue; }
                trim_l = 0;
            }
            var line_len = line_end - ls;
            # Skip blank lines + comment lines
            var skip = 0;
            if (line_len == 0) { skip = 1; }
            if (skip == 0) {
                if ((load8(buf + ls) & 0xFF) == 35) { skip = 1; }   # '#'
            }
            if (skip == 0) {
                if (line_len == hlen) {
                    if (memeq(buf + ls, handle, hlen) == 1) {
                        found = 1;
                    }
                }
            }
            line_start = i + 1;
            if (found == 1) { scanning = 0; continue; }
        }
        if (i >= n) { scanning = 0; continue; }
        i = i + 1;
    }
    return found;
}

# Bytes of buf[0..n) that are WHOLE lines: the offset just past its last LF, or 0
# if it has none. Pure.
fn board_admins_lines(buf, n): i64 {
    var i = n;
    var keep = 0;
    while (i > 0) {
        if ((load8(buf + i - 1) & 0xFF) == 10) { keep = i; i = 0; continue; }
        i = i - 1;
    }
    return keep;
}

# Check if `handle` appears in `<store>/<board>/.admins`. Returns 1 if present,
# 0 otherwise (including a missing or unreadable file — fails closed).
#
# 1.9.0 — the whole file is read, in BOARD_ADMINS_CHUNK windows. It stopped at 4
# KB (~120 handles) with no continuation, and after 1.8.1 (audit S2 / M4) the
# handles past the cut were ignored with a warning — failing closed, but still a
# board whose later admins could not post. Each window scans only its WHOLE
# lines and carries the unfinished one into the next, so a line straddling a
# window is never matched by its cut-off prefix (the S2 bug: `qixbert` cut to
# `qix`). A line longer than a window cannot be a handle and is skipped to its
# LF. Past BOARD_ADMINS_FILE_CAP the rest is ignored, with a warning — the bound
# on what one `post` can be made to read.
fn board_admin_check(store, board, handle): i64 {
    var path = cmd_alloc(PATH_MAX_BYTES);
    board_admins_path(store, board, path);
    var fd = store_open(path, O_RDONLY);
    if (fd < 0) { return 0; }
    var buf = cmd_alloc(BOARD_ADMINS_CHUNK);
    var have = 0;        # an unfinished line carried over, at buf[0..have)
    var skipping = 0;    # inside a line longer than a window: drop to its LF
    var total = 0;
    var found = 0;
    var reading = 1;
    while (reading == 1) {
        var want = BOARD_ADMINS_CHUNK - have;
        if (want > BOARD_ADMINS_FILE_CAP - total) { want = BOARD_ADMINS_FILE_CAP - total; }
        var n = 0;
        if (want > 0) { n = file_read(fd, buf + have, want); }
        else {
            # At the cap: a byte past it means handles are being ignored.
            var probe[8];
            n = file_read(fd, &probe, 1);
            if (n > 0) {
                eprint("agora: .admins over 1 MiB, later handles ignored: ", 50);
                eprint(path, strlen(path));
                eprint("\n", 1);
                reading = 0;
                continue;
            }
        }
        if (n < 0) { reading = 0; continue; }
        if (n == 0) {
            # End of file ends the carried line.
            if (skipping == 0) { if (have > 0) { found = board_admins_scan(buf, have, handle); } }
            reading = 0;
            continue;
        }
        total = total + n;
        var end = have + n;
        var start = 0;
        if (skipping == 1) {
            var k = have;
            start = 0 - 1;
            while (k < end) {
                if ((load8(buf + k) & 0xFF) == 10) { start = k + 1; k = end; continue; }
                k = k + 1;
            }
            if (start < 0) { start = end; } else { skipping = 0; }
        }
        var w = board_admins_lines(buf + start, end - start);
        if (w > 0) { found = board_admins_scan(buf + start, w, handle); }
        var rest = end - start - w;
        if (rest == BOARD_ADMINS_CHUNK) {
            skipping = 1;
            rest = 0;
        }
        var c = 0;
        while (c < rest) {
            store8(buf + c, load8(buf + start + w + c));
            c = c + 1;
        }
        have = rest;
        if (found == 1) { reading = 0; }
    }
    file_close(fd);
    return found;
}

# Single decision point — given a session identity (fp + handle —
# either may be 0 / empty for anonymous) decide if a post would be
# accepted in (store, board). Returns 1 = allowed, 0 = denied.
# Caller is responsible for surfacing the right user-visible reason.
fn board_can_post(store, board, session_fp, session_handle): i64 {
    # Anonymous always denied at M6 (operator override via per-board
    # policy `anon-allowed` is a future ADR per ADR 0006 § Negative).
    if (session_fp == 0)              { return 0; }
    if ((load8(session_fp) & 0xFF) == 0) { return 0; }

    var pol = board_policy_get(store, board);
    if (pol == POLICY_OPEN)  { return 1; }
    if (pol == POLICY_KNOWN) {
        # At M6, every authenticated session is locally-registered
        # (login resolves through `.users/`). Verify the fp still
        # has a `public_key.bin` on disk — guards against a stale
        # session whose user was unregistered out-of-band.
        var pk_buf[32];
        if (account_lookup_pubkey(store, session_fp, &pk_buf) != 0) { return 0; }
        return 1;
    }
    if (pol == POLICY_ADMIN) {
        if (session_handle == 0)               { return 0; }
        if ((load8(session_handle) & 0xFF) == 0) { return 0; }
        return board_admin_check(store, board, session_handle);
    }
    return 0;
}
