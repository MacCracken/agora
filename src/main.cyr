# agora — main entry point.
#
# argv dispatch + boot banner + per-verb command handlers. The serve
# verb drives the M1 telnet listener via lib/net.cyr (Linux today;
# macOS / Windows / AGNOS follow as the stdlib gains backends — see
# docs/adr/0001-cross-platform-listener-decoupled-from-agnos.md).
#
# Roadmap shape (docs/development/roadmap.md):
#   M0 (0.1.0) ✅  argv dispatch + banner + stub verbs
#   M1 ← active   telnet listener (RFC 854) + LINEMODE (RFC 1184)
#   M2            ANSI BBS aesthetic (darshana + bannermanor)
#   M3            inline-image post bodies (kii)
#   M4            stored-file deltas (sankoch compression)
#   M5            post persistence
#   M6            user accounts + auth (sigil-backed)
#   1.0.0         all six milestones green, multi-user telnet BBS

include "lib/darshana.cyr"
include "src/arena.cyr"
include "src/telnet.cyr"
include "src/board.cyr"
include "src/account.cyr"
include "src/door.cyr"
include "src/wager.cyr"
include "src/decode_words.cyr"
include "src/decode.cyr"
include "src/smuggler.cyr"
include "src/port_authority.cyr"
include "src/handler.cyr"
include "src/chat.cyr"
include "src/eliza.cyr"
include "src/parry.cyr"
include "src/quest.cyr"
include "src/jabberwacky.cyr"
include "src/olympiad.cyr"
include "src/ashes.cyr"
include "src/descent.cyr"

# Default port. 23 is the IANA-assigned telnet port but requires
# root on Linux for bind. Override via `agora serve <port>`.
enum AgoraDefaults {
    DEFAULT_PORT      = 2323;
    LISTEN_BACKLOG    = 16;
    RECV_BUF_BYTES    = 4096;
    # Slowloris timeout — caps how long a quiet client can pin an
    # accept-loop worker. 60s of no traffic ends the connection.
    # Tuned for human-paced BBS use; trim for higher fanout.
    RECV_TIMEOUT_SECS = 60;
    # Send-side counterpart [T2]: a slowloris-READ peer (connects but
    # never drains its receive window) fills our kernel send buffer and
    # would park a worker inside a blocking write() — the recv timeout
    # never fires because the worker is in write(), not read(). Bound it.
    SEND_TIMEOUT_SECS = 60;
    # Operator-supplied MOTD ceiling (--motd <path>). 4 KB covers
    # any reasonable BBS welcome banner. File contents are sent
    # verbatim; operators are responsible for using CRLF line
    # endings (telnet NVT) and embedding any ANSI escapes they want.
    MOTD_FILE_CAP     = 4096;
    # Per-connection line buffer cap for the M5-B command parser.
    # 4 KB absorbs any plausible command + a long post-body line.
    LINE_BUF_CAP      = 4096;
}

# M5-B/D session modes. Drives the per-byte dispatch in handle_client:
#   MODE_COMMAND          — interpret each completed line as a command
#   MODE_POSTING_SUBJECT  — M5-D: capture the Subject line, then move to body
#   MODE_POSTING          — accumulate lines into the post body; commit
#                           when we see a line that is exactly "."
enum SessMode {
    MODE_COMMAND          = 0;
    MODE_POSTING_SUBJECT  = 1;
    MODE_POSTING          = 2;
    MODE_LOGIN_AWAIT_SIG  = 3;   # M6-C: parked challenge, waiting for `auth:`
    MODE_DOOR             = 4;   # 1.1.0: in a door game; lines route to the game
    MODE_CHAT             = 5;   # 1.3.0: in a chat channel; lines say to the room (ADR 0011)
}

# 1.3.0 chat runtime (ADR 0011). These are main.cyr socket concerns —
# the pure transcript params (caps, scrollback) live in chat.cyr's
# ChatCap. While in MODE_CHAT the socket recv timeout drops to
# CHAT_POLL_SECS so an idle recv (EWOULDBLOCK) becomes a live-tail tick
# instead of a disconnect; accumulated true-silence is bounded by
# CHAT_IDLE_SECS so an idle chatter can't pin a forked worker forever.
enum ChatRuntime {
    CHAT_POLL_SECS  = 2;        # recv timeout in chat = live-tail tick cadence
    CHAT_IDLE_SECS  = 900;      # 15 min of pure silence ends a chat session
    EWOULDBLOCK_ERR = 11;       # sys_read return on SO_RCVTIMEO fire (EAGAIN)
}

# Operator-supplied MOTD, loaded once in cmd_serve before the
# listener opens. Null (0) means "use the default render_motd"; a
# non-null pointer with g_motd_len > 0 means "send these bytes
# verbatim to every connection". Globals (vs. threading through
# handle_client) since they're set-once-at-startup state and the
# accept loop currently single-tracks anyway.
var g_motd_buf = 0;
var g_motd_len = 0;

# Post-storage root used by the telnet-side command interpreter
# (M5-B). Set once in cmd_serve from --store <path>, defaults to
# the same `./agora-data/` used by the CLI verbs. Per-connection
# handle_client reads this without threading through args.
var g_store_buf = "./agora-data";

# M5-F: per-session reply state. `reply <id>` writes these and
# handle_client reads them when finalizing the post. NB: at v0.5.0
# the accept loop single-tracks, so these are effectively
# per-session even though they're global slots. A future
# concurrent-accept refactor pulls them into per-session locals.
var g_reply_to          = 0;           # 0 = regular post, >0 = parent id
var g_reply_subject     = 0;           # alloc'd lazily on first use
var g_reply_subject_len = 0;

# M6-C: per-session identity binding. NUL terminator at offset 0
# (empty cstring) = anonymous; populated by a successful `login`
# challenge/response round. Single-tracking accept loop note from
# g_reply_to applies here too — these are per-session in effect,
# pulled to per-conn locals when concurrent-accept lands.
var g_session_fp     = 0;             # alloc'd in handle_client (ACCOUNT_FP_BUF_BYTES)
var g_session_handle = 0;             # alloc'd in handle_client (ACCOUNT_HANDLE_BUF)

# M6-C: parked login challenge. g_login_fp holds the fingerprint
# resolved from the typed handle; g_login_nonce holds the hex-encoded
# 32-byte nonce we sent on the wire. Both empty (NUL at offset 0)
# = no login in flight. Cleared on every auth attempt (pass or fail)
# + on session close.
var g_login_fp    = 0;                # alloc'd in handle_client (ACCOUNT_FP_BUF_BYTES)
var g_login_nonce = 0;                # alloc'd in handle_client (ACCOUNT_NONCE_BUF_BYTES)

# 1.1.0 door subsystem (ADR 0009). Active game id (DoorGame enum),
# heap pointer to the running game state, and the play mode (DoorMode).
# Per-session in effect via fork-per-accept, like g_session_* above;
# initialized in handle_client. GAME_NONE = no game active.
var g_door_game  = 0;
var g_door_state = 0;
var g_door_mode  = 0;

# 1.2.0 Universe (ADR 0010 bites 2-4). Per-session shared-world snapshot
# buffer, alloc'd lazily on entry to `play <game> universe` (sized to the
# largest game world). The flock'd lock→read→feed→write transaction
# around each input line reads into this buffer and writes it back, so
# concurrent players serialize on the world lock with no lost updates.
var g_uni_world = 0;

# 1.3.0 chat (ADR 0011). Per-session chat state, per-session-in-effect
# via fork-per-accept like g_session_* / g_door_*; initialized in
# handle_client. g_chat_channel is the joined channel name buffer (empty
# = not in chat); g_chat_seen is the highest transcript seq this session
# has shown (the live-tail watermark — keyed on absolute seq, not a byte
# offset, so the ring's front-trim never desyncs it); g_chat_idle
# accumulates seconds of pure silence to bound an idle chatter.
var g_chat_channel = 0;             # alloc'd in handle_client (CHAT_CHANNEL_MAX + 1)
var g_chat_seen    = 0;
var g_chat_idle    = 0;

# 1.3.0/1.3.1 (ADR 0011): the private chatbot side-channel inside chat.
# g_chat_bot selects the active bot on the couch: 0 = none (talking to
# the room), 1 = Eliza, 2 = Parry, 3 = Jabberwacky (1.3.3). While
# non-zero, non-command lines go to that bot and the reply is sent ONLY
# to this user (never chat_say'd to the room); room tailing is paused.
# The per-bot states are alloc'd lazily on first /eliza / /parry /
# /jabberwacky and keep their response buffer at the same struct offset
# (EZ_RESP/EZ_RESPLEN == PY_RESP/PY_RESPLEN == JW_RESP/JW_RESPLEN) so the
# couch reads any of them uniformly.
var g_chat_bot     = 0;
var g_eliza_state  = 0;
var g_parry_state  = 0;
var g_jabber_state = 0;

enum DoorRuntime {
    DOOR_FRAME_CAP = 8192;        # per-frame render buffer (logical cap; emit_* bound to this)
    DOOR_FRAME_GUARD = 1024;      # [D3] slack past the cap so a raw-store8 tail can't overrun the alloc
    DOOR_SAVE_CAP  = 32768;       # save/load buffer (Handler registry is the largest)
    DOOR_WORLD_CAP = 8192;        # 1.2.0 Universe shared-world snapshot buffer (largest world fits)
}

# 0.7.0 audit M6 — explicit 30 s deadline on a parked login challenge.
# Set to `clock_now_ms()` when `login` parks the nonce; checked at
# MODE_LOGIN_AWAIT_SIG dispatch. Independent of `RECV_TIMEOUT_SECS`
# (which only fires on socket-idle — a client sending heartbeat bytes
# could pin a parked slot indefinitely otherwise). ADR 0006 § Specifics.
var g_login_started_ms = 0;
enum AgoraLogin {
    LOGIN_DEADLINE_MS = 30000;        # 30 s, per ADR 0006
}

fn print_banner(): i64 {
    println("agora — BBS for AGNOS");
    println("v1.6.4 — civic-marketplace BBS for AGNOS; chat + Eliza/PARRY + QUEST + Jabberwacky + casino + Olympiad + Ashes of Empire + Descent link + Decode");
    return 0;
}

fn print_help(): i64 {
    print_banner();
    println("");
    println("USAGE: agora <command> [args]");
    println("");
    println("COMMANDS:");
    println("  serve [port] [--motd <path>] [--store <path>]");
    println("                 start telnet listener (default port 2323;");
    println("                 --motd reads a file as the connection MOTD");
    println("                 instead of the default bannermanor render;");
    println("                 --store sets the post-storage root for the");
    println("                 in-session post/list/read commands —");
    println("                 default ./agora-data/, same as the CLI verbs)");
    println("  post [--store <path>] [--board <name>] [--subject <text>] [--reply-to <id>]");
    println("                 read stdin → new post → print assigned ID");
    println("                 (default store ./agora-data/, board 'main';");
    println("                 named boards live at <store>/<name>/. Subject");
    println("                 is written as an RFC-822 header per ADR 0003;");
    println("                 --reply-to writes a Reply-To header per ADR 0005.)");
    println("  list [--store <path>] [--board <name>]");
    println("                 list post IDs in the chosen board");
    println("  read <id> [--store <path>] [--board <name>]");
    println("                 print a post body to stdout by ID");
    println("  keygen [--key <path>]");
    println("                 generate a fresh Ed25519 keyfile (32-byte seed,");
    println("                 mode 0600; default ~/.agora/key; refuses overwrite)");
    println("  register --handle <h> [--key <path>] [--store <path>]");
    println("                 register the keyfile's pubkey under <h> in the store");
    println("  whoami [--key <path>] [--store <path>]");
    println("                 print '<handle?> <fp16>' for the keyfile's identity");
    println("                 (handle from a --store lookup; fp from the keyfile alone)");
    println("  version        print version string");
    println("  help           show this message");
    println("");
    println("EXIT CODES:");
    println("  0  success");
    println("  1  command-specific failure");
    println("  2  bad usage (unknown command / arg)");
    return 0;
}

# Send a literal byte buffer to a connected client. Returns 0 on
# success, 1 on partial-write or socket error (caller closes conn).
fn send_buf(cfd, buf, len): i64 {
    # Poll multiplex (1.6.0): never block the shared loop on one client's socket —
    # queue the bytes on the active session's tx buffer; the poll loop drains it
    # non-blocking (session_drain). Fork/serial: blocking write as before.
    if (g_serve_mode == SERVE_POLL) {
        return sess_tx_enqueue(g_active_sess, buf, len);
    }
    var off = 0;
    while (off < len) {
        var n = sys_write(cfd, buf + off, len - off);
        # A short / failed write (peer reset, transient error) returns 1
        # so the caller closes the connection. `return` (not `break`)
        # exits cleanly — the prior flag+continue idiom spun forever here:
        # with off < len still true, `done` only suppressed work, never
        # terminated the loop (a remotely-triggerable CPU-peg DoS). [T1]
        if (n <= 0) { return 1; }
        off = off + n;
    }
    return 0;
}

# Copy a cstring (NUL-terminated) into `buf` at `pos`. Returns new
# pos. Used by render_motd to splice literal MOTD-text segments
# between SGR escape runs.
fn motd_emit_cstr(buf, pos, s): i64 {
    var n = strlen(s);
    memcpy(buf + pos, s, n);
    return pos + n;
}

# === M5-B session helpers ===
#
# The session state for one telnet client is kept in `handle_client`'s
# locals (a heap-allocated struct buys nothing while the accept loop
# single-tracks). These free-standing helpers take the explicit args
# they need and operate on the per-connection buffers.

# 1.6.4 (audit M2) — send STORED / USER-DERIVED text with IAC doubled.
#
# RFC 854: 0xFF is IAC on the wire, and a data byte of that value MUST be sent
# as `IAC IAC` or the receiver reads it as the start of a command. agora never
# did this on any egress path, so a 0xFF sitting in a post body, a subject, a
# handle or a chat line reached every reader's client as a live telnet command —
# a stored, replayable wedge with no removal path. CLAUDE.md is unambiguous
# about which side of that is correct: "the wire is the contract ... any
# deviation is a bug, not a feature".
#
# This is deliberately NOT folded into `send_buf`. That is the funnel for every
# byte agora sends, including the telnet layer's OWN command sequences (the
# announce salvo, option replies drained from telnet_tx_buf) — doubling those
# would corrupt the protocol. The split is by intent: protocol bytes go out via
# send_buf, content bytes via send_text.
#
# Escaping is done in bounded chunks into a small stack buffer rather than by
# allocating a 2x copy: a post body is up to 64 KB and this runs per read.
# `cap` is deliberately even so a doubled byte can never straddle a flush.
fn send_text(cfd, buf, len): i64 {
    var out[512];
    var op = 0;
    var i = 0;
    var rc = 0;
    var done = 0;
    while (done == 0) {
        if (i >= len) { done = 1; continue; }
        var b = load8(buf + i) & 0xFF;
        store8(&out + op, b); op = op + 1;
        if (b == 0xFF) { store8(&out + op, 0xFF); op = op + 1; }   # IAC IAC
        if (op >= 510) {
            if (send_buf(cfd, &out, op) != 0) { rc = 1; done = 1; }
            op = 0;
        }
        i = i + 1;
    }
    if (rc == 0) {
        if (op > 0) { rc = send_buf(cfd, &out, op); }
    }
    return rc;
}

# Send a NUL-terminated cstring over the socket. Convenience wrapper
# for the in-session prompts / replies.
fn send_str(cfd, s): i64 {
    return send_buf(cfd, s, strlen(s));
}

# Echo a single byte back to the client. We announced WILL ECHO at
# connect (M2-B Q-method announce salvo), so the client trusts us
# to drive the display.
fn echo_byte(cfd, b): i64 {
    var one[1];
    store8(&one, b & 0xFF);
    return send_buf(cfd, &one, 1);
}

# Send the in-session prompt. M5-E: when current_board is "main"
# the prompt is the bare `> ` (preserves 0.4.0 visual); when in a
# named board the prompt is `[name] > ` so the user always knows
# which board their next command targets.
fn send_prompt(cfd, current_board): i64 {
    if (streq(current_board, "main") != 0) {
        return send_str(cfd, "> ");
    }
    send_str(cfd, "[");
    send_str(cfd, current_board);
    return send_str(cfd, "] > ");
}

# `input_byte_ok` lives in board.cyr (storage-policy layer). It's
# what the post storage system accepts; main.cyr's wire layer just
# enforces it at ingress. See board.cyr for the rationale.

# Return 1 if buffer [line, line_len) starts with the cstring `prefix`,
# 0 otherwise. Used by the command parser to dispatch on the first
# token of a typed command line.
fn line_has_prefix(line, line_len, prefix): i64 {
    var plen = strlen(prefix);
    if (line_len < plen) { return 0; }
    return memeq(line, prefix, plen);
}

# Parse a positive integer from `line[off..line_len)`. Skips leading
# spaces. Stops at the first non-digit byte. Returns the parsed
# integer, or -1 if no digits found / value is zero.
fn line_parse_int(line, off, line_len): i64 {
    # Skip leading spaces — track explicitly without the trap of
    # using one loop variable for "did we stop because of EOL or
    # because we found a non-space?"
    var i = off;
    var skipping = 1;
    while (skipping == 1) {
        if (i >= line_len)                       { skipping = 0; }
        else { if ((load8(line + i) & 0xFF) != 32) { skipping = 0; }
               else                                { i = i + 1; } }
    }
    # Read digits
    var n = 0;
    var got_any = 0;
    var reading = 1;
    while (reading == 1) {
        if (i >= line_len) { reading = 0; }
        else {
            var c = load8(line + i) & 0xFF;
            if (c < 48) { reading = 0; }
            else { if (c > 57) { reading = 0; }
                   else        { n = n * 10 + (c - 48); got_any = 1; i = i + 1; } }
        }
    }
    if (got_any == 0) { return 0 - 1; }
    if (n <= 0)       { return 0 - 1; }
    return n;
}

# Execute a typed command line. Returns the new session mode
# (MODE_COMMAND or MODE_POSTING_SUBJECT) and writes side-effect bytes
# to cfd. Quit-style commands set *quit_out = 1 and return MODE_COMMAND.
# M5-E: `current_board` is a pointer to the per-session board-name
# buffer (`BOARD_NAME_MAX + 1` bytes, NUL-terminated). `enter` and
# `leave` write into this buffer; all storage commands route through it.
fn session_execute(cfd, line, line_len, current_board, quit_out): i64 {
    # Trim trailing spaces.
    var len = line_len;
    var trimming = 1;
    while (trimming == 1) {
        if (len <= 0) { trimming = 0; }
        else { if ((load8(line + len - 1) & 0xFF) != 32) { trimming = 0; }
               else                                       { len = len - 1; } }
    }
    # Empty line — nothing to do, return to prompt.
    if (len == 0) { return MODE_COMMAND; }

    if (line_has_prefix(line, len, "help") != 0) {
        send_str(cfd, "\r\nCommands:\r\n");
        send_str(cfd, "  boards          list all boards (main + named)\r\n");
        send_str(cfd, "  enter <name>    switch to a named board (auto-creates)\r\n");
        send_str(cfd, "  leave           return to main\r\n");
        send_str(cfd, "  list            list post IDs in the current board\r\n");
        send_str(cfd, "  read <id>       read a post by ID (with reply list)\r\n");
        send_str(cfd, "  post            compose a new post; end with '.' on a line by itself\r\n");
        send_str(cfd, "  reply <id>      compose a reply to <id>; auto Re: subject\r\n");
        send_str(cfd, "  login <handle>  start a challenge/response login (sigil Ed25519)\r\n");
        send_str(cfd, "  whoami          print bound identity (handle + fingerprint) or 'anonymous'\r\n");
        send_str(cfd, "  play <game>     door: smuggler | port | handler | eliza | parry | quest | jabberwacky | olympiad | ashes | decode  [practice|solo|universe]\r\n");
        send_str(cfd, "  scores <game>   top-10 leaderboard for a door game\r\n");
        send_str(cfd, "  chat [channel]  join a live chat channel (default 'lobby'); /leave to exit\r\n");
        send_str(cfd, "  descent         step through the portal into the Yeoman's Descent MUD\r\n");
        send_str(cfd, "  help            this message\r\n");
        send_str(cfd, "  quit            close the session\r\n\r\n");
        return MODE_COMMAND;
    }

    # M5-E: `boards` — list main + all named subdirectory boards.
    if (line_has_prefix(line, len, "boards") != 0) {
        var idsmain = cmd_alloc(DIRENT_ID_MAX * 8);
        var maincount = post_list(g_store_buf, "main", idsmain, DIRENT_ID_MAX);
        # Always list main
        send_str(cfd, "  main      ");
        var ibuf[24];
        var ilen = fmt_int_buf(maincount, &ibuf);
        send_buf(cfd, &ibuf, ilen);
        send_str(cfd, " posts\r\n");

        var names = cmd_alloc(BOARD_LIST_MAX * 8);
        var bcount = boards_list(g_store_buf, names, BOARD_LIST_MAX);
        var i = 0;
        while (i < bcount) {
            var entry = load64(names + i * 8);
            var name_cstr = str_data(entry);
            var pcount = post_list(g_store_buf, name_cstr, idsmain, DIRENT_ID_MAX);
            send_str(cfd, "  ");
            send_str(cfd, name_cstr);
            # Pad to 10 columns for visual alignment with "main      "
            var nlen = strlen(name_cstr);
            var pad = 10 - nlen;
            while (pad > 0) {
                send_str(cfd, " ");
                pad = pad - 1;
            }
            var pbuf[24];
            var plen = fmt_int_buf(pcount, &pbuf);
            send_buf(cfd, &pbuf, plen);
            send_str(cfd, " posts\r\n");
            i = i + 1;
        }
        return MODE_COMMAND;
    }

    # M5-E: `enter <name>` — switch the session's current board.
    # Auto-creates the board's directory on first use (ADR 0004 § Lifecycle).
    if (line_has_prefix(line, len, "enter") != 0) {
        # Skip "enter" + leading spaces. Always advance `i` regardless of
        # which branch we take (avoids the trap-pattern that bit M5-D parse).
        var i = 5;
        var skipping = 1;
        while (skipping == 1) {
            if (i >= len) { skipping = 0; }
            else { if ((load8(line + i) & 0xFF) != 32) { skipping = 0; }
                   else                                 { i = i + 1; } }
        }
        if (i >= len) {
            send_str(cfd, "usage: enter <name>\r\n");
            return MODE_COMMAND;
        }
        var name_len = len - i;
        if (name_len > BOARD_NAME_MAX) {
            send_str(cfd, "board name too long (max 32 bytes)\r\n");
            return MODE_COMMAND;
        }
        var name_buf = cmd_alloc(BOARD_NAME_MAX + 1);
        memcpy(name_buf, line + i, name_len);
        store8(name_buf + name_len, 0);

        if (board_name_valid(name_buf) == 0) {
            send_str(cfd, "invalid board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')\r\n");
            return MODE_COMMAND;
        }
        # 0.8.3 audit M4 — anonymous sessions may enter existing boards
        # but may not create new ones. Auth-gate only the create path;
        # existing-board enter stays anonymous-permitted (matches the
        # M6 "anon-read, auth-post" default policy shape).
        #
        # Pre-0.8.3 shape: every `enter <name>` ran board_ensure,
        # letting any anon spam `enter b1 / enter b2 / ...` to mkdir
        # arbitrary subdirs of the store (audit M4 in 2026-05-23-audit.md).
        var is_anon = 0;
        if (g_session_fp == 0) { is_anon = 1; }
        else { if ((load8(g_session_fp) & 0xFF) == 0) { is_anon = 1; } }
        if (is_anon != 0) {
            if (board_exists(g_store_buf, name_buf) == 0) {
                send_str(cfd, "auth required to create new boards — run 'login <handle>' first\r\n");
                return MODE_COMMAND;
            }
        }
        # Switch + (no-op if already exists) auto-create. board_ensure
        # is safe to call on an existing board.
        memcpy(current_board, name_buf, name_len);
        store8(current_board + name_len, 0);
        board_ensure(g_store_buf, current_board);
        send_str(cfd, "entered ");
        send_str(cfd, current_board);
        send_str(cfd, "\r\n");
        return MODE_COMMAND;
    }

    # M5-E: `leave` — return to main.
    if (line_has_prefix(line, len, "leave") != 0) {
        memcpy(current_board, "main", 4);
        store8(current_board + 4, 0);
        send_str(cfd, "back in main\r\n");
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "list") != 0) {
        var ids = cmd_alloc(DIRENT_ID_MAX * 8);
        var count = post_list(g_store_buf, current_board, ids, DIRENT_ID_MAX);
        if (count == 0) {
            send_str(cfd, "(no posts)\r\n");
        } else {
            # Preallocate a per-iteration scratch buffer for the
            # whole post file (read once to extract Subject), and a
            # subject-extract buffer. Subject lookup is O(file)
            # which is negligible at the v1.0 BBS scale.
            var fbuf = cmd_alloc(POST_MAX_BYTES + 1024);
            var sbuf = cmd_alloc(SUBJECT_MAX_BYTES);
            var hbuf = cmd_alloc(ACCOUNT_HANDLE_BUF);
            var fpbuf = cmd_alloc(ACCOUNT_FP_BUF_BYTES);
            var idx = 0;
            while (idx < count) {
                var id = load64(ids + idx * 8);
                var idbuf[24];
                var idlen = fmt_int_buf(id, &idbuf);
                send_buf(cfd, &idbuf, idlen);
                send_str(cfd, "  ");
                var flen = post_read(g_store_buf, current_board, id, fbuf, POST_MAX_BYTES + 1024);
                # M6-E: [<handle>|anon] before subject.
                send_str(cfd, "[");
                if (flen > 0) {
                    if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
                        send_text(cfd, hbuf, strlen(hbuf));
                    } else {
                        send_str(cfd, "anon");
                    }
                } else {
                    send_str(cfd, "anon");
                }
                send_str(cfd, "]  ");
                if (flen > 0) {
                    var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
                    if (slen > 0) {
                        send_text(cfd, sbuf, slen);
                    }
                }
                send_str(cfd, "\r\n");
                idx = idx + 1;
            }
        }
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "read") != 0) {
        var id = line_parse_int(line, 4, len);
        if (id < 0) {
            send_str(cfd, "usage: read <id>\r\n");
            return MODE_COMMAND;
        }
        var fbuf = cmd_alloc(POST_MAX_BYTES + 1024);
        var flen = post_read(g_store_buf, current_board, id, fbuf, POST_MAX_BYTES + 1024);
        if (flen <= 0) {
            send_str(cfd, "post not found\r\n");
            return MODE_COMMAND;
        }

        # M5-D: surface Subject before the body so the reader knows
        # what they're looking at. Headerless (M5-A/B/C) posts skip
        # this — body_off == 0 and post_subject returns 0 length.
        # M6-E: From line above subject (or "From: anonymous" for
        # missing-header posts).
        var hbuf = cmd_alloc(ACCOUNT_HANDLE_BUF);
        var fpbuf = cmd_alloc(ACCOUNT_FP_BUF_BYTES);
        send_str(cfd, "From: ");
        if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
            send_text(cfd, hbuf, strlen(hbuf));
            send_str(cfd, " ");
            send_text(cfd, fpbuf, strlen(fpbuf));
            send_str(cfd, "\r\n");
        } else {
            send_str(cfd, "anonymous\r\n");
        }
        var sbuf = cmd_alloc(SUBJECT_MAX_BYTES);
        var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
        if (slen > 0) {
            send_str(cfd, "Subject: ");
            send_text(cfd, sbuf, slen);
            send_str(cfd, "\r\n");
        }
        send_str(cfd, "\r\n");

        var body_off = post_body_offset(fbuf, flen);
        var body_len = flen - body_off;
        if (body_len > 0) {
            send_text(cfd, fbuf + body_off, body_len);
            if ((load8(fbuf + body_off + body_len - 1) & 0xFF) != 10) {
                send_str(cfd, "\r\n");
            }
        }

        # M5-F: list child reply IDs (one-deep). Enumerated by
        # scanning the board for posts with Reply-To: <id>.
        var rbuf = cmd_alloc(DIRENT_ID_MAX * 8);
        var rcount = replies_to(g_store_buf, current_board, id, rbuf, DIRENT_ID_MAX);
        if (rcount > 0) {
            send_str(cfd, "\r\nReplies: ");
            var ri = 0;
            while (ri < rcount) {
                if (ri > 0) { send_str(cfd, ", "); }
                var rid_buf[24];
                var rid_len = fmt_int_buf(load64(rbuf + ri * 8), &rid_buf);
                send_buf(cfd, &rid_buf, rid_len);
                ri = ri + 1;
            }
            send_str(cfd, "\r\n");
        }
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "post") != 0) {
        # M6-E auth gate + M6-F per-board policy (.policy / .admins).
        # board_can_post returns 1 only if both the session is
        # authenticated AND the policy allows; otherwise we give a
        # policy-aware error so the user knows whether to login or
        # ask the operator.
        if (board_can_post(g_store_buf, current_board, g_session_fp, g_session_handle) == 0) {
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "auth required — run 'login <handle>' first\r\n");
            } else {
                send_str(cfd, "post denied by board policy (admin-only or unregistered)\r\n");
            }
            return MODE_COMMAND;
        }
        send_str(cfd, "Subject: ");
        return MODE_POSTING_SUBJECT;
    }

    # M5-F: `reply <id>` — compose a reply to parent post <id> in
    # the current board. Computes Re-prefixed subject from parent,
    # skips Subject prompt, transitions straight to MODE_POSTING.
    # The session's `reply_to_out` global slot is set here and read
    # by handle_client when finalizing the post.
    if (line_has_prefix(line, len, "reply") != 0) {
        # M6-E auth gate + M6-F per-board policy (same as `post`).
        if (board_can_post(g_store_buf, current_board, g_session_fp, g_session_handle) == 0) {
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "auth required — run 'login <handle>' first\r\n");
            } else {
                send_str(cfd, "reply denied by board policy (admin-only or unregistered)\r\n");
            }
            return MODE_COMMAND;
        }
        var parent_id = line_parse_int(line, 5, len);
        if (parent_id < 0) {
            send_str(cfd, "usage: reply <id>\r\n");
            return MODE_COMMAND;
        }
        var fbuf = cmd_alloc(POST_MAX_BYTES + 1024);
        var flen = post_read(g_store_buf, current_board, parent_id, fbuf, POST_MAX_BYTES + 1024);
        if (flen <= 0) {
            send_str(cfd, "reply: parent post not found\r\n");
            return MODE_COMMAND;
        }
        # Build derived Re: subject — copy into the session's subject
        # buffer via the `current_board` trick: we expose the slot
        # through globals (set_reply_state below).
        var parent_sub = cmd_alloc(SUBJECT_MAX_BYTES);
        var ps_len = post_subject(fbuf, flen, parent_sub, SUBJECT_MAX_BYTES);
        var derived = cmd_alloc(SUBJECT_MAX_BYTES + 8);
        subject_reply_prefix(parent_sub, ps_len, derived, SUBJECT_MAX_BYTES + 8);
        # Park the derived subject + parent_id in globals — they're
        # picked up by handle_client at the next MODE_POSTING '.' commit.
        g_reply_to = parent_id;
        var dlen = strlen(derived);
        # (1.6.2: g_reply_subject is owned by the session slot — always non-0.)
        memcpy(g_reply_subject, derived, dlen);
        store8(g_reply_subject + dlen, 0);
        g_reply_subject_len = dlen;
        send_str(cfd, "Subject: ");
        send_text(cfd, derived, dlen);
        send_str(cfd, "\r\n");
        send_str(cfd, "Compose reply. End with '.' on a line by itself.\r\n");
        return MODE_POSTING;
    }

    # M6-C: login <handle>. Looks up the handle, generates a 32-byte
    # nonce via /dev/urandom, hex-encodes, sends `challenge: <64-hex>`,
    # parks (fp, nonce_hex) in g_login_*, transitions to
    # MODE_LOGIN_AWAIT_SIG. ADR 0006 § Specifics.
    if (line_has_prefix(line, len, "login") != 0) {
        # Skip "login" + leading spaces. Same shape as the `enter` parse.
        var li = 5;
        var lskip = 1;
        while (lskip == 1) {
            if (li >= len) { lskip = 0; }
            else { if ((load8(line + li) & 0xFF) != 32) { lskip = 0; }
                   else                                  { li = li + 1; } }
        }
        if (li >= len) {
            send_str(cfd, "usage: login <handle>\r\n");
            return MODE_COMMAND;
        }
        var hname_len = len - li;
        if (hname_len > ACCOUNT_HANDLE_MAX) {
            send_str(cfd, "handle too long (max 32 bytes)\r\n");
            return MODE_COMMAND;
        }
        var hname_buf = cmd_alloc(ACCOUNT_HANDLE_BUF);
        memcpy(hname_buf, line + li, hname_len);
        store8(hname_buf + hname_len, 0);

        # Resolve handle → fingerprint via the M6-B scan.
        var got = account_resolve_handle(g_store_buf, hname_buf, g_login_fp);
        if (got != 1) {
            send_str(cfd, "unknown user\r\n");
            store8(g_login_fp, 0);
            return MODE_COMMAND;
        }

        # Generate the nonce, hex-encode, park.
        var nonce_raw[32];
        if (nonce_random(&nonce_raw) != 0) {
            send_str(cfd, "login failed (entropy)\r\n");
            store8(g_login_fp, 0);
            return MODE_COMMAND;
        }
        nonce_to_hex(&nonce_raw, g_login_nonce);
        g_login_started_ms = clock_now_ms();

        send_str(cfd, "challenge: ");
        send_buf(cfd, g_login_nonce, ACCOUNT_NONCE_HEX_BYTES);
        send_str(cfd, "\r\nreply with: auth: <128-hex-ed25519-sig over \"agora-login:\" + challenge>\r\n");
        return MODE_LOGIN_AWAIT_SIG;
    }

    # M6-D: `whoami` — print bound identity or "anonymous".
    if (line_has_prefix(line, len, "whoami") != 0) {
        if ((load8(g_session_fp) & 0xFF) == 0) {
            send_str(cfd, "anonymous\r\n");
        } else {
            if ((load8(g_session_handle) & 0xFF) != 0) {
                send_str(cfd, g_session_handle);
                send_str(cfd, " ");
            }
            send_str(cfd, g_session_fp);
            send_str(cfd, "\r\n");
        }
        return MODE_COMMAND;
    }

    # 1.1.0: `play <game> [mode]` — launch a door game (ADR 0009).
    if (line_has_prefix(line, len, "play") != 0) {
        # token 1 = game name, token 2 = mode (optional, default practice)
        var p = 4;
        var sk = 1;
        while (sk == 1) {
            if (p >= len) { sk = 0; }
            else { if ((load8(line + p) & 0xFF) != 32) { sk = 0; } else { p = p + 1; } }
        }
        var gstart = p;
        var ge = 1;
        while (ge == 1) {
            if (p >= len) { ge = 0; }
            else { if ((load8(line + p) & 0xFF) == 32) { ge = 0; } else { p = p + 1; } }
        }
        var glen = p - gstart;
        if (glen <= 0) {
            send_str(cfd, "usage: play <smuggler|port|handler|eliza|parry|quest|jabberwacky|olympiad|ashes|decode> [practice|solo]\r\n");
            return MODE_COMMAND;
        }
        if (glen > 15) { glen = 15; }
        var gbuf = cmd_alloc(16);
        memcpy(gbuf, line + gstart, glen);
        store8(gbuf + glen, 0);
        var sk2 = 1;
        while (sk2 == 1) {
            if (p >= len) { sk2 = 0; }
            else { if ((load8(line + p) & 0xFF) != 32) { sk2 = 0; } else { p = p + 1; } }
        }
        var mstart = p;
        var me = 1;
        while (me == 1) {
            if (p >= len) { me = 0; }
            else { if ((load8(line + p) & 0xFF) == 32) { me = 0; } else { p = p + 1; } }
        }
        var mlen = p - mstart;
        if (mlen > 15) { mlen = 15; }
        var mbuf = cmd_alloc(16);
        if (mlen > 0) { memcpy(mbuf, line + mstart, mlen); }
        store8(mbuf + mlen, 0);

        var game = GAME_NONE;
        if (streq(gbuf, "smuggler") != 0) { game = GAME_SMUGGLER; }
        if (streq(gbuf, "port") != 0)     { game = GAME_PORT; }
        if (streq(gbuf, "handler") != 0)  { game = GAME_HANDLER; }
        if (streq(gbuf, "eliza") != 0)    { game = GAME_ELIZA; }
        if (streq(gbuf, "parry") != 0)    { game = GAME_PARRY; }
        if (streq(gbuf, "quest") != 0)    { game = GAME_QUEST; }
        if (streq(gbuf, "jabberwacky") != 0) { game = GAME_JABBER; }
        if (streq(gbuf, "olympiad") != 0) { game = GAME_OLYMPIAD; }
        if (streq(gbuf, "ashes") != 0)    { game = GAME_ASHES; }
        if (streq(gbuf, "decode") != 0)   { game = GAME_DECODE; }
        if (game == GAME_NONE) {
            send_str(cfd, "unknown game. try: play smuggler | port | handler | eliza | parry | quest | jabberwacky | olympiad | ashes | decode\r\n");
            return MODE_COMMAND;
        }
        var dmode = DOOR_PRACTICE;
        if (streq(mbuf, "solo") != 0)     { dmode = DOOR_SOLO; }
        if (streq(mbuf, "universe") != 0) { dmode = DOOR_UNIVERSE; }
        # 1.4.6 (R7 / ADR 0020): per-game mode coercion is descriptor data
        # (DD_MODE_POLICY). Chatbots force practice (no save, no world); the
        # solo-only games (QUEST/Jabberwacky/Olympiad/Decode) downgrade a
        # `universe` request to solo — without this they'd fall into the
        # unwired DOOR_UNIVERSE branch, leave g_door_state NULL, and segfault
        # the worker on the first render; Ashes forces universe (the map IS
        # the game). Smuggler/Port/Handler are DM_NORMAL (all modes allowed).
        var pd = door_desc_for(game);
        if (pd != 0) {
            var mp = load64(pd + DD_MODE_POLICY);
            if (mp == DM_PRACTICE_ONLY)  { dmode = DOOR_PRACTICE; }
            if (mp == DM_NO_UNIVERSE)    { if (dmode == DOOR_UNIVERSE) { dmode = DOOR_SOLO; } }
            if (mp == DM_FORCE_UNIVERSE) { dmode = DOOR_UNIVERSE; }
        }

        if (dmode == DOOR_UNIVERSE) {
            # 1.2.0 (ADR 0010 bites 2-4): all three games have a shared
            # Universe. Login-gated — a persistent actor needs an identity.
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "Universe play needs an identity — log in first ('login <handle>').\r\n");
                return MODE_COMMAND;
            }
            # 1.6.3 — a `play` while a state is already live would orphan it.
            door_state_free();
            g_door_game = game;
            g_door_mode = DOOR_UNIVERSE;
            # (1.6.2: g_uni_world is owned by the session slot — always non-0.)
            var uslot = door_universe_slot(game);
            var uloaded = 0;
            if (door_save_exists(g_store_buf, g_session_fp, uslot) == 1) {
                var ulbuf = cmd_alloc(DOOR_SAVE_CAP);
                var uln = door_save_read(g_store_buf, g_session_fp, uslot, ulbuf, DOOR_SAVE_CAP);
                if (uln > 0) {
                    var uld = door_desc_for(game);
                    var ulfp = 0;
                    if (uld != 0) { ulfp = load64(uld + DD_LOAD); }
                    if (ulfp != 0) { g_door_state = callptr(ulfp, ulbuf, uln); }
                    if (g_door_state != 0) { uloaded = 1; }
                }
            }
            if (uloaded == 0) {
                var und = door_desc_for(game);
                var unfp = 0;
                var unseed = clock_now_ns();
                var undays = 0;
                if (und != 0) {
                    unfp = load64(und + DD_NEW);
                    undays = load64(und + DD_DEF_DAYS);
                    var us = load64(und + DD_UNI_SEED);   # PA's galaxy seed; 0 -> clock for the rest
                    if (us != 0) { unseed = us; }
                }
                if (unfp != 0) { g_door_state = callptr(unfp, unseed, DOOR_UNIVERSE, undays); }
            }
            var usd = door_desc_for(game);
            if (usd != 0) {
                var ustfp = load64(usd + DD_START);
                if (ustfp != 0) { var usr = callptr(ustfp, g_door_state); }
                var ufpoff = load64(usd + DD_FP_OFF);
                if (ufpoff != 0) {
                    var realoff = ufpoff - 1;   # undo the +1 bias (AE_FP legitimately == 0)
                    store64(g_door_state + realoff, hex16_to_i64(g_session_fp));
                }
            }
            # Prime the world — mints + persists it on the first ever entry
            # — so the opening frame already reflects shared state. For Ashes,
            # door_world_begin also runs the lazy turn resolution; surface the
            # async "what happened while you were gone" notice after it ticks.
            var ufd = door_world_begin();
            if (ufd >= 0) {
                door_set_world(game, g_uni_world);
                var oed = door_desc_for(game);
                if (oed != 0) {
                    var oefp = load64(oed + DD_ON_ENTRY);
                    if (oefp != 0) { var oer = callptr(oefp, g_door_state); }
                }
                door_world_commit(ufd);
            }
            door_send_frame(cfd);
            return MODE_DOOR;
        }
        if (dmode == DOOR_SOLO) {
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "solo play saves progress — log in first ('login <handle>').\r\n");
                return MODE_COMMAND;
            }
        }

        # 1.6.3 — same guard as the Universe branch above: never overwrite a
        # live state pointer, or its buffers are orphaned for the life of the
        # server under poll.
        door_state_free();
        g_door_game = game;
        g_door_mode = dmode;
        var seed = clock_now_ns();
        var loaded = 0;
        if (dmode == DOOR_SOLO) {
            var nm = door_game_name(game);
            if (door_save_exists(g_store_buf, g_session_fp, nm) == 1) {
                var lbuf = cmd_alloc(DOOR_SAVE_CAP);
                var ln = door_save_read(g_store_buf, g_session_fp, nm, lbuf, DOOR_SAVE_CAP);
                if (ln > 0) {
                    var sld = door_desc_for(game);
                    var slfp = 0;
                    if (sld != 0) { slfp = load64(sld + DD_LOAD); }
                    if (slfp != 0) { g_door_state = callptr(slfp, lbuf, ln); }
                    if (g_door_state != 0) { loaded = 1; }
                }
            }
        }
        if (loaded == 0) {
            var nd = door_desc_for(game);
            if (nd != 0) {
                var nfp = load64(nd + DD_NEW);
                var ndays = load64(nd + DD_DEF_DAYS);
                if (nfp != 0) { g_door_state = callptr(nfp, seed, dmode, ndays); }
            }
        }
        var ssd = door_desc_for(game);
        if (ssd != 0) {
            var sstfp = load64(ssd + DD_START);
            if (sstfp != 0) { var ssr = callptr(sstfp, g_door_state); }
        }
        door_send_frame(cfd);
        return MODE_DOOR;
    }

    # 1.2.0 bite 5: `scores <game>` — show a game's top-10 leaderboard.
    if (line_has_prefix(line, len, "scores") != 0) {
        var scsp = 6;
        var scsk = 1;
        while (scsk == 1) {
            if (scsp >= len) { scsk = 0; }
            else { if ((load8(line + scsp) & 0xFF) != 32) { scsk = 0; } else { scsp = scsp + 1; } }
        }
        var scgs = scsp;
        var scge = 1;
        while (scge == 1) {
            if (scsp >= len) { scge = 0; }
            else { if ((load8(line + scsp) & 0xFF) == 32) { scge = 0; } else { scsp = scsp + 1; } }
        }
        var scgl = scsp - scgs;
        if (scgl <= 0) {
            send_str(cfd, "usage: scores <smuggler|port|handler|quest|olympiad|ashes|decode>\r\n");
            return MODE_COMMAND;
        }
        if (scgl > 15) { scgl = 15; }
        var scgb = cmd_alloc(16);
        memcpy(scgb, line + scgs, scgl);
        store8(scgb + scgl, 0);
        var scgame = GAME_NONE;
        if (streq(scgb, "smuggler") != 0) { scgame = GAME_SMUGGLER; }
        if (streq(scgb, "port") != 0)     { scgame = GAME_PORT; }
        if (streq(scgb, "handler") != 0)  { scgame = GAME_HANDLER; }
        if (streq(scgb, "quest") != 0)    { scgame = GAME_QUEST; }
        if (streq(scgb, "olympiad") != 0) { scgame = GAME_OLYMPIAD; }
        if (streq(scgb, "ashes") != 0)    { scgame = GAME_ASHES; }
        if (streq(scgb, "decode") != 0)   { scgame = GAME_DECODE; }
        if (scgame == GAME_NONE) {
            send_str(cfd, "unknown game. try: scores smuggler | port | handler | quest | olympiad | ashes | decode\r\n");
            return MODE_COMMAND;
        }
        door_render_leaderboard(cfd, scgame);
        return MODE_COMMAND;
    }

    # 1.3.0: `chat [channel]` — join a live chat channel (ADR 0011).
    # Login-gated: a chat presence is a persistent-ish actor (needs an
    # identity), same rule as Universe. Default channel "lobby".
    if (line_has_prefix(line, len, "chat") != 0) {
        if ((load8(g_session_fp) & 0xFF) == 0) {
            send_str(cfd, "chat needs an identity — log in first ('login <handle>').\r\n");
            return MODE_COMMAND;
        }
        var ci = 4;
        var csk = 1;
        while (csk == 1) {
            if (ci >= len) { csk = 0; }
            else { if ((load8(line + ci) & 0xFF) != 32) { csk = 0; } else { ci = ci + 1; } }
        }
        var chan = cmd_alloc(CHAT_CHANNEL_MAX + 1);
        if (ci >= len) {
            memcpy(chan, "lobby", 5); store8(chan + 5, 0);
        } else {
            var clen = len - ci;
            if (clen > CHAT_CHANNEL_MAX) {
                send_str(cfd, "channel name too long (max 32 bytes)\r\n");
                return MODE_COMMAND;
            }
            memcpy(chan, line + ci, clen); store8(chan + clen, 0);
            if (chat_channel_valid(chan) == 0) {
                send_str(cfd, "invalid channel name (lowercase ASCII + digits + '-' / '_', 1-32 bytes)\r\n");
                return MODE_COMMAND;
            }
        }
        if (chat_dir_ensure(g_store_buf, chan) != 0) {
            send_str(cfd, "could not open channel\r\n");
            return MODE_COMMAND;
        }
        memcpy(g_chat_channel, chan, strlen(chan) + 1);
        # Banner + scrollback (last CHAT_SCROLLBACK_LINES); set the
        # live-tail watermark to the latest seq so only NEW lines stream.
        send_str(cfd, "\r\n-- chat: #");
        send_str(cfd, g_chat_channel);
        send_str(cfd, " --  (type a line to talk; /help for commands, /leave to exit)\r\n");
        var lbuf = cmd_alloc(CHAT_LOG_BUF);
        var ln = chat_log_read(g_store_buf, g_chat_channel, lbuf, CHAT_LOG_CAP);
        var seenp = cmd_alloc(8);
        store64(seenp, 0);
        if (ln > 0) {
            var ob = cmd_alloc(CHAT_TAIL_CAP);
            var ol = chat_emit_tail_k(lbuf, ln, CHAT_SCROLLBACK_LINES, ob, CHAT_TAIL_CAP, seenp);
            if (ol > 0) { send_text(cfd, ob, ol); }
        }
        g_chat_seen = load64(seenp);
        g_chat_idle = 0;
        # Drop the recv timeout to the live-tail poll cadence so an idle
        # recv becomes a tail tick (handle_client) instead of a hangup.
        sock_set_recv_timeout(cfd, CHAT_POLL_SECS, 0);
        return MODE_CHAT;
    }

    # 1.4.0 (ADR 0017): `descent` — step through the portal into the
    # sibling Yeoman's Descent MUD. Login-gated like chat (a citizen
    # steps through; the MUD still runs its own login). descent_run
    # blocks in the transparent proxy until the MUD session ends, then
    # returns and we drop straight back to the BBS command prompt. All
    # of descent_run's failure paths are soft (print + return).
    if (line_has_prefix(line, len, "descent") != 0) {
        if ((load8(g_session_fp) & 0xFF) == 0) {
            send_str(cfd, "descent needs an identity — log in first ('login <handle>').\r\n");
            return MODE_COMMAND;
        }
        descent_run(cfd, g_store_buf, g_session_handle);
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "quit") != 0) {
        send_str(cfd, "bye\r\n");
        store64(quit_out, 1);
        return MODE_COMMAND;
    }
    if (line_has_prefix(line, len, "exit") != 0) {
        send_str(cfd, "bye\r\n");
        store64(quit_out, 1);
        return MODE_COMMAND;
    }
    if (line_has_prefix(line, len, "bye") != 0) {
        send_str(cfd, "bye\r\n");
        store64(quit_out, 1);
        return MODE_COMMAND;
    }

    send_str(cfd, "unknown command — type 'help' for the list\r\n");
    return MODE_COMMAND;
}

# === 1.1.0 door subsystem glue (ADR 0009) ===
#
# The games are pure modules (render into a buffer, consume one line);
# these helpers own the socket I/O + persistence that the MODE_DOOR
# dispatch and the `play` command call.

# === 1.4.6 (R7): the per-game door descriptor registry ===
#
# Every door's identity + behavior lives in ONE descriptor record keyed by
# its GAME_* id, instead of being smeared across ~16 `if (game == GAME_X)`
# dispatch functions. Adding a door is now a single registry block, not an
# edit to eighteen call sites. The behavior slots hold function addresses
# (`&xx_render`, …) called via `callptr`; an absent capability is a 0 slot
# the dispatcher falls back on (e.g. a chatbot has no save / no is_over).
# Uniform signatures make this safe: render(st,buf,cap), feed(st,line,len),
# is_over(st), save_format(st,buf,cap), new(seed,mode,days), load(buf,len).
enum DoorDesc {
    DD_NAME        = 0;     # cstring — the `play <name>` / leaderboard name
    DD_USLOT       = 8;     # cstring — Universe per-player save slot ("<game>u"); 0 = solo-only
    DD_RENDER      = 16;    # fn(st,buf,cap)->i64
    DD_FEED        = 24;    # fn(st,line,len)->i64
    DD_IS_OVER     = 32;    # fn(st)->i64  (0 = never over — chatbots)
    DD_SAVE_FMT    = 40;    # fn(st,buf,cap)->i64  (0 = no save)
    DD_NEW         = 48;    # fn(seed,mode,days)->st  (2-arg news ignore days)
    DD_LOAD        = 56;    # fn(buf,len)->st  (0 = no load)
    DD_DEF_DAYS    = 64;    # i64 — 3rd arg to NEW
    DD_FLAGS       = 72;    # bitfield (DF_*)
    DD_WORLD_BYTES = 80;    # fn()->i64 snapshot size (0 = not a Universe game; default 8)
    DD_WORLD_VALID = 88;    # fn(buf,len)->i64
    DD_WORLD_NEW   = 96;    # fn(seed)->ptr  (seedless world ctors ignore the arg)
    DD_WORLD_SEED  = 104;   # i64 seed for WORLD_NEW
    DD_WORLD_OFF   = 112;   # byte offset of the world ptr field inside the game state
    DD_MSG         = 120;   # fn(st,cstr)  — Universe "world is busy" notice
    DD_BUSY        = 128;   # cstring — the busy notice text
    DD_SCORE       = 136;   # fn(st)->i64 final score (0 = no leaderboard)
    DD_RANK        = 144;   # fn(score)->cstring rank label
    DD_WORLD_TICK  = 152;   # fn(world,turn) lazy turn-batch resolve on world-open (0 = none)
    DD_TICK_NS     = 160;   # i64 ns per turn (divisor for the tick turn number)
    DD_START       = 168;   # fn(st) post-construction start hook (0 = none, e.g. Olympiad)
    DD_FP_OFF      = 176;   # (byte offset + 1) to store the session fp (hex16->i64); 0 = none
                            # (the +1 bias is because a real fp field can sit at offset 0, e.g. AE_FP)
    DD_UNI_SEED    = 184;   # i64 game-state seed override for Universe new (0 = clock)
    DD_ON_ENTRY    = 192;   # fn(st) Universe on-entry hook (Ashes founding); 0 = none
    DD_MODE_POLICY = 200;   # DM_* mode coercion applied by the `play` launcher
    # 1.6.3 (ADR 0022) — fn(st) releasing a door state and everything it owns.
    # 0 = this game's state is not freeable (none today: all ten register one).
    # The state and its owned buffers come from the FREELIST (fl_alloc), not the
    # bump allocator, so the pairing is real; a game's *_free lives next to its
    # constructor in the same module, which is how the pairing stays honest.
    DD_FREE        = 208;
    DD_SIZE        = 216;
    DF_UNIVERSE    = 1;     # DD_FLAGS bit — shared-world game
    DM_NORMAL         = 0;  # practice / solo / universe all allowed
    DM_PRACTICE_ONLY  = 1;  # chatbots — force practice (no save, no world)
    DM_NO_UNIVERSE    = 2;  # real solo/practice game — downgrade a `universe` request to solo
    DM_FORCE_UNIVERSE = 3;  # inherently shared world — force universe
}

var g_door_registry = 0;   # alloc'd: (GAME_DECODE+1) i64 slots, game id -> descriptor ptr

# Allocate + zero a descriptor and slot it into the registry by game id.
fn dd_new_desc(game): i64 {
    var d = alloc(DD_SIZE);
    memset(d, 0, DD_SIZE);
    store64(g_door_registry + game * 8, d);
    return d;
}

# Active descriptor for a game id, or 0 (uninitialized / out of range / NONE).
fn door_desc_for(game): i64 {
    if (g_door_registry == 0) { return 0; }
    if (game < 1) { return 0; }
    if (game > GAME_DECODE) { return 0; }
    return load64(g_door_registry + game * 8);
}

# Build the registry once per process (guarded in handle_client). Each block
# IS a door's entry — to add a game, add one block here and nothing else.
fn door_registry_init(): i64 {
    g_door_registry = alloc((GAME_DECODE + 1) * 8);
    memset(g_door_registry, 0, (GAME_DECODE + 1) * 8);
    var d = 0;

    d = dd_new_desc(GAME_SMUGGLER);
    store64(d + DD_NAME, "smuggler");      store64(d + DD_USLOT, "smuggleru");
    store64(d + DD_RENDER, &sl_render);    store64(d + DD_FEED, &sl_feed);
    store64(d + DD_IS_OVER, &sl_is_over);  store64(d + DD_SAVE_FMT, &sl_save_format);
    store64(d + DD_NEW, &sl_new);
    store64(d + DD_FREE, &sl_free);          store64(d + DD_LOAD, &sl_load_parse);
    store64(d + DD_DEF_DAYS, SL_DEF_DAYS); store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &slw_byte_size); store64(d + DD_WORLD_VALID, &slw_valid);
    store64(d + DD_WORLD_NEW, &slw_new);   store64(d + DD_WORLD_SEED, 0);
    store64(d + DD_WORLD_OFF, SL_WORLD);
    store64(d + DD_MSG, &sl_msg);          store64(d + DD_BUSY, "The streets are busy — try again.");
    store64(d + DD_SCORE, &sl_final_score); store64(d + DD_RANK, &sl_rank);
    store64(d + DD_START, &sl_start);

    d = dd_new_desc(GAME_PORT);
    store64(d + DD_NAME, "port");          store64(d + DD_USLOT, "portu");
    store64(d + DD_RENDER, &pa_render);    store64(d + DD_FEED, &pa_feed);
    store64(d + DD_IS_OVER, &pa_is_over);  store64(d + DD_SAVE_FMT, &pa_save_format);
    store64(d + DD_NEW, &pa_new);
    store64(d + DD_FREE, &pa_free);          store64(d + DD_LOAD, &pa_load_parse);
    store64(d + DD_DEF_DAYS, PA_DEF_DAYS); store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &paw_byte_size); store64(d + DD_WORLD_VALID, &paw_valid);
    store64(d + DD_WORLD_NEW, &paw_new);   store64(d + DD_WORLD_SEED, PA_UNIVERSE_SEED);
    store64(d + DD_WORLD_OFF, PA_WORLD);
    store64(d + DD_MSG, &pa_msg);          store64(d + DD_BUSY, "The galaxy is busy — try again.");
    store64(d + DD_SCORE, &pa_final_score); store64(d + DD_RANK, &pa_rank);
    store64(d + DD_START, &pa_start);       store64(d + DD_FP_OFF, PA_FP + 1);
    store64(d + DD_UNI_SEED, PA_UNIVERSE_SEED);

    d = dd_new_desc(GAME_HANDLER);
    store64(d + DD_NAME, "handler");       store64(d + DD_USLOT, "handleru");
    store64(d + DD_RENDER, &th_render);    store64(d + DD_FEED, &th_feed);
    store64(d + DD_IS_OVER, &th_is_over);  store64(d + DD_SAVE_FMT, &th_save_format);
    store64(d + DD_NEW, &th_new);
    store64(d + DD_FREE, &th_free);          store64(d + DD_LOAD, &th_load_parse);
    store64(d + DD_DEF_DAYS, TH_DEF_DAYS); store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &thw_byte_size); store64(d + DD_WORLD_VALID, &thw_valid);
    store64(d + DD_WORLD_NEW, &thw_new);   store64(d + DD_WORLD_SEED, 0);
    store64(d + DD_WORLD_OFF, TH_WORLD);
    store64(d + DD_MSG, &th_msg);          store64(d + DD_BUSY, "The registry is busy — try again.");
    store64(d + DD_SCORE, &th_score);      store64(d + DD_RANK, &th_rank);
    store64(d + DD_START, &th_start);

    d = dd_new_desc(GAME_ELIZA);
    store64(d + DD_NAME, "eliza");
    store64(d + DD_RENDER, &ez_render);    store64(d + DD_FEED, &ez_feed);
    store64(d + DD_NEW, &ez_new);
    store64(d + DD_FREE, &ez_free);          store64(d + DD_DEF_DAYS, EZ_DEF_DAYS);
    store64(d + DD_START, &ez_start);       store64(d + DD_MODE_POLICY, DM_PRACTICE_ONLY);

    d = dd_new_desc(GAME_PARRY);
    store64(d + DD_NAME, "parry");
    store64(d + DD_RENDER, &py_render);    store64(d + DD_FEED, &py_feed);
    store64(d + DD_NEW, &py_new);
    store64(d + DD_FREE, &py_free);          store64(d + DD_DEF_DAYS, PY_DEF_DAYS);
    store64(d + DD_START, &py_start);       store64(d + DD_MODE_POLICY, DM_PRACTICE_ONLY);

    d = dd_new_desc(GAME_QUEST);
    store64(d + DD_NAME, "quest");
    store64(d + DD_RENDER, &qu_render);    store64(d + DD_FEED, &qu_feed);
    store64(d + DD_IS_OVER, &qu_is_over);  store64(d + DD_SAVE_FMT, &qu_save_format);
    store64(d + DD_NEW, &qu_new);
    store64(d + DD_FREE, &qu_free);          store64(d + DD_LOAD, &qu_load_parse);
    store64(d + DD_DEF_DAYS, 0);
    store64(d + DD_SCORE, &qu_final_score); store64(d + DD_RANK, &qu_rank);
    store64(d + DD_START, &qu_start);       store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    d = dd_new_desc(GAME_JABBER);
    store64(d + DD_NAME, "jabberwacky");
    store64(d + DD_RENDER, &jw_render);    store64(d + DD_FEED, &jw_feed);
    store64(d + DD_IS_OVER, &jw_is_over);  store64(d + DD_SAVE_FMT, &jw_save_format);
    store64(d + DD_NEW, &jw_new);
    store64(d + DD_FREE, &jw_free);          store64(d + DD_LOAD, &jw_load_parse);
    store64(d + DD_DEF_DAYS, JW_DEF_DAYS);
    store64(d + DD_START, &jw_start);       store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    d = dd_new_desc(GAME_OLYMPIAD);
    store64(d + DD_NAME, "olympiad");
    store64(d + DD_RENDER, &ol_render);    store64(d + DD_FEED, &ol_feed);
    store64(d + DD_IS_OVER, &ol_is_over);  store64(d + DD_SAVE_FMT, &ol_save_format);
    store64(d + DD_NEW, &ol_new);
    store64(d + DD_FREE, &ol_free);          store64(d + DD_LOAD, &ol_load_parse);
    store64(d + DD_DEF_DAYS, 0);
    store64(d + DD_SCORE, &ol_final_score); store64(d + DD_RANK, &ol_rank);
    store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    d = dd_new_desc(GAME_ASHES);
    store64(d + DD_NAME, "ashes");         store64(d + DD_USLOT, "ashesu");
    store64(d + DD_RENDER, &ash_render);   store64(d + DD_FEED, &ash_feed);
    store64(d + DD_IS_OVER, &ash_is_over); store64(d + DD_SAVE_FMT, &ash_save_format);
    store64(d + DD_NEW, &ash_new);
    store64(d + DD_FREE, &ash_free);         store64(d + DD_LOAD, &ash_load_parse);
    store64(d + DD_DEF_DAYS, 0);           store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &ashw_byte_size); store64(d + DD_WORLD_VALID, &ashw_valid);
    store64(d + DD_WORLD_NEW, &ashw_new);  store64(d + DD_WORLD_SEED, ASH_WORLD_SEED);
    store64(d + DD_WORLD_OFF, AE_WORLD);
    store64(d + DD_MSG, &ash_msg);         store64(d + DD_BUSY, "the realm is busy — try again.");
    store64(d + DD_SCORE, &ash_final_score); store64(d + DD_RANK, &ash_rank);
    store64(d + DD_WORLD_TICK, &ash_world_tick); store64(d + DD_TICK_NS, ASH_NS_PER_TURN);
    store64(d + DD_START, &ash_start);      store64(d + DD_FP_OFF, AE_FP + 1);
    store64(d + DD_ON_ENTRY, &ash_on_entry); store64(d + DD_MODE_POLICY, DM_FORCE_UNIVERSE);

    d = dd_new_desc(GAME_DECODE);
    store64(d + DD_NAME, "decode");
    store64(d + DD_RENDER, &decode_render);   store64(d + DD_FEED, &decode_feed);
    store64(d + DD_IS_OVER, &decode_is_over); store64(d + DD_SAVE_FMT, &decode_save_format);
    store64(d + DD_NEW, &decode_new);
    store64(d + DD_FREE, &decode_free);         store64(d + DD_LOAD, &decode_load_parse);
    store64(d + DD_DEF_DAYS, 0);
    store64(d + DD_SCORE, &decode_final_score); store64(d + DD_RANK, &decode_rank);
    store64(d + DD_START, &decode_start);   store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    return 0;
}

fn door_game_name(game): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return "game"; }
    var nm = load64(d + DD_NAME);
    if (nm == 0) { return "game"; }
    return nm;
}

# === 1.3.0 chat glue (ADR 0011) ===
#
# The transcript layer is pure + storage (chat.cyr); these own the
# socket I/O the MODE_CHAT dispatch + live-tail tick call.

# Render every transcript line newer than this session's watermark and
# send it, advancing g_chat_seen. Called on each idle poll tick and
# right after the session says a line (so the speaker sees their own
# line in canonical form). No-op when nothing is new.
# 1.6.3 (audit) — these three were per-CALL bump allocations, and this function
# runs on every idle chat tick (every CHAT_TICK_MS while a session sits in a
# channel), not just after a typed line. That put it outside the per-line arena
# reset in process_rx, so under poll a single idle chat session leaked
# CHAT_LOG_BUF + CHAT_TAIL_CAP + 8 every couple of seconds, forever.
#
# Dedicated process-lifetime statics rather than cmd_alloc, precisely BECAUSE
# the tick is not bracketed by a reset. They are safe to share: dispatch is
# single-threaded (the poll sweep runs one session to completion before the
# next), and neither buffer outlives the call — the bytes are handed to
# send_buf before returning. Bare `= 0` initializers take the static-init fast
# path, so they cost no gvar_toks slot (CLAUDE.md counting rule).
var g_chat_tail_buf   = 0;
var g_chat_tail_out   = 0;
var g_chat_tail_seenp = 0;

fn chat_flush_tail(cfd): i64 {
    if (g_chat_tail_buf == 0)   { g_chat_tail_buf = alloc(CHAT_LOG_BUF); }
    if (g_chat_tail_out == 0)   { g_chat_tail_out = alloc(CHAT_TAIL_CAP); }
    if (g_chat_tail_seenp == 0) { g_chat_tail_seenp = alloc(8); }
    var buf = g_chat_tail_buf;
    var n = chat_log_read(g_store_buf, g_chat_channel, buf, CHAT_LOG_CAP);
    if (n <= 0) { return 0; }
    var out = g_chat_tail_out;
    var seenp = g_chat_tail_seenp;
    store64(seenp, g_chat_seen);
    var olen = chat_emit_since(buf, n, g_chat_seen, out, CHAT_TAIL_CAP, seenp);
    if (olen > 0) { send_text(cfd, out, olen); }
    g_chat_seen = load64(seenp);
    return 0;
}

# Dispatch a '/'-prefixed chat command. Returns 0 = stay in chat,
# 1 = leave chat (back to the BBS prompt), 2 = quit the session.
fn chat_cmd_dispatch(cfd, line, len): i64 {
    if (line_has_prefix(line, len, "/leave") != 0) {
        send_str(cfd, "left #");
        send_str(cfd, g_chat_channel);
        send_str(cfd, ".\r\n");
        return 1;
    }
    if (line_has_prefix(line, len, "/quit") != 0) {
        send_str(cfd, "bye\r\n");
        return 2;
    }
    if (line_has_prefix(line, len, "/exit") != 0) {
        send_str(cfd, "bye\r\n");
        return 2;
    }
    if (line_has_prefix(line, len, "/eliza") != 0) {
        # 1.3.0 (ADR 0011): toggle the private DOCTOR side-channel. While
        # on the couch, your lines go only to the bot — never to the room.
        if (g_chat_bot == 1) {
            g_chat_bot = 0;
            send_str(cfd, "(left the couch -- back in the room)\r\n");
            return 0;
        }
        if (g_eliza_state == 0) { g_eliza_state = ez_new(0, DOOR_PRACTICE, EZ_DEF_DAYS); }
        ez_start(g_eliza_state);
        g_chat_bot = 1;
        send_str(cfd, "ELIZA: ");
        send_buf(cfd, load64(g_eliza_state + EZ_RESP), load64(g_eliza_state + EZ_RESPLEN));
        send_str(cfd, "\r\n(private session with Eliza -- /eliza to return to the room, 'bye' to leave her)\r\n");
        return 0;
    }
    if (line_has_prefix(line, len, "/parry") != 0) {
        # 1.3.1: toggle the private PARRY side-channel (same couch).
        if (g_chat_bot == 2) {
            g_chat_bot = 0;
            send_str(cfd, "(left the couch -- back in the room)\r\n");
            return 0;
        }
        if (g_parry_state == 0) { g_parry_state = py_new(0, DOOR_PRACTICE, PY_DEF_DAYS); }
        py_start(g_parry_state);
        g_chat_bot = 2;
        send_str(cfd, "PARRY: ");
        send_buf(cfd, load64(g_parry_state + PY_RESP), load64(g_parry_state + PY_RESPLEN));
        send_str(cfd, "\r\n(private session with Parry -- /parry to return to the room, 'bye' to leave him)\r\n");
        return 0;
    }
    if (line_has_prefix(line, len, "/jabberwacky") != 0) {
        # 1.3.3 (ADR 0015): toggle the private Jabberwacky side-channel.
        # Ephemeral, seed-only (the persistent learned layer lives on the
        # `play jabberwacky solo` door, not the couch).
        if (g_chat_bot == 3) {
            g_chat_bot = 0;
            send_str(cfd, "(left the couch -- back in the room)\r\n");
            return 0;
        }
        if (g_jabber_state == 0) { g_jabber_state = jw_new(0, DOOR_PRACTICE, JW_DEF_DAYS); }
        jw_start(g_jabber_state);
        g_chat_bot = 3;
        send_str(cfd, "JABBERWACKY: ");
        send_buf(cfd, load64(g_jabber_state + JW_RESP), load64(g_jabber_state + JW_RESPLEN));
        send_str(cfd, "\r\n(private session with Jabberwacky -- /jabberwacky to return to the room, 'bye' to leave)\r\n");
        return 0;
    }
    if (line_has_prefix(line, len, "/help") != 0) {
        send_str(cfd, "chat commands:  /leave (back to BBS)   /eliza (the DOCTOR)   /parry (the paranoiac)   /jabberwacky (the mimic)   /help   /quit\r\n");
        send_str(cfd, "anything else you type is said to the room.\r\n");
        return 0;
    }
    send_str(cfd, "unknown chat command — /help for the list\r\n");
    return 0;
}

# === 1.3.1 chat-bot couch dispatch ===
#
# The active bot (g_chat_bot: 1 Eliza, 2 Parry) shares the same response
# struct offsets (EZ_RESP/EZ_RESPLEN == PY_RESP/PY_RESPLEN), so the couch
# reads either uniformly. Returns the active bot's state pointer, feeds a
# line to it (returning the exit control), or names it for the prompt.
fn chat_bot_state(): i64 {
    if (g_chat_bot == 1) { return g_eliza_state; }
    if (g_chat_bot == 2) { return g_parry_state; }
    if (g_chat_bot == 3) { return g_jabber_state; }
    return 0;
}

fn chat_bot_feed(line, len): i64 {
    if (g_chat_bot == 1) { return ez_feed(g_eliza_state, line, len); }
    if (g_chat_bot == 2) { return py_feed(g_parry_state, line, len); }
    if (g_chat_bot == 3) { return jw_feed(g_jabber_state, line, len); }
    return 1;
}

fn chat_bot_name(): i64 {
    if (g_chat_bot == 1) { return "ELIZA: "; }
    if (g_chat_bot == 2) { return "PARRY: "; }
    if (g_chat_bot == 3) { return "JABBERWACKY: "; }
    return "BOT: ";
}

# === 1.2.0 Universe world transaction (ADR 0010 bites 2-4) ===
#
# Each game's shared world lives under <store>/.games/<game>/world/ (the
# bite-1 world dir). Per-player state stays in a Solo-style save under a
# dedicated "<game>u" slot. main.cyr owns the flock'd lock→read→feed→
# write transaction; the pure modules mutate the in-memory snapshot.
# These helpers dispatch by g_door_game so PA (bite 2-3), Smuggler, and
# Handler (bite 4) all share one transaction path.

# Snapshot byte size for a game's world.
fn door_world_bytes(game): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 8; }
    var fp = load64(d + DD_WORLD_BYTES);
    if (fp == 0) { return 8; }
    return callptr(fp, 0);   # byte-size ctors take no args; the extra reg is ignored (SysV)
}

# Validate a freshly-read snapshot for a game (size + version).
fn door_world_valid(game, buf, len): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_WORLD_VALID);
    if (fp == 0) { return 0; }
    return callptr(fp, buf, len);
}

# Mint a fresh world for a game into buf (used when no/invalid snapshot
# exists yet). PA's galaxy is seeded; Smuggler/Handler start clean.
fn door_world_fresh_into(game, buf): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_WORLD_NEW);
    if (fp == 0) { return 0; }
    var seed = load64(d + DD_WORLD_SEED);
    var src = callptr(fp, seed);
    if (src != 0) { memcpy(buf, src, door_world_bytes(game)); }
    return 0;
}

# Point the active game state's world field at ptr (so its pure
# transforms read/write the in-memory snapshot during the transaction).
fn door_set_world(game, ptr): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var wb = load64(d + DD_WORLD_BYTES);
    if (wb == 0) { return 0; }                       # not a Universe game (no world ctor)
    var off = load64(d + DD_WORLD_OFF);
    store64(g_door_state + off, ptr);
    return 0;
}

# The per-player Universe save slot for a game ("<game>u" — distinct
# from the Solo slot so a player can keep both).
fn door_universe_slot(game): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return "gameu"; }
    var s = load64(d + DD_USLOT);
    if (s == 0) { return "gameu"; }
    return s;
}

# Open the world lock and load the active game's snapshot into
# g_uni_world, minting + persisting a fresh world if none/invalid.
# Returns the held lock fd, or (0 - 1). Caller MUST door_world_commit.
fn door_world_begin(): i64 {
    var name = door_game_name(g_door_game);
    var fd = world_lock_acquire(g_store_buf, name);
    if (fd < 0) { return 0 - 1; }
    var cap = door_world_bytes(g_door_game);
    var n = world_read(g_store_buf, name, g_uni_world, cap);
    if (door_world_valid(g_door_game, g_uni_world, n) == 0) {
        door_world_fresh_into(g_door_game, g_uni_world);
        world_write(g_store_buf, name, g_uni_world, cap);
    }
    # 1.3.7 (ADR 0014): a Universe game can resolve overdue turn windows lazily
    # on every world-open — the entering caller (already holding the lock) runs
    # the batch resolution; the commit that follows persists it. Generalized at
    # 1.4.6 (R7) via the descriptor's tick fp + ns-per-turn (Ashes is the only
    # one today). `tr` holds the (unused) result — a bare callptr statement does
    # not parse, so the result must be bound.
    var dt = door_desc_for(g_door_game);
    if (dt != 0) {
        var tfp = load64(dt + DD_WORLD_TICK);
        if (tfp != 0) {
            var turn = clock_epoch_ns() / load64(dt + DD_TICK_NS);
            var tr = callptr(tfp, g_uni_world, turn);
        }
    }
    return fd;
}

# Write g_uni_world back under the held lock and release it. Returns the
# world_write status (0 = persisted) so a caller can surface a failed
# shared-world snapshot rather than silently losing the turn; the lock is
# released either way so a write error can't strand the world locked. [R6]
fn door_world_commit(fd): i64 {
    var wr = world_write(g_store_buf, door_game_name(g_door_game), g_uni_world, door_world_bytes(g_door_game));
    world_lock_release(fd);
    return wr;
}

# Feed one line to a Universe session inside the world transaction:
# lock → read snapshot → <game>_feed (mutates it via the pure
# transforms) → write snapshot → unlock. The world field stays set so
# the post-feed render reflects shared state. Returns the feed's exit
# control (1 = leave the game).
fn door_universe_feed(line, len): i64 {
    var fd = door_world_begin();
    var d = door_desc_for(g_door_game);
    if (fd < 0) {
        if (d != 0) {
            var mfp = load64(d + DD_MSG);
            var busy = load64(d + DD_BUSY);
            if (mfp != 0) { var mr = callptr(mfp, g_door_state, busy); }
        }
        return 0;
    }
    door_set_world(g_door_game, g_uni_world);
    var ctrl = 0;
    if (d != 0) {
        var ffp = load64(d + DD_FEED);
        if (ffp != 0) { ctrl = callptr(ffp, g_door_state, line, len); }
    }
    door_world_commit(fd);
    return ctrl;
}

# Persist the active Universe player's per-player state under its
# "<game>u" slot, keyed by fp — separate from the Solo save.
fn door_universe_save(): i64 {
    if ((load8(g_session_fp) & 0xFF) == 0) { return 0; }
    var d = door_desc_for(g_door_game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_SAVE_FMT);
    if (fp == 0) { return 0; }
    var buf = cmd_alloc(DOOR_SAVE_CAP);
    var n = callptr(fp, g_door_state, buf, DOOR_SAVE_CAP);
    if (n > 0) { door_save_write(g_store_buf, g_session_fp, door_universe_slot(g_door_game), buf, n); }
    return 0;
}

# Render the active game's current frame and send it to the client.
fn door_send_frame(cfd): i64 {
    # [D3] Render into a guard-banded buffer with the emit_* helpers bounded
    # to DOOR_FRAME_CAP: the helpers (the bulk of every frame) refuse to write
    # past the cap, the guard band absorbs any raw-store8 tail beyond it, and
    # the send is clamped to the cap below — so a frame that outgrows 8192
    # truncates cleanly instead of overrunning the heap. No frame does today;
    # this enforces the invariant against future row-count growth.
    var buf = cmd_alloc(DOOR_FRAME_CAP + DOOR_FRAME_GUARD);
    g_door_emit_cap = DOOR_FRAME_CAP;
    var n = 0;
    var d = door_desc_for(g_door_game);
    if (d != 0) {
        var fp = load64(d + DD_RENDER);
        if (fp != 0) { n = callptr(fp, g_door_state, buf, DOOR_FRAME_CAP); }
    }
    g_door_emit_cap = DOOR_EMIT_UNBOUNDED;             # [D3] restore the default for non-frame emit users
    if (n > DOOR_FRAME_CAP) { n = DOOR_FRAME_CAP; }    # [D3] clamp any overshoot — never send past the cap
    if (n > 0) { send_buf(cfd, buf, n); }
    return 0;
}

# Feed one input line to the active game. Returns 1 if the game exited.
# Port Authority Universe play wraps the feed in a world transaction so
# trades/claims hit the shared galaxy under the flock (ADR 0010 bite 2).
fn door_feed_line(cfd, line, line_len): i64 {
    if (g_door_mode == DOOR_UNIVERSE) { return door_universe_feed(line, line_len); }
    var d = door_desc_for(g_door_game);
    if (d == 0) { return 1; }
    var fp = load64(d + DD_FEED);
    if (fp == 0) { return 1; }
    return callptr(fp, g_door_state, line, line_len);
}

fn door_is_over(): i64 {
    var d = door_desc_for(g_door_game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_IS_OVER);
    if (fp == 0) { return 0; }          # chatbots (Eliza/Parry): never over
    return callptr(fp, g_door_state);
}

# === 1.2.0 bite 5 — cross-game leaderboards (generalizes the 1.1.0
# Handler standings to all three games) ===
#
# Each game appends "<handle>\t<score>\t<rank>\n" to a shared, flock'd
# per-game file <store>/.games/<game>/leaderboard on a finished run
# (solo OR universe). `scores <game>` reads it back, top-10 by score.

# Build <store>/.games/<game>/leaderboard into out_buf, ensuring dirs.
fn door_leaderboard_path(game, out_buf): i64 {
    var name = door_game_name(game);
    var dir1 = cmd_alloc(PATH_MAX_BYTES);
    var slen = strlen(g_store_buf);
    memcpy(dir1, g_store_buf, slen);
    store8(dir1 + slen, 47);
    memcpy(dir1 + slen + 1, ".games", 6);
    store8(dir1 + slen + 7, 0);
    store_ensure(dir1);

    var dir2 = cmd_alloc(PATH_MAX_BYTES);
    var d1len = strlen(dir1);
    memcpy(dir2, dir1, d1len);
    store8(dir2 + d1len, 47);
    var glen = strlen(name);
    memcpy(dir2 + d1len + 1, name, glen);
    store8(dir2 + d1len + 1 + glen, 0);
    store_ensure(dir2);

    var d2len = strlen(dir2);
    memcpy(out_buf, dir2, d2len);
    store8(out_buf + d2len, 47);
    memcpy(out_buf + d2len + 1, "leaderboard", 11);
    store8(out_buf + d2len + 12, 0);
    return 0;
}

# Format a "<handle>\t<score>\t<rank>\n" line into buf; returns length.
fn door_format_score(handle, score, rank, buf): i64 {
    var pos = 0;
    pos = emit_cstr(buf, pos, handle);
    store8(buf + pos, 9); pos = pos + 1;
    pos = emit_int(buf, pos, score);
    store8(buf + pos, 9); pos = pos + 1;
    pos = emit_cstr(buf, pos, rank);
    store8(buf + pos, 10); pos = pos + 1;
    return pos;
}

# Append the active player's final score for `game` to its leaderboard.
fn door_post_score(game): i64 {
    if ((load8(g_session_handle) & 0xFF) == 0) { return 0; }
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var sfp = load64(d + DD_SCORE);
    if (sfp == 0) { return 0; }              # no leaderboard for this game (chatbots)
    var score = callptr(sfp, g_door_state);
    var rfp = load64(d + DD_RANK);
    var rank = "";
    if (rfp != 0) { rank = callptr(rfp, score); }
    var path = cmd_alloc(PATH_MAX_BYTES);
    door_leaderboard_path(game, path);
    var line = cmd_alloc(256);
    var n = door_format_score(g_session_handle, score, rank, line);
    file_append_locked(path, line, n);
    return 0;
}

# Send the top-10 (by score) of a game's leaderboard to the client.
fn door_render_leaderboard(cfd, game): i64 {
    var path = cmd_alloc(PATH_MAX_BYTES);
    door_leaderboard_path(game, path);
    var cap = 16384;
    var buf = cmd_alloc(cap);
    var total = file_read_all(path, buf, cap);
    send_str(cfd, "== ");
    send_str(cfd, door_game_name(game));
    send_str(cfd, " leaderboard ==\r\n");
    if (total <= 0) { send_str(cfd, "No scores posted yet — finish a run to make the board.\r\n"); return 0; }

    var maxe = 256;
    # 1.6.3 — hoisted out of the ranking loop below (one buffer reused per row
    # instead of one allocation per row).
    var ln = cmd_alloc(320);
    var starts = cmd_alloc(maxe * 8);
    var ends   = cmd_alloc(maxe * 8);
    var scores = cmd_alloc(maxe * 8);
    var count = 0;
    var i = 0;
    var ls = 0;
    while (i <= total) {
        var atend = 0;
        if (i == total) { atend = 1; }
        else { if ((load8(buf + i) & 0xFF) == 10) { atend = 1; } }
        if (atend == 1) {
            if (i > ls) {
                if (count < maxe) {
                    store64(starts + count * 8, ls);
                    store64(ends + count * 8, i);
                    store64(scores + count * 8, lb_line_score(buf, ls, i));
                    count = count + 1;
                }
            }
            ls = i + 1;
        }
        i = i + 1;
    }

    var shown = count;
    if (shown > 10) { shown = 10; }
    var k = 0;
    while (k < shown) {
        var best = k;
        var j = k + 1;
        while (j < count) {
            if (load64(scores + j * 8) > load64(scores + best * 8)) { best = j; }
            j = j + 1;
        }
        var ts = load64(starts + k * 8); store64(starts + k * 8, load64(starts + best * 8)); store64(starts + best * 8, ts);
        var te = load64(ends + k * 8);   store64(ends + k * 8,   load64(ends + best * 8));   store64(ends + best * 8, te);
        var tc = load64(scores + k * 8); store64(scores + k * 8, load64(scores + best * 8)); store64(scores + best * 8, tc);

        var p = 0;
        p = emit_int(ln, p, k + 1);
        store8(ln + p, 41); p = p + 1;    # )
        store8(ln + p, 32); p = p + 1;    # space
        var s2 = load64(starts + k * 8);
        var e2 = load64(ends + k * 8);
        var x = s2;
        while (x < e2) {
            var ch = load8(buf + x) & 0xFF;
            if (ch == 9) { ch = 32; }      # tabs -> spaces for display
            store8(ln + p, ch); p = p + 1;
            x = x + 1;
        }
        store8(ln + p, 13); p = p + 1;
        store8(ln + p, 10); p = p + 1;
        send_buf(cfd, ln, p);
        k = k + 1;
    }
    return 0;
}

# 1.6.3 (ADR 0022) — release the active door state through its descriptor's
# DD_FREE hook and null the global, so the caller cannot double-free and no
# later render can touch dead memory.
#
# Why this exists: door states are the last allocations in agora with a lifetime
# longer than one dispatched line, so the 1.6.2 per-command arena (ADR 0021)
# cannot own them. Under AGORA_SERVE=poll one process serves every session for
# the life of the server, so every state abandoned at `quit` or at disconnect
# stayed allocated forever — the whole difference between the Eliza and QUEST
# rows in the 1.6.2 leak table. Under fork this was invisible: the child exited.
#
# Called from exactly three places, which together cover every way a state is
# dropped: the MODE_DOOR exit in process_rx (`quit`), session_reset (a slot
# being handed to a NEW connection while a game was still open — i.e. the
# player disconnected mid-game), and the `play` launcher before it installs a
# replacement.
fn door_state_free(): i64 {
    if (g_door_state == 0) { g_door_game = GAME_NONE; return 0; }
    var d = door_desc_for(g_door_game);
    if (d != 0) {
        var ffp = load64(d + DD_FREE);
        if (ffp != 0) { var fr = callptr(ffp, g_door_state); }
    }
    g_door_state = 0;
    g_door_game = GAME_NONE;
    return 0;
}

# On leaving a door: persist a solo checkpoint (logged-in, mid-game),
# and post a Handler standing on a finished campaign.
fn door_save_on_exit(cfd): i64 {
    # 1.2.0 Universe: the shared world is already persisted per action;
    # checkpoint the player's own state under the "<game>u" slot.
    if (g_door_mode == DOOR_UNIVERSE) {
        door_universe_save();
    } else { if (g_door_mode == DOOR_SOLO) {
        if ((load8(g_session_fp) & 0xFF) != 0) {
            if (door_is_over() == 0) {
                var d = door_desc_for(g_door_game);
                var n = 0;
                if (d != 0) {
                    var fp = load64(d + DD_SAVE_FMT);
                    if (fp != 0) {
                        var buf = cmd_alloc(DOOR_SAVE_CAP);
                        n = callptr(fp, g_door_state, buf, DOOR_SAVE_CAP);
                        if (n > 0) { door_save_write(g_store_buf, g_session_fp, door_game_name(g_door_game), buf, n); }
                    }
                }
            }
        }
    } }
    # 1.2.0 bite 5: any finished run by a logged-in player posts to the
    # cross-game leaderboard (solo or universe; all three games).
    if (door_is_over() == 1) {
        if ((load8(g_session_handle) & 0xFF) != 0) {
            door_post_score(g_door_game);
        }
    }
    return 0;
}

# Finalize a post-compose flow: write the accumulated body + subject
# into the session's current_board, send the assigned ID (or an error).
#
# M5-F: if `g_reply_to != 0`, this is a reply — use the derived
# subject from `g_reply_subject` (computed by the `reply <id>`
# command) and write a Reply-To header. Reset g_reply_to after the
# commit so the next plain `post` doesn't accidentally reuse the
# previous reply parent.
fn session_finalize_post(cfd, current_board, subject, body, body_len): i64 {
    if (body_len <= 0) {
        send_str(cfd, "(empty post discarded)\r\n");
        g_reply_to = 0;
        return 0;
    }
    # M6-E: From: header derived from the bound session identity.
    # Anonymous session → from_handle / from_fp both 0 → no header.
    var from_handle = 0;
    var from_fp     = 0;
    if (g_session_fp != 0) {
        if ((load8(g_session_fp) & 0xFF) != 0) {
            from_handle = g_session_handle;
            from_fp     = g_session_fp;
        }
    }
    # 0.9.0 ABI (ADR 0008): PostHeaders struct replaces the M6-E
    # 8-arg shape. Construct headers per session state, then post_new.
    var ph = post_headers_new();
    post_headers_set_from(ph, from_handle, from_fp);
    var id = 0 - 1;
    if (g_reply_to > 0) {
        post_headers_set_subject(ph, g_reply_subject);
        post_headers_set_reply_to(ph, g_reply_to);
        id = post_new(g_store_buf, current_board, ph, body, body_len);
    } else {
        post_headers_set_subject(ph, subject);
        id = post_new(g_store_buf, current_board, ph, body, body_len);
    }
    if (id < 0) {
        send_str(cfd, "post failed (storage error)\r\n");
        g_reply_to = 0;
        return 0;
    }
    send_str(cfd, "posted as #");
    var idbuf[24];
    var idlen = fmt_int_buf(id, &idbuf);
    send_buf(cfd, &idbuf, idlen);
    send_str(cfd, "\r\n");
    g_reply_to = 0;
    return 0;
}

# Render the colored MOTD into a caller-allocated buffer. Returns
# the number of bytes written. The AGORA banner is wrapped in cyan
# (SGR 36), the version line in yellow (SGR 33), the prompt line
# uses default fg with a reset terminator.
#
# Buffer must be ≥ 1024 bytes. Rendered length at 0.2.x is ~580 B
# (banner ~470 + SGR overhead ~50 + version + prompt ~60); the
# 1024 ceiling leaves headroom for the next bite's color tweaks
# without re-tuning the alloc.
#
# The AGORA banner art was generated once via `bnrmr "AGORA"`
# (block font, 5×5, bannermanor v1.0.0). The `#` bytes use `\x23`
# escapes to dodge cyrius's line-comment lexer. SGR primitives are
# darshana's `tty_sgr_buf` / `tty_sgr_reset_buf` — the `_buf`
# variants compose into a buffer rather than writing to fd 1, which
# is exactly what we need to send bytes back over the telnet socket.
fn render_motd(buf): i64 {
    var pos = 0;
    # Leading CRLF gives the client a clean line after the IAC announce.
    store8(buf + pos, 13); pos = pos + 1;  # \r
    store8(buf + pos, 10); pos = pos + 1;  # \n

    # Cyan-wrapped 5-line AGORA banner. Each line ends CRLF; the
    # opening SGR sticks for all five lines, closed by reset after
    # line 5. (Some terminals reset SGR on \n — most don't; the
    # explicit close-after-line-5 keeps the spec.)
    pos = tty_sgr_buf(buf, pos, 36);
    pos = motd_emit_cstr(buf, pos, " \x23\x23\x23   \x23\x23\x23\x23  \x23\x23\x23  \x23\x23\x23\x23   \x23\x23\x23 \r\n");
    pos = motd_emit_cstr(buf, pos, "\x23   \x23 \x23     \x23   \x23 \x23   \x23 \x23   \x23\r\n");
    pos = motd_emit_cstr(buf, pos, "\x23\x23\x23\x23\x23 \x23  \x23\x23 \x23   \x23 \x23\x23\x23\x23  \x23\x23\x23\x23\x23\r\n");
    pos = motd_emit_cstr(buf, pos, "\x23   \x23 \x23   \x23 \x23   \x23 \x23  \x23  \x23   \x23\r\n");
    pos = motd_emit_cstr(buf, pos, "\x23   \x23  \x23\x23\x23\x23  \x23\x23\x23  \x23   \x23 \x23   \x23\r\n");
    pos = tty_sgr_reset_buf(buf, pos);

    # Blank line between banner and metadata.
    store8(buf + pos, 13); pos = pos + 1;
    store8(buf + pos, 10); pos = pos + 1;

    # Yellow version line.
    pos = tty_sgr_buf(buf, pos, 33);
    pos = motd_emit_cstr(buf, pos, "  agora 1.6.4 — telnet BBS + door games (casino + Olympiad + Ashes of Empire + Decode) + chat + Eliza/PARRY + QUEST + Jabberwacky + Descent MUD link\r\n");
    pos = tty_sgr_reset_buf(buf, pos);

    # Default-color prompt + closing blank line.
    pos = motd_emit_cstr(buf, pos, "  Type anything; Ctrl+] then 'quit' to exit.\r\n\r\n");

    return pos;
}

# Serve one connection. Sends MOTD + initial prompt, then runs the
# M5-B in-session command interpreter (`list` / `read <id>` / `post`
# / `help` / `quit`) until the peer disconnects or sends `quit`.
#
# Per-byte dispatch: every byte goes through the IAC state machine
# first (M1), then the data byte (when present) drives the line
# buffer and mode-aware handler. We announced WILL ECHO at connect
# (M2-B Q-method), so the server drives the visual display — every
# typed byte gets echoed before processing.
#
# CR / LF handling per telnet NVT (RFC 854): CR is the line
# terminator; the LF that often follows is paired and silently
# absorbed. Lone LF also terminates (raw `nc -e` and similar clients
# send only \n).
# ============================================================================
# 1.6.0 — single-process session-multiplex (poll) serve model.
#
# The classic path (serve_fork on Linux / serial-accept on agnos) serves one
# connection at a time. serve_poll multiplexes N connections in ONE process via a
# pre-allocated session POOL (no per-conn alloc/free): each slot is a heap struct
# snapshotting every per-connection global + a non-blocking tx queue. The operator
# picks the model at runtime with AGORA_SERVE={fork,poll}; agnos has no fork so it
# always polls. Door games / dispatch are untouched (ADR 0009: pure state
# machines) — the loop swaps the active session's deep state into the g_* session
# globals around each dispatch (sess_load/sess_save), so session_execute /
# door_feed_line / chat_* see exactly the globals they always have. The shallow
# parse state (ts/line/mode/…) rides in process_rx's locals, loaded from the slot.
# ============================================================================

enum ServeMode {
    SERVE_FORK = 0;      # classic: fork-per-conn (Linux) / serial-accept (agnos)
    SERVE_POLL = 1;      # single-process poll-multiplex (both platforms)
}
var g_serve_mode  = 0;   # SERVE_FORK default; set from AGORA_SERVE / platform at serve start
var g_active_sess = 0;   # session currently being dispatched (send_buf tx target in poll mode)
var g_sess_pool   = 0;   # alloc(MAX_SESS*8): pre-allocated session slots, reused

enum SessCap {
    MAX_SESS    = 64;         # concurrent connections in poll mode
    SESS_TX_CAP = 131072;     # per-session non-blocking tx queue (>= POST_MAX_BYTES 64K + headers)
}

# Per-session struct offsets. One alloc(SESS_SIZE) block per pool slot, reused
# across connections (session_reset clears it; no free — the pool is fixed-size).
enum SessOff {
    SESS_FD          = 0;    # accepted socket fd (-1 when free)
    SESS_ACTIVE      = 8;    # 1 = slot in use
    SESS_GREETED     = 16;   # 1 = announce+MOTD+first prompt already sent
    SESS_LAST_MS     = 24;   # last-activity wall clock (idle reap)
    SESS_TX          = 32;   # tx queue buffer (SESS_TX_CAP)
    SESS_TX_LEN      = 40;   # bytes queued
    SESS_TX_OFF      = 48;   # bytes already flushed
    # --- shallow per-conn parse/scratch state (process_rx locals) ---
    SESS_TS          = 56;   # telnet parser (telnet_state_new)
    SESS_RXBUF       = 64;   # recv scratch (RECV_BUF_BYTES)
    SESS_LINE        = 72;   # line accumulator (LINE_BUF_CAP)
    SESS_LINE_POS    = 80;
    SESS_POST        = 88;   # post compose buffer (POST_MAX_BYTES)
    SESS_POST_POS    = 96;
    SESS_SUBJECT     = 104;  # subject buffer (SUBJECT_MAX_BYTES+1)
    SESS_SUBJECT_LEN = 112;
    SESS_CURBOARD    = 120;  # current board name (BOARD_NAME_MAX+1)
    SESS_MODE        = 128;  # MODE_*
    SESS_LAST_CR     = 136;
    SESS_QUIT        = 144;  # quit flag ptr (alloc(8); session_execute writes through it)
    # --- deep session globals mirror (sess_load/sess_save swap surface) ---
    SESS_SESSION_FP        = 152;
    SESS_SESSION_HANDLE    = 160;
    SESS_LOGIN_FP          = 168;
    SESS_LOGIN_NONCE       = 176;
    SESS_LOGIN_STARTED_MS  = 184;
    SESS_DOOR_GAME         = 192;
    SESS_DOOR_STATE        = 200;
    SESS_DOOR_MODE         = 208;
    SESS_UNI_WORLD         = 216;
    SESS_CHAT_CHANNEL      = 224;
    SESS_CHAT_SEEN         = 232;
    SESS_CHAT_IDLE         = 240;
    SESS_CHAT_BOT          = 248;
    SESS_ELIZA             = 256;
    SESS_PARRY             = 264;
    SESS_JABBER            = 272;
    SESS_REPLY_TO          = 280;
    SESS_REPLY_SUBJECT     = 288;
    SESS_REPLY_SUBJECT_LEN = 296;
    SESS_CHAT_TICK_MS      = 304;   # poll: wall-clock of the last chat live-tail flush
    SESS_SIZE              = 320;
}

# Build the pool once (at serve_poll start): MAX_SESS slots, each with its per-conn
# buffers allocated ONCE and reused. Slots start free (SESS_ACTIVE=0, fd=-1).
# Allocate one session slot + all its per-connection buffers (reused across
# connections; fd=-1, inactive). Used by both the pool (poll mode) and the
# standalone fork/serial handle_client.
fn session_alloc(): i64 {
    var s = alloc(SESS_SIZE);
    memset(s, 0, SESS_SIZE);
    store64(s + SESS_TS,             telnet_state_new());
    store64(s + SESS_RXBUF,          alloc(RECV_BUF_BYTES));
    store64(s + SESS_LINE,           alloc(LINE_BUF_CAP));
    store64(s + SESS_POST,           alloc(POST_MAX_BYTES));
    store64(s + SESS_SUBJECT,        alloc(SUBJECT_MAX_BYTES + 1));
    store64(s + SESS_CURBOARD,       alloc(BOARD_NAME_MAX + 1));
    store64(s + SESS_SESSION_FP,     alloc(ACCOUNT_FP_BUF_BYTES));
    store64(s + SESS_SESSION_HANDLE, alloc(ACCOUNT_HANDLE_BUF));
    store64(s + SESS_LOGIN_FP,       alloc(ACCOUNT_FP_BUF_BYTES));
    store64(s + SESS_LOGIN_NONCE,    alloc(ACCOUNT_NONCE_BUF_BYTES));
    store64(s + SESS_CHAT_CHANNEL,   alloc(CHAT_CHANNEL_MAX + 1));
    store64(s + SESS_QUIT,           alloc(8));
    store64(s + SESS_TX,             alloc(SESS_TX_CAP));
    # 1.6.2 — pooled, not per-session. Both used to be allocated lazily from a
    # process global (`if (g_uni_world == 0) { g_uni_world = alloc(...) }`).
    # sess_load/sess_save swap those globals per session, so a fresh session
    # always saw 0 and allocated again: an 8 KB + 264 B leak for every session
    # that entered a Universe door or replied to a post — bounded by sessions
    # SERVED, i.e. unbounded over a server's life. Owning them in the slot makes
    # it 64 allocations total, ever (+541 KB once against a ~13 MB image).
    store64(s + SESS_UNI_WORLD,      alloc(DOOR_WORLD_CAP));
    store64(s + SESS_REPLY_SUBJECT,  alloc(SUBJECT_MAX_BYTES + 8));
    store64(s + SESS_FD, 0 - 1);
    return s;
}

fn session_pool_init(): i64 {
    g_sess_pool = alloc(MAX_SESS * 8);
    var i = 0;
    while (i < MAX_SESS) {
        store64(g_sess_pool + i * 8, session_alloc());
        i = i + 1;
    }
    return 0;
}

# Reset a slot's mutable per-connection state for a NEW connection on cfd. Buffers
# are reused (contents reset, not freed). Mirrors handle_client's per-conn init.
fn session_reset(s, cfd): i64 {
    store64(s + SESS_FD, cfd);
    store64(s + SESS_ACTIVE, 1);
    store64(s + SESS_GREETED, 0);
    store64(s + SESS_LAST_MS, clock_now_ms());
    store64(s + SESS_CHAT_TICK_MS, clock_now_ms());
    store64(s + SESS_TX_LEN, 0);
    store64(s + SESS_TX_OFF, 0);
    telnet_state_reset(load64(s + SESS_TS));
    store64(s + SESS_LINE_POS, 0);
    store64(s + SESS_POST_POS, 0);
    store64(s + SESS_SUBJECT_LEN, 0);
    var cb = load64(s + SESS_CURBOARD);
    memcpy(cb, "main", 4);
    store8(cb + 4, 0);
    store64(s + SESS_MODE, MODE_COMMAND);
    store64(s + SESS_LAST_CR, 0);
    store64(load64(s + SESS_QUIT), 0);
    store8(load64(s + SESS_SESSION_FP), 0);
    store8(load64(s + SESS_SESSION_HANDLE), 0);
    store8(load64(s + SESS_LOGIN_FP), 0);
    store8(load64(s + SESS_LOGIN_NONCE), 0);
    store64(s + SESS_LOGIN_STARTED_MS, 0);
    # 1.6.3 — defensive: releasing normally goes through session_release, but a
    # slot must never hand a stale state to its next occupant, and dropping the
    # pointer here without freeing would leak it.
    session_door_free(s);
    store64(s + SESS_DOOR_GAME, GAME_NONE);
    store64(s + SESS_DOOR_STATE, 0);
    store64(s + SESS_DOOR_MODE, DOOR_PRACTICE);
    memset(load64(s + SESS_UNI_WORLD), 0, DOOR_WORLD_CAP);
    store8(load64(s + SESS_CHAT_CHANNEL), 0);
    store64(s + SESS_CHAT_SEEN, 0);
    store64(s + SESS_CHAT_IDLE, 0);
    store64(s + SESS_CHAT_BOT, 0);
    store64(s + SESS_ELIZA, 0);
    store64(s + SESS_PARRY, 0);
    store64(s + SESS_JABBER, 0);
    store64(s + SESS_REPLY_TO, 0);
    store8(load64(s + SESS_REPLY_SUBJECT), 0);
    store64(s + SESS_REPLY_SUBJECT_LEN, 0);
    return 0;
}

# Claim a free slot for cfd; returns the session ptr or 0 if the pool is full.
fn session_acquire(cfd): i64 {
    var i = 0;
    while (i < MAX_SESS) {
        var s = load64(g_sess_pool + i * 8);
        if (load64(s + SESS_ACTIVE) == 0) {
            session_reset(s, cfd);
            return s;
        }
        i = i + 1;
    }
    return 0;
}

# Return a slot to the pool (buffers persist for reuse; transient game/bot allocs
# on the slot are re-initialized by session_reset on the next claim).
# 1.6.3 (ADR 0022) — release a door state held by a SLOT, not by the globals.
# This exists separately from door_state_free() because of the poll model's
# context swap: at release time the g_* globals belong to whichever session was
# last sess_load'ed, which is NOT necessarily this one. Freeing through the
# globals here would free the wrong session's game — so read the state and the
# game id straight out of the slot.
fn session_door_free(s): i64 {
    var ds = load64(s + SESS_DOOR_STATE);
    if (ds != 0) {
        var d = door_desc_for(load64(s + SESS_DOOR_GAME));
        if (d != 0) {
            var ffp = load64(d + DD_FREE);
            if (ffp != 0) { var fr = callptr(ffp, ds); }
        }
    }
    store64(s + SESS_DOOR_STATE, 0);
    store64(s + SESS_DOOR_GAME, GAME_NONE);
    # 1.6.3 — the three chat-couch bot states leak the same way and have the
    # same shape: lazily built by ez_new / py_new / jw_new on first `/eliza`,
    # `/parry` or `/jabberwacky`, held for the session, and previously just
    # nulled at reset. They are freelist-allocated now, so free them here too.
    var ez = load64(s + SESS_ELIZA);
    if (ez != 0) { ez_free(ez); store64(s + SESS_ELIZA, 0); }
    var py = load64(s + SESS_PARRY);
    if (py != 0) { py_free(py); store64(s + SESS_PARRY, 0); }
    var jw = load64(s + SESS_JABBER);
    if (jw != 0) { jw_free(jw); store64(s + SESS_JABBER, 0); }
    if (g_eliza_state == ez)  { g_eliza_state = 0; }
    if (g_parry_state == py)  { g_parry_state = 0; }
    if (g_jabber_state == jw) { g_jabber_state = 0; }
    # The globals may currently mirror THIS slot (the common case: the sweep
    # sess_load'ed it, decided to close it, and is releasing it now). If so they
    # would be left dangling at the freed state, so clear them too.
    if (g_door_state == ds) { g_door_state = 0; g_door_game = GAME_NONE; }
    return 0;
}

fn session_release(s): i64 {
    # 1.6.3 — a player who disconnects mid-game leaves a live door state in the
    # slot. Under fork the child's exit reclaimed it; under poll nothing did.
    session_door_free(s);
    store64(s + SESS_ACTIVE, 0);
    store64(s + SESS_FD, 0 - 1);
    return 0;
}

# Swap the active session's DEEP state into the g_* session globals the dispatch
# functions read (sess_load), and back afterward (sess_save). Shallow parse state
# (ts/line/mode/…) is handled by process_rx via its locals, not here.
fn sess_load(s): i64 {
    g_session_fp        = load64(s + SESS_SESSION_FP);
    g_session_handle    = load64(s + SESS_SESSION_HANDLE);
    g_login_fp          = load64(s + SESS_LOGIN_FP);
    g_login_nonce       = load64(s + SESS_LOGIN_NONCE);
    g_login_started_ms  = load64(s + SESS_LOGIN_STARTED_MS);
    g_door_game         = load64(s + SESS_DOOR_GAME);
    g_door_state        = load64(s + SESS_DOOR_STATE);
    g_door_mode         = load64(s + SESS_DOOR_MODE);
    g_uni_world         = load64(s + SESS_UNI_WORLD);
    g_chat_channel      = load64(s + SESS_CHAT_CHANNEL);
    g_chat_seen         = load64(s + SESS_CHAT_SEEN);
    g_chat_idle         = load64(s + SESS_CHAT_IDLE);
    g_chat_bot          = load64(s + SESS_CHAT_BOT);
    g_eliza_state       = load64(s + SESS_ELIZA);
    g_parry_state       = load64(s + SESS_PARRY);
    g_jabber_state      = load64(s + SESS_JABBER);
    g_reply_to          = load64(s + SESS_REPLY_TO);
    g_reply_subject     = load64(s + SESS_REPLY_SUBJECT);
    g_reply_subject_len = load64(s + SESS_REPLY_SUBJECT_LEN);
    g_active_sess = s;
    return 0;
}

fn sess_save(s): i64 {
    store64(s + SESS_SESSION_FP,        g_session_fp);
    store64(s + SESS_SESSION_HANDLE,    g_session_handle);
    store64(s + SESS_LOGIN_FP,          g_login_fp);
    store64(s + SESS_LOGIN_NONCE,       g_login_nonce);
    store64(s + SESS_LOGIN_STARTED_MS,  g_login_started_ms);
    store64(s + SESS_DOOR_GAME,         g_door_game);
    store64(s + SESS_DOOR_STATE,        g_door_state);
    store64(s + SESS_DOOR_MODE,         g_door_mode);
    store64(s + SESS_UNI_WORLD,         g_uni_world);
    store64(s + SESS_CHAT_CHANNEL,      g_chat_channel);
    store64(s + SESS_CHAT_SEEN,         g_chat_seen);
    store64(s + SESS_CHAT_IDLE,         g_chat_idle);
    store64(s + SESS_CHAT_BOT,          g_chat_bot);
    store64(s + SESS_ELIZA,             g_eliza_state);
    store64(s + SESS_PARRY,             g_parry_state);
    store64(s + SESS_JABBER,            g_jabber_state);
    store64(s + SESS_REPLY_TO,          g_reply_to);
    store64(s + SESS_REPLY_SUBJECT,     g_reply_subject);
    store64(s + SESS_REPLY_SUBJECT_LEN, g_reply_subject_len);
    return 0;
}

# Serve model from AGORA_SERVE ({fork,poll,epoll}). Default: fork on Linux
# (classic/back-compat), poll on agnos (its only concurrent option; no fork).
fn serve_mode_from_env(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var dflt = SERVE_POLL;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var dflt = SERVE_FORK;
    #endif
    var e = getenv("AGORA_SERVE");
    if (e == 0) { return dflt; }
    if (streq(e, "poll") == 1)  { return SERVE_POLL; }
    if (streq(e, "epoll") == 1) { return SERVE_POLL; }
    if (streq(e, "fork") == 1) {
        #ifdef CYRIUS_TARGET_AGNOS
        return SERVE_POLL;   # agnos has no fork; honor "single-process" intent via poll
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        return SERVE_FORK;
        #endif
    }
    return dflt;
}

# --- poll-mode I/O (bites C+D) -------------------------------------------------

# Poll mode: append bytes to session s's tx queue (drained non-blocking by the
# poll loop). Returns 1 (caller closes) if s is missing or the queue would
# overflow — a client not draining its socket fills the queue and gets dropped
# (the poll-mode slow-reader defense; fork mode uses SO_SNDTIMEO instead).
fn sess_tx_enqueue(s, buf, len): i64 {
    if (s == 0) { return 1; }
    var tlen = load64(s + SESS_TX_LEN);
    if (tlen + len > SESS_TX_CAP) { return 1; }
    memcpy(load64(s + SESS_TX) + tlen, buf, len);
    store64(s + SESS_TX_LEN, tlen + len);
    return 0;
}

# Flush session s's tx queue to its socket, NON-BLOCKING. Returns 0 = fully
# drained (queue reset), 1 = partial (kernel buffer full; remainder kept for the
# next sweep), <0 = socket error (caller closes). Mirrors descent's session_drain
# — sys_write is non-blocking on both platforms (agnos socket / Linux O_NONBLOCK).
fn session_drain(s): i64 {
    var tx_len = load64(s + SESS_TX_LEN);
    var tx_off = load64(s + SESS_TX_OFF);
    if (tx_off >= tx_len) {
        store64(s + SESS_TX_LEN, 0);
        store64(s + SESS_TX_OFF, 0);
        return 0;
    }
    var fd = load64(s + SESS_FD);
    var tx = load64(s + SESS_TX);
    var done = 0;
    var rc = 0;
    while (done == 0) {
        if (tx_off >= tx_len) { done = 1; rc = 0; continue; }
        var n = sys_write(fd, tx + tx_off, tx_len - tx_off);
        if (n < 0) {
            if (n == (0 - EWOULDBLOCK_ERR)) { done = 1; rc = 1; continue; }
            done = 1; rc = n; continue;
        }
        if (n == 0) { done = 1; rc = 1; continue; }
        tx_off = tx_off + n;
    }
    if (rc == 0) {
        store64(s + SESS_TX_LEN, 0);
        store64(s + SESS_TX_OFF, 0);
    } else {
        store64(s + SESS_TX_OFF, tx_off);
    }
    return rc;
}

# Read up to RECV_BUF_BYTES into session s's rxbuf WITHOUT blocking. Returns
# n>0 = bytes read, 0 = would-block (no data now), -1 = EOF/error (caller closes).
# agnos: sys_read on a socket fd is the BLOCKING adapter, so use sock_recv#49
# directly (inverted sense: >0 bytes / 0 would-block / -1 EOF). Linux: sys_read on
# the O_NONBLOCK'd fd (-EAGAIN = would-block). The split descent uses.
fn sess_recv_nonblock(s): i64 {
    var fd = load64(s + SESS_FD);
    var rxbuf = load64(s + SESS_RXBUF);
    #ifdef CYRIUS_TARGET_AGNOS
    var conn = _agnos_fd_conn(fd);
    var na = sys_sock_recv(conn, rxbuf, RECV_BUF_BYTES);
    if (na == 0) { return 0; }
    if (na < 0) { return 0 - 1; }
    return na;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = sys_read(fd, rxbuf, RECV_BUF_BYTES);
    if (n > 0) { return n; }
    if (n == 0) { return 0 - 1; }
    if (n == (0 - EWOULDBLOCK_ERR)) { return 0; }
    return 0 - 1;
    #endif
}

enum PollRuntime {
    POLL_MS      = 20;         # sweep cadence
    SESS_IDLE_MS = 60000;      # general idle reap (mirrors RECV_TIMEOUT_SECS)
    CHAT_TICK_MS = 2000;       # chat live-tail flush cadence (CHAT_POLL_SECS)
}

# 1.6.0 single-process poll multiplex: one process serves ALL connections. Each
# sweep drains pending accepts (non-blocking), then services every active slot —
# non-blocking recv → process_rx → non-blocking tx drain — swapping the active
# session's deep globals in/out (sess_load/sess_save) around each. Never blocks on
# any one client. agnos paces with sys_sleep_ms; Linux with the portable sleep_ms
# over O_NONBLOCK sockets (epoll is a later optimization).
fn serve_poll(sfd): i64 {
    session_pool_init();
    if (g_door_registry == 0) { door_registry_init(); }
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(sfd);
    #endif
    var stop = 0;
    while (stop == 0) {
        # 1) drain pending accepts
        var acc = 1;
        while (acc == 1) {
            var ar = sock_accept(sfd);
            if (is_ok(ar) == 0) { acc = 0; }
            else {
                var cfd = result_unwrap(ar);
                #ifndef CYRIUS_TARGET_AGNOS
                sock_set_nonblocking(cfd);
                #endif
                var s = session_acquire(cfd);
                if (s == 0) {
                    # 1.6.2 — was 33, which is the byte count for an ASCII
                    # hyphen. The dash here is an em dash (U+2014, THREE bytes
                    # in UTF-8), so the literal is 35 bytes and the short count
                    # cut off exactly the trailing CRLF: the one message a
                    # client gets when the 64-slot pool is full arrived
                    # unterminated, and its next output ran on from there.
                    # This is also the only socket write in agora that does not
                    # go through send_buf — there is no session to enqueue into
                    # yet — so a send_buf-based audit misses it.
                    sys_write(cfd, "server full — try again shortly\r\n", 35);
                    sock_close(cfd);
                } else {
                    sess_load(s);
                    session_greet(s);
                    var gd = session_drain(s);
                    sess_save(s);
                    if (gd < 0) { sock_close(cfd); session_release(s); }
                }
            }
        }
        # 2) sweep active sessions
        var now = clock_now_ms();
        var i = 0;
        while (i < MAX_SESS) {
            var s = load64(g_sess_pool + i * 8);
            if (load64(s + SESS_ACTIVE) != 0) {
                var cfd = load64(s + SESS_FD);
                sess_load(s);
                var close_it = 0;
                var n = sess_recv_nonblock(s);
                if (n > 0) {
                    # 1.6.4 (audit M3) — the idle timer is NOT refreshed here.
                    #
                    # It used to be, on ANY bytes arriving, which made the 64-slot
                    # pool trivially pinnable: `IAC NOP` (2 bytes) is consumed by
                    # the state machine with no response and no data byte, so 64
                    # connections sending one every 50 s held every slot forever
                    # at ~2 bytes/minute each — invisibly, since nothing was ever
                    # typed. Protocol chatter is not activity. `process_rx` now
                    # refreshes the timer only when a byte actually reaches the
                    # session as DATA, so a keepalive-only connection ages out
                    # like a silent one.
                    g_chat_idle = 0;
                    if (process_rx(s, n) == 1) { close_it = 1; }
                }
                else { if (n < 0) { close_it = 1; }
                else {
                    # would-block: no input this sweep. Chat live-tail tick +
                    # idle reaping (fork mode gets these from the recv timeout).
                    if (load64(s + SESS_MODE) == MODE_CHAT) {
                        if (now - load64(s + SESS_CHAT_TICK_MS) >= CHAT_TICK_MS) {
                            store64(s + SESS_CHAT_TICK_MS, now);
                            if (load64(s + SESS_LINE_POS) == 0) {
                                if (g_chat_bot == 0) { chat_flush_tail(cfd); }
                            }
                            g_chat_idle = g_chat_idle + CHAT_POLL_SECS;
                            if (g_chat_idle >= CHAT_IDLE_SECS) {
                                send_str(cfd, "\r\n(idle — leaving chat)\r\n");
                                close_it = 1;
                            }
                        }
                    } else {
                        if (now - load64(s + SESS_LAST_MS) >= SESS_IDLE_MS) { close_it = 1; }
                    }
                } }
                # 3) flush queued output
                if (close_it == 0) {
                    if (session_drain(s) < 0) { close_it = 1; }
                }
                sess_save(s);
                if (close_it == 1) {
                    session_drain(s);            # best-effort final flush (e.g. "bye")
                    sock_close(cfd);
                    session_release(s);
                }
            }
            i = i + 1;
        }
        # 4) pace the sweep
        #ifdef CYRIUS_TARGET_AGNOS
        sys_sleep_ms(POLL_MS);
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        sleep_ms(POLL_MS);
        #endif
    }
    sock_close(sfd);
    return 0;
}

# Send the connect greeting on session `s`: telnet option salvo, MOTD, first
# prompt. Extracted verbatim from handle_client's entry.
fn session_greet(s): i64 {
    var cfd = load64(s + SESS_FD);
    var ts  = load64(s + SESS_TS);
    # Open with the preferred-options salvo (IAC WILL ECHO / WILL SGA / DO NAWS /
    # DO TERMINAL_TYPE) before any application bytes flow.
    telnet_announce(ts);
    var tx_len_ann = telnet_tx_len(ts);
    if (tx_len_ann > 0) {
        send_buf(cfd, telnet_tx_buf(ts), tx_len_ann);
        telnet_tx_consume(ts);
    }
    # MOTD: operator file (--motd) if present, else the default render.
    if (g_motd_buf != 0) {
        send_buf(cfd, g_motd_buf, g_motd_len);
    } else {
        var motd = cmd_alloc(1024);
        var motd_len = render_motd(motd);
        send_buf(cfd, motd, motd_len);
    }
    send_prompt(cfd, load64(s + SESS_CURBOARD));
    store64(s + SESS_GREETED, 1);
    return 0;
}

# Handle an n<=0 read on session `s`. In MODE_CHAT an EWOULDBLOCK (the short
# CHAT_POLL_SECS timeout) is the live-tail tick, not a disconnect (ADR 0011):
# flush new transcript lines when the input line is empty, bound pure silence by
# CHAT_IDLE_SECS. Returns 1 = close the session, 0 = keep (chat tick). Deep chat
# globals must be sess_load'd by the caller first.
fn session_rx_idle(s, n): i64 {
    var cfd = load64(s + SESS_FD);
    var mode = load64(s + SESS_MODE);
    var line_pos = load64(s + SESS_LINE_POS);
    if (mode == MODE_CHAT) {
        if (n == (0 - EWOULDBLOCK_ERR)) {
            if (line_pos == 0) { if (g_chat_bot == 0) { chat_flush_tail(cfd); } }
            g_chat_idle = g_chat_idle + CHAT_POLL_SECS;
            if (g_chat_idle >= CHAT_IDLE_SECS) {
                send_str(cfd, "\r\n(idle — leaving chat)\r\n");
                return 1;
            }
            return 0;
        }
    }
    return 1;
}

# Process n bytes already sitting in session `s`'s rxbuf: telnet-decode byte by
# byte, accumulate lines, dispatch each complete line by mode. This is the exact
# byte-loop that used to live inline in handle_client — verbatim below. The
# shallow parse state (ts/line/mode/post/subject/board/last_cr/quit) rides in the
# session slot; loaded to locals here and saved back at exit so it survives across
# reads (poll multiplex) or across a blocking loop (fork). The deep session
# globals are swapped by the caller (sess_load/sess_save). Returns 1 iff the
# client asked to quit (quit flag set).
fn process_rx(s, n): i64 {
    var cfd = load64(s + SESS_FD);
    var rxbuf = load64(s + SESS_RXBUF);
    var ts = load64(s + SESS_TS);
    var line = load64(s + SESS_LINE);
    var line_pos = load64(s + SESS_LINE_POS);
    var post = load64(s + SESS_POST);
    var post_pos = load64(s + SESS_POST_POS);
    var subject = load64(s + SESS_SUBJECT);
    var subject_len = load64(s + SESS_SUBJECT_LEN);
    var current_board = load64(s + SESS_CURBOARD);
    var mode = load64(s + SESS_MODE);
    var last_cr = load64(s + SESS_LAST_CR);
    var quit = load64(s + SESS_QUIT);
    var i = 0;
    while (i < n) {
        if (load64(quit) != 0) { i = n; continue; }
        var b = load8(rxbuf + i) & 0xFF;
        var ev = telnet_feed(ts, b);

        # Drain any IAC responses queued by the state machine
        # before processing the data byte — keeps on-wire order
        # matching RFC 854.
        # 1.6.3 (audit) — a failed send here is a DEAD PEER, and ignoring it was
        # an unauthenticated resource-exhaustion path. Fork mode writes with a
        # 60 s SO_SNDTIMEO (SEND_TIMEOUT_SECS): a client that stops reading fills
        # the socket buffer, every `sys_write` parks for the full timeout, and
        # because the return was discarded the loop simply moved to the NEXT
        # byte and parked again — one 4096-byte recv could pin a forked child
        # for hours at zero ongoing attacker cost, and children are unbounded.
        # In poll mode `sess_tx_enqueue` refuses an over-cap write and returns 1
        # WITHOUT copying, so the session went mute-but-open forever, holding a
        # slot: exactly the "slow-reader defense" its own comment claims but did
        # not implement. Setting quit and leaving the loop makes process_rx
        # return 1, which both serve models already turn into a close.
        var tx_len = telnet_tx_len(ts);
        if (tx_len > 0) {
            var txr = send_buf(cfd, telnet_tx_buf(ts), tx_len);
            telnet_tx_consume(ts);
            if (txr != 0) { store64(quit, 1); i = n; continue; }
        }

        if (ev == EV_SB) {
            telnet_handle_sb(ts);
        }

        if (ev == EV_DATA) {
            # 1.6.4 (audit M3) — THIS is what counts as activity: a byte that
            # survived the telnet layer and is destined for the session. Moved
            # here from the poll sweep so protocol-only traffic (IAC NOP, option
            # negotiation, an unterminated subnegotiation) cannot hold a slot.
            # Harmless in fork mode, where the recv timeout bounds idling and
            # SESS_LAST_MS is not consulted.
            store64(s + SESS_LAST_MS, clock_now_ms());
            var db = telnet_data_byte(ts) & 0xFF;
            # M5-H input filter: drop NUL + ESC silently before
            # they reach the line buffer or get echoed back to
            # the client. See input_byte_ok for the reasoning.
            if (input_byte_ok(db) == 0) {
                i = i + 1;
                continue;
            }
            # === EOL detection: CR is canonical; LF after CR is
            # silently absorbed (consumed-here, NOT passed on to
            # the printable-byte branch — would otherwise land at
            # line[0] and corrupt the next command); lone LF also
            # terminates (Unix clients). `eol == 1` means current
            # byte completed a line; `consumed == 1` means current
            # byte is the paired LF after CR — drop it entirely.
            var eol = 0;
            var consumed = 0;
            if (db == 13) { eol = 1; last_cr = 1; }
            else { if (db == 10) {
                if (last_cr != 0) { last_cr = 0; consumed = 1; }
                else              { eol = 1; }
            } else { last_cr = 0; } }

            if (consumed != 0) {
                i = i + 1;
                continue;
            }

            if (eol != 0) {
                send_str(cfd, "\r\n");
                # 1.6.2 — reclaim the per-command scratch arena. This is the one
                # point that dominates EVERY line dispatch below (command, door,
                # chat, login, posting) in BOTH serve models, since the fork
                # worker drives process_rx too. See cmd_alloc's header.
                cmd_scratch_reset();
                # Mode-aware line dispatch.
                if (mode == MODE_COMMAND) {
                    mode = session_execute(cfd, line, line_pos, current_board, quit);
                    line_pos = 0;
                    if (mode == MODE_COMMAND) {
                        if (load64(quit) == 0) { send_prompt(cfd, current_board); }
                    }
                }
                else { if (mode == MODE_LOGIN_AWAIT_SIG) {
                    # M6-C: client sent `auth: <128-hex-sig>`.
                    # Parse + verify against the parked challenge.
                    # Heap-allocated buffers via alloc() — matches the
                    # pattern other handle_client paths use for
                    # session-scoped working memory (rxbuf / line /
                    # post / subject above), and avoids the
                    # cyrius `var buf[N]`-in-deep-nesting hazards
                    # flagged in CLAUDE.md.
                    #
                    # 0.7.0 audit M6 — explicit 30 s deadline. Even
                    # if the wire stayed warm (slowloris timeout
                    # never tripped), a parked challenge older than
                    # LOGIN_DEADLINE_MS is stale and must be rejected
                    # before any signature work happens.
                    if (g_login_started_ms > 0) {
                        if (clock_now_ms() - g_login_started_ms > LOGIN_DEADLINE_MS) {
                            send_str(cfd, "login failed (challenge timed out — retry 'login <handle>')\r\n");
                            store8(g_login_fp, 0);
                            store8(g_login_nonce, 0);
                            g_login_started_ms = 0;
                            line_pos = 0;
                            mode = MODE_COMMAND;
                            send_prompt(cfd, current_board);
                            i = i + 1; continue;
                        }
                    }
                    var sig_raw = cmd_alloc(ACCOUNT_SIG_BYTES);
                    var sig_len = parse_auth_sig(line, line_pos, sig_raw);
                    line_pos = 0;
                    if (sig_len != ACCOUNT_SIG_BYTES) {
                        send_str(cfd, "login failed (malformed auth)\r\n");
                        store8(g_login_fp, 0);
                        store8(g_login_nonce, 0);
                        mode = MODE_COMMAND;
                        send_prompt(cfd, current_board);
                        i = i + 1; continue;
                    }
                    var pk_buf = cmd_alloc(ACCOUNT_PK_BYTES);
                    if (account_lookup_pubkey(g_store_buf, g_login_fp, pk_buf) != 0) {
                        send_str(cfd, "login failed (pubkey lookup)\r\n");
                        store8(g_login_fp, 0);
                        store8(g_login_nonce, 0);
                        mode = MODE_COMMAND;
                        send_prompt(cfd, current_board);
                        i = i + 1; continue;
                    }
                    # Build challenge message = "agora-login:" + nonce_hex.
                    var verify_msg = cmd_alloc(LOGIN_MSG_LEN);
                    format_challenge_msg(g_login_nonce, verify_msg);
                    var ok = ed25519_verify(pk_buf, verify_msg, LOGIN_MSG_LEN, sig_raw);
                    # Single-use nonce: clear regardless of pass / fail.
                    store8(g_login_nonce, 0);
                    if (ok != 1) {
                        send_str(cfd, "login failed (signature)\r\n");
                        store8(g_login_fp, 0);
                        mode = MODE_COMMAND;
                        send_prompt(cfd, current_board);
                        i = i + 1; continue;
                    }
                    # Bind session. Copy g_login_fp → g_session_fp
                    # then resolve the handle from the bound fp.
                    memcpy(g_session_fp, g_login_fp, ACCOUNT_FP_BUF_BYTES);
                    store8(g_login_fp, 0);
                    var hlen = account_lookup_handle(g_store_buf, g_session_fp, g_session_handle, ACCOUNT_HANDLE_BUF);
                    if (hlen <= 0) { store8(g_session_handle, 0); }
                    send_str(cfd, "welcome, ");
                    if (hlen > 0) { send_buf(cfd, g_session_handle, hlen); }
                    else          { send_str(cfd, "(no handle)"); }
                    send_str(cfd, "\r\n");
                    mode = MODE_COMMAND;
                    send_prompt(cfd, current_board);
                    i = i + 1; continue;
                }
                else { if (mode == MODE_DOOR) {
                    # 1.1.0: route the completed line to the active
                    # game. ctrl==1 means the game exited → save +
                    # back to the BBS prompt; else paint the next frame.
                    var dctrl = door_feed_line(cfd, line, line_pos);
                    line_pos = 0;
                    if (dctrl == 1) {
                        door_save_on_exit(cfd);
                        # 1.6.3 — save FIRST (it reads the state), then release.
                        door_state_free();
                        mode = MODE_COMMAND;
                        send_prompt(cfd, current_board);
                    } else {
                        door_send_frame(cfd);
                    }
                    i = i + 1; continue;
                }
                else { if (mode == MODE_CHAT) {
                    # 1.3.0 (ADR 0011): a completed line in chat is
                    # either a '/'-command or a message said to the room.
                    var clen = line_pos;
                    line_pos = 0;
                    var handled = 0;
                    if (clen > 0) {
                        if ((load8(line) & 0xFF) == 47) {     # leading '/'
                            handled = 1;
                            var cc = chat_cmd_dispatch(cfd, line, clen);
                            if (cc == 1) {
                                # /leave — restore the command-mode recv
                                # timeout, drop the channel, back to BBS.
                                sock_set_recv_timeout(cfd, RECV_TIMEOUT_SECS, 0);
                                store8(g_chat_channel, 0);
                                g_chat_seen = 0;
                                g_chat_bot = 0;
                                mode = MODE_COMMAND;
                                send_prompt(cfd, current_board);
                            }
                            if (cc == 2) { store64(quit, 1); }
                        }
                    }
                    if (handled == 0) {
                        if (g_chat_bot != 0) {
                            # On the couch: this line goes only to the
                            # active bot, never to the room. 'bye'
                            # returns the user to the channel.
                            if (clen > 0) {
                                var bs = chat_bot_state();
                                var bctrl = chat_bot_feed(line, clen);
                                send_str(cfd, chat_bot_name());
                                send_buf(cfd, load64(bs + EZ_RESP), load64(bs + EZ_RESPLEN));
                                send_str(cfd, "\r\n");
                                if (bctrl == 1) {
                                    g_chat_bot = 0;
                                    send_str(cfd, "(back in #");
                                    send_str(cfd, g_chat_channel);
                                    send_str(cfd, ")\r\n");
                                }
                            }
                        } else {
                            # Ordinary line → sanitise + say to the room,
                            # then flush so the speaker sees the canonical
                            # "<handle> text" line (and any interleaved ones).
                            if (clen > 0) {
                                var tbuf = cmd_alloc(CHAT_MSG_MAX + 1);
                                var tlen = chat_text_sanitize(line, clen, tbuf, CHAT_MSG_MAX);
                                if (tlen > 0) {
                                    chat_say(g_store_buf, g_chat_channel, g_session_handle, tbuf, tlen);
                                }
                            }
                            chat_flush_tail(cfd);
                        }
                    }
                    i = i + 1; continue;
                }
                else { if (mode == MODE_POSTING_SUBJECT) {
                    # M5-D: capture the typed Subject line, then
                    # transition into MODE_POSTING for the body.
                    subject_len = line_pos;
                    if (subject_len > SUBJECT_MAX_BYTES) {
                        subject_len = SUBJECT_MAX_BYTES;
                    }
                    if (subject_len > 0) {
                        memcpy(subject, line, subject_len);
                    }
                    store8(subject + subject_len, 0);
                    line_pos = 0;
                    send_str(cfd, "Compose post. End with '.' on a line by itself.\r\n");
                    mode = MODE_POSTING;
                }
                else {
                    # MODE_POSTING: '.' alone ends + commits.
                    if (line_pos == 1) {
                        if ((load8(line) & 0xFF) == 46) {
                            session_finalize_post(cfd, current_board, subject, post, post_pos);
                            post_pos = 0;
                            subject_len = 0;
                            store8(subject, 0);
                            line_pos = 0;
                            mode = MODE_COMMAND;
                            send_prompt(cfd, current_board);
                            i = i + 1; continue;
                        }
                    }
                    # Otherwise append line + CRLF to post body.
                    if (post_pos + line_pos + 2 < POST_MAX_BYTES) {
                        memcpy(post + post_pos, line, line_pos);
                        post_pos = post_pos + line_pos;
                        store8(post + post_pos, 13); post_pos = post_pos + 1;
                        store8(post + post_pos, 10); post_pos = post_pos + 1;
                    }
                    line_pos = 0;
                } } } } }
} else {
                # === Printable byte: echo + append to line ===
                if (line_pos < LINE_BUF_CAP - 1) {
                    store8(line + line_pos, db);
                    line_pos = line_pos + 1;
                    # 1.6.3 (audit) — same as the IAC drain above: the echo is
                    # the other per-byte write, so a discarded failure here has
                    # the same unbounded shape.
                    if (echo_byte(cfd, db) != 0) { store64(quit, 1); i = n; continue; }
                }
            }
        }
        i = i + 1;
    }
    store64(s + SESS_LINE_POS, line_pos);
    store64(s + SESS_POST_POS, post_pos);
    store64(s + SESS_SUBJECT_LEN, subject_len);
    store64(s + SESS_MODE, mode);
    store64(s + SESS_LAST_CR, last_cr);
    if (load64(quit) != 0) { return 1; }
    return 0;
}

# Classic serve path: serve ONE connection to completion in THIS process — a fork
# child on Linux, or serially on agnos. Uses a standalone session slot; the deep
# session globals ARE this connection (sess_load restores them from the slot each
# iteration, sess_save persists them, so process_rx / session_greet see exactly
# the globals the dispatch functions expect).
fn handle_client(cfd): i64 {
    # Slowloris defense: bound how long a quiet client can pin this worker. recv()
    # returns EWOULDBLOCK after the timeout (a clean disconnect, except the chat
    # live-tail tick); send() likewise can't park on a peer that stops draining.
    sock_set_recv_timeout(cfd, RECV_TIMEOUT_SECS, 0);
    sock_set_send_timeout(cfd, SEND_TIMEOUT_SECS, 0);
    if (g_door_registry == 0) { door_registry_init(); }

    var s = session_alloc();
    session_reset(s, cfd);
    sess_load(s);
    session_greet(s);
    sess_save(s);

    var done = 0;
    while (done == 0) {
        sess_load(s);
        var n = sys_read(cfd, load64(s + SESS_RXBUF), RECV_BUF_BYTES);
        if (n <= 0) {
            done = session_rx_idle(s, n);
        } else {
            g_chat_idle = 0;
            done = process_rx(s, n);
        }
        sess_save(s);
    }
    sock_close(cfd);
    return 0;
}

# Spin up the listener and run the accept loop. Returns 0 if the
# loop exits cleanly (signal — not yet wired), 1 on bind/listen
# failure.
fn cmd_serve_on(port): i64 {
    println("agora serve: opening telnet listener");

    # 1.6.2 — ignore SIGPIPE before a single byte can be written.
    #
    # Every byte agora sends leaves through a flagsless `sys_write` (send_buf's
    # fork branch at :244, session_drain's poll branch at :2103, and the Descent
    # proxy). A peer that closes mid-write makes the kernel raise SIGPIPE, whose
    # DEFAULT disposition terminates the process — no error return, no cleanup.
    # Under fork that cost one child; under the 1.6.0 poll multiplex it costs the
    # whole 64-session server, and poll is the ONLY model on agnos (no fork). That
    # is an unauthenticated remote kill from a client that just disconnects rudely.
    #
    # SIG_IGN converts it into an EPIPE (-32) return, which BOTH write paths
    # already treat correctly as "close this connection": send_buf returns 1 on
    # any `n <= 0` (the 1.4.4 T1 fix) and session_drain returns the negative errno,
    # which its callers test with `< 0` (:2224). EWOULDBLOCK keeps its own arm, so
    # a slow reader still just retries next sweep.
    #
    # Placed here — before the model dispatch — so it dominates every serve path:
    # poll, the fork parent (and its children, which inherit the disposition
    # across fork), and the agnos serial loop. ADR 0007 rejected `sigaction`
    # because of the rt_sigaction `sa_restorer` trampoline; cyrius 6.4.51's
    # `signal_ignore` builds the 32-byte SIG_IGN act itself and needs no
    # trampoline, so that objection no longer applies. It is a no-op on agnos
    # (ring-3 has no signal delivery) and on Windows, so the call is portable.
    # The return is deliberately unchecked: a failure leaves the default
    # disposition, i.e. exactly today's behavior, and there is nothing better to
    # do about it than serve anyway.
    signal_ignore(SIGPIPE);

    var sr = tcp_socket();
    if (is_ok(sr) == 0) {
        println("agora serve: tcp_socket() failed");
        return 1;
    }
    var sfd = result_unwrap(sr);

    sock_reuse(sfd);

    var br = sock_bind(sfd, INADDR_ANY(), port);
    if (is_ok(br) == 0) {
        println("agora serve: sock_bind() failed");
        sock_close(sfd);
        return 1;
    }

    var lr = sock_listen(sfd, LISTEN_BACKLOG);
    if (is_ok(lr) == 0) {
        println("agora serve: sock_listen() failed");
        sock_close(sfd);
        return 1;
    }

    println("agora serve: listening (port printed below)");
    print_num(port);
    println("");
    println("agora serve: waiting for connections (Ctrl+C to exit)");

    # 1.6.0: pick the serve model. agnos always polls (no fork); Linux honors
    # AGORA_SERVE ({fork,poll}), default fork (classic per-connection isolation).
    g_serve_mode = serve_mode_from_env();
    if (g_serve_mode == SERVE_POLL) {
        println("agora serve: model = poll (single-process multiplex)");
        return serve_poll(sfd);
    }
    println("agora serve: model = fork (classic per-connection)");

    var stop = 0;
    while (stop == 0) {
        #ifndef CYRIUS_TARGET_AGNOS
        # ADR 0007: drain any zombies that accumulated since the last
        # accept. Non-blocking — exits the loop immediately when no
        # zombies are ready. Without this the process table fills as
        # children exit and the kernel keeps their exit-status entries
        # around indefinitely. (Fork model only; agnos serves serially,
        # so there are no children to reap — and agnos has no WNOHANG.)
        var reap = 1;
        while (reap == 1) {
            var rpid = sys_waitpid(0 - 1, 0, WNOHANG);
            if (rpid <= 0) { reap = 0; }
        }
        #endif

        var ar = sock_accept(sfd);
        if (is_ok(ar) == 0) {
            # Transient accept errors should not kill the loop;
            # bail only on signal handling which we don't have yet.
            continue;
        }
        var cfd = result_unwrap(ar);

        #ifdef CYRIUS_TARGET_AGNOS
        # agnos has NO fork — its process model is spawn#3 (from an in-memory
        # ELF, which can't inherit the accepted socket fd) + a blocking per-pid
        # waitpid#4. So serve SERIALLY: handle this connection to completion in
        # THIS process, then loop for the next. Session globals are reused
        # across connections (handle_client re-inits per-conn state on entry).
        # Concurrency (a single-process epoll event loop — descent's model)
        # is the follow-up; this makes agora run under mirshi / on agnos today.
        handle_client(cfd);
        sock_close(cfd);
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        # ADR 0007: fork-per-accept. Each connection becomes its own
        # process; the kernel handles per-conn memory cleanup at child
        # exit (closes audit M1) and globals are per-process (closes
        # audit M2). Parent immediately closes the accepted cfd —
        # the child has its own fd via fork — and loops back to
        # accept the next connection.
        var pid = sys_fork();
        if (pid == 0) {
            # Child: drop the listening fd we inherited (a child crash
            # shouldn't leak the listener), serve the client, exit.
            sock_close(sfd);
            handle_client(cfd);
            sys_exit(0);
        }
        if (pid < 0) {
            # Fork failed (likely RLIMIT_NPROC). Close the cfd so
            # the client gets EOF, log to stderr, keep serving.
            sock_close(cfd);
            syscall(1, 2, "agora serve: fork failed (resource exhaustion?); connection dropped\n", 68);
            continue;
        }
        # Parent: child owns cfd now via fork; we drop our copy.
        sock_close(cfd);
        #endif
    }

    sock_close(sfd);
    return 0;
}

# Load an operator-supplied MOTD file into the g_motd_* globals.
# Returns 0 on success, non-zero on any I/O error (with a stderr
# warning + fallback to the default render_motd path). The
# allocation lives for the process lifetime — set-once-at-startup;
# no per-connection re-read.
fn load_motd_file(path): i64 {
    var buf = alloc(MOTD_FILE_CAP);
    var n = file_read_all(path, buf, MOTD_FILE_CAP);
    if (n < 0) {
        println("agora serve: --motd path could not be read; using default MOTD");
        return 1;
    }
    if (n == 0) {
        println("agora serve: --motd file is empty; using default MOTD");
        return 1;
    }
    g_motd_buf = buf;
    g_motd_len = n;
    return 0;
}

fn cmd_serve(): i64 {
    args_init();
    var n = argc();
    var port = DEFAULT_PORT;

    # Argv scan. Order-insensitive: a positive-integer positional
    # is taken as the port; --motd consumes the next arg as an MOTD
    # path; --store consumes the next arg as the post-storage root
    # used by the in-session command interpreter (M5-B).
    var i = 2;
    var go = 1;
    while (i < n) {
        if (go == 0) { continue; }
        var arg = argv(i);
        if (streq(arg, "--motd") != 0) {
            if (i + 1 >= n) {
                println("agora serve: --motd requires a path argument");
                go = 0;
                continue;
            }
            load_motd_file(argv(i + 1));
            i = i + 2;
            continue;
        }
        if (streq(arg, "--store") != 0) {
            if (i + 1 >= n) {
                println("agora serve: --store requires a path argument");
                go = 0;
                continue;
            }
            g_store_buf = argv(i + 1);
            i = i + 2;
            continue;
        }
        var p = atoi(arg);
        if (p > 0) { port = p; }
        i = i + 1;
    }
    if (go == 0) { return 2; }

    return cmd_serve_on(port);
}

# Default post-storage root, used by cmd_post / cmd_list / cmd_read
# when --store is not passed. Cwd-relative per ADR 0002.
var DEFAULT_STORE = "./agora-data";
var DEFAULT_BOARD = "main";

# Walk argv looking for --store <path>. Returns the path cstring if
# found, else the supplied default.
fn parse_store(default_store): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--store") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return default_store;
        }
        i = i + 1;
    }
    return default_store;
}

# Walk argv looking for --board <name>. Returns the name cstring if
# found, else "main". M5-E: every CLI verb routes through this.
fn parse_board(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--board") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return DEFAULT_BOARD;
        }
        i = i + 1;
    }
    return DEFAULT_BOARD;
}

# Walk argv looking for the first non-flag positional after the verb.
# Skips any `--<flag> <value>` pair (so all our two-arg flags —
# `--store`, `--board`, `--subject`, `--motd`, `--reply-to`,
# `--key`, `--handle`, `--as` — don't shadow the positional).
# Returns 0 if no positional found.
fn first_positional_after_verb(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        # Two-char flag prefix '--'? skip arg + value.
        if (strlen(arg) >= 2) {
            if ((load8(arg) & 0xFF) == 45) {        # '-'
                if ((load8(arg + 1) & 0xFF) == 45) { # '--'
                    i = i + 2;
                    continue;
                }
            }
        }
        return arg;
    }
    return 0;
}

# k-th non-flag positional after the verb (0-based), skipping
# `--flag value` pairs. Returns 0 if absent. Used by the worldbench /
# worldread diagnostic verbs that take two positionals (game + count).
fn nth_positional(k): i64 {
    args_init();
    var n = argc();
    var i = 2;
    var seen = 0;
    var result = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= n) { scanning = 0; continue; }
        var arg = argv(i);
        var is_flag = 0;
        if (strlen(arg) >= 2) {
            if ((load8(arg) & 0xFF) == 45) {
                if ((load8(arg + 1) & 0xFF) == 45) { is_flag = 1; }
            }
        }
        if (is_flag == 1) { i = i + 2; continue; }
        if (seen == k) { result = arg; scanning = 0; continue; }
        seen = seen + 1;
        i = i + 1;
    }
    return result;
}

# === 1.2.0 world-framework diagnostics (ADR 0010 § Phasing bite 1) ===
#
# `agora worldbench <game> <count> [--store X]` runs `count` flock'd
# world transactions (+1 each). `agora worldread <game> [--store X]`
# prints the world counter. Run many `worldbench` processes against one
# store concurrently, then `worldread` — a correct framework yields
# exactly (procs × count) with no lost updates (see 08-world-concurrency.sh).
fn cmd_worldbench(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var game = nth_positional(0);
    if (game == 0) { println("usage: agora worldbench <game> <count> [--store X]"); return 1; }
    var count_s = nth_positional(1);
    var count = 0;
    if (count_s != 0) { count = atoi(count_s); }
    var i = 0;
    while (i < count) {
        world_txn_add(store, game, 1);
        i = i + 1;
    }
    println("worldbench done");
    return 0;
}

fn cmd_worldread(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var game = nth_positional(0);
    if (game == 0) { println("usage: agora worldread <game> [--store X]"); return 1; }
    var buf = alloc(8);
    var n = world_read(store, game, buf, 8);
    var v = 0;
    if (n == 8) { v = load64(buf); }
    fmt_int(v);
    println("");
    return 0;
}

fn parse_subject_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--subject") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# M5-F: walk argv looking for --reply-to <id>. Returns the parsed
# parent ID (positive integer), or 0 if absent / unparseable.
fn parse_reply_to_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--reply-to") != 0) {
            if (i + 1 < n) {
                var v = atoi(argv(i + 1));
                if (v > 0) { return v; }
                return 0;
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# M6-E: --as <handle> for CLI-side authored posts. When given, the
# CLI loads the keyfile (default ~/.agora/key, override --key),
# derives the fingerprint, and validates that the handle is registered
# to that fingerprint in the store. Anonymous posts (default — no
# --as) keep the 0.5.x shape (no From header).
fn parse_as_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--as") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# `agora post [--subject "..."] [--as <handle>] [--key <path>]` —
# read stdin → write a new post → print assigned ID. Up to
# POST_MAX_BYTES (64 KB) of body. With --as, the post lands with a
# `From: <handle> <fp16>` header; without, it's anonymous.
fn cmd_post(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var board = parse_board();
    var subject = parse_subject_flag();
    # 0.7.0 audit H1 — reject CR/LF/NUL/ESC/other C0 in --subject.
    # The CLI is operator-trusted, but stored posts persist with
    # forged headers if injection is allowed (post_reply_to / post_from
    # would parse the injected lines as real headers on every later
    # read). Cheap to validate at entry; expensive to clean up at the
    # store layer after the fact.
    if (subject != 0) {
        if (header_text_cstr_ok(subject) == 0) {
            println("agora post: --subject contains control bytes (CR/LF/NUL/ESC or other C0 — not allowed in header values)");
            return 2;
        }
    }
    var reply_to = parse_reply_to_flag();
    # M6-E: resolve identity. --as alone is insufficient — we need
    # the matching key to prove ownership of the handle.
    var as_handle = parse_as_flag();
    var from_handle = 0;
    var from_fp     = 0;
    if (as_handle != 0) {
        if (handle_valid(as_handle) == 0) {
            println("agora post: invalid --as handle");
            return 2;
        }
        var key_path = parse_key_flag(default_key_path());
        var fp_buf = alloc(ACCOUNT_FP_BUF_BYTES);
        if (keyfile_to_fingerprint(key_path, fp_buf) != 0) {
            println("agora post: --as requires a keyfile (run 'agora keygen' or pass --key <path>)");
            return 1;
        }
        # Verify handle ↔ key binding via the store registry.
        var resolved_fp = alloc(ACCOUNT_FP_BUF_BYTES);
        if (account_resolve_handle(store, as_handle, resolved_fp) != 1) {
            println("agora post: --as handle is not registered in this store");
            return 1;
        }
        if (streq(fp_buf, resolved_fp) == 0) {
            println("agora post: --as handle is registered to a different keyfile");
            return 1;
        }
        from_handle = as_handle;
        from_fp     = fp_buf;
    }
    # M5-E: validate the board name unless it's the default "main".
    #
    # 1.6.4 (audit M5) — this MOVED above the policy check below. `board_can_post`
    # assembles `<store>/<board>/.policy` and `.admins` and reads them, so with
    # the old ordering `--board ../../../../etc` reached the filesystem before
    # anything checked the name: the 0.7.0 audit fixed exactly this ordering for
    # `list` and `read`, and `post` had quietly re-opened it. Nothing between the
    # two depends on the policy result, so validating first is a pure reorder.
    if (streq(board, "main") == 0) {
        if (board_name_valid(board) == 0) {
            println("agora post: invalid --board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')");
            return 2;
        }
    }
    # M6-F: per-board policy check. Anonymous CLI posts (no --as)
    # still need to pass policy — `open` admits them, `known` and
    # `admin` reject. (Anonymous CLI posts at the open default are
    # the 0.5.x shape; tightening the operator surface is what
    # policy is for.)
    if (board_can_post(store, board, from_fp, from_handle) == 0) {
        if (from_fp == 0) {
            println("agora post: board policy requires authentication (rerun with --as <handle> --key <path>)");
        } else {
            println("agora post: board policy denies this post (admin-only or unregistered)");
        }
        return 1;
    }
    # M5-F: if --reply-to was given without --subject, auto-derive
    # `Re: <parent-subject>` so the CLI matches the wire-side reply
    # flow. Subject explicitly passed via --subject wins over the
    # derived one (operator can still override).
    if (reply_to > 0) {
        if (subject == 0) {
            var pfbuf = alloc(POST_MAX_BYTES + 1024);
            var pflen = post_read(store, board, reply_to, pfbuf, POST_MAX_BYTES + 1024);
            if (pflen > 0) {
                var psub = alloc(SUBJECT_MAX_BYTES);
                var pslen = post_subject(pfbuf, pflen, psub, SUBJECT_MAX_BYTES);
                var dsub = alloc(SUBJECT_MAX_BYTES + 8);
                subject_reply_prefix(psub, pslen, dsub, SUBJECT_MAX_BYTES + 8);
                subject = dsub;
            }
        }
    }
    var body = alloc(POST_MAX_BYTES);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(STDIN, body + total, POST_MAX_BYTES - total);
        if (n <= 0) { rgo = 0; continue; }
        total = total + n;
        if (total >= POST_MAX_BYTES) { rgo = 0; }
    }
    if (total <= 0) {
        println("agora post: no input on stdin (pipe in post body)");
        return 1;
    }
    # 0.9.0 ABI (ADR 0008): PostHeaders struct.
    var ph = post_headers_new();
    post_headers_set_subject(ph, subject);
    if (reply_to > 0) { post_headers_set_reply_to(ph, reply_to); }
    if (from_handle != 0) { post_headers_set_from(ph, from_handle, from_fp); }
    var id = post_new(store, board, ph, body, total);
    if (id < 0) {
        println("agora post: failed to write post");
        return 1;
    }
    print_num(id);
    println("");
    return 0;
}

# `agora list` — print `<id>  <subject>` per post in the chosen board
# (default "main"). Subject is empty for headerless / no-Subject posts.
fn cmd_list(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var board = parse_board();
    # 0.7.0 audit H2 — validate --board to prevent path-traversal
    # (`--board "../../etc"` would resolve via board_path into the
    # parent of <store>). cmd_post already does this; cmd_list/cmd_read
    # missed it. Operator-side surface today; remote-disclosure surface
    # once any tool scripts agora against an untrusted board source.
    if (streq(board, "main") == 0) {
        if (board_name_valid(board) == 0) {
            println("agora list: invalid --board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')");
            return 2;
        }
    }
    var ids = alloc(DIRENT_ID_MAX * 8);
    var count = post_list(store, board, ids, DIRENT_ID_MAX);
    if (count == 0) {
        println("agora list: no posts");
        return 0;
    }
    var fbuf = alloc(POST_MAX_BYTES + 1024);
    var sbuf = alloc(SUBJECT_MAX_BYTES);
    var hbuf = alloc(ACCOUNT_HANDLE_BUF);
    var fpbuf = alloc(ACCOUNT_FP_BUF_BYTES);
    var i = 0;
    while (i < count) {
        var id = load64(ids + i * 8);
        print_num(id);
        sys_write(1, "  ", 2);
        var flen = post_read(store, board, id, fbuf, POST_MAX_BYTES + 1024);
        # M6-E: `[<handle>]` or `[anon]` before the subject.
        sys_write(1, "[", 1);
        if (flen > 0) {
            if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
                sys_write(1, hbuf, strlen(hbuf));
            } else {
                sys_write(1, "anon", 4);
            }
        } else {
            sys_write(1, "anon", 4);
        }
        sys_write(1, "]  ", 3);
        if (flen > 0) {
            var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
            if (slen > 0) { sys_write(1, sbuf, slen); }
        }
        println("");
        i = i + 1;
    }
    return 0;
}

# `agora read <id>` — print one post body to stdout. Subject is
# shown as a one-line prefix; headerless legacy posts skip the prefix.
fn cmd_read(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var board = parse_board();
    # 0.7.0 audit H2 — see cmd_list for rationale.
    if (streq(board, "main") == 0) {
        if (board_name_valid(board) == 0) {
            println("agora read: invalid --board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')");
            return 2;
        }
    }
    var id_arg = first_positional_after_verb();
    if (id_arg == 0) {
        println("agora read: missing post ID");
        return 2;
    }
    var id = atoi(id_arg);
    if (id <= 0) {
        println("agora read: invalid post ID");
        return 2;
    }
    var fbuf = alloc(POST_MAX_BYTES + 1024);
    var flen = post_read(store, board, id, fbuf, POST_MAX_BYTES + 1024);
    if (flen <= 0) {
        println("agora read: post not found");
        return 1;
    }
    var sbuf = alloc(SUBJECT_MAX_BYTES);
    var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
    # M6-E: `From: <handle> <fp16>` (or "From: anonymous") preface.
    var hbuf = alloc(ACCOUNT_HANDLE_BUF);
    var fpbuf = alloc(ACCOUNT_FP_BUF_BYTES);
    sys_write(1, "From: ", 6);
    if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
        sys_write(1, hbuf, strlen(hbuf));
        sys_write(1, " ", 1);
        sys_write(1, fpbuf, strlen(fpbuf));
        sys_write(1, "\n", 1);
    } else {
        sys_write(1, "anonymous\n", 10);
    }
    if (slen > 0) {
        sys_write(1, "Subject: ", 9);
        sys_write(1, sbuf, slen);
        sys_write(1, "\n", 1);
    }
    sys_write(1, "\n", 1);
    var body_off = post_body_offset(fbuf, flen);
    var body_len = flen - body_off;
    if (body_len > 0) {
        sys_write(1, fbuf + body_off, body_len);
    }
    return 0;
}

# M6-D CLI helpers. parse_key_flag / parse_handle_flag mirror the
# parse_store / parse_subject_flag shape.
fn parse_key_flag(default_path): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--key") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return default_path;
        }
        i = i + 1;
    }
    return default_path;
}

fn parse_handle_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--handle") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# Default keyfile path: `$HOME/.agora/key` if HOME is set, else
# `./agora.key` in cwd. ADR 0006 § Specifics — the keyfile is the
# user's secret, kept under their home by default.
fn default_key_path(): i64 {
    var home = getenv("HOME");
    if (home == 0) { return "./agora.key"; }
    var hlen = strlen(home);
    var out = alloc(hlen + 16);
    memcpy(out, home, hlen);
    memcpy(out + hlen, "/.agora/key", 11);
    store8(out + hlen + 11, 0);
    return out;
}

# Ensure the parent directory of `path` exists (one-level mkdir).
# Used by cmd_keygen so the default `~/.agora/key` works without
# the operator pre-creating `~/.agora/`. EEXIST treated as success;
# leading-path-component absence still surfaces via the subsequent
# file_open in keyfile_generate.
fn ensure_parent_dir(path): i64 {
    var len = strlen(path);
    var i = len - 1;
    var sentinel = 0;
    while (i > 0) {
        if (sentinel == 0) {
            if ((load8(path + i) & 0xFF) == 47) {   # '/'
                sentinel = i;
                i = 0;
                continue;
            }
        }
        i = i - 1;
    }
    if (sentinel == 0) { return 0; }   # no parent (relative bare name)
    var parent = alloc(sentinel + 1);
    memcpy(parent, path, sentinel);
    store8(parent + sentinel, 0);
    return store_ensure(parent);
}

# `agora keygen [--key <path>]` — generate a fresh Ed25519 seed,
# write to `<path>` (default `~/.agora/key`) with mode 0o600,
# refuse to overwrite. Prints the resulting fingerprint.
fn cmd_keygen(): i64 {
    var path = parse_key_flag(default_key_path());
    ensure_parent_dir(path);
    if (keyfile_generate(path) != 0) {
        println("agora keygen: failed to write keyfile (path exists, or open/write/entropy error)");
        return 1;
    }
    var fp_buf = alloc(ACCOUNT_FP_BUF_BYTES);
    if (keyfile_to_fingerprint(path, fp_buf) != 0) {
        println("agora keygen: wrote keyfile but could not derive fingerprint");
        return 1;
    }
    sys_write(1, "wrote keyfile ", 14);
    sys_write(1, path, strlen(path));
    sys_write(1, " (fp ", 5);
    sys_write(1, fp_buf, ACCOUNT_FP_HEX_BYTES);
    sys_write(1, ")\n", 2);
    return 0;
}

# `agora register --handle <h> [--key <path>] [--store <path>]` —
# load the keyfile, derive the pubkey + fingerprint, refuse if the
# handle is invalid or already taken, register under the chosen
# store. The server-side handle lookup is O(n) (M6-B scan).
fn cmd_register(): i64 {
    var handle = parse_handle_flag();
    if (handle == 0) {
        println("agora register: --handle <handle> is required");
        return 2;
    }
    if (handle_valid(handle) == 0) {
        println("agora register: invalid handle (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not anonymous/system/admin)");
        return 2;
    }
    var path = parse_key_flag(default_key_path());
    var store = parse_store(DEFAULT_STORE);

    var seed = alloc(ACCOUNT_SEED_BYTES);
    if (keyfile_load_seed(path, seed) != 0) {
        println("agora register: could not read keyfile (run 'agora keygen' first or pass --key <path>)");
        return 1;
    }
    var pk = alloc(ACCOUNT_PK_BYTES);
    seed_to_pk(seed, pk);

    # Refuse if the handle is taken (different fp).
    var found_fp = alloc(ACCOUNT_FP_BUF_BYTES);
    if (account_resolve_handle(store, handle, found_fp) == 1) {
        # Compute our own fp; if same, idempotent re-register OK;
        # if different, handle is squatted by someone else.
        var our_fp = alloc(ACCOUNT_FP_BUF_BYTES);
        compute_fingerprint(pk, our_fp);
        if (streq(found_fp, our_fp) == 0) {
            println("agora register: handle already registered to a different fingerprint");
            return 1;
        }
    }

    var fp_out = alloc(ACCOUNT_FP_BUF_BYTES);
    if (account_register(store, pk, handle, fp_out) != 0) {
        println("agora register: write failed (mkdir / open / write error)");
        return 1;
    }
    sys_write(1, "registered ", 11);
    sys_write(1, handle, strlen(handle));
    sys_write(1, " ", 1);
    sys_write(1, fp_out, ACCOUNT_FP_HEX_BYTES);
    sys_write(1, "\n", 1);
    return 0;
}

# `agora whoami [--key <path>] [--store <path>]` — decode the
# keyfile, derive the fingerprint, optionally look up the handle in
# the store. Prints `<handle?> <fp16>` or just `<fp16>`. Returns 1
# if the keyfile cannot be read.
fn cmd_whoami(): i64 {
    var path = parse_key_flag(default_key_path());
    var store = parse_store(DEFAULT_STORE);
    var fp_buf = alloc(ACCOUNT_FP_BUF_BYTES);
    if (keyfile_to_fingerprint(path, fp_buf) != 0) {
        println("agora whoami: no keyfile (run 'agora keygen' or pass --key <path>)");
        return 1;
    }
    var handle_buf = alloc(ACCOUNT_HANDLE_BUF);
    var hlen = account_lookup_handle(store, fp_buf, handle_buf, ACCOUNT_HANDLE_BUF);
    if (hlen > 0) {
        sys_write(1, handle_buf, hlen);
        sys_write(1, " ", 1);
    }
    sys_write(1, fp_buf, ACCOUNT_FP_HEX_BYTES);
    sys_write(1, "\n", 1);
    return 0;
}

fn cmd_version(): i64 {
    println("agora 1.6.4");
    return 0;
}

fn main(): i64 {
    alloc_init();
    args_init();
    var n = argc();
    if (n < 2) {
        print_help();
        return 2;
    }
    var verb = argv(1);
    if (streq(verb, "help") != 0) { return print_help(); }
    if (streq(verb, "--help") != 0) { return print_help(); }
    if (streq(verb, "-h") != 0) { return print_help(); }
    if (streq(verb, "version") != 0) { return cmd_version(); }
    if (streq(verb, "--version") != 0) { return cmd_version(); }
    if (streq(verb, "serve") != 0) { return cmd_serve(); }
    if (streq(verb, "post") != 0) { return cmd_post(); }
    if (streq(verb, "list") != 0) { return cmd_list(); }
    if (streq(verb, "read") != 0) { return cmd_read(); }
    if (streq(verb, "whoami")   != 0) { return cmd_whoami(); }
    if (streq(verb, "keygen")   != 0) { return cmd_keygen(); }
    if (streq(verb, "register") != 0) { return cmd_register(); }
    if (streq(verb, "worldbench") != 0) { return cmd_worldbench(); }
    if (streq(verb, "worldread") != 0) { return cmd_worldread(); }
    println("agora: unknown command");
    print_help();
    return 2;
}

var exit_code = main();
# 1.6.2 — `sys_exit`, not a raw `syscall(60, ...)`. 60 is exit only on Linux
# x86_64; on agnos exit is 0 and 60 is `SYS_WINSIZE` (nullary, returns the
# framebuffer console grid), so the raw form made an agnos build query the
# console, discard the answer, and fall off the end of the program instead of
# terminating. `sys_exit` picks the right number per target and is what the
# fork child at :2708 already used — these two top-level exits were the outlier.
sys_exit(exit_code);
