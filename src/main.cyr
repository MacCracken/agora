# agora — main entry point.
#
# argv dispatch + boot banner + per-verb command handlers. The serve
# verb drives the M1 telnet listener via lib/net.cyr (Linux today;
# macOS / Windows / AGNOS follow as the stdlib gains backends — see
# docs/adr/0001-cross-platform-listener-decoupled-from-agnos.md).
#
# Milestones M0-M6 all closed at 1.0.0 (2026-05-23); M3 (inline-image posts via
# kii) and M4 (stored-file deltas via sankoch) are the two that shipped as gates
# rather than features and remain unbuilt. Current plan: docs/development/roadmap.md.

include "lib/darshana.cyr"
include "src/arena.cyr"
include "src/telnet.cyr"
include "src/term.cyr"
include "src/board.cyr"
include "src/account.cyr"
include "src/door.cyr"
include "src/wager.cyr"
include "src/decode_words.cyr"
include "src/decode.cyr"
include "src/smuggler.cyr"
include "src/port_authority.cyr"
include "src/handler.cyr"
include "src/chat.cyr"
include "src/eliza.cyr"
include "src/parry.cyr"
include "src/quest.cyr"
include "src/jabberwacky.cyr"
include "src/olympiad.cyr"
include "src/ashes.cyr"
include "src/descent.cyr"

# Default port. 23 is the IANA-assigned telnet port but requires
# root on Linux for bind. Override via `agora serve <port>`.
enum AgoraDefaults {
    DEFAULT_PORT      = 2323;
    LISTEN_BACKLOG    = 16;
    RECV_BUF_BYTES    = 4096;
    # Slowloris timeout — caps how long a quiet client can pin an
    # accept-loop worker. 60s of no traffic ends the connection.
    # Tuned for human-paced BBS use; trim for higher fanout.
    RECV_TIMEOUT_SECS = 60;
    # Send-side counterpart [T2]: a slowloris-READ peer (connects but
    # never drains its receive window) fills our kernel send buffer and
    # would park a worker inside a blocking write() — the recv timeout
    # never fires because the worker is in write(), not read(). Bound it.
    SEND_TIMEOUT_SECS = 60;
    # Operator-supplied MOTD ceiling (--motd <path>). 4 KB covers
    # any reasonable BBS welcome banner. File contents are sent
    # verbatim; operators are responsible for using CRLF line
    # endings (telnet NVT) and embedding any ANSI escapes they want.
    MOTD_FILE_CAP     = 4096;
    # Per-connection line buffer cap for the M5-B command parser.
    # 4 KB absorbs any plausible command + a long post-body line.
    LINE_BUF_CAP      = 4096;
}

# M5-B/D session modes. Drives the per-byte dispatch in handle_client:
#   MODE_COMMAND          — interpret each completed line as a command
#   MODE_POSTING_SUBJECT  — M5-D: capture the Subject line, then move to body
#   MODE_POSTING          — accumulate lines into the post body; commit
#                           when we see a line that is exactly "."
enum SessMode {
    MODE_COMMAND          = 0;
    MODE_POSTING_SUBJECT  = 1;
    MODE_POSTING          = 2;
    MODE_LOGIN_AWAIT_SIG  = 3;   # M6-C: parked challenge, waiting for `auth:`
    MODE_DOOR             = 4;   # 1.1.0: in a door game; lines route to the game
    MODE_CHAT             = 5;   # 1.3.0: in a chat channel; lines say to the room (ADR 0011)
    MODE_DESCENT          = 6;   # 1.11.0: in the Descent; bytes go to the MUD (ADR 0031)
}

# 1.3.0 chat runtime (ADR 0011). These are main.cyr socket concerns —
# the pure transcript params (caps, scrollback) live in chat.cyr's
# ChatCap. While in MODE_CHAT the socket recv timeout drops to
# CHAT_POLL_SECS so an idle recv (EWOULDBLOCK) becomes a live-tail tick
# instead of a disconnect; accumulated true-silence is bounded by
# CHAT_IDLE_SECS so an idle chatter can't pin a forked worker forever.
enum ChatRuntime {
    CHAT_POLL_SECS  = 2;        # recv timeout in chat = live-tail tick cadence
    CHAT_IDLE_SECS  = 900;      # 15 min of pure silence ends a chat session
    EWOULDBLOCK_ERR = 11;       # sys_read return on SO_RCVTIMEO fire (EAGAIN)
}

# Operator-supplied MOTD, loaded once in cmd_serve before the
# listener opens. Null (0) means "use the default render_motd"; a
# non-null pointer with g_motd_len > 0 means "send these bytes
# verbatim to every connection". Globals (vs. threading through handle_client)
# because they are set-once-at-startup state — true under every serve model, and
# unlike the per-session globals below they are never swapped.
var g_motd_buf = 0;
var g_motd_len = 0;

# Post-storage root used by the telnet-side command interpreter
# (M5-B). Set once in cmd_serve from --store <path>, defaults to
# the same `./agora-data/` used by the CLI verbs. Per-connection
# handle_client reads this without threading through args.
var g_store_buf = "./agora-data";

# M5-F: per-session reply state. `reply <id>` writes these and handle_client
# reads them when finalizing the post. These ARE global slots, and since 1.6.0
# that is only safe because sess_load/sess_save swap them in and out of the
# session pool around every dispatch (ADR 0023) — under fork they were private
# by address space, under poll they are private by the context swap.
var g_reply_to          = 0;           # 0 = regular post, >0 = parent id
var g_reply_subject     = 0;           # alloc'd lazily on first use
var g_reply_subject_len = 0;

# M6-C: per-session identity binding. NUL terminator at offset 0
# (empty cstring) = anonymous; populated by a successful `login`
# challenge/response round. Like every g_* below, these are swapped in and
# out of the session slot around each dispatch (sess_load / sess_save,
# since 1.6.0) — the buffers live in the slot (session_alloc).
var g_session_fp     = 0;             # slot buffer (ACCOUNT_FP_BUF_BYTES)
var g_session_handle = 0;             # slot buffer (ACCOUNT_HANDLE_BUF)

# M6-C: parked login challenge. g_login_fp holds the fingerprint
# resolved from the typed handle; g_login_nonce holds the hex-encoded
# 32-byte nonce we sent on the wire. Both empty (NUL at offset 0)
# = no login in flight. Cleared on every auth attempt (pass or fail)
# + on session close.
var g_login_fp    = 0;                # slot buffer (ACCOUNT_FP_BUF_BYTES)
var g_login_nonce = 0;                # slot buffer (ACCOUNT_NONCE_BUF_BYTES)

# 1.1.0 door subsystem (ADR 0009). Active game id (DoorGame enum),
# heap pointer to the running game state, and the play mode (DoorMode).
# Per-session via sess_load / sess_save, like g_session_* above.
# GAME_NONE = no game active.
var g_door_game  = 0;
var g_door_state = 0;
var g_door_mode  = 0;

# 1.2.0 Universe (ADR 0010 bites 2-4). Per-session shared-world snapshot
# buffer, owned by the session slot since 1.6.2 (sized to the largest game
# world). The flock'd lock→read→feed→write transaction
# around each input line reads into this buffer and writes it back, so
# concurrent players serialize on the world lock with no lost updates.
var g_uni_world = 0;

# 1.3.0 chat (ADR 0011). Per-session chat state, swapped per session like
# g_session_* / g_door_*. g_chat_channel is the joined channel name buffer (empty
# = not in chat); g_chat_seen is the highest transcript seq this session
# has shown (the live-tail watermark — keyed on absolute seq, not a byte
# offset, so the ring's front-trim never desyncs it); g_chat_idle
# accumulates seconds of pure silence to bound an idle chatter.
var g_chat_channel = 0;             # alloc'd in handle_client (CHAT_CHANNEL_MAX + 1)
var g_chat_seen    = 0;
var g_chat_idle    = 0;

# 1.3.0/1.3.1 (ADR 0011): the private chatbot side-channel inside chat.
# g_chat_bot selects the active bot on the couch: 0 = none (talking to the
# room), otherwise the bot's GAME_* id (1.11.1 — it was 1 / 2 / 3). While
# non-zero, non-command lines go to that bot and the reply is sent ONLY to this
# user (never chat_say'd to the room); room tailing is paused.
#
# 1.11.1 — the couch is in the door registry: a bot is any door whose descriptor
# has a DD_COUCH_CMD, and it is driven through its DD_NEW / DD_START / DD_FEED /
# DD_REPLY / DD_FREE slots. Until 1.11.1 it was a separate 3-way switch, and the
# reply was read at Eliza's struct offsets (EZ_RESP / EZ_RESPLEN) for every bot —
# an ABI nothing enforced. g_couch is this session's table of couch states,
# indexed by game id, built lazily on a bot's first command.
var g_chat_bot     = 0;
var g_couch        = 0;   # slot array: (GAME_LAST + 1) state pointers (SESS_COUCH)

enum DoorRuntime {
    DOOR_FRAME_CAP = 8192;        # per-frame render buffer (logical cap; emit_* bound to this)
    DOOR_FRAME_GUARD = 1024;      # [D3] slack past the cap so a raw-store8 tail can't overrun the alloc
    DOOR_SAVE_CAP  = 32768;       # save/load buffer (Handler registry is the largest)
    DOOR_WORLD_CAP = 8192;        # 1.2.0 Universe shared-world snapshot buffer (largest world fits)
    LB_ROW_CAP     = 320;         # leaderboard display row: "NN) " + row + CR LF (bounded at 1.8.0)
    LB_TOP         = 10;          # rows `scores` shows
    LB_CHUNK       = 16384;       # 1.8.1 — leaderboard read piece (the whole file is streamed)
}

# 0.7.0 audit M6 — explicit 30 s deadline on a parked login challenge.
# Set to `clock_now_ms()` when `login` parks the nonce; checked at
# MODE_LOGIN_AWAIT_SIG dispatch. Independent of `RECV_TIMEOUT_SECS`
# (which only fires on socket-idle — a client sending heartbeat bytes
# could pin a parked slot indefinitely otherwise). ADR 0006 § Specifics.
var g_login_started_ms = 0;
enum AgoraLogin {
    LOGIN_DEADLINE_MS = 30000;        # 30 s, per ADR 0006
}

# 1.8.2 — the version in print_banner, cmd_version and render_motd is
# CYRIUS_PKG_VERSION, which `cyrius build` derives from cyrius.cyml's
# `[package] version = "${file:VERSION}"`. VERSION is now the ONE place a
# release bumps; these were three hand-edited literals (promised as a generated
# string since 0.2.0), and CI's drift check only ever covered one of them.
fn print_banner(): i64 {
    println("agora — BBS for AGNOS");
    print("v", 1);
    print(CYRIUS_PKG_VERSION, strlen(CYRIUS_PKG_VERSION));
    var tag1 = " — civic-marketplace BBS for AGNOS; chat + Eliza/PARRY + QUEST + Jabberwacky + casino";
    print(tag1, strlen(tag1));
    println(" + Olympiad + Ashes of Empire + Descent link + Decode");
    return 0;
}

# `agora help` (and a bad command line): the banner, then every CLI verb and env knob.
fn print_help(): i64 {
    print_banner();
    println("");
    println("USAGE: agora <command> [args]");
    println("");
    println("COMMANDS:");
    println("  serve [port] [--motd <path>] [--store <path>]");
    println("                 start telnet listener (default port 2323;");
    println("                 --motd reads a file as the connection MOTD");
    println("                 instead of the default bannermanor render;");
    println("                 --store sets the post-storage root for the");
    println("                 in-session post/list/read commands —");
    println("                 default ./agora-data/, same as the CLI verbs)");
    println("  post [--store <path>] [--board <name>] [--subject <text>] [--reply-to <id>]");
    println("                 read stdin → new post → print assigned ID");
    println("                 (default store ./agora-data/, board 'main';");
    println("                 named boards live at <store>/<name>/. Subject");
    println("                 is written as an RFC-822 header per ADR 0003;");
    println("                 --reply-to writes a Reply-To header per ADR 0005.)");
    println("  list [--store <path>] [--board <name>]");
    println("                 list post IDs in the chosen board");
    println("  read <id> [--store <path>] [--board <name>]");
    println("                 print a post body to stdout by ID");
    println("  keygen [--key <path>]");
    println("                 generate a fresh Ed25519 keyfile (32-byte seed,");
    println("                 mode 0600; default ~/.agora/key; refuses overwrite)");
    println("  register --handle <h> [--key <path>] [--store <path>]");
    println("                 register the keyfile's pubkey under <h> in the store");
    println("  whoami [--key <path>] [--store <path>]");
    println("                 print '<handle?> <fp16>' for the keyfile's identity");
    println("                 (handle from a --store lookup; fp from the keyfile alone)");
    println("  policy get <board> [--store <path>]");
    println("  policy set <board> <open|known|anon|admin> [--store <path>]");
    println("                 a board's posting/reading mode (ADR 0028): open = anyone");
    println("                 reads, logged-in users post (default); known = members");
    println("                 only, login to read and post; anon = anyone posts,");
    println("                 anonymous included; admin = only .admins post");
    println("  admins list <board> [--store <path>]");
    println("  admins add|rm <board> <handle|fingerprint> [--store <path>]");
    println("                 edit a board's .admins; add writes the key's fingerprint");
    println("                 (rights follow the key, not the handle)");
    println("  version        print version string");
    println("  help           show this message");
    println("");
    println("EXIT CODES:");
    println("  0  success");
    println("  1  command-specific failure");
    println("  2  bad usage (unknown command / arg)");
    return 0;
}

# Send a literal byte buffer to a connected client. Returns 0 on
# success, 1 on partial-write or socket error (caller closes conn).
fn send_buf(cfd, buf, len): i64 {
    # Poll multiplex (1.6.0): never block the shared loop on one client's socket —
    # queue the bytes on the active session's tx buffer; the poll loop drains it
    # non-blocking (session_drain). Fork/serial: blocking write as before.
    if (g_serve_mode == SERVE_POLL) {
        return sess_tx_enqueue(g_active_sess, buf, len);
    }
    # 1.8.1 (audit H19 / P10) — a failed fork-mode send is STICKY, as the poll
    # queue's overflow already is (1.7.0, N3-B). Each write to a client that has
    # stopped reading parks for SEND_TIMEOUT_SECS (60 s), and session_execute
    # discards almost every send's return, so the next send parked another 60 s:
    # `read 1` x500 into a non-reading client held its child ~3 min and counting
    # (the theoretical bound was hours). After one failure every later send is
    # refused at once and process_rx closes the connection.
    if (g_active_sess != 0) {
        if (load64(g_active_sess + SESS_TX_OVF) != 0) { return 1; }
    }
    # A short write is a failure too (1.8.2). The socket is blocking, so Linux
    # returns fewer bytes than asked only when SO_SNDTIMEO expired — or a socket
    # error / signal cut the wait — after some were copied: the client let the
    # kernel free no room for 60 s, exactly as when nothing was copied. Until
    # 1.8.2 that write counted as success and the remainder was retried, so the
    # 1.8.1 latch fired only on a write that gained NO bytes in 60 s — and on a
    # zero-window peer the kernel can still take a few KB into the send queue on
    # a probe's ACK: measured on Linux 7.2, a non-reader that had acked 4,521 B
    # held its child 186 s (three timeouts) instead of 60. [T1: no retry loop is
    # left to spin; the one before 1.6.x spun forever on a failed write.]
    if (len <= 0) { return 0; }
    var n = sys_write(cfd, buf, len);
    if (n != len) {
        if (g_active_sess != 0) { store64(g_active_sess + SESS_TX_OVF, 1); }
        return 1;
    }
    return 0;
}

# Copy a cstring (NUL-terminated) into `buf` at `pos`. Returns new
# pos. Used by render_motd to splice literal MOTD-text segments
# between SGR escape runs.
#
# 1.8.0 — a negative `pos` is passed through untouched, writing nothing. That
# makes this a link of the same chain as darshana's `_buf` composers, which
# since darshana 0.9.3 return -1 for a negative `pos` (and for an out-of-range
# SGR code) instead of writing below the buffer: a -1 from any link now
# poisons the rest of render_motd's chain rather than being memcpy'd to buf-1.
fn motd_emit_cstr(buf, pos, s): i64 {
    if (pos < 0) { return pos; }
    var n = strlen(s);
    memcpy(buf + pos, s, n);
    return pos + n;
}

# === M5-B session helpers ===
#
# Session state for one telnet client lives in the pooled slot (the SESS_*
# struct, 1.6.0) and is swapped into these globals per dispatch. These
# free-standing helpers take the explicit args they need and operate on the
# per-connection buffers.

# 1.6.4 (audit M2) — send STORED / USER-DERIVED text with IAC doubled.
#
# RFC 854: 0xFF is IAC on the wire, and a data byte of that value MUST be sent
# as `IAC IAC` or the receiver reads it as the start of a command. agora never
# did this on any egress path, so a 0xFF sitting in a post body, a subject, a
# handle or a chat line reached every reader's client as a live telnet command —
# a stored, replayable wedge with no removal path. CLAUDE.md is unambiguous
# about which side of that is correct: "the wire is the contract ... any
# deviation is a bug, not a feature".
#
# This is deliberately NOT folded into `send_buf`. That is the funnel for every
# byte agora sends, including the telnet layer's OWN command sequences (the
# announce salvo, option replies drained from telnet_tx_buf) — doubling those
# would corrupt the protocol. The split is by intent: protocol bytes go out via
# send_buf, content bytes via send_text.
#
# 1.8.0 (ADR 0024) — and with every terminal control NEUTRALIZED. Doubling IAC
# protected the telnet layer, not the reader's terminal: C1 controls (raw 0x9B,
# UTF-8-encoded C2 9B), and any ESC in a CLI-authored or pre-filter post, went
# out verbatim and were executed by every reader's terminal. Each chunk now goes
# through `text_sanitize` (darshana `tty_sanitize_buf`, UTF-8 mode, keeping
# TAB / CR / LF) before the IAC pass. Well-formed UTF-8 is unchanged.
#
# Work is done in bounded chunks on the stack rather than by allocating a copy:
# a post body is up to 64 KB and this runs per read, on a per-line path where a
# bare alloc() would leak under poll (ADR 0021). `text_chunk_end` never splits a
# UTF-8 sequence, so the chunked result is byte-identical to sanitizing the
# whole input at once. Buffer sizes: a chunk is <= TEXT_CHUNK_MAX (504) bytes in,
# <= 504 sanitized, <= 1008 after doubling.
#
# 1.10.0 (audit 1.8.1 I12) — and with NVT newlines: `text_nvt_iac` turns a bare LF
# into CR LF and a bare CR into CR NUL (RFC 854 p.11), carrying a trailing CR
# across chunks, and a CR that ends the text gets its NUL here. Output stays
# <= 2 bytes per input byte, so `out` is unchanged.
fn send_text(cfd, buf, len): i64 {
    var san[512];
    var out[1024];
    var cr[8];
    store64(&cr, 0);
    var i = 0;
    var rc = 0;
    while (i < len) {
        var e = text_chunk_end(buf, i, len, TEXT_CHUNK_MAX);
        var sn = text_sanitize(&san, buf + i, e - i);
        if (sn > 0) {
            var on = text_nvt_iac(&out, &san, sn, &cr);
            if (send_buf(cfd, &out, on) != 0) { rc = 1; e = len; }
        }
        i = e;
    }
    if (rc == 0) {
        var tn = text_nvt_end(&out, &cr);
        if (tn > 0) { if (send_buf(cfd, &out, tn) != 0) { rc = 1; } }
    }
    return rc;
}

# The width to wrap the active session's output to (term.cyr): from the NAWS
# window width the client reported (RFC 1073), or 0 — do not wrap — when it has
# reported none. Read at every send, so a resized window takes effect on the
# next command.
fn session_wrap_width(): i64 {
    if (g_active_sess == 0) { return 0; }
    var ts = load64(g_active_sess + SESS_TS);
    if (ts == 0) { return 0; }
    return term_wrap_width(telnet_term_cols(ts));
}

# 1.10.1 (ADR 0030) — send text laid out for the client's window: lines wider
# than the NAWS width break between words (term.cyr). `col0` is the column the
# text starts at (text already sent on the row); continuation rows indent by
# `hang`, plus the line's own leading whitespace under TW_AUTO, or its leading
# "<tag> " under TW_TAG.
#
# Without TW_RAW the text is content — stored or user-derived — and gets exactly
# `send_text`'s treatment: sanitized (ADR 0024), then NVT newlines and IAC
# doubling. ⚠ It is sanitized IN PLACE, before the wrap measures it, so the
# columns counted are the ones the reader sees: `buf` must be the caller's
# scratch, never a literal or a stored copy it reads again. With TW_RAW the bytes
# are trusted and already wire-ready (a door frame's SGR and CR LF, a literal):
# wrapped and sent as they are, through `send_buf`.
#
# A session with no width (no NAWS, or a width of 0) takes the old path, so its
# bytes are exactly what they were before 1.10.1. Returns 0, or 1 if a send
# failed.
fn send_wrapped(cfd, buf, len, col0, hang, flags): i64 {
    var width = session_wrap_width();
    var raw = 0;
    if ((flags & TW_RAW) != 0) { raw = 1; }
    if (width == 0) {
        if (raw == 1) { return send_buf(cfd, buf, len); }
        return send_text(cfd, buf, len);
    }
    if (len <= 0) { return 0; }
    var n = len;
    if (raw == 0) {
        n = text_sanitize(buf, buf, len);
        if (n < 0) { return 1; }
    }
    var st[104];                 # WS_SIZE
    var chunk[2048];
    var out[4096];               # <= 2 x chunk after text_nvt_iac
    var cr[8];
    store64(&cr, 0);
    term_wrap_init(&st, buf, n, col0, hang, flags, width);
    var rc = 0;
    var going = 1;
    while (going == 1) {
        var k = term_wrap_chunk(&st, &chunk, 2048);
        if (k <= 0) { going = 0; continue; }
        if (raw == 1) {
            if (send_buf(cfd, &chunk, k) != 0) { rc = 1; going = 0; }
        } else {
            var on = text_nvt_iac(&out, &chunk, k, &cr);
            if (send_buf(cfd, &out, on) != 0) { rc = 1; going = 0; }
        }
    }
    if (rc == 0) {
        if (raw == 0) {
            var tn = text_nvt_end(&out, &cr);
            if (tn > 0) { if (send_buf(cfd, &out, tn) != 0) { rc = 1; } }
        }
    }
    return rc;
}

# The CLI viewers' twin of `send_text` (1.8.0): `agora read` / `agora list`
# print other people's posts into the OPERATOR's terminal, and did so raw.
# Same rule, same chunking, written to `fd` with no IAC pass (stdout is not a
# telnet stream). The raw post is still on disk for anyone who needs the bytes.
fn write_text(fd, buf, len): i64 {
    var san[512];
    var i = 0;
    while (i < len) {
        var e = text_chunk_end(buf, i, len, TEXT_CHUNK_MAX);
        var sn = text_sanitize(&san, buf + i, e - i);
        if (sn > 0) { sys_write(fd, &san, sn); }
        i = e;
    }
    return 0;
}

# Send a NUL-terminated cstring over the socket. Convenience wrapper
# for the in-session prompts / replies.
fn send_str(cfd, s): i64 {
    return send_buf(cfd, s, strlen(s));
}

# Echo a single byte back to the client. We announced WILL ECHO at
# connect (M2-B Q-method announce salvo), so the client trusts us
# to drive the display.
fn echo_byte(cfd, b): i64 {
    var one[1];
    store8(&one, b & 0xFF);
    return send_buf(cfd, &one, 1);
}

# Send the in-session prompt. M5-E: when current_board is "main"
# the prompt is the bare `> ` (preserves 0.4.0 visual); when in a
# named board the prompt is `[name] > ` so the user always knows
# which board their next command targets.
fn send_prompt(cfd, current_board): i64 {
    if (streq(current_board, "main") != 0) {
        return send_str(cfd, "> ");
    }
    send_str(cfd, "[");
    send_str(cfd, current_board);
    return send_str(cfd, "] > ");
}

# One `help` entry (a literal ending CR LF), wrapped to the client's window with
# its description continuing under the description column (1.10.1).
fn send_help_line(cfd, s): i64 {
    return send_wrapped(cfd, s, strlen(s), 0, 18, TW_RAW);
}

# `input_byte_ok` lives in board.cyr (storage-policy layer). It's
# what the post storage system accepts; main.cyr's wire layer just
# enforces it at ingress. See board.cyr for the rationale.

# Return 1 if buffer [line, line_len) starts with the cstring `prefix`,
# 0 otherwise. Used by the command parser to dispatch on the first
# token of a typed command line.
fn line_has_prefix(line, line_len, prefix): i64 {
    var plen = strlen(prefix);
    if (line_len < plen) { return 0; }
    return memeq(line, prefix, plen);
}

# Parse a positive integer from `line[off..line_len)`. Skips leading
# spaces. Stops at the first non-digit byte. Returns the parsed
# integer, or -1 if no digits found / value is zero.
fn line_parse_int(line, off, line_len): i64 {
    # Skip leading spaces — track explicitly without the trap of
    # using one loop variable for "did we stop because of EOL or
    # because we found a non-space?"
    var i = off;
    var skipping = 1;
    while (skipping == 1) {
        if (i >= line_len)                       { skipping = 0; }
        else { if ((load8(line + i) & 0xFF) != 32) { skipping = 0; }
            else                                { i = i + 1; } }
    }
    # Read digits. 1.8.1 (audit W6) — at most 18, as parse_post_id has had since
    # the 0.7.0 audit (M3): a 20-digit `read` id wrapped the i64. Only ever a
    # wrong post number, but the two id parsers now agree.
    var n = 0;
    var got_any = 0;
    var ndig = 0;
    var reading = 1;
    while (reading == 1) {
        if (i >= line_len) { reading = 0; }
        else {
            var c = load8(line + i) & 0xFF;
            if (c < 48) { reading = 0; }
            else { if (c > 57) { reading = 0; }
                else        { n = n * 10 + (c - 48); got_any = 1; ndig = ndig + 1; i = i + 1; } }
        }
    }
    if (got_any == 0) { return 0 - 1; }
    if (ndig > 18)    { return 0 - 1; }
    if (n <= 0)       { return 0 - 1; }
    return n;
}

# Execute a typed command line. Returns the new session mode
# (MODE_COMMAND or MODE_POSTING_SUBJECT) and writes side-effect bytes
# to cfd. Quit-style commands set *quit_out = 1 and return MODE_COMMAND.
# M5-E: `current_board` is a pointer to the per-session board-name
# buffer (`BOARD_NAME_MAX + 1` bytes, NUL-terminated). `enter` and
# `leave` write into this buffer; all storage commands route through it.
fn session_execute(cfd, line, line_len, current_board, quit_out): i64 {
    # Trim trailing spaces.
    var len = line_len;
    var trimming = 1;
    while (trimming == 1) {
        if (len <= 0) { trimming = 0; }
        else { if ((load8(line + len - 1) & 0xFF) != 32) { trimming = 0; }
            else                                       { len = len - 1; } }
    }
    # Empty line — nothing to do, return to prompt.
    if (len == 0) { return MODE_COMMAND; }

    if (line_has_prefix(line, len, "help") != 0) {
        # 1.10.1 (ADR 0030) — each entry wrapped to the client's window, its
        # description continuing under the description column (18).
        send_str(cfd, "\r\nCommands:\r\n");
        send_help_line(cfd, "  boards          list all boards (main + named)\r\n");
        send_help_line(cfd, "  enter <name>    switch to a named board (auto-creates)\r\n");
        send_help_line(cfd, "  leave           return to main\r\n");
        send_help_line(cfd, "  list            list post IDs in the current board\r\n");
        send_help_line(cfd, "  read <id>       read a post by ID (with reply list)\r\n");
        send_help_line(cfd, "  post            compose a new post; end with '.' on a line by itself\r\n");
        send_help_line(cfd, "  reply <id>      compose a reply to <id>; auto Re: subject\r\n");
        send_help_line(cfd, "  login <handle>  start a challenge/response login (sigil Ed25519)\r\n");
        send_help_line(cfd, "  whoami          print bound identity (handle + fingerprint) or 'anonymous'\r\n");
        # 1.11.1 — the door list comes from the registry.
        var play[256];
        var pl = door_names_into(&play, "  play <game>     door: ", " | ", 200);
        var pt = "  [practice|solo|universe]\r\n";
        memcpy((&play) + pl, pt, strlen(pt));
        send_wrapped(cfd, &play, pl + strlen(pt), 0, 18, TW_RAW);
        send_help_line(cfd, "  scores <game>   top-10 leaderboard for a door game\r\n");
        send_help_line(cfd, "  chat [channel]  join a live chat channel (default 'lobby'); /leave to exit\r\n");
        send_help_line(cfd, "  descent         step through the portal into the Yeoman's Descent MUD\r\n");
        send_help_line(cfd, "  help            this message\r\n");
        send_help_line(cfd, "  quit            close the session\r\n");
        send_str(cfd, "\r\n");
        return MODE_COMMAND;
    }

    # M5-E: `boards` — list main + all named subdirectory boards.
    if (line_has_prefix(line, len, "boards") != 0) {
        var idsmain = cmd_alloc(DIRENT_ID_MAX * 8);
        var maincount = post_list(g_store_buf, "main", idsmain, DIRENT_ID_MAX);
        # Always list main. 1.9.2 — a members-only board (ADR 0028) shows "members
        # only" instead of its post count to a session that may not read it.
        send_str(cfd, "  main      ");
        if (board_can_read(g_store_buf, "main", g_session_fp) == 0) {
            send_str(cfd, "members only\r\n");
        } else {
            var ibuf[24];
            var ilen = fmt_int_buf(maincount, &ibuf);
            send_buf(cfd, &ibuf, ilen);
            send_str(cfd, " posts\r\n");
        }

        var names = cmd_alloc(BOARD_LIST_MAX * 8);
        var bcount = boards_list(g_store_buf, names, BOARD_LIST_MAX);
        var i = 0;
        while (i < bcount) {
            var name_cstr = load64(names + i * 8);
            var pcount = post_list(g_store_buf, name_cstr, idsmain, DIRENT_ID_MAX);
            send_str(cfd, "  ");
            # 1.8.0 — a directory name read off the disk is content, not a
            # literal, so it goes out through `send_text` (IAC doubling + ADR
            # 0024 sanitization) like every other stored string. Since 1.8.1
            # `boards_list` only returns names that pass `board_name_valid`, so
            # this is defence in depth; a valid name is byte-identical.
            send_text(cfd, name_cstr, strlen(name_cstr));
            # Pad to 10 columns for visual alignment with "main      "
            var nlen = strlen(name_cstr);
            var pad = 10 - nlen;
            while (pad > 0) {
                send_str(cfd, " ");
                pad = pad - 1;
            }
            if (board_can_read(g_store_buf, name_cstr, g_session_fp) == 0) {
                send_str(cfd, "members only\r\n");
            } else {
                var pbuf[24];
                var plen = fmt_int_buf(pcount, &pbuf);
                send_buf(cfd, &pbuf, plen);
                send_str(cfd, " posts\r\n");
            }
            i = i + 1;
        }
        return MODE_COMMAND;
    }

    # M5-E: `enter <name>` — switch the session's current board.
    # Auto-creates the board's directory on first use (ADR 0004 § Lifecycle).
    if (line_has_prefix(line, len, "enter") != 0) {
        # Skip "enter" + leading spaces. Always advance `i` regardless of
        # which branch we take (avoids the trap-pattern that bit M5-D parse).
        var i = 5;
        var skipping = 1;
        while (skipping == 1) {
            if (i >= len) { skipping = 0; }
            else { if ((load8(line + i) & 0xFF) != 32) { skipping = 0; }
                else                                 { i = i + 1; } }
        }
        if (i >= len) {
            send_str(cfd, "usage: enter <name>\r\n");
            return MODE_COMMAND;
        }
        var name_len = len - i;
        if (name_len > BOARD_NAME_MAX) {
            send_str(cfd, "board name too long (max 32 bytes)\r\n");
            return MODE_COMMAND;
        }
        var name_buf = cmd_alloc(BOARD_NAME_MAX + 1);
        memcpy(name_buf, line + i, name_len);
        store8(name_buf + name_len, 0);

        if (board_name_valid(name_buf) == 0) {
            send_str(cfd, "invalid board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')\r\n");
            return MODE_COMMAND;
        }
        # 0.8.3 audit M4 — anonymous sessions may enter existing boards
        # but may not create new ones. Auth-gate only the create path;
        # existing-board enter stays anonymous-permitted (matches the
        # M6 "anon-read, auth-post" default policy shape).
        #
        # Pre-0.8.3 shape: every `enter <name>` ran board_ensure,
        # letting any anon spam `enter b1 / enter b2 / ...` to mkdir
        # arbitrary subdirs of the store (audit M4 in 2026-05-23-audit.md).
        var is_anon = 0;
        if (g_session_fp == 0) { is_anon = 1; }
        else { if ((load8(g_session_fp) & 0xFF) == 0) { is_anon = 1; } }
        if (is_anon != 0) {
            if (board_exists(g_store_buf, name_buf) == 0) {
                send_str(cfd, "auth required to create new boards — run 'login <handle>' first\r\n");
                return MODE_COMMAND;
            }
        }
        # 1.9.2 — a members-only board (ADR 0028) is entered by members only.
        if (board_can_read(g_store_buf, name_buf, g_session_fp) == 0) {
            send_str(cfd, "members only — run 'login <handle>' first\r\n");
            return MODE_COMMAND;
        }
        # Switch + (no-op if already exists) auto-create. board_ensure
        # is safe to call on an existing board.
        memcpy(current_board, name_buf, name_len);
        store8(current_board + name_len, 0);
        board_ensure(g_store_buf, current_board);
        send_str(cfd, "entered ");
        send_str(cfd, current_board);
        send_str(cfd, "\r\n");
        return MODE_COMMAND;
    }

    # M5-E: `leave` — return to main.
    if (line_has_prefix(line, len, "leave") != 0) {
        memcpy(current_board, "main", 4);
        store8(current_board + 4, 0);
        send_str(cfd, "back in main\r\n");
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "list") != 0) {
        # 1.9.2 — checked on every list, not only at `enter`: the board may have
        # become members-only since (and `main` is where every session starts).
        if (board_can_read(g_store_buf, current_board, g_session_fp) == 0) {
            send_str(cfd, "members only — run 'login <handle>' first\r\n");
            return MODE_COMMAND;
        }
        var ids = cmd_alloc(DIRENT_ID_MAX * 8);
        var count = post_list(g_store_buf, current_board, ids, DIRENT_ID_MAX);
        if (count == 0) {
            send_str(cfd, "(no posts)\r\n");
        } else {
            # Preallocate a per-iteration scratch buffer for the
            # whole post file (read once to extract Subject), and a
            # subject-extract buffer. Subject lookup is O(file)
            # which is negligible at the v1.0 BBS scale.
            var fbuf = cmd_alloc(POST_MAX_BYTES + 1024);
            var sbuf = cmd_alloc(SUBJECT_MAX_BYTES);
            var hbuf = cmd_alloc(ACCOUNT_HANDLE_BUF);
            var fpbuf = cmd_alloc(ACCOUNT_FP_BUF_BYTES);
            # 1.10.1 (ADR 0030) — each row is composed whole and sent wrapped to
            # the client's window, the subject's continuation rows aligned under
            # the subject: `<id>  [<handle>|anon]  <subject>`. One send per row
            # (it was seven — each a write(2) under fork). The handle is
            # sanitized as it is copied, so the hang is measured on what the
            # reader sees; send_wrapped sanitizes the subject. The row is stack
            # scratch, per iteration (t232's rule: no arena take inside a loop).
            var idx = 0;
            while (idx < count) {
                var id = load64(ids + idx * 8);
                var row[320];          # 20 id + 3 + 32 handle + 3 + 256 subject + 2 = 316
                var rl = fmt_int_buf(id, &row);
                memcpy((&row) + rl, "  [", 3);
                rl = rl + 3;
                var flen = post_read(g_store_buf, current_board, id, fbuf, POST_MAX_BYTES + 1024);
                # M6-E: [<handle>|anon] before subject.
                var named = 0;
                if (flen > 0) {
                    if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
                        named = 1;
                    }
                }
                if (named == 1) {
                    var hl = strlen(hbuf);
                    if (hl > ACCOUNT_HANDLE_MAX) { hl = ACCOUNT_HANDLE_MAX; }
                    rl = rl + text_sanitize((&row) + rl, hbuf, hl);
                } else {
                    memcpy((&row) + rl, "anon", 4);
                    rl = rl + 4;
                }
                memcpy((&row) + rl, "]  ", 3);
                rl = rl + 3;
                var hang = term_cols(&row, 0, rl, 0);
                if (flen > 0) {
                    var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
                    if (slen > SUBJECT_MAX_BYTES) { slen = SUBJECT_MAX_BYTES; }
                    if (slen > 0) {
                        memcpy((&row) + rl, sbuf, slen);
                        rl = rl + slen;
                    }
                }
                store8((&row) + rl, 13);
                store8((&row) + rl + 1, 10);
                send_wrapped(cfd, &row, rl + 2, 0, hang, 0);
                idx = idx + 1;
            }
        }
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "read") != 0) {
        if (board_can_read(g_store_buf, current_board, g_session_fp) == 0) {
            send_str(cfd, "members only — run 'login <handle>' first\r\n");
            return MODE_COMMAND;
        }
        var id = line_parse_int(line, 4, len);
        if (id < 0) {
            send_str(cfd, "usage: read <id>\r\n");
            return MODE_COMMAND;
        }
        var fbuf = cmd_alloc(POST_MAX_BYTES + 1024);
        var flen = post_read(g_store_buf, current_board, id, fbuf, POST_MAX_BYTES + 1024);
        if (flen <= 0) {
            send_str(cfd, "post not found\r\n");
            return MODE_COMMAND;
        }

        # M5-D: surface Subject before the body so the reader knows
        # what they're looking at. Headerless (M5-A/B/C) posts skip
        # this — body_off == 0 and post_subject returns 0 length.
        # M6-E: From line above subject (or "From: anonymous" for
        # missing-header posts).
        var hbuf = cmd_alloc(ACCOUNT_HANDLE_BUF);
        var fpbuf = cmd_alloc(ACCOUNT_FP_BUF_BYTES);
        send_str(cfd, "From: ");
        if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
            send_text(cfd, hbuf, strlen(hbuf));
            send_str(cfd, " ");
            send_text(cfd, fpbuf, strlen(fpbuf));
            send_str(cfd, "\r\n");
        } else {
            send_str(cfd, "anonymous\r\n");
        }
        var sbuf = cmd_alloc(SUBJECT_MAX_BYTES);
        var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
        if (slen > SUBJECT_MAX_BYTES) { slen = SUBJECT_MAX_BYTES; }
        if (slen > 0) {
            # 1.10.1 (ADR 0030) — one row, wrapped under the subject's own column.
            var subj = cmd_alloc(SUBJECT_MAX_BYTES + 16);
            memcpy(subj, "Subject: ", 9);
            memcpy(subj + 9, sbuf, slen);
            store8(subj + 9 + slen, 13);
            store8(subj + 10 + slen, 10);
            send_wrapped(cfd, subj, slen + 11, 0, 9, 0);
        }
        send_str(cfd, "\r\n");

        var body_off = post_body_offset(fbuf, flen);
        var body_len = flen - body_off;
        if (body_len > 0) {
            # Read before the send: send_wrapped sanitizes the body in place.
            var ends_lf = 0;
            if ((load8(fbuf + body_off + body_len - 1) & 0xFF) == 10) { ends_lf = 1; }
            # 1.10.1 (ADR 0030) — wrapped to the client's window; an indented
            # line (a list item, a code block) keeps its indent when it wraps.
            send_wrapped(cfd, fbuf + body_off, body_len, 0, 0, TW_AUTO);
            if (ends_lf == 0) { send_str(cfd, "\r\n"); }
        }

        # M5-F: list child reply IDs (one-deep) — from the reply index since
        # 1.9.1 (ADR 0027), the board scan before it.
        #
        # 1.9.1 — the line is composed in 2 KB pieces rather than sent id by id:
        # under fork every send_buf is a write(2), and a 409-reply thread cost ~800
        # of them (~5.6 ms) — more than finding the replies. Same bytes on the wire.
        var rbuf = cmd_alloc(DIRENT_ID_MAX * 8);
        var rcount = replies_to(g_store_buf, current_board, id, rbuf, DIRENT_ID_MAX);
        if (rcount > 0) {
            var rline[2048];
            memcpy(&rline, "\r\nReplies: ", 11);
            var rlp = 11;
            # 1.10.1 (ADR 0030) — wrapped to the client's window between ids, the
            # continuation rows under the first id. `rcol` is the output column;
            # with no NAWS width (0) the line is as long as it ever was.
            var rwidth = session_wrap_width();
            var rhang = 9;
            if (rhang > rwidth / 2) { rhang = rwidth / 2; }
            var rcol = 9;
            var ri = 0;
            while (ri < rcount) {
                if (rlp > 2000) { send_buf(cfd, &rline, rlp); rlp = 0; }
                var rid[24];
                var ridn = fmt_int_buf(load64(rbuf + ri * 8), &rid);
                if (ri > 0) {
                    store8((&rline) + rlp, 44);          # ','
                    rlp = rlp + 1;
                    rcol = rcol + 1;
                    # ' ' + the id, and the ',' that will follow it unless it is last.
                    var rneed = 1 + ridn;
                    if (ri + 1 < rcount) { rneed = rneed + 1; }
                    var rbreak = 0;
                    if (rwidth > 0) { if (rcol + rneed > rwidth) { rbreak = 1; } }
                    if (rbreak == 1) {
                        store8((&rline) + rlp, 13);
                        store8((&rline) + rlp + 1, 10);
                        memset((&rline) + rlp + 2, 32, rhang);
                        rlp = rlp + 2 + rhang;
                        rcol = rhang;
                    } else {
                        store8((&rline) + rlp, 32);      # ' '
                        rlp = rlp + 1;
                        rcol = rcol + 1;
                    }
                }
                memcpy((&rline) + rlp, &rid, ridn);
                rlp = rlp + ridn;
                rcol = rcol + ridn;
                ri = ri + 1;
            }
            store8((&rline) + rlp, 13);
            store8((&rline) + rlp + 1, 10);
            send_buf(cfd, &rline, rlp + 2);
        }
        return MODE_COMMAND;
    }

    if (line_has_prefix(line, len, "post") != 0) {
        # M6-E auth gate + M6-F per-board policy (.policy / .admins).
        # board_can_post returns 1 only if both the session is
        # authenticated AND the policy allows; otherwise we give a
        # policy-aware error so the user knows whether to login or
        # ask the operator.
        if (board_can_post(g_store_buf, current_board, g_session_fp, g_session_handle) == 0) {
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "auth required — run 'login <handle>' first\r\n");
            } else {
                send_str(cfd, "post denied by board policy (admin-only or unregistered)\r\n");
            }
            return MODE_COMMAND;
        }
        send_str(cfd, "Subject: ");
        return MODE_POSTING_SUBJECT;
    }

    # M5-F: `reply <id>` — compose a reply to parent post <id> in
    # the current board. Computes Re-prefixed subject from parent,
    # skips Subject prompt, transitions straight to MODE_POSTING.
    # The parent id and derived subject are parked in g_reply_to /
    # g_reply_subject (session-slot state) and read by
    # session_finalize_post at the `.` commit.
    if (line_has_prefix(line, len, "reply") != 0) {
        # M6-E auth gate + M6-F per-board policy (same as `post`).
        if (board_can_post(g_store_buf, current_board, g_session_fp, g_session_handle) == 0) {
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "auth required — run 'login <handle>' first\r\n");
            } else {
                send_str(cfd, "reply denied by board policy (admin-only or unregistered)\r\n");
            }
            return MODE_COMMAND;
        }
        var parent_id = line_parse_int(line, 5, len);
        if (parent_id < 0) {
            send_str(cfd, "usage: reply <id>\r\n");
            return MODE_COMMAND;
        }
        var fbuf = cmd_alloc(POST_MAX_BYTES + 1024);
        var flen = post_read(g_store_buf, current_board, parent_id, fbuf, POST_MAX_BYTES + 1024);
        if (flen <= 0) {
            send_str(cfd, "reply: parent post not found\r\n");
            return MODE_COMMAND;
        }
        # Build the derived Re: subject.
        var parent_sub = cmd_alloc(SUBJECT_MAX_BYTES);
        var ps_len = post_subject(fbuf, flen, parent_sub, SUBJECT_MAX_BYTES);
        var derived = cmd_alloc(SUBJECT_MAX_BYTES + 8);
        subject_reply_prefix(parent_sub, ps_len, derived, SUBJECT_MAX_BYTES + 8);
        # Park the derived subject + parent_id in the session globals —
        # session_finalize_post picks them up at the MODE_POSTING '.' commit.
        g_reply_to = parent_id;
        var dlen = strlen(derived);
        # (1.6.2: g_reply_subject is owned by the session slot — always non-0.)
        memcpy(g_reply_subject, derived, dlen);
        store8(g_reply_subject + dlen, 0);
        g_reply_subject_len = dlen;
        send_str(cfd, "Subject: ");
        send_text(cfd, derived, dlen);
        send_str(cfd, "\r\n");
        send_str(cfd, "Compose reply. End with '.' on a line by itself.\r\n");
        return MODE_POSTING;
    }

    # M6-C: login <handle>. Looks up the handle, generates a 32-byte
    # nonce via /dev/urandom, hex-encodes, sends `challenge: <64-hex>`,
    # parks (fp, nonce_hex) in g_login_*, transitions to
    # MODE_LOGIN_AWAIT_SIG. ADR 0006 § Specifics.
    if (line_has_prefix(line, len, "login") != 0) {
        # Skip "login" + leading spaces. Same shape as the `enter` parse.
        var li = 5;
        var lskip = 1;
        while (lskip == 1) {
            if (li >= len) { lskip = 0; }
            else { if ((load8(line + li) & 0xFF) != 32) { lskip = 0; }
                else                                  { li = li + 1; } }
        }
        if (li >= len) {
            send_str(cfd, "usage: login <handle>\r\n");
            return MODE_COMMAND;
        }
        var hname_len = len - li;
        if (hname_len > ACCOUNT_HANDLE_MAX) {
            send_str(cfd, "handle too long (max 32 bytes)\r\n");
            return MODE_COMMAND;
        }
        var hname_buf = cmd_alloc(ACCOUNT_HANDLE_BUF);
        memcpy(hname_buf, line + li, hname_len);
        store8(hname_buf + hname_len, 0);

        # Resolve handle → fingerprint via the M6-B scan.
        var got = account_resolve_handle(g_store_buf, hname_buf, g_login_fp);
        if (got != 1) {
            send_str(cfd, "unknown user\r\n");
            store8(g_login_fp, 0);
            return MODE_COMMAND;
        }

        # Generate the nonce, hex-encode, park.
        var nonce_raw[32];
        if (nonce_random(&nonce_raw) != 0) {
            send_str(cfd, "login failed (entropy)\r\n");
            store8(g_login_fp, 0);
            return MODE_COMMAND;
        }
        nonce_to_hex(&nonce_raw, g_login_nonce);
        g_login_started_ms = clock_now_ms();

        send_str(cfd, "challenge: ");
        send_buf(cfd, g_login_nonce, ACCOUNT_NONCE_HEX_BYTES);
        send_str(cfd, "\r\nreply with: auth: <128-hex-ed25519-sig over \"agora-login:\" + challenge>\r\n");
        return MODE_LOGIN_AWAIT_SIG;
    }

    # M6-D: `whoami` — print bound identity or "anonymous".
    if (line_has_prefix(line, len, "whoami") != 0) {
        if ((load8(g_session_fp) & 0xFF) == 0) {
            send_str(cfd, "anonymous\r\n");
        } else {
            if ((load8(g_session_handle) & 0xFF) != 0) {
                send_str(cfd, g_session_handle);
                send_str(cfd, " ");
            }
            send_str(cfd, g_session_fp);
            send_str(cfd, "\r\n");
        }
        return MODE_COMMAND;
    }

    # 1.1.0: `play <game> [mode]` — launch a door game (ADR 0009).
    if (line_has_prefix(line, len, "play") != 0) {
        # token 1 = game name, token 2 = mode (optional, default practice)
        var p = 4;
        var sk = 1;
        while (sk == 1) {
            if (p >= len) { sk = 0; }
            else { if ((load8(line + p) & 0xFF) != 32) { sk = 0; } else { p = p + 1; } }
        }
        var gstart = p;
        var ge = 1;
        while (ge == 1) {
            if (p >= len) { ge = 0; }
            else { if ((load8(line + p) & 0xFF) == 32) { ge = 0; } else { p = p + 1; } }
        }
        var glen = p - gstart;
        if (glen <= 0) {
            send_str(cfd, "usage: play <smuggler|port|handler|eliza|parry|quest|jabberwacky|olympiad|ashes|decode>");
            send_str(cfd, " [practice|solo|universe]\r\n");
            return MODE_COMMAND;
        }
        if (glen > 15) { glen = 15; }
        var gbuf = cmd_alloc(16);
        memcpy(gbuf, line + gstart, glen);
        store8(gbuf + glen, 0);
        var sk2 = 1;
        while (sk2 == 1) {
            if (p >= len) { sk2 = 0; }
            else { if ((load8(line + p) & 0xFF) != 32) { sk2 = 0; } else { p = p + 1; } }
        }
        var mstart = p;
        var me = 1;
        while (me == 1) {
            if (p >= len) { me = 0; }
            else { if ((load8(line + p) & 0xFF) == 32) { me = 0; } else { p = p + 1; } }
        }
        var mlen = p - mstart;
        if (mlen > 15) { mlen = 15; }
        var mbuf = cmd_alloc(16);
        if (mlen > 0) { memcpy(mbuf, line + mstart, mlen); }
        store8(mbuf + mlen, 0);

        # 1.11.1 — the name is looked up in the registry (it was a second,
        # hand-kept list of the ten names, one more place a new door had to edit).
        var game = door_game_by_name(gbuf, 0);
        if (game == GAME_NONE) {
            send_str(cfd, "unknown game. try: play ");
            door_send_names(cfd, 0, " | ");
            send_str(cfd, "\r\n");
            return MODE_COMMAND;
        }
        var dmode = DOOR_PRACTICE;
        if (streq(mbuf, "solo") != 0)     { dmode = DOOR_SOLO; }
        if (streq(mbuf, "universe") != 0) { dmode = DOOR_UNIVERSE; }
        # 1.4.6 (R7 / ADR 0020): per-game mode coercion is descriptor data
        # (DD_MODE_POLICY). Chatbots force practice (no save, no world); the
        # solo-only games (QUEST/Jabberwacky/Olympiad/Decode) downgrade a
        # `universe` request to solo — without this they'd fall into the
        # unwired DOOR_UNIVERSE branch, leave g_door_state NULL, and segfault
        # the worker on the first render; Ashes forces universe (the map IS
        # the game). Smuggler/Port/Handler are DM_NORMAL (all modes allowed).
        var pd = door_desc_for(game);
        if (pd != 0) {
            var mp = load64(pd + DD_MODE_POLICY);
            if (mp == DM_PRACTICE_ONLY)  { dmode = DOOR_PRACTICE; }
            if (mp == DM_NO_UNIVERSE)    { if (dmode == DOOR_UNIVERSE) { dmode = DOOR_SOLO; } }
            if (mp == DM_FORCE_UNIVERSE) { dmode = DOOR_UNIVERSE; }
        }

        if (dmode == DOOR_UNIVERSE) {
            # 1.2.0 (ADR 0010 bites 2-4): the Universe doors (Smuggler, Port
            # Authority, The Handler; Ashes since 1.3.7) have a shared
            # Universe. Login-gated — a persistent actor needs an identity.
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "Universe play needs an identity — log in first ('login <handle>').\r\n");
                return MODE_COMMAND;
            }
            # 1.6.3 — a `play` while a state is already live would orphan it.
            door_state_free();
            # (1.6.2: g_uni_world is owned by the session slot — always non-0.)
            var uslot = door_universe_slot(game);
            if (door_take_play_lock(cfd, uslot) == 0) { return MODE_COMMAND; }
            g_door_game = game;
            g_door_mode = DOOR_UNIVERSE;
            var uloaded = 0;
            if (door_save_exists(g_store_buf, g_session_fp, uslot) == 1) {
                var ulbuf = cmd_alloc(DOOR_SAVE_CAP);
                var uln = door_save_read(g_store_buf, g_session_fp, uslot, ulbuf, DOOR_SAVE_CAP);
                if (uln > 0) {
                    var uld = door_desc_for(game);
                    var ulfp = 0;
                    if (uld != 0) { ulfp = load64(uld + DD_LOAD); }
                    if (ulfp != 0) { g_door_state = callptr(ulfp, ulbuf, uln); }
                    if (g_door_state != 0) { uloaded = 1; }
                }
                uloaded = door_vet_loaded(cfd, game, uslot, uloaded);
            }
            if (uloaded == 0) {
                var und = door_desc_for(game);
                var unfp = 0;
                var unseed = clock_now_ns();
                var undays = 0;
                if (und != 0) {
                    unfp = load64(und + DD_NEW);
                    undays = load64(und + DD_DEF_DAYS);
                    var us = load64(und + DD_UNI_SEED);   # PA's galaxy seed; 0 -> clock for the rest
                    if (us != 0) { unseed = us; }
                }
                if (unfp != 0) { g_door_state = callptr(unfp, unseed, DOOR_UNIVERSE, undays); }
            }
            var usd = door_desc_for(game);
            if (usd != 0) {
                var ustfp = load64(usd + DD_START);
                if (ustfp != 0) { var usr = callptr(ustfp, g_door_state); }
                var ufpoff = load64(usd + DD_FP_OFF);
                if (ufpoff != 0) {
                    var realoff = ufpoff - 1;   # undo the +1 bias (AE_FP legitimately == 0)
                    store64(g_door_state + realoff, hex16_to_i64(g_session_fp));
                }
            }
            # Prime the world — mints + persists it on the first ever entry
            # — so the opening frame already reflects shared state. For Ashes,
            # door_world_begin also runs the lazy turn resolution; surface the
            # async "what happened while you were gone" notice after it ticks.
            var ufd = door_world_begin();
            if (ufd >= 0) {
                door_set_world(game, g_uni_world);
                var oed = door_desc_for(game);
                if (oed != 0) {
                    var oefp = load64(oed + DD_ON_ENTRY);
                    if (oefp != 0) { var oer = callptr(oefp, g_door_state); }
                }
                door_world_commit(ufd);
            }
            store64(g_active_sess + SESS_DOOR_OVER0, door_is_over());
            door_send_frame(cfd);
            return MODE_DOOR;
        }
        if (dmode == DOOR_SOLO) {
            if ((load8(g_session_fp) & 0xFF) == 0) {
                send_str(cfd, "solo play saves progress — log in first ('login <handle>').\r\n");
                return MODE_COMMAND;
            }
        }

        # 1.6.3 — same guard as the Universe branch above: never overwrite a
        # live state pointer, or its buffers are orphaned for the life of the
        # server under poll.
        door_state_free();
        if (dmode == DOOR_SOLO) {
            if (door_take_play_lock(cfd, door_game_name(game)) == 0) { return MODE_COMMAND; }
        }
        g_door_game = game;
        g_door_mode = dmode;
        var seed = clock_now_ns();
        var loaded = 0;
        if (dmode == DOOR_SOLO) {
            var nm = door_game_name(game);
            if (door_save_exists(g_store_buf, g_session_fp, nm) == 1) {
                var lbuf = cmd_alloc(DOOR_SAVE_CAP);
                var ln = door_save_read(g_store_buf, g_session_fp, nm, lbuf, DOOR_SAVE_CAP);
                if (ln > 0) {
                    var sld = door_desc_for(game);
                    var slfp = 0;
                    if (sld != 0) { slfp = load64(sld + DD_LOAD); }
                    if (slfp != 0) { g_door_state = callptr(slfp, lbuf, ln); }
                    if (g_door_state != 0) { loaded = 1; }
                }
                loaded = door_vet_loaded(cfd, game, nm, loaded);
            }
        }
        if (loaded == 0) {
            var nd = door_desc_for(game);
            if (nd != 0) {
                var nfp = load64(nd + DD_NEW);
                var ndays = load64(nd + DD_DEF_DAYS);
                if (nfp != 0) { g_door_state = callptr(nfp, seed, dmode, ndays); }
            }
        }
        var ssd = door_desc_for(game);
        if (ssd != 0) {
            var sstfp = load64(ssd + DD_START);
            if (sstfp != 0) { var ssr = callptr(sstfp, g_door_state); }
        }
        store64(g_active_sess + SESS_DOOR_OVER0, door_is_over());
        door_send_frame(cfd);
        return MODE_DOOR;
    }

    # 1.2.0 bite 5: `scores <game>` — show a game's top-10 leaderboard.
    if (line_has_prefix(line, len, "scores") != 0) {
        var scsp = 6;
        var scsk = 1;
        while (scsk == 1) {
            if (scsp >= len) { scsk = 0; }
            else { if ((load8(line + scsp) & 0xFF) != 32) { scsk = 0; } else { scsp = scsp + 1; } }
        }
        var scgs = scsp;
        var scge = 1;
        while (scge == 1) {
            if (scsp >= len) { scge = 0; }
            else { if ((load8(line + scsp) & 0xFF) == 32) { scge = 0; } else { scsp = scsp + 1; } }
        }
        var scgl = scsp - scgs;
        if (scgl <= 0) {
            send_str(cfd, "usage: scores <");
            door_send_names(cfd, DD_SCORE, "|");
            send_str(cfd, ">\r\n");
            return MODE_COMMAND;
        }
        if (scgl > 15) { scgl = 15; }
        var scgb = cmd_alloc(16);
        memcpy(scgb, line + scgs, scgl);
        store8(scgb + scgl, 0);
        # 1.11.1 — only a game with a leaderboard (a DD_SCORE slot) has scores.
        var scgame = door_game_by_name(scgb, DD_SCORE);
        if (scgame == GAME_NONE) {
            send_str(cfd, "unknown game. try: scores ");
            door_send_names(cfd, DD_SCORE, " | ");
            send_str(cfd, "\r\n");
            return MODE_COMMAND;
        }
        door_render_leaderboard(cfd, scgame);
        return MODE_COMMAND;
    }

    # 1.3.0: `chat [channel]` — join a live chat channel (ADR 0011).
    # Login-gated: a chat presence is a persistent-ish actor (needs an
    # identity), same rule as Universe. Default channel "lobby".
    if (line_has_prefix(line, len, "chat") != 0) {
        if ((load8(g_session_fp) & 0xFF) == 0) {
            send_str(cfd, "chat needs an identity — log in first ('login <handle>').\r\n");
            return MODE_COMMAND;
        }
        var ci = 4;
        var csk = 1;
        while (csk == 1) {
            if (ci >= len) { csk = 0; }
            else { if ((load8(line + ci) & 0xFF) != 32) { csk = 0; } else { ci = ci + 1; } }
        }
        var chan = cmd_alloc(CHAT_CHANNEL_MAX + 1);
        if (ci >= len) {
            memcpy(chan, "lobby", 5); store8(chan + 5, 0);
        } else {
            var clen = len - ci;
            if (clen > CHAT_CHANNEL_MAX) {
                send_str(cfd, "channel name too long (max 32 bytes)\r\n");
                return MODE_COMMAND;
            }
            memcpy(chan, line + ci, clen); store8(chan + clen, 0);
            if (chat_channel_valid(chan) == 0) {
                send_str(cfd, "invalid channel name (lowercase ASCII + digits + '-' / '_', 1-32 bytes)\r\n");
                return MODE_COMMAND;
            }
        }
        var crc = chat_dir_ensure(g_store_buf, chan);
        if (crc == (0 - CHAT_E_FULL)) {
            send_str(cfd, "too many chat channels (64) — join an existing one\r\n");
            return MODE_COMMAND;
        }
        if (crc != 0) {
            send_str(cfd, "could not open channel\r\n");
            return MODE_COMMAND;
        }
        memcpy(g_chat_channel, chan, strlen(chan) + 1);
        # Banner + scrollback (last CHAT_SCROLLBACK_LINES); set the
        # live-tail watermark to the latest seq so only NEW lines stream.
        send_str(cfd, "\r\n-- chat: #");
        send_str(cfd, g_chat_channel);
        send_str(cfd, " --  (type a line to talk; /help for commands, /leave to exit)\r\n");
        var lbuf = cmd_alloc(CHAT_LOG_BUF);
        var ln = chat_log_read(g_store_buf, g_chat_channel, lbuf, CHAT_LOG_CAP);
        var seenp = cmd_alloc(8);
        store64(seenp, 0);
        if (ln > 0) {
            var ob = cmd_alloc(CHAT_TAIL_CAP);
            var ol = chat_emit_tail_k(lbuf, ln, CHAT_SCROLLBACK_LINES, ob, CHAT_TAIL_CAP, seenp);
            if (ol > 0) { send_wrapped(cfd, ob, ol, 0, 0, TW_TAG); }   # 1.10.1: under the speaker
        }
        g_chat_seen = load64(seenp);
        g_chat_idle = 0;
        # Drop the recv timeout to the live-tail poll cadence so an idle
        # recv becomes a tail tick (handle_client) instead of a hangup.
        sock_set_recv_timeout(cfd, CHAT_POLL_SECS, 0);
        return MODE_CHAT;
    }

    # 1.4.0 (ADR 0017): `descent` — step through the portal into the
    # sibling Yeoman's Descent MUD. Login-gated like chat (a citizen
    # steps through; the MUD still runs its own login). 1.11.0 (ADR 0031) —
    # it no longer blocks: descent_begin dials and returns MODE_DESCENT, and the
    # serve loop moves the bytes (descent_pump) until the visit ends.
    if (line_has_prefix(line, len, "descent") != 0) {
        if ((load8(g_session_fp) & 0xFF) == 0) {
            send_str(cfd, "descent needs an identity — log in first ('login <handle>').\r\n");
            return MODE_COMMAND;
        }
        return descent_begin(cfd);
    }

    if (line_has_prefix(line, len, "quit") != 0) {
        send_str(cfd, "bye\r\n");
        store64(quit_out, 1);
        return MODE_COMMAND;
    }
    if (line_has_prefix(line, len, "exit") != 0) {
        send_str(cfd, "bye\r\n");
        store64(quit_out, 1);
        return MODE_COMMAND;
    }
    if (line_has_prefix(line, len, "bye") != 0) {
        send_str(cfd, "bye\r\n");
        store64(quit_out, 1);
        return MODE_COMMAND;
    }

    send_str(cfd, "unknown command — type 'help' for the list\r\n");
    return MODE_COMMAND;
}

# === 1.1.0 door subsystem glue (ADR 0009) ===
#
# The games are pure modules (render into a buffer, consume one line);
# these helpers own the socket I/O + persistence that the MODE_DOOR
# dispatch and the `play` command call.

# === 1.4.6 (R7): the per-game door descriptor registry ===
#
# Every door's identity + behavior lives in ONE descriptor record keyed by
# its GAME_* id, instead of being smeared across ~16 `if (game == GAME_X)`
# dispatch functions. Adding a door is now a single registry block, not an
# edit to eighteen call sites. The behavior slots hold function addresses
# (`&xx_render`, …) called via `callptr`; an absent capability is a 0 slot
# the dispatcher falls back on (e.g. a chatbot has no save / no is_over).
# Uniform signatures make this safe: render(st,buf,cap), feed(st,line,len),
# is_over(st), save_format(st,buf,cap), new(seed,mode,days), load(buf,len).
enum DoorDesc {
    DD_NAME        = 0;     # cstring — the `play <name>` / leaderboard name
    DD_USLOT       = 8;     # cstring — Universe per-player save slot ("<game>u"); 0 = solo-only
    DD_RENDER      = 16;    # fn(st,buf,cap)->i64
    DD_FEED        = 24;    # fn(st,line,len)->i64
    DD_IS_OVER     = 32;    # fn(st)->i64  (0 = never over — chatbots)
    DD_SAVE_FMT    = 40;    # fn(st,buf,cap)->i64  (0 = no save)
    DD_NEW         = 48;    # fn(seed,mode,days)->st  (2-arg news ignore days)
    DD_LOAD        = 56;    # fn(buf,len)->st  (0 = no load)
    DD_DEF_DAYS    = 64;    # i64 — 3rd arg to NEW
    DD_FLAGS       = 72;    # bitfield (DF_*)
    DD_WORLD_BYTES = 80;    # fn()->i64 snapshot size (0 = not a Universe game; default 8)
    DD_WORLD_VALID = 88;    # fn(buf,len)->i64
    DD_WORLD_NEW   = 96;    # fn(seed)->ptr  (seedless world ctors ignore the arg)
    DD_WORLD_SEED  = 104;   # i64 seed for WORLD_NEW
    DD_WORLD_OFF   = 112;   # byte offset of the world ptr field inside the game state
    DD_MSG         = 120;   # fn(st,cstr)  — Universe "world is busy" notice
    DD_BUSY        = 128;   # cstring — the busy notice text
    DD_SCORE       = 136;   # fn(st)->i64 final score (0 = no leaderboard)
    DD_RANK        = 144;   # fn(score)->cstring rank label
    DD_WORLD_TICK  = 152;   # fn(world,turn) lazy turn-batch resolve on world-open (0 = none)
    DD_TICK_NS     = 160;   # i64 ns per turn (divisor for the tick turn number)
    DD_START       = 168;   # fn(st) post-construction start hook (0 = none, e.g. Olympiad)
    DD_FP_OFF      = 176;   # (byte offset + 1) to store the session fp (hex16->i64); 0 = none
    # (the +1 bias is because a real fp field can sit at offset 0, e.g. AE_FP)
    DD_UNI_SEED    = 184;   # i64 game-state seed override for Universe new (0 = clock)
    DD_ON_ENTRY    = 192;   # fn(st) Universe on-entry hook (Ashes founding); 0 = none
    DD_MODE_POLICY = 200;   # DM_* mode coercion applied by the `play` launcher
    # 1.6.3 (ADR 0022) — fn(st) releasing a door state and everything it owns.
    # 0 = this game's state is not freeable (none today: all ten register one).
    # The state and its owned buffers come from the FREELIST (fl_alloc), not the
    # bump allocator, so the pairing is real; a game's *_free lives next to its
    # constructor in the same module, which is how the pairing stays honest.
    DD_FREE        = 208;
    # 1.11.1 — the chat couch (ADR 0011 / 0012), in the registry since 1.11.1: a
    # door with a DD_COUCH_CMD can be talked to privately inside chat.
    DD_COUCH_CMD   = 216;   # cstring — the chat command that opens the couch ("/eliza"); 0 = none
    DD_COUCH_NAME  = 224;   # cstring — the reply prefix ("ELIZA: ")
    DD_COUCH_HELP  = 232;   # cstring — the /help blurb ("(the DOCTOR)")
    DD_COUCH_NOTE  = 240;   # cstring — the line shown when the couch opens
    DD_REPLY       = 248;   # fn(st, lenp)->buf — the last reply, its length at lenp (couch bots)
    DD_SIZE        = 256;
    DF_UNIVERSE    = 1;     # DD_FLAGS bit — shared-world game
    DM_NORMAL         = 0;  # practice / solo / universe all allowed
    DM_PRACTICE_ONLY  = 1;  # chatbots — force practice (no save, no world)
    DM_NO_UNIVERSE    = 2;  # real solo/practice game — downgrade a `universe` request to solo
    DM_FORCE_UNIVERSE = 3;  # inherently shared world — force universe
}

var g_door_registry = 0;   # alloc'd: (GAME_LAST+1) i64 slots, game id -> descriptor ptr

# Allocate + zero a descriptor and slot it into the registry by game id.
fn dd_new_desc(game): i64 {
    var d = alloc(DD_SIZE);
    memset(d, 0, DD_SIZE);
    store64(g_door_registry + game * 8, d);
    return d;
}

# Active descriptor for a game id, or 0 (uninitialized / out of range / NONE).
fn door_desc_for(game): i64 {
    if (g_door_registry == 0) { return 0; }
    if (game < 1) { return 0; }
    if (game > GAME_LAST) { return 0; }
    return load64(g_door_registry + game * 8);
}

# Build the registry once per process (guarded in handle_client). Each block
# IS a door's entry — to add a game, add one block here and nothing else.
fn door_registry_init(): i64 {
    g_door_registry = alloc((GAME_LAST + 1) * 8);
    memset(g_door_registry, 0, (GAME_LAST + 1) * 8);
    var d = 0;

    d = dd_new_desc(GAME_SMUGGLER);
    store64(d + DD_NAME, "smuggler");      store64(d + DD_USLOT, "smuggleru");
    store64(d + DD_RENDER, &sl_render);    store64(d + DD_FEED, &sl_feed);
    store64(d + DD_IS_OVER, &sl_is_over);  store64(d + DD_SAVE_FMT, &sl_save_format);
    store64(d + DD_NEW, &sl_new);
    store64(d + DD_FREE, &sl_free);          store64(d + DD_LOAD, &sl_load_parse);
    store64(d + DD_DEF_DAYS, SL_DEF_DAYS); store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &slw_byte_size); store64(d + DD_WORLD_VALID, &slw_valid);
    store64(d + DD_WORLD_NEW, &slw_new);   store64(d + DD_WORLD_SEED, 0);
    store64(d + DD_WORLD_OFF, SL_WORLD);
    store64(d + DD_MSG, &sl_msg);          store64(d + DD_BUSY, "The streets are busy — try again.");
    store64(d + DD_SCORE, &sl_final_score); store64(d + DD_RANK, &sl_rank);
    store64(d + DD_START, &sl_start);

    d = dd_new_desc(GAME_PORT);
    store64(d + DD_NAME, "port");          store64(d + DD_USLOT, "portu");
    store64(d + DD_RENDER, &pa_render);    store64(d + DD_FEED, &pa_feed);
    store64(d + DD_IS_OVER, &pa_is_over);  store64(d + DD_SAVE_FMT, &pa_save_format);
    store64(d + DD_NEW, &pa_new);
    store64(d + DD_FREE, &pa_free);          store64(d + DD_LOAD, &pa_load_parse);
    store64(d + DD_DEF_DAYS, PA_DEF_DAYS); store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &paw_byte_size); store64(d + DD_WORLD_VALID, &paw_valid);
    store64(d + DD_WORLD_NEW, &paw_new);   store64(d + DD_WORLD_SEED, PA_UNIVERSE_SEED);
    store64(d + DD_WORLD_OFF, PA_WORLD);
    store64(d + DD_MSG, &pa_msg);          store64(d + DD_BUSY, "The galaxy is busy — try again.");
    store64(d + DD_SCORE, &pa_final_score); store64(d + DD_RANK, &pa_rank);
    store64(d + DD_START, &pa_start);       store64(d + DD_FP_OFF, PA_FP + 1);
    store64(d + DD_UNI_SEED, PA_UNIVERSE_SEED);

    d = dd_new_desc(GAME_HANDLER);
    store64(d + DD_NAME, "handler");       store64(d + DD_USLOT, "handleru");
    store64(d + DD_RENDER, &th_render);    store64(d + DD_FEED, &th_feed);
    store64(d + DD_IS_OVER, &th_is_over);  store64(d + DD_SAVE_FMT, &th_save_format);
    store64(d + DD_NEW, &th_new);
    store64(d + DD_FREE, &th_free);          store64(d + DD_LOAD, &th_load_parse);
    store64(d + DD_DEF_DAYS, TH_DEF_DAYS); store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &thw_byte_size); store64(d + DD_WORLD_VALID, &thw_valid);
    store64(d + DD_WORLD_NEW, &thw_new);   store64(d + DD_WORLD_SEED, 0);
    store64(d + DD_WORLD_OFF, TH_WORLD);
    store64(d + DD_MSG, &th_msg);          store64(d + DD_BUSY, "The registry is busy — try again.");
    store64(d + DD_SCORE, &th_score);      store64(d + DD_RANK, &th_rank);
    store64(d + DD_START, &th_start);

    d = dd_new_desc(GAME_ELIZA);
    store64(d + DD_NAME, "eliza");
    store64(d + DD_RENDER, &ez_render);    store64(d + DD_FEED, &ez_feed);
    store64(d + DD_NEW, &ez_new);
    store64(d + DD_FREE, &ez_free);          store64(d + DD_DEF_DAYS, EZ_DEF_DAYS);
    store64(d + DD_START, &ez_start);       store64(d + DD_MODE_POLICY, DM_PRACTICE_ONLY);
    store64(d + DD_COUCH_CMD, "/eliza");    store64(d + DD_COUCH_NAME, "ELIZA: ");
    store64(d + DD_COUCH_HELP, "(the DOCTOR)");
    store64(d + DD_COUCH_NOTE, "(private session with Eliza -- /eliza to return to the room, 'bye' to leave her)");
    store64(d + DD_REPLY, &ez_reply);

    d = dd_new_desc(GAME_PARRY);
    store64(d + DD_NAME, "parry");
    store64(d + DD_RENDER, &py_render);    store64(d + DD_FEED, &py_feed);
    store64(d + DD_NEW, &py_new);
    store64(d + DD_FREE, &py_free);          store64(d + DD_DEF_DAYS, PY_DEF_DAYS);
    store64(d + DD_START, &py_start);       store64(d + DD_MODE_POLICY, DM_PRACTICE_ONLY);
    store64(d + DD_COUCH_CMD, "/parry");    store64(d + DD_COUCH_NAME, "PARRY: ");
    store64(d + DD_COUCH_HELP, "(the paranoiac)");
    store64(d + DD_COUCH_NOTE, "(private session with Parry -- /parry to return to the room, 'bye' to leave him)");
    store64(d + DD_REPLY, &py_reply);

    d = dd_new_desc(GAME_QUEST);
    store64(d + DD_NAME, "quest");
    store64(d + DD_RENDER, &qu_render);    store64(d + DD_FEED, &qu_feed);
    store64(d + DD_IS_OVER, &qu_is_over);  store64(d + DD_SAVE_FMT, &qu_save_format);
    store64(d + DD_NEW, &qu_new);
    store64(d + DD_FREE, &qu_free);          store64(d + DD_LOAD, &qu_load_parse);
    store64(d + DD_DEF_DAYS, 0);
    store64(d + DD_SCORE, &qu_final_score); store64(d + DD_RANK, &qu_rank);
    store64(d + DD_START, &qu_start);       store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    d = dd_new_desc(GAME_JABBER);
    store64(d + DD_NAME, "jabberwacky");
    store64(d + DD_RENDER, &jw_render);    store64(d + DD_FEED, &jw_feed);
    store64(d + DD_IS_OVER, &jw_is_over);  store64(d + DD_SAVE_FMT, &jw_save_format);
    store64(d + DD_NEW, &jw_new);
    store64(d + DD_FREE, &jw_free);          store64(d + DD_LOAD, &jw_load_parse);
    store64(d + DD_DEF_DAYS, JW_DEF_DAYS);
    store64(d + DD_START, &jw_start);       store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);
    store64(d + DD_COUCH_CMD, "/jabberwacky"); store64(d + DD_COUCH_NAME, "JABBERWACKY: ");
    store64(d + DD_COUCH_HELP, "(the mimic)");
    var jnote = "(private session with Jabberwacky -- /jabberwacky to return to the room, 'bye' to leave)";
    store64(d + DD_COUCH_NOTE, jnote);
    store64(d + DD_REPLY, &jw_reply);

    d = dd_new_desc(GAME_OLYMPIAD);
    store64(d + DD_NAME, "olympiad");
    store64(d + DD_RENDER, &ol_render);    store64(d + DD_FEED, &ol_feed);
    store64(d + DD_IS_OVER, &ol_is_over);  store64(d + DD_SAVE_FMT, &ol_save_format);
    store64(d + DD_NEW, &ol_new);
    store64(d + DD_FREE, &ol_free);          store64(d + DD_LOAD, &ol_load_parse);
    store64(d + DD_DEF_DAYS, 0);
    store64(d + DD_SCORE, &ol_final_score); store64(d + DD_RANK, &ol_rank);
    store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    d = dd_new_desc(GAME_ASHES);
    store64(d + DD_NAME, "ashes");         store64(d + DD_USLOT, "ashesu");
    store64(d + DD_RENDER, &ash_render);   store64(d + DD_FEED, &ash_feed);
    store64(d + DD_IS_OVER, &ash_is_over); store64(d + DD_SAVE_FMT, &ash_save_format);
    store64(d + DD_NEW, &ash_new);
    store64(d + DD_FREE, &ash_free);         store64(d + DD_LOAD, &ash_load_parse);
    store64(d + DD_DEF_DAYS, 0);           store64(d + DD_FLAGS, DF_UNIVERSE);
    store64(d + DD_WORLD_BYTES, &ashw_byte_size); store64(d + DD_WORLD_VALID, &ashw_valid);
    store64(d + DD_WORLD_NEW, &ashw_new);  store64(d + DD_WORLD_SEED, ASH_WORLD_SEED);
    store64(d + DD_WORLD_OFF, AE_WORLD);
    store64(d + DD_MSG, &ash_msg);         store64(d + DD_BUSY, "the realm is busy — try again.");
    store64(d + DD_SCORE, &ash_final_score); store64(d + DD_RANK, &ash_rank);
    store64(d + DD_WORLD_TICK, &ash_world_tick); store64(d + DD_TICK_NS, ASH_NS_PER_TURN);
    store64(d + DD_START, &ash_start);      store64(d + DD_FP_OFF, AE_FP + 1);
    store64(d + DD_ON_ENTRY, &ash_on_entry); store64(d + DD_MODE_POLICY, DM_FORCE_UNIVERSE);

    d = dd_new_desc(GAME_DECODE);
    store64(d + DD_NAME, "decode");
    store64(d + DD_RENDER, &decode_render);   store64(d + DD_FEED, &decode_feed);
    store64(d + DD_IS_OVER, &decode_is_over); store64(d + DD_SAVE_FMT, &decode_save_format);
    store64(d + DD_NEW, &decode_new);
    store64(d + DD_FREE, &decode_free);         store64(d + DD_LOAD, &decode_load_parse);
    store64(d + DD_DEF_DAYS, 0);
    store64(d + DD_SCORE, &decode_final_score); store64(d + DD_RANK, &decode_rank);
    store64(d + DD_START, &decode_start);   store64(d + DD_MODE_POLICY, DM_NO_UNIVERSE);

    return 0;
}

# 1.11.1 — the door whose registry name is `name` (a cstring), or GAME_NONE. With
# `need` non-zero only a door whose descriptor slot `need` is filled counts
# (DD_SCORE: a door with a leaderboard). The registry IS the list of doors, so a
# new door needs no parser edit.
fn door_game_by_name(name, need): i64 {
    var g = 1;
    var found = GAME_NONE;
    while (g <= GAME_LAST) {
        var d = door_desc_for(g);
        if (d != 0) {
            var nm = load64(d + DD_NAME);
            if (nm != 0) {
                if (streq(name, nm) != 0) {
                    if (need == 0) { found = g; }
                    else { if (load64(d + need) != 0) { found = g; } }
                }
            }
        }
        g = g + 1;
    }
    return found;
}

# Send the registry names of every door (with slot `need` filled, when non-zero),
# in id order, joined by `sep`.
fn door_send_names(cfd, need, sep): i64 {
    var g = 1;
    var first = 1;
    while (g <= GAME_LAST) {
        var d = door_desc_for(g);
        var ok = 0;
        if (d != 0) {
            if (load64(d + DD_NAME) != 0) {
                ok = 1;
                if (need != 0) { if (load64(d + need) == 0) { ok = 0; } }
            }
        }
        if (ok == 1) {
            if (first == 0) { send_str(cfd, sep); }
            send_str(cfd, load64(d + DD_NAME));
            first = 0;
        }
        g = g + 1;
    }
    return 0;
}

# Write `prefix` and every door's registry name joined by `sep` into buf, at most
# `cap` bytes (a name that would not fit is left off); returns the length.
fn door_names_into(buf, prefix, sep, cap): i64 {
    var n = strlen(prefix);
    memcpy(buf, prefix, n);
    var g = 1;
    var first = 1;
    while (g <= GAME_LAST) {
        var d = door_desc_for(g);
        if (d != 0) {
            var nm = load64(d + DD_NAME);
            if (nm != 0) {
                var need = strlen(nm);
                if (first == 0) { need = need + strlen(sep); }
                if (n + need <= cap) {
                    if (first == 0) { memcpy(buf + n, sep, strlen(sep)); n = n + strlen(sep); }
                    memcpy(buf + n, nm, strlen(nm));
                    n = n + strlen(nm);
                    first = 0;
                }
            }
        }
        g = g + 1;
    }
    return n;
}

# The registry name of door `game` ("port", "quest", ...) — also its save/world slot name; "game" if unknown.
fn door_game_name(game): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return "game"; }
    var nm = load64(d + DD_NAME);
    if (nm == 0) { return "game"; }
    return nm;
}

# === 1.3.0 chat glue (ADR 0011) ===
#
# The transcript layer is pure + storage (chat.cyr); these own the
# socket I/O the MODE_CHAT dispatch + live-tail tick call.

# Render every transcript line newer than this session's watermark and
# send it, advancing g_chat_seen. Called on each idle poll tick and
# right after the session says a line (so the speaker sees their own
# line in canonical form). No-op when nothing is new.
# 1.6.3 (audit) — these three were per-CALL bump allocations, and this function
# runs on every idle chat tick (every CHAT_TICK_MS while a session sits in a
# channel), not just after a typed line. That put it outside the per-line arena
# reset in process_rx, so under poll a single idle chat session leaked
# CHAT_LOG_BUF + CHAT_TAIL_CAP + 8 every couple of seconds, forever.
#
# Dedicated process-lifetime statics rather than cmd_alloc, precisely BECAUSE
# the tick is not bracketed by a reset. They are safe to share: dispatch is
# single-threaded (the poll sweep runs one session to completion before the
# next), and neither buffer outlives the call — the bytes are handed to
# send_buf before returning. Bare `= 0` initializers take the static-init fast
# path, so they cost no gvar_toks slot (CLAUDE.md counting rule).
var g_chat_tail_buf   = 0;
var g_chat_tail_out   = 0;
var g_chat_tail_seenp = 0;

# Send the active session any chat lines newer than its watermark (the live tail); pure statics, no per-tick alloc.
fn chat_flush_tail(cfd): i64 {
    if (g_chat_tail_buf == 0)   { g_chat_tail_buf = alloc(CHAT_LOG_BUF); }
    if (g_chat_tail_out == 0)   { g_chat_tail_out = alloc(CHAT_TAIL_CAP); }
    if (g_chat_tail_seenp == 0) { g_chat_tail_seenp = alloc(8); }
    var buf = g_chat_tail_buf;
    var n = chat_log_read(g_store_buf, g_chat_channel, buf, CHAT_LOG_CAP);
    if (n <= 0) { return 0; }
    var out = g_chat_tail_out;
    var seenp = g_chat_tail_seenp;
    store64(seenp, g_chat_seen);
    var olen = chat_emit_since(buf, n, g_chat_seen, out, CHAT_TAIL_CAP, seenp);
    # 1.10.1 (ADR 0030) — wrapped to this reader's window, continuation rows
    # aligned after the speaker's "<handle> ".
    if (olen > 0) { send_wrapped(cfd, out, olen, 0, 0, TW_TAG); }
    g_chat_seen = load64(seenp);
    return 0;
}

# Dispatch a '/'-prefixed chat command. Returns 0 = stay in chat,
# 1 = leave chat (back to the BBS prompt), 2 = quit the session.
fn chat_cmd_dispatch(cfd, line, len): i64 {
    if (line_has_prefix(line, len, "/leave") != 0) {
        send_str(cfd, "left #");
        send_str(cfd, g_chat_channel);
        send_str(cfd, ".\r\n");
        return 1;
    }
    if (line_has_prefix(line, len, "/quit") != 0) {
        send_str(cfd, "bye\r\n");
        return 2;
    }
    if (line_has_prefix(line, len, "/exit") != 0) {
        send_str(cfd, "bye\r\n");
        return 2;
    }
    # 1.3.0 / 1.3.1 / 1.3.3 (ADR 0011, 0015): `/eliza`, `/parry`, `/jabberwacky`
    # toggle a private side-channel with that bot. 1.11.1 — any door with a
    # DD_COUCH_CMD is a couch bot; the three hand-written blocks are gone.
    var cgame = couch_game_for(line, len);
    if (cgame != GAME_NONE) { return couch_toggle(cfd, cgame); }
    if (line_has_prefix(line, len, "/help") != 0) {
        send_str(cfd, "chat commands:  /leave (back to BBS)");
        var hg = 1;
        while (hg <= GAME_LAST) {
            var hd = door_desc_for(hg);
            if (hd != 0) {
                if (load64(hd + DD_COUCH_CMD) != 0) {
                    send_str(cfd, "   ");
                    send_str(cfd, load64(hd + DD_COUCH_CMD));
                    send_str(cfd, " ");
                    send_str(cfd, load64(hd + DD_COUCH_HELP));
                }
            }
            hg = hg + 1;
        }
        send_str(cfd, "   /help   /quit\r\n");
        send_str(cfd, "anything else you type is said to the room.\r\n");
        return 0;
    }
    send_str(cfd, "unknown chat command — /help for the list\r\n");
    return 0;
}

# === 1.3.1 chat-bot couch dispatch — through the registry since 1.11.1 ===
#
# g_chat_bot is the active bot's GAME_* id; everything below reads its
# descriptor (DD_FEED, DD_COUCH_NAME, DD_REPLY). Until 1.11.1 these were 3-way
# switches on 1 / 2 / 3 and the reply was read at EZ_RESP for every bot.
#
# The active couch bot's state in this session's table, or 0.
fn chat_bot_state(): i64 {
    if (g_chat_bot == 0) { return 0; }
    if (g_couch == 0) { return 0; }
    return load64(g_couch + g_chat_bot * 8);
}

# Feed one chat-couch line to the bot this session is talking to (its DD_FEED); 1 = leave.
fn chat_bot_feed(line, len): i64 {
    var d = door_desc_for(g_chat_bot);
    var st = chat_bot_state();
    if (d == 0) { return 1; }
    if (st == 0) { return 1; }
    return callptr(load64(d + DD_FEED), st, line, len);
}

# The "NAME: " prefix for the active couch bot's replies (its DD_COUCH_NAME).
fn chat_bot_name(): i64 {
    var d = door_desc_for(g_chat_bot);
    if (d == 0) { return "BOT: "; }
    if (load64(d + DD_COUCH_NAME) == 0) { return "BOT: "; }
    return load64(d + DD_COUCH_NAME);
}

# 1.11.1 — the active couch bot's last reply (its DD_REPLY): the buffer, with the
# length stored at `lenp`; 0 / length 0 if there is none.
fn chat_bot_reply(lenp): i64 {
    store64(lenp, 0);
    var d = door_desc_for(g_chat_bot);
    var st = chat_bot_state();
    if (d == 0) { return 0; }
    if (st == 0) { return 0; }
    var fp = load64(d + DD_REPLY);
    if (fp == 0) { return 0; }
    return callptr(fp, st, lenp);
}

# 1.11.1 — the couch bot whose DD_COUCH_CMD this chat line starts with, or GAME_NONE.
fn couch_game_for(line, len): i64 {
    var g = 1;
    var found = GAME_NONE;
    while (g <= GAME_LAST) {
        var d = door_desc_for(g);
        if (d != 0) {
            var c = load64(d + DD_COUCH_CMD);
            if (c != 0) { if (found == GAME_NONE) { if (line_has_prefix(line, len, c) != 0) { found = g; } } }
        }
        g = g + 1;
    }
    return found;
}

# Toggle the couch with bot `game`: off if it is the one this session is talking
# to, otherwise on — its state built on first use (practice, through DD_NEW) and
# kept for the session, restarted (DD_START), and its opening line sent.
fn couch_toggle(cfd, game): i64 {
    if (g_chat_bot == game) {
        g_chat_bot = 0;
        send_str(cfd, "(left the couch -- back in the room)\r\n");
        return 0;
    }
    var d = door_desc_for(game);
    var st = load64(g_couch + game * 8);
    if (st == 0) {
        st = callptr(load64(d + DD_NEW), 0, DOOR_PRACTICE, load64(d + DD_DEF_DAYS));
        store64(g_couch + game * 8, st);
    }
    if (load64(d + DD_START) != 0) { var sr = callptr(load64(d + DD_START), st); }
    g_chat_bot = game;
    send_str(cfd, load64(d + DD_COUCH_NAME));
    var rl[8];
    var rb = chat_bot_reply(&rl);
    send_buf(cfd, rb, load64(&rl));
    send_str(cfd, "\r\n");
    send_str(cfd, load64(d + DD_COUCH_NOTE));
    send_str(cfd, "\r\n");
    return 0;
}

# === 1.2.0 Universe world transaction (ADR 0010 bites 2-4) ===
#
# Each game's shared world lives under <store>/.games/<game>/world/ (the
# bite-1 world dir). Per-player state stays in a Solo-style save under a
# dedicated "<game>u" slot. main.cyr owns the flock'd lock→read→feed→
# write transaction; the pure modules mutate the in-memory snapshot.
# These helpers dispatch by g_door_game so PA (bite 2-3), Smuggler, and
# Handler (bite 4) all share one transaction path.

# Snapshot byte size for a game's world.
fn door_world_bytes(game): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 8; }
    var fp = load64(d + DD_WORLD_BYTES);
    if (fp == 0) { return 8; }
    return callptr(fp, 0);   # byte-size ctors take no args; the extra reg is ignored (SysV)
}

# Validate a freshly-read snapshot for a game (size + version).
fn door_world_valid(game, buf, len): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_WORLD_VALID);
    if (fp == 0) { return 0; }
    return callptr(fp, buf, len);
}

# Mint a fresh world for a game into buf (used when no/invalid snapshot
# exists yet). PA's galaxy is seeded; Smuggler/Handler start clean.
fn door_world_fresh_into(game, buf): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_WORLD_NEW);
    if (fp == 0) { return 0; }
    var seed = load64(d + DD_WORLD_SEED);
    var src = callptr(fp, seed);
    if (src != 0) { memcpy(buf, src, door_world_bytes(game)); }
    return 0;
}

# Point the active game state's world field at ptr (so its pure
# transforms read/write the in-memory snapshot during the transaction).
fn door_set_world(game, ptr): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var wb = load64(d + DD_WORLD_BYTES);
    if (wb == 0) { return 0; }                       # not a Universe game (no world ctor)
    var off = load64(d + DD_WORLD_OFF);
    store64(g_door_state + off, ptr);
    return 0;
}

# The per-player Universe save slot for a game ("<game>u" — distinct
# from the Solo slot so a player can keep both).
fn door_universe_slot(game): i64 {
    var d = door_desc_for(game);
    if (d == 0) { return "gameu"; }
    var s = load64(d + DD_USLOT);
    if (s == 0) { return "gameu"; }
    return s;
}

# Open the world lock and load the active game's snapshot into
# g_uni_world, minting + persisting a fresh world if none/invalid.
# Returns the held lock fd, or (0 - 1). Caller MUST door_world_commit.
fn door_world_begin(): i64 {
    var name = door_game_name(g_door_game);
    var fd = world_lock_acquire(g_store_buf, name);
    if (fd < 0) { return 0 - 1; }
    var cap = door_world_bytes(g_door_game);
    var n = world_read(g_store_buf, name, g_uni_world, cap);
    # 1.8.1 (audit D6) — a snapshot that exists but cannot be read is NOT "no
    # world": refuse (the caller says the world is busy) rather than mint a fresh
    # world over it. An INVALID one (corrupt, wrong version) is set aside as
    # snapshot.bad before the fresh world replaces it.
    if (n < 0) { world_lock_release(fd); return 0 - 1; }
    if (door_world_valid(g_door_game, g_uni_world, n) == 0) {
        if (n > 0) { world_quarantine(g_store_buf, name); }
        door_world_fresh_into(g_door_game, g_uni_world);
        world_write(g_store_buf, name, g_uni_world, cap);
    }
    # 1.3.7 (ADR 0014): a Universe game can resolve overdue turn windows lazily
    # on every world-open — the entering caller (already holding the lock) runs
    # the batch resolution; the commit that follows persists it. Generalized at
    # 1.4.6 (R7) via the descriptor's tick fp + ns-per-turn (Ashes is the only
    # one today). `tr` holds the (unused) result — a bare callptr statement does
    # not parse, so the result must be bound.
    var dt = door_desc_for(g_door_game);
    if (dt != 0) {
        var tfp = load64(dt + DD_WORLD_TICK);
        # 1.8.1 (audit I3) — a tick hook with no tick length would divide by
        # zero and SIGFPE the whole poll server; such a registration is skipped.
        if (load64(dt + DD_TICK_NS) <= 0) { tfp = 0; }
        if (tfp != 0) {
            var turn = clock_epoch_ns() / load64(dt + DD_TICK_NS);
            var tr = callptr(tfp, g_uni_world, turn);
        }
    }
    return fd;
}

# Write g_uni_world back under the held lock and release it. Returns the
# world_write status (0 = persisted) so a caller can surface a failed
# shared-world snapshot rather than silently losing the turn; the lock is
# released either way so a write error can't strand the world locked. [R6]
fn door_world_commit(fd): i64 {
    var wr = world_write(g_store_buf, door_game_name(g_door_game), g_uni_world, door_world_bytes(g_door_game));
    world_lock_release(fd);
    return wr;
}

# Feed one line to a Universe session inside the world transaction:
# lock → read snapshot → <game>_feed (mutates it via the pure
# transforms) → write snapshot → unlock. The world field stays set so
# the post-feed render reflects shared state. Returns the feed's exit
# control (1 = leave the game).
fn door_universe_feed(line, len): i64 {
    var fd = door_world_begin();
    var d = door_desc_for(g_door_game);
    if (fd < 0) {
        if (d != 0) {
            var mfp = load64(d + DD_MSG);
            var busy = load64(d + DD_BUSY);
            if (mfp != 0) { var mr = callptr(mfp, g_door_state, busy); }
        }
        return 0;
    }
    door_set_world(g_door_game, g_uni_world);
    var ctrl = 0;
    if (d != 0) {
        var ffp = load64(d + DD_FEED);
        if (ffp != 0) { ctrl = callptr(ffp, g_door_state, line, len); }
    }
    # 1.8.1 (audit D7) — the 2026-06-15 R6 fix made door_world_commit RETURN the
    # write status, but no caller looked at it, so a failed snapshot write (a
    # full disk) lost the turn silently. Tell the player.
    if (door_world_commit(fd) != 0) {
        if (d != 0) {
            var wmfp = load64(d + DD_MSG);
            var wmsg = "The shared world could not be saved — that move may not have taken.";
            if (wmfp != 0) { var wmr = callptr(wmfp, g_door_state, wmsg); }
        }
    }
    return ctrl;
}

# Render the active game's current frame and send it to the client.
fn door_send_frame(cfd): i64 {
    # [D3] Render into a guard-banded buffer with the emit_* helpers bounded
    # to DOOR_FRAME_CAP: the helpers (the bulk of every frame) refuse to write
    # past the cap, the guard band absorbs any raw-store8 tail beyond it, and
    # the send is clamped to the cap below — so a frame that outgrows 8192
    # truncates cleanly instead of overrunning the heap. No frame does today;
    # this enforces the invariant against future row-count growth.
    var buf = cmd_alloc(DOOR_FRAME_CAP + DOOR_FRAME_GUARD);
    g_door_emit_cap = DOOR_FRAME_CAP;
    var n = 0;
    var d = door_desc_for(g_door_game);
    if (d != 0) {
        var fp = load64(d + DD_RENDER);
        if (fp != 0) { n = callptr(fp, g_door_state, buf, DOOR_FRAME_CAP); }
    }
    g_door_emit_cap = DOOR_EMIT_UNBOUNDED;             # [D3] restore the default for non-frame emit users
    if (n > DOOR_FRAME_CAP) { n = DOOR_FRAME_CAP; }    # [D3] clamp any overshoot — never send past the cap
    # 1.10.1 (ADR 0030) — wrapped to the client's window; an indented line keeps
    # its indent on its continuation rows. Frames are rendered by agora with
    # their own SGR colour, so they go out raw (escape sequences take no column).
    if (n > 0) { send_wrapped(cfd, buf, n, 0, 0, TW_RAW | TW_AUTO); }
    return 0;
}

# Feed one input line to the active game. Returns 1 if the game exited.
# Port Authority Universe play wraps the feed in a world transaction so
# trades/claims hit the shared galaxy under the flock (ADR 0010 bite 2).
fn door_feed_line(cfd, line, line_len): i64 {
    if (g_door_mode == DOOR_UNIVERSE) { return door_universe_feed(line, line_len); }
    var d = door_desc_for(g_door_game);
    if (d == 0) { return 1; }
    var fp = load64(d + DD_FEED);
    if (fp == 0) { return 1; }
    return callptr(fp, g_door_state, line, line_len);
}

# 1 if the active door state's run is finished (its DD_IS_OVER hook); chatbots are never over.
fn door_is_over(): i64 {
    var d = door_desc_for(g_door_game);
    if (d == 0) { return 0; }
    var fp = load64(d + DD_IS_OVER);
    if (fp == 0) { return 0; }          # chatbots (Eliza/Parry): never over
    return callptr(fp, g_door_state);
}

# === 1.2.0 bite 5 — cross-game leaderboards (generalizes the 1.1.0
# Handler standings to every scored door) ===
#
# Each game appends "<handle>\t<score>\t<rank>\n" to a shared, flock'd
# per-game file <store>/.games/<game>/leaderboard on a finished run
# (solo OR universe). `scores <game>` reads it back, top-10 by score.

# Build <store>/.games/<game>/leaderboard into out_buf, ensuring dirs.
fn door_leaderboard_path(game, out_buf): i64 {
    var name = door_game_name(game);
    var dir1 = cmd_alloc(PATH_MAX_BYTES);
    var slen = strlen(g_store_buf);
    memcpy(dir1, g_store_buf, slen);
    store8(dir1 + slen, 47);
    memcpy(dir1 + slen + 1, ".games", 6);
    store8(dir1 + slen + 7, 0);
    store_ensure(dir1);

    var dir2 = cmd_alloc(PATH_MAX_BYTES);
    var d1len = strlen(dir1);
    memcpy(dir2, dir1, d1len);
    store8(dir2 + d1len, 47);
    var glen = strlen(name);
    memcpy(dir2 + d1len + 1, name, glen);
    store8(dir2 + d1len + 1 + glen, 0);
    store_ensure(dir2);

    var d2len = strlen(dir2);
    memcpy(out_buf, dir2, d2len);
    store8(out_buf + d2len, 47);
    memcpy(out_buf + d2len + 1, "leaderboard", 11);
    store8(out_buf + d2len + 12, 0);
    return 0;
}

# Format a "<handle>\t<score>\t<rank>\n" line into buf; returns length.
fn door_format_score(handle, score, rank, buf): i64 {
    var pos = 0;
    pos = emit_cstr(buf, pos, handle);
    store8(buf + pos, 9); pos = pos + 1;
    pos = emit_int(buf, pos, score);
    store8(buf + pos, 9); pos = pos + 1;
    pos = emit_cstr(buf, pos, rank);
    store8(buf + pos, 10); pos = pos + 1;
    return pos;
}

# Append the active player's final score for `game` to its leaderboard.
fn door_post_score(game): i64 {
    if ((load8(g_session_handle) & 0xFF) == 0) { return 0; }
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    var sfp = load64(d + DD_SCORE);
    if (sfp == 0) { return 0; }              # no leaderboard for this game (chatbots)
    var score = callptr(sfp, g_door_state);
    var rfp = load64(d + DD_RANK);
    var rank = "";
    if (rfp != 0) { rank = callptr(rfp, score); }
    var path = cmd_alloc(PATH_MAX_BYTES);
    door_leaderboard_path(game, path);
    var line = cmd_alloc(256);
    var n = door_format_score(g_session_handle, score, rank, line);
    store_append_locked(path, line, n, 0);
    return 0;
}

# Send the top 10 (by score) of a game's leaderboard to the client.
#
# 1.8.1 (audit D5) — streams the WHOLE file in LB_CHUNK pieces, keeping a
# running top 10. It read only the first 16 KB and ranked only the first 256
# rows of an append-only file, so every board froze for good after 256
# finishes: a new best score landed in the file and never on the board. Ties
# keep the earlier row, as the old selection sort did.
fn door_render_leaderboard(cfd, game): i64 {
    var path = cmd_alloc(PATH_MAX_BYTES);
    door_leaderboard_path(game, path);
    send_str(cfd, "== ");
    send_str(cfd, door_game_name(game));
    send_str(cfd, " leaderboard ==\r\n");
    var rows = cmd_alloc(LB_TOP * LB_ROW_CAP);
    var lens = cmd_alloc(LB_TOP * 8);
    var scores = cmd_alloc(LB_TOP * 8);
    var count = 0;
    var fd = store_open(path, O_RDONLY);     # 1.9.0: no symlink, no FIFO (arena.cyr)
    if (fd >= 0) {
        var buf = cmd_alloc(LB_CHUNK);
        var have = 0;        # bytes carried over (a partial line) at buf[0..have)
        var skipping = 0;    # inside a line longer than a whole chunk: drop to LF
        var reading = 1;
        while (reading == 1) {
            var n = file_read(fd, buf + have, LB_CHUNK - have);
            var eof = 0;
            if (n <= 0) { eof = 1; n = 0; }
            var total = have + n;
            var ls = 0;
            var i = 0;
            while (i < total) {
                if ((load8(buf + i) & 0xFF) == 10) {
                    if (skipping == 0) { count = lb_offer(buf, ls, i, rows, lens, scores, count); }
                    skipping = 0;
                    ls = i + 1;
                }
                i = i + 1;
            }
            if (eof == 1) {
                if (ls < total) { if (skipping == 0) { count = lb_offer(buf, ls, total, rows, lens, scores, count); } }
                reading = 0;
                continue;
            }
            have = total - ls;
            if (have >= LB_CHUNK) { have = 0; skipping = 1; }   # no LF in a whole chunk
            else { if (ls > 0) { memcpy(buf, buf + ls, have); } }   # forward copy, dst < src
        }
        file_close(fd);
    }
    if (count == 0) { send_str(cfd, "No scores posted yet — finish a run to make the board.\r\n"); return 0; }

    var ln = cmd_alloc(LB_ROW_CAP + 16);
    var k = 0;
    while (k < count) {
        var p = 0;
        p = emit_int(ln, p, k + 1);
        store8(ln + p, 41); p = p + 1;    # )
        store8(ln + p, 32); p = p + 1;    # space
        var rl = load64(lens + k * 8);
        var row = rows + k * LB_ROW_CAP;
        var x = 0;
        while (x < rl) {
            var ch = load8(row + x) & 0xFF;
            if (ch == 9) { ch = 32; }      # tabs -> spaces for display
            store8(ln + p, ch); p = p + 1;
            x = x + 1;
        }
        store8(ln + p, 13); p = p + 1;
        store8(ln + p, 10); p = p + 1;
        # 1.8.0 — the row is file content (a handle and a score), so it goes out
        # through `send_text`, not `send_buf`: IAC doubling + ADR 0024.
        send_text(cfd, ln, p);
        k = k + 1;
    }
    return 0;
}

# Offer leaderboard line buf[s, e) to the running top LB_TOP (scores
# descending; a tie keeps the earlier row). The row is copied, clamped to
# LB_ROW_CAP - 8 bytes (1.8.0's bound: agora's rows are ~50 bytes, a damaged
# line is truncated for display). Returns the new count.
fn lb_offer(buf, s, e, rows, lens, scores, count): i64 {
    if (e <= s) { return count; }
    var sc = lb_line_score(buf, s, e);
    var pos = count;
    var scan = 1;
    while (scan == 1) {
        if (pos <= 0) { scan = 0; continue; }
        if (load64(scores + (pos - 1) * 8) >= sc) { scan = 0; continue; }
        pos = pos - 1;
    }
    if (pos >= LB_TOP) { return count; }
    var last = count;
    if (last >= LB_TOP) { last = LB_TOP - 1; }
    var k = last;
    while (k > pos) {
        memcpy(rows + k * LB_ROW_CAP, rows + (k - 1) * LB_ROW_CAP, LB_ROW_CAP);
        store64(lens + k * 8, load64(lens + (k - 1) * 8));
        store64(scores + k * 8, load64(scores + (k - 1) * 8));
        k = k - 1;
    }
    var rl = e - s;
    if (rl > LB_ROW_CAP - 8) { rl = LB_ROW_CAP - 8; }
    memcpy(rows + pos * LB_ROW_CAP, buf + s, rl);
    store64(lens + pos * 8, rl);
    store64(scores + pos * 8, sc);
    if (count < LB_TOP) { return count + 1; }
    return count;
}

# 1.6.3 (ADR 0022) — release the active door state through its descriptor's
# DD_FREE hook and null the global, so the caller cannot double-free and no
# later render can touch dead memory.
#
# Why this exists: door states are the last allocations in agora with a lifetime
# longer than one dispatched line, so the 1.6.2 per-command arena (ADR 0021)
# cannot own them. Under AGORA_SERVE=poll one process serves every session for
# the life of the server, so every state abandoned at `quit` or at disconnect
# stayed allocated forever — the whole difference between the Eliza and QUEST
# rows in the 1.6.2 leak table. Under fork this was invisible: the child exited.
#
# Called from exactly three places, which together cover every way a state is
# dropped: the MODE_DOOR exit in process_rx (`quit`), session_reset (a slot
# being handed to a NEW connection while a game was still open — i.e. the
# player disconnected mid-game), and the `play` launcher before it installs a
# replacement.
# Release the active door state's buffers (DD_FREE) and clear the globals.
fn door_state_drop(): i64 {
    if (g_door_state == 0) { g_door_game = GAME_NONE; return 0; }
    door_release_state(g_door_game, g_door_state);
    g_door_state = 0;
    g_door_game = GAME_NONE;
    return 0;
}

# 1.11.1 — release door state `st` of game `game`: THE one place a door's
# DD_FREE runs (door_state_drop, session_door_free and the chat couch all come
# here). ADR 0022's invariant made structural: a Universe game's world field
# (DD_WORLD_OFF) points at the SESSION SLOT's snapshot buffer, which the state
# does not own and which comes from alloc(), not the freelist — a door's *_free
# that freed it would hand an alloc() block to fl_free and corrupt the pool.
# Until 1.11.1 every *_free had to step around it by hand; now the field is
# cleared here first, so the most a door can free through it is 0 (a no-op).
fn door_release_state(game, st): i64 {
    if (st == 0) { return 0; }
    var d = door_desc_for(game);
    if (d == 0) { return 0; }
    if (load64(d + DD_WORLD_BYTES) != 0) { store64(st + load64(d + DD_WORLD_OFF), 0); }
    var ffp = load64(d + DD_FREE);
    if (ffp != 0) { var fr = callptr(ffp, st); }
    return 0;
}

# Leave the active door entirely: drop its state AND release its play lock
# (1.8.1, audit D1).
fn door_state_free(): i64 {
    door_state_drop();
    if (g_active_sess != 0) {
        door_play_unlock(load64(g_active_sess + SESS_DOOR_LOCK));
        store64(g_active_sess + SESS_DOOR_LOCK, 0 - 1);
        store64(g_active_sess + SESS_DOOR_OVER0, 0);
    }
    return 0;
}

# 1.8.1 (audit D1) — take the play lock for (this identity, `slot`) before a
# saved door loads. Returns 1 to go ahead, 0 if another session holds it (the
# caller has told the player). A lock file that cannot be opened (-2) plays on
# unlocked rather than refusing.
fn door_take_play_lock(cfd, slot): i64 {
    var lk = door_play_lock(g_store_buf, g_session_fp, slot);
    if (lk == (0 - 1)) {
        send_str(cfd, "you are already playing that game in another session — finish there first.\r\n");
        return 0;
    }
    if (lk >= 0) { store64(g_active_sess + SESS_DOOR_LOCK, lk); }
    return 1;
}

# 1.8.1 (audit D2 / D6) — vet a save the launcher just tried to load. A save
# that exists but could not be read or parsed (`loaded == 0`) is moved aside to
# `<slot>.sav.bad` and the player is told, rather than being overwritten by the
# fresh run on exit. A run that loaded already OVER is discarded so a fresh one
# starts: replaying a finished checkpoint is how one win was posted forever.
# Returns 1 if a usable, unfinished state is now in g_door_state, else 0.
fn door_vet_loaded(cfd, game, slot, loaded): i64 {
    if (loaded == 0) {
        door_save_quarantine(g_store_buf, g_session_fp, slot);
        send_str(cfd, "(your saved game could not be read — it was set aside as ");
        send_str(cfd, slot);
        send_str(cfd, ".sav.bad and a new one begins)\r\n");
        return 0;
    }
    if (door_is_over() == 1) {
        door_state_drop();
        g_door_game = game;
        door_save_remove(g_store_buf, g_session_fp, slot);
        return 0;
    }
    return 1;
}

# On leaving a door — a clean `q`, OR (1.8.1) any disconnect or shutdown, via
# session_door_checkpoint: persist the player's state, or retire it if the run
# is over, and post a finished run to the leaderboard.
#
# 1.8.1 (audit D1 / D2 / G3):
#  - this used to run ONLY on a clean `q`. A dropped connection saved nothing,
#    while a Universe game's world was written on every line — so a disconnect
#    refunded a player's costs and kept the world effects (deploy fighters, drop
#    the link, re-enter: the garrison grew 29 → 58 → 87 … while the ship kept
#    30), and erased any lost bet (2,000 → 893,641 credits in 14 all-in bets).
#  - a finished run now REMOVES its save (Solo kept the last checkpoint, Universe
#    saved the finished state); the launcher also discards a save that loads
#    already over (door_vet_loaded). One finish = one leaderboard row.
#  - a run that was already over when entered (Ashes domination is a property
#    of the shared map, true on every later entry) does not post again.
fn door_save_on_exit(cfd): i64 {
    var over = door_is_over();
    if ((load8(g_session_fp) & 0xFF) != 0) {
        var slot = 0;
        if (g_door_mode == DOOR_UNIVERSE) { slot = door_universe_slot(g_door_game); }
        if (g_door_mode == DOOR_SOLO)     { slot = door_game_name(g_door_game); }
        if (slot != 0) {
            if (over == 1) { door_save_remove(g_store_buf, g_session_fp, slot); }
            else {
                var d = door_desc_for(g_door_game);
                if (d != 0) {
                    var fp = load64(d + DD_SAVE_FMT);
                    if (fp != 0) {
                        var buf = cmd_alloc(DOOR_SAVE_CAP);
                        var n = callptr(fp, g_door_state, buf, DOOR_SAVE_CAP);
                        if (n > 0) { door_save_write(g_store_buf, g_session_fp, slot, buf, n); }
                    }
                }
            }
        }
    }
    # 1.2.0 bite 5: a finished run by a logged-in player posts to the cross-game
    # leaderboard — in any mode (a practice run is a real, fresh run). Only a run
    # that became over during THIS session (SESS_DOOR_OVER0, 1.8.1).
    if (over == 1) {
        var over0 = 0;
        if (g_active_sess != 0) { over0 = load64(g_active_sess + SESS_DOOR_OVER0); }
        if (over0 == 0) {
            if ((load8(g_session_handle) & 0xFF) != 0) {
                door_post_score(g_door_game);
            }
            if (g_active_sess != 0) { store64(g_active_sess + SESS_DOOR_OVER0, 1); }
        }
    }
    return 0;
}

# 1.8.1 (audit D1) — save a live door session that is ending WITHOUT a clean
# `q`: a disconnect, an idle reap, a server shutdown. Called on every close path
# before the state is freed, after sess_save(s) has made the slot current.
fn session_door_checkpoint(s): i64 {
    if (load64(s + SESS_DOOR_STATE) == 0) { return 0; }
    sess_load(s);
    door_save_on_exit(load64(s + SESS_FD));
    return 0;
}

# Finalize a post-compose flow: write the accumulated body + subject
# into the session's current_board, send the assigned ID (or an error).
#
# M5-F: if `g_reply_to != 0`, this is a reply — use the derived
# subject from `g_reply_subject` (computed by the `reply <id>`
# command) and write a Reply-To header. Reset g_reply_to after the
# commit so the next plain `post` doesn't accidentally reuse the
# previous reply parent.
fn session_finalize_post(cfd, current_board, subject, body, body_len): i64 {
    if (body_len <= 0) {
        send_str(cfd, "(empty post discarded)\r\n");
        g_reply_to = 0;
        return 0;
    }
    # 1.8.1 (audit storage I4) — re-check the board policy at COMMIT. It was
    # checked only when `post` / `reply` began, so an operator tightening a
    # board's policy while someone was composing did not stop that post.
    if (board_can_post(g_store_buf, current_board, g_session_fp, g_session_handle) == 0) {
        send_str(cfd, "post refused — the board's policy changed while you were writing\r\n");
        g_reply_to = 0;
        return 0;
    }
    # M6-E: From: header derived from the bound session identity.
    # Anonymous session → from_handle / from_fp both 0 → no header.
    var from_handle = 0;
    var from_fp     = 0;
    if (g_session_fp != 0) {
        if ((load8(g_session_fp) & 0xFF) != 0) {
            from_handle = g_session_handle;
            from_fp     = g_session_fp;
        }
    }
    # 0.9.0 ABI (ADR 0008): PostHeaders struct replaces the M6-E
    # 8-arg shape. Construct headers per session state, then post_new.
    var ph = post_headers_new();
    post_headers_set_from(ph, from_handle, from_fp);
    var id = 0 - 1;
    if (g_reply_to > 0) {
        post_headers_set_subject(ph, g_reply_subject);
        post_headers_set_reply_to(ph, g_reply_to);
        id = post_new(g_store_buf, current_board, ph, body, body_len);
    } else {
        post_headers_set_subject(ph, subject);
        id = post_new(g_store_buf, current_board, ph, body, body_len);
    }
    if (id < 0) {
        send_str(cfd, "post failed (storage error)\r\n");
        g_reply_to = 0;
        return 0;
    }
    send_str(cfd, "posted as #");
    var idbuf[24];
    var idlen = fmt_int_buf(id, &idbuf);
    send_buf(cfd, &idbuf, idlen);
    send_str(cfd, "\r\n");
    g_reply_to = 0;
    return 0;
}

# Render the colored MOTD into a caller-allocated buffer. Returns
# the number of bytes written. The AGORA banner is wrapped in cyan
# (SGR 36), the version line in yellow (SGR 33), the prompt line
# uses default fg with a reset terminator.
#
# Buffer must be ≥ 1024 bytes. Rendered length at 0.2.x is ~580 B
# (banner ~470 + SGR overhead ~50 + version + prompt ~60); the
# 1024 ceiling leaves headroom for the next bite's color tweaks
# without re-tuning the alloc.
#
# The AGORA banner art was generated once via `bnrmr "AGORA"`
# (block font, 5×5, bannermanor v1.0.0). The `#` bytes use `\x23`
# escapes to dodge cyrius's line-comment lexer. SGR primitives are
# darshana's `tty_sgr_buf` / `tty_sgr_reset_buf` — the `_buf`
# variants compose into a buffer rather than writing to fd 1, which
# is exactly what we need to send bytes back over the telnet socket.
#
# 1.8.0 (darshana 0.9.0 → 1.3.0) — the -1 audit. darshana 0.9.3 made both
# composers return -1 for a negative `pos`; `tty_sgr_buf` already did for a
# code outside [0, 999]. Neither can happen here: `pos` starts at 2 and only
# grows, and the codes are the in-range TTY_FG_* constants. The chain is now
# -1-safe anyway — every link after the leading CRLF is a darshana composer or
# `motd_emit_cstr`, each of which passes a negative `pos` through without
# writing — so a -1 would yield an empty MOTD (return 0), never a write below
# `buf`. The bytes are identical to 1.7.x: TTY_FG_CYAN is 36, TTY_FG_YELLOW 33.
fn render_motd(buf): i64 {
    var pos = 0;
    # Leading CRLF gives the client a clean line after the IAC announce.
    store8(buf + pos, 13); pos = pos + 1;  # \r
    store8(buf + pos, 10); pos = pos + 1;  # \n

    # Cyan-wrapped 5-line AGORA banner. Each line ends CRLF; the
    # opening SGR sticks for all five lines, closed by reset after
    # line 5. (Some terminals reset SGR on \n — most don't; the
    # explicit close-after-line-5 keeps the spec.)
    pos = tty_sgr_buf(buf, pos, TTY_FG_CYAN);
    pos = motd_emit_cstr(buf, pos, " \x23\x23\x23   \x23\x23\x23\x23  ");
    pos = motd_emit_cstr(buf, pos, "\x23\x23\x23  \x23\x23\x23\x23   \x23\x23\x23 \r\n");
    pos = motd_emit_cstr(buf, pos, "\x23   \x23 \x23     \x23   \x23 \x23   \x23 \x23   \x23\r\n");
    pos = motd_emit_cstr(buf, pos, "\x23\x23\x23\x23\x23 \x23  \x23\x23 \x23   \x23 ");
    pos = motd_emit_cstr(buf, pos, "\x23\x23\x23\x23  \x23\x23\x23\x23\x23\r\n");
    pos = motd_emit_cstr(buf, pos, "\x23   \x23 \x23   \x23 \x23   \x23 \x23  \x23  \x23   \x23\r\n");
    pos = motd_emit_cstr(buf, pos, "\x23   \x23  \x23\x23\x23\x23  \x23\x23\x23  \x23   \x23 \x23   \x23\r\n");
    pos = tty_sgr_reset_buf(buf, pos);

    # Blank line between banner and metadata.
    pos = motd_emit_cstr(buf, pos, "\r\n");

    # Yellow version line. 1.10.1 (ADR 0030) — laid out for 80 columns: it was
    # one 149-column line that every terminal narrower than that broke mid-word.
    # The greeting goes out before the client can report its window (NAWS), so
    # it cannot use the real width; 80 is the classic terminal's.
    pos = tty_sgr_buf(buf, pos, TTY_FG_YELLOW);
    if (pos >= 0) {
        var tag[256];
        var tl = motd_emit_cstr(&tag, 0, "  agora ");
        tl = motd_emit_cstr(&tag, tl, CYRIUS_PKG_VERSION);   # 1.8.2 — from VERSION (see print_banner)
        tl = motd_emit_cstr(&tag, tl, " — telnet BBS + door games (casino + Olympiad + Ashes of Empire + Decode)");
        tl = motd_emit_cstr(&tag, tl, " + chat + Eliza/PARRY + QUEST + Jabberwacky + Descent MUD link\r\n");
        var wst[104];          # WS_SIZE
        term_wrap_init(&wst, &tag, tl, 0, 0, TW_AUTO, term_wrap_width(TERM_GREET_COLS));
        var wk = 1;
        while (wk > 0) {
            wk = term_wrap_chunk(&wst, buf + pos, 256);
            pos = pos + wk;
        }
    }
    pos = tty_sgr_reset_buf(buf, pos);

    # Default-color prompt + closing blank line.
    pos = motd_emit_cstr(buf, pos, "  Type anything; Ctrl+] then 'quit' to exit.\r\n\r\n");

    if (pos < 0) { return 0; }
    return pos;
}

# How a connection is served, in both models (session_greet sends the MOTD +
# first prompt; process_rx, below, is the byte loop that handle_client's fork
# worker and serve_poll's sweep both drive): the in-session command
# interpreter runs until the peer disconnects or sends `quit`.
#
# Per-byte dispatch: every byte goes through the IAC state machine
# first (M1), then the data byte (when present) drives the line
# buffer and mode-aware handler. We announced WILL ECHO at connect
# (M2-B Q-method), so the server drives the visual display — every
# typed byte gets echoed before processing.
#
# CR / LF handling per telnet NVT (RFC 854): CR is the line
# terminator; the LF that often follows is paired and silently
# absorbed. Lone LF also terminates (raw `nc -e` and similar clients
# send only \n).
# ============================================================================
# 1.6.0 — single-process session-multiplex (poll) serve model.
#
# The fork path (Linux only — agnos has no fork and always polls) serves each
# connection in its own process. serve_poll multiplexes N connections in ONE process via a
# pre-allocated session POOL (no per-conn alloc/free): each slot is a heap struct
# snapshotting every per-connection global + a non-blocking tx queue. The operator
# picks the model at runtime with AGORA_SERVE={fork,poll}; agnos has no fork so it
# always polls. Door games / dispatch are untouched (ADR 0009: pure state
# machines) — the loop swaps the active session's deep state into the g_* session
# globals around each dispatch (sess_load/sess_save), so session_execute /
# door_feed_line / chat_* see exactly the globals they always have. The shallow
# parse state (ts/line/mode/…) rides in process_rx's locals, loaded from the slot.
# ============================================================================

enum ServeMode {
    SERVE_FORK = 0;      # fork-per-conn (Linux only; agnos always polls)
    SERVE_POLL = 1;      # single-process poll-multiplex (both platforms)
}
var g_serve_mode  = 0;   # SERVE_FORK default; set from AGORA_SERVE / platform at serve start
var g_active_sess = 0;   # session currently being dispatched (send_buf tx target in poll mode)
# 1.7.0 (N1) — armed ONCE in cmd_serve_on, before the listener exists, and read
# by whichever serve loop runs. Globals rather than locals because both loops
# need them and `serve_poll` takes only `sfd`. (0 - 1) = not armed.
var g_shutdown_sigfd   = 0 - 1;
var g_shutdown_siginfo = 0;
var g_poll_fds    = 0;   # 1.11.0 — serve_poll_wait's pollfd array (POLL_FDS_MAX entries, once)
var g_child_sigfd = 0 - 1;   # 1.11.0 — a fork child's own shutdown signalfd (fork_child_arm)
var g_sess_pool   = 0;   # alloc(MAX_SESS*8): pre-allocated session slots, reused

enum SessCap {
    MAX_SESS    = 64;         # concurrent connections in poll mode
    SESS_TX_CAP = 131072;     # per-session non-blocking tx queue (>= POST_MAX_BYTES 64K + headers)
}

# Per-session struct offsets. One alloc(SESS_SIZE) block per pool slot, reused
# across connections (session_reset clears it; no free — the pool is fixed-size).
enum SessOff {
    SESS_FD          = 0;    # accepted socket fd (-1 when free)
    SESS_ACTIVE      = 8;    # 1 = slot in use
    SESS_GREETED     = 16;   # 1 = announce+MOTD+first prompt already sent
    SESS_LAST_MS     = 24;   # last-activity wall clock (idle reap)
    SESS_TX          = 32;   # tx queue buffer (SESS_TX_CAP)
    SESS_TX_LEN      = 40;   # bytes queued
    SESS_TX_OFF      = 48;   # bytes already flushed
    # --- shallow per-conn parse/scratch state (process_rx locals) ---
    SESS_TS          = 56;   # telnet parser (telnet_state_new)
    SESS_RXBUF       = 64;   # recv scratch (RECV_BUF_BYTES)
    SESS_LINE        = 72;   # line accumulator (LINE_BUF_CAP)
    SESS_LINE_POS    = 80;
    SESS_POST        = 88;   # post compose buffer (POST_MAX_BYTES)
    SESS_POST_POS    = 96;
    SESS_SUBJECT     = 104;  # subject buffer (SUBJECT_MAX_BYTES+1)
    SESS_SUBJECT_LEN = 112;
    SESS_CURBOARD    = 120;  # current board name (BOARD_NAME_MAX+1)
    SESS_MODE        = 128;  # MODE_*
    SESS_LAST_CR     = 136;
    SESS_QUIT        = 144;  # quit flag ptr (alloc(8); session_execute writes through it)
    # --- deep session globals mirror (sess_load/sess_save swap surface) ---
    SESS_SESSION_FP        = 152;
    SESS_SESSION_HANDLE    = 160;
    SESS_LOGIN_FP          = 168;
    SESS_LOGIN_NONCE       = 176;
    SESS_LOGIN_STARTED_MS  = 184;
    SESS_DOOR_GAME         = 192;
    SESS_DOOR_STATE        = 200;
    SESS_DOOR_MODE         = 208;
    SESS_UNI_WORLD         = 216;
    SESS_CHAT_CHANNEL      = 224;
    SESS_CHAT_SEEN         = 232;
    SESS_CHAT_IDLE         = 240;
    SESS_CHAT_BOT          = 248;
    SESS_COUCH             = 256;   # 1.11.1 — couch states by game id (was SESS_ELIZA)
    SESS_SPARE_264         = 264;   # (SESS_PARRY until 1.11.1)
    SESS_SPARE_272         = 272;   # (SESS_JABBER until 1.11.1)
    SESS_REPLY_TO          = 280;
    SESS_REPLY_SUBJECT     = 288;
    SESS_REPLY_SUBJECT_LEN = 296;
    SESS_CHAT_TICK_MS      = 304;   # poll: wall-clock of the last chat live-tail flush
    # 1.7.0 (roadmap N3, hole B): sticky "this session's tx queue overflowed".
    # Set by sess_tx_enqueue when it refuses a write; consumed by session_drain,
    # which both serve models already close on. Occupies the 8 bytes of slack
    # that were already inside SESS_SIZE, so the slot allocation is unchanged.
    SESS_TX_OVF            = 312;
    # 1.8.1 (audit H2) — the unconsumed tail of the last recv, parked by the poll
    # line budget: bytes [SESS_RX_OFF, SESS_RX_LEN) of SESS_RXBUF still to run.
    SESS_RX_OFF            = 320;
    SESS_RX_LEN            = 328;
    # 1.8.1 (audit D1 / G3) — the door play lock's fd (-1 = none held), and
    # whether the active door's run was already over when it was entered.
    SESS_DOOR_LOCK         = 336;
    SESS_DOOR_OVER0        = 344;
    SESS_POST_FULL         = 352;   # 1.8.1 (S12) — the compose body hit POST_MAX_BYTES
    # 1.11.0 (ADR 0031) — the Descent negotiation observer (telnet.cyr TOB_SIZE),
    # allocated on the slot's first `descent` and kept for the slot's life: at most
    # one per slot (64 under poll, one per fork child), never per command.
    SESS_DESC_OBS          = 360;
    # 1.11.0 (ADR 0031) — a Descent visit as session state: the MUD socket (-1 =
    # none), the phase (descent.cyr DESC_*), the connect deadline, and the last
    # time bytes moved (the 30-minute silence bound). While in MODE_DESCENT the
    # receive buffer's SESS_RX_OFF..SESS_RX_LEN holds client bytes the MUD has
    # not taken yet.
    SESS_MUD_FD            = 368;
    SESS_DESC_PHASE        = 376;
    SESS_DESC_DEADLINE     = 384;
    SESS_DESC_LAST_MS      = 392;
    SESS_SIZE              = 400;
}

# Build the pool once (at serve_poll start): MAX_SESS slots, each with its per-conn
# buffers allocated ONCE and reused. Slots start free (SESS_ACTIVE=0, fd=-1).
# Allocate one session slot + all its per-connection buffers (reused across
# connections; fd=-1, inactive). Used by both the pool (poll mode) and a fork
# child's standalone handle_client.
fn session_alloc(): i64 {
    var s = alloc(SESS_SIZE);
    memset(s, 0, SESS_SIZE);
    store64(s + SESS_TS,             telnet_state_new());
    store64(s + SESS_RXBUF,          alloc(RECV_BUF_BYTES));
    store64(s + SESS_LINE,           alloc(LINE_BUF_CAP));
    store64(s + SESS_POST,           alloc(POST_MAX_BYTES));
    store64(s + SESS_SUBJECT,        alloc(SUBJECT_MAX_BYTES + 1));
    store64(s + SESS_CURBOARD,       alloc(BOARD_NAME_MAX + 1));
    store64(s + SESS_SESSION_FP,     alloc(ACCOUNT_FP_BUF_BYTES));
    store64(s + SESS_SESSION_HANDLE, alloc(ACCOUNT_HANDLE_BUF));
    store64(s + SESS_LOGIN_FP,       alloc(ACCOUNT_FP_BUF_BYTES));
    store64(s + SESS_LOGIN_NONCE,    alloc(ACCOUNT_NONCE_BUF_BYTES));
    store64(s + SESS_CHAT_CHANNEL,   alloc(CHAT_CHANNEL_MAX + 1));
    store64(s + SESS_QUIT,           alloc(8));
    store64(s + SESS_TX,             alloc(SESS_TX_CAP));
    # 1.6.2 — pooled, not per-session. Both used to be allocated lazily from a
    # process global (`if (g_uni_world == 0) { g_uni_world = alloc(...) }`).
    # sess_load/sess_save swap those globals per session, so a fresh session
    # always saw 0 and allocated again: an 8 KB + 264 B leak for every session
    # that entered a Universe door or replied to a post — bounded by sessions
    # SERVED, i.e. unbounded over a server's life. Owning them in the slot makes
    # it 64 allocations total, ever (+541 KB once; the image was ~13 MB then,
    # ~1 MB since 1.7.1).
    store64(s + SESS_UNI_WORLD,      alloc(DOOR_WORLD_CAP));
    store64(s + SESS_REPLY_SUBJECT,  alloc(SUBJECT_MAX_BYTES + 8));
    var couch = alloc((GAME_LAST + 1) * 8);
    memset(couch, 0, (GAME_LAST + 1) * 8);
    store64(s + SESS_COUCH, couch);
    store64(s + SESS_FD, 0 - 1);
    store64(s + SESS_DOOR_LOCK, 0 - 1);
    store64(s + SESS_MUD_FD, 0 - 1);
    return s;
}

# Build the poll model's MAX_SESS session slots once, at serve start; slots start free.
fn session_pool_init(): i64 {
    g_sess_pool = alloc(MAX_SESS * 8);
    var i = 0;
    while (i < MAX_SESS) {
        store64(g_sess_pool + i * 8, session_alloc());
        i = i + 1;
    }
    return 0;
}

# Reset a slot's mutable per-connection state for a NEW connection on cfd. Buffers
# are reused (contents reset, not freed). Mirrors handle_client's per-conn init.
fn session_reset(s, cfd): i64 {
    store64(s + SESS_FD, cfd);
    store64(s + SESS_ACTIVE, 1);
    store64(s + SESS_GREETED, 0);
    store64(s + SESS_LAST_MS, clock_now_ms());
    store64(s + SESS_CHAT_TICK_MS, clock_now_ms());
    store64(s + SESS_TX_LEN, 0);
    store64(s + SESS_TX_OFF, 0);
    # 1.7.0 (N3-B) — the overflow flag is STICKY, so a slot that closed on it
    # must clear it here or it poisons every later occupant of that slot: the
    # next client would be dropped on its first drain, having sent nothing.
    store64(s + SESS_TX_OVF, 0);
    store64(s + SESS_RX_OFF, 0);
    store64(s + SESS_RX_LEN, 0);
    store64(s + SESS_DESC_PHASE, DESC_NONE);
    telnet_state_reset(load64(s + SESS_TS));
    store64(s + SESS_LINE_POS, 0);
    store64(s + SESS_POST_POS, 0);
    store64(s + SESS_POST_FULL, 0);
    store64(s + SESS_SUBJECT_LEN, 0);
    var cb = load64(s + SESS_CURBOARD);
    memcpy(cb, "main", 4);
    store8(cb + 4, 0);
    store64(s + SESS_MODE, MODE_COMMAND);
    store64(s + SESS_LAST_CR, 0);
    store64(load64(s + SESS_QUIT), 0);
    store8(load64(s + SESS_SESSION_FP), 0);
    store8(load64(s + SESS_SESSION_HANDLE), 0);
    store8(load64(s + SESS_LOGIN_FP), 0);
    store8(load64(s + SESS_LOGIN_NONCE), 0);
    store64(s + SESS_LOGIN_STARTED_MS, 0);
    # 1.6.3 — defensive: releasing normally goes through session_release, but a
    # slot must never hand a stale state to its next occupant, and dropping the
    # pointer here without freeing would leak it. (Also releases a held door
    # play lock, 1.8.1.)
    session_door_free(s);
    store64(s + SESS_DOOR_GAME, GAME_NONE);
    store64(s + SESS_DOOR_STATE, 0);
    store64(s + SESS_DOOR_MODE, DOOR_PRACTICE);
    memset(load64(s + SESS_UNI_WORLD), 0, DOOR_WORLD_CAP);
    store8(load64(s + SESS_CHAT_CHANNEL), 0);
    store64(s + SESS_CHAT_SEEN, 0);
    store64(s + SESS_CHAT_IDLE, 0);
    store64(s + SESS_CHAT_BOT, 0);
    store64(s + SESS_REPLY_TO, 0);
    store8(load64(s + SESS_REPLY_SUBJECT), 0);
    store64(s + SESS_REPLY_SUBJECT_LEN, 0);
    return 0;
}

# Claim a free slot for cfd; returns the session ptr or 0 if the pool is full.
fn session_acquire(cfd): i64 {
    var i = 0;
    while (i < MAX_SESS) {
        var s = load64(g_sess_pool + i * 8);
        if (load64(s + SESS_ACTIVE) == 0) {
            session_reset(s, cfd);
            return s;
        }
        i = i + 1;
    }
    return 0;
}

# Return a slot to the pool (buffers persist for reuse; transient game/bot allocs
# on the slot are re-initialized by session_reset on the next claim).
# 1.6.3 (ADR 0022) — release a door state held by a SLOT, not by the globals.
# This exists separately from door_state_free() because of the poll model's
# context swap: at release time the g_* globals belong to whichever session was
# last sess_load'ed, which is NOT necessarily this one. Freeing through the
# globals here would free the wrong session's game — so read the state and the
# game id straight out of the slot.
fn session_door_free(s): i64 {
    door_play_unlock(load64(s + SESS_DOOR_LOCK));
    store64(s + SESS_DOOR_LOCK, 0 - 1);
    store64(s + SESS_DOOR_OVER0, 0);
    var ds = load64(s + SESS_DOOR_STATE);
    if (ds != 0) { door_release_state(load64(s + SESS_DOOR_GAME), ds); }
    store64(s + SESS_DOOR_STATE, 0);
    store64(s + SESS_DOOR_GAME, GAME_NONE);
    # 1.6.3 — the chat-couch bot states leak the same way and have the same
    # shape: built lazily on a bot's first couch command and held for the session.
    # 1.11.1 — one table, released through the registry like any door state.
    var couch = load64(s + SESS_COUCH);
    var cg = 1;
    while (cg <= GAME_LAST) {
        var cst = load64(couch + cg * 8);
        if (cst != 0) { door_release_state(cg, cst); store64(couch + cg * 8, 0); }
        cg = cg + 1;
    }
    # The globals may currently mirror THIS slot (the common case: the sweep
    # sess_load'ed it, decided to close it, and is releasing it now). If so they
    # would be left dangling at the freed state, so clear them too.
    if (g_door_state == ds) { g_door_state = 0; g_door_game = GAME_NONE; }
    return 0;
}

# Free a poll slot after its socket closed: drop its door state (and play lock), mark it inactive.
fn session_release(s): i64 {
    # 1.6.3 — a player who disconnects mid-game leaves a live door state in the
    # slot. Under fork the child's exit reclaimed it; under poll nothing did.
    session_door_free(s);
    # 1.11.0 — a client gone mid-visit takes its MUD connection with it.
    var mfd = load64(s + SESS_MUD_FD);
    if (mfd >= 0) { sock_close(mfd); store64(s + SESS_MUD_FD, 0 - 1); }
    store64(s + SESS_DESC_PHASE, DESC_NONE);
    store64(s + SESS_ACTIVE, 0);
    store64(s + SESS_FD, 0 - 1);
    return 0;
}

# Swap the active session's DEEP state into the g_* session globals the dispatch
# functions read (sess_load), and back afterward (sess_save). Shallow parse state
# (ts/line/mode/…) is handled by process_rx via its locals, not here.
fn sess_load(s): i64 {
    g_session_fp        = load64(s + SESS_SESSION_FP);
    g_session_handle    = load64(s + SESS_SESSION_HANDLE);
    g_login_fp          = load64(s + SESS_LOGIN_FP);
    g_login_nonce       = load64(s + SESS_LOGIN_NONCE);
    g_login_started_ms  = load64(s + SESS_LOGIN_STARTED_MS);
    g_door_game         = load64(s + SESS_DOOR_GAME);
    g_door_state        = load64(s + SESS_DOOR_STATE);
    g_door_mode         = load64(s + SESS_DOOR_MODE);
    g_uni_world         = load64(s + SESS_UNI_WORLD);
    g_chat_channel      = load64(s + SESS_CHAT_CHANNEL);
    g_chat_seen         = load64(s + SESS_CHAT_SEEN);
    g_chat_idle         = load64(s + SESS_CHAT_IDLE);
    g_chat_bot          = load64(s + SESS_CHAT_BOT);
    g_couch             = load64(s + SESS_COUCH);
    g_reply_to          = load64(s + SESS_REPLY_TO);
    g_reply_subject     = load64(s + SESS_REPLY_SUBJECT);
    g_reply_subject_len = load64(s + SESS_REPLY_SUBJECT_LEN);
    g_active_sess = s;
    return 0;
}

# The inverse of sess_load: store the deep g_* session globals back into slot `s`.
fn sess_save(s): i64 {
    store64(s + SESS_SESSION_FP,        g_session_fp);
    store64(s + SESS_SESSION_HANDLE,    g_session_handle);
    store64(s + SESS_LOGIN_FP,          g_login_fp);
    store64(s + SESS_LOGIN_NONCE,       g_login_nonce);
    store64(s + SESS_LOGIN_STARTED_MS,  g_login_started_ms);
    store64(s + SESS_DOOR_GAME,         g_door_game);
    store64(s + SESS_DOOR_STATE,        g_door_state);
    store64(s + SESS_DOOR_MODE,         g_door_mode);
    store64(s + SESS_UNI_WORLD,         g_uni_world);
    store64(s + SESS_CHAT_CHANNEL,      g_chat_channel);
    store64(s + SESS_CHAT_SEEN,         g_chat_seen);
    store64(s + SESS_CHAT_IDLE,         g_chat_idle);
    store64(s + SESS_CHAT_BOT,          g_chat_bot);
    store64(s + SESS_REPLY_TO,          g_reply_to);
    store64(s + SESS_REPLY_SUBJECT,     g_reply_subject);
    store64(s + SESS_REPLY_SUBJECT_LEN, g_reply_subject_len);
    return 0;
}

# Serve model from AGORA_SERVE: `fork` or `poll`. Default: fork on Linux
# (classic/back-compat), poll on agnos (its only concurrent option; no fork).
#
# 1.11.0 (ADR 0031) — anything else is REJECTED (returns -1; `agora serve` exits
# 2 before binding). `epoll` used to be accepted and silently mean `poll`, and a
# typo silently meant the default: an operator who asked for a model got another
# one without a word. Since 1.11.0 the poll model waits on readiness itself, so
# there is no separate epoll model to ask for.
fn serve_mode_from_env(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var dflt = SERVE_POLL;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var dflt = SERVE_FORK;
    #endif
    var e = getenv("AGORA_SERVE");
    if (e == 0) { return dflt; }
    if (streq(e, "poll") == 1)  { return SERVE_POLL; }
    if (streq(e, "fork") == 1) {
        #ifdef CYRIUS_TARGET_AGNOS
        return SERVE_POLL;   # agnos has no fork; honor "single-process" intent via poll
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        return SERVE_FORK;
        #endif
    }
    return 0 - 1;
}

# --- poll-mode I/O (bites C+D) -------------------------------------------------

# Poll mode: append bytes to session s's tx queue (drained non-blocking by the
# poll loop). Returns 1 (caller closes) if s is missing or the queue would
# overflow — a client not draining its socket fills the queue and gets dropped
# (the poll-mode slow-reader defense; fork mode uses SO_SNDTIMEO instead).
#
# 1.7.0 (roadmap N3, hole B): the over-cap arm now RECORDS the refusal on the
# session instead of only returning 1. The return value was correct and almost
# nobody read it — 158 of the 159 send sites discard it, the sole exception
# being the 1.6.3 telnet-tx drain in process_rx. So the "slow-reader defense"
# this comment has always advertised did not exist: an over-cap session lost
# bytes *silently* and stayed open holding one of the 64 slots, mute forever.
#
# The fix deliberately does NOT touch 158 call sites. `send_buf` is the single
# choke point — in poll mode it is the only caller of this function — so the
# failure is recorded here and acted on in `session_drain`, whose negative
# return both serve models ALREADY turn into a close. No new close path, no new
# error plumbing, and no way for a future send site to forget to check.
#
# Closing is the right disposition, not a harsh one: the queue is 128 KB, so
# reaching the cap means the peer has not read 128 KB of pending output. Growing
# the queue instead would be unbounded-by-design, which is the exact leak class
# 1.6.2 (ADR 0021) and 1.6.3 (ADR 0022) each spent a cut eliminating.
fn sess_tx_enqueue(s, buf, len): i64 {
    if (s == 0) { return 1; }
    if (load64(s + SESS_TX_OVF) != 0) { return 1; }
    var tlen = load64(s + SESS_TX_LEN);
    if (tlen + len > SESS_TX_CAP) {
        # 1.8.1 (audit S5 / P3) — make room before calling it an overflow. The
        # queue is only drained by the sweep AFTER a command returns, so "full"
        # meant "this one command printed more than SESS_TX_CAP", not "the peer
        # stopped reading" (the 1.7.0 rationale): a `list` of ~600+ posts cut off
        # at 128 KB and the session was dropped, so a busy board could never be
        # listed under poll — on agnos, never at all. Drain what the socket will
        # take now (non-blocking on Linux; one bounded send on agnos), compact
        # the queue, and only flag an overflow if there is still no room.
        if (session_drain(s) < 0) { store64(s + SESS_TX_OVF, 1); return 1; }
        var off = load64(s + SESS_TX_OFF);
        tlen = load64(s + SESS_TX_LEN);
        if (off > 0) {
            var tx = load64(s + SESS_TX);
            memcpy(tx, tx + off, tlen - off);   # forward copy, dst < src
            tlen = tlen - off;
            store64(s + SESS_TX_LEN, tlen);
            store64(s + SESS_TX_OFF, 0);
        }
        if (tlen + len > SESS_TX_CAP) {
            store64(s + SESS_TX_OVF, 1);
            return 1;
        }
    }
    memcpy(load64(s + SESS_TX) + tlen, buf, len);
    store64(s + SESS_TX_LEN, tlen + len);
    return 0;
}

# Flush session s's tx queue to its socket. Returns 0 = fully drained (queue
# reset), 1 = partial (remainder kept for the next sweep), <0 = socket error or
# a refused enqueue (caller closes).
#
# 1.7.0 (roadmap N3, hole A) — THE OLD DOC COMMENT WAS FALSE and the code rested
# on it. It claimed "sys_write is non-blocking on both platforms (agnos socket /
# Linux O_NONBLOCK)". Linux is true: `sock_set_nonblocking` sets O_NONBLOCK and
# EWOULDBLOCK comes back. **agnos is not.** `sock_set_nonblocking` is a literal
# `return 0;` no-op there (lib/net.cyr), and `sys_write` on a tagged socket fd
# routes to `SYS_SOCK_SEND = 48`, whose own table entry says `BLOCKS`
# (lib/syscalls_x86_64_agnos.cyr:351). So on agnos — **the only target that
# always polls** — this loop kept calling a blocking send until the entire queue
# was gone, and one slow reader stalled the shared sweep for all 64 sessions.
# The `EWOULDBLOCK` arm below is unreachable there, so the failure was invisible.
#
# There is NO non-blocking send on agnos to switch to: the syscall table has
# sock_send #48 and nothing else, no MSG_DONTWAIT and no flags argument, and
# `sock_recv` #49's would-block return has no send-side peer. So the honest fix
# is to BOUND the exposure rather than pretend to remove it: on agnos, attempt
# exactly ONE send per drain and hand the remainder to the next sweep via the
# partial path that already exists. A stalled peer can now cost the sweep one
# send call instead of an unbounded number, and the 20 ms cadence keeps the
# other 63 sessions moving. This is a mitigation, not a cure — recorded as such
# rather than closed, because the real fix is a kernel-side non-blocking send.
#
# (Hole B) A session whose enqueue was refused returns <0 here even though the
# socket itself is healthy, so the poll loop's existing `session_drain(s) < 0`
# close path retires it. The final flush is best-effort and deliberately still
# runs: the peer may yet read the "bye" already sitting in the queue.
fn session_drain(s): i64 {
    var tx_len = load64(s + SESS_TX_LEN);
    var tx_off = load64(s + SESS_TX_OFF);
    if (tx_off >= tx_len) {
        store64(s + SESS_TX_LEN, 0);
        store64(s + SESS_TX_OFF, 0);
        if (load64(s + SESS_TX_OVF) != 0) { return 0 - 1; }
        return 0;
    }
    var fd = load64(s + SESS_FD);
    var tx = load64(s + SESS_TX);
    var done = 0;
    var rc = 0;
    while (done == 0) {
        if (tx_off >= tx_len) { done = 1; rc = 0; continue; }
        # 1.8.1 (audit H5) — on agnos, ONE raw sock_send#48. Since cyrius 6.6.7
        # the stdlib's agnos `sys_write` on a socket is `_agnos_sock_send_all`,
        # which retries a 0 ("no progress after ~8 s") until a 30 s stall
        # deadline that re-arms whenever any byte moves — so one zero-window
        # peer froze the whole sweep for 30 s+, and a peer ACKing a trickle froze
        # it indefinitely. That arrived with the 1.8.0 pin move unnoticed; the
        # raw call restores the bound ADR 0023 documents (one send, then yield).
        #ifdef CYRIUS_TARGET_AGNOS
        var conn = _agnos_fd_conn(fd);
        var n = 0 - 1;
        if (conn >= 0) { n = sys_sock_send(conn, tx + tx_off, tx_len - tx_off); }
        #endif
        #ifndef CYRIUS_TARGET_AGNOS
        var n = sys_write(fd, tx + tx_off, tx_len - tx_off);
        #endif
        if (n < 0) {
            if (n == (0 - EWOULDBLOCK_ERR)) { done = 1; rc = 1; continue; }
            done = 1; rc = n; continue;
        }
        if (n == 0) { done = 1; rc = 1; continue; }
        tx_off = tx_off + n;
        # agnos only: one blocking send per drain, then yield to the sweep.
        # `continue` re-tests the loop guard, so the flag+continue idiom is
        # required here — `break` is unreliable in a while body that declares
        # `var` (CLAUDE.md § Cyrius Conventions).
        #ifdef CYRIUS_TARGET_AGNOS
        if (tx_off < tx_len) { done = 1; rc = 1; continue; }
        #endif
    }
    if (rc == 0) {
        store64(s + SESS_TX_LEN, 0);
        store64(s + SESS_TX_OFF, 0);
    } else {
        store64(s + SESS_TX_OFF, tx_off);
    }
    if (rc >= 0) {
        if (load64(s + SESS_TX_OVF) != 0) { return 0 - 1; }
    }
    return rc;
}

# === 1.11.0 — the Descent as a session state (ADR 0031) ======================
#
# Until 1.11.0 `descent` called a proxy that owned the process for the whole
# visit: under poll (and always on agnos) every other session froze, and a dead
# endpoint cost up to 4 s inside the sweep. Now `descent` dials and returns
# MODE_DESCENT; each sweep (poll) or wakeup (fork) runs `descent_pump` once, and
# the visit ends in `descent_leave`. Everything sent to the client goes through
# `send_buf` — the session's tx queue under poll — so the portal lines, the MUD's
# bytes and the return arrive in order, and the 1.8.1 flush is gone.

# `descent`: read the endpoint, dial, and enter MODE_DESCENT. Every failure is
# soft — a line, and the caller stays in MODE_COMMAND.
fn descent_begin(cfd): i64 {
    var s = g_active_sess;
    var ap = cmd_alloc(8);
    var pp = cmd_alloc(8);
    var er = descent_endpoint(g_store_buf, ap, pp);
    if (er == 1) {
        send_str(cfd, "\r\nNo Descent linked.\r\n");
        send_str(cfd, "(operator: put 'host:port' or a bare port in <store>/.descent)\r\n");
        return MODE_COMMAND;
    }
    if (er == 2) {
        send_str(cfd, "\r\nThe Descent endpoint is misconfigured (expected 'host:port' or a bare port).\r\n");
        return MODE_COMMAND;
    }
    var now = clock_now_ms();
    if (now < g_descent_down_until) {
        send_str(cfd, "\r\nThe Descent is not answering (operator may have it offline).\r\n");
        return MODE_COMMAND;
    }
    var stp = cmd_alloc(8);
    var mfd = descent_dial(load64(ap), load64(pp), stp);
    if (mfd < 0) {
        g_descent_down_until = clock_now_ms() + DESCENT_RETRY_MS;
        send_str(cfd, "\r\nThe Descent is not answering (operator may have it offline).\r\n");
        return MODE_COMMAND;
    }
    # The negotiation observer (telnet.cyr): one per slot, kept for its life.
    var obs = load64(s + SESS_DESC_OBS);
    if (obs == 0) {
        obs = alloc(TOB_SIZE);
        store64(s + SESS_DESC_OBS, obs);
    }
    tobs_init(obs, load64(s + SESS_TS));
    store64(s + SESS_MUD_FD, mfd);
    store64(s + SESS_DESC_PHASE, load64(stp));
    store64(s + SESS_DESC_DEADLINE, clock_now_ms() + DESCENT_CONNECT_MS);
    store64(s + SESS_DESC_LAST_MS, clock_now_ms());
    if (load64(stp) == DESC_PROXY) { descent_arrived(cfd); }
    return MODE_DESCENT;
}

# The connection is up: the portal lines.
fn descent_arrived(cfd): i64 {
    g_descent_down_until = 0;
    send_str(cfd, "\r\n-- stepping through the portal into Yeoman's Descent --\r\n");
    if ((load8(g_session_handle) & 0xFF) != 0) {
        send_str(cfd, "(you are ");
        send_str(cfd, g_session_handle);
        send_str(cfd, " on agora; the Descent runs its own login — identity hand-off is a future link)\r\n");
    }
    send_str(cfd, "\r\n");
    return 0;
}

# End the visit: close the MUD socket, say `msg` (0 = nothing) and, if the MUD
# was reached, `back at the agora`, then resync the telnet options from what the
# observer saw (telnet_resync) and return to the BBS prompt. Client bytes still
# waiting for the MUD are dropped — they were typed for the MUD, not as BBS
# commands.
fn descent_leave(s, msg): i64 {
    var cfd = load64(s + SESS_FD);
    var mfd = load64(s + SESS_MUD_FD);
    if (mfd >= 0) { sock_close(mfd); }
    store64(s + SESS_MUD_FD, 0 - 1);
    var reached = 0;
    if (load64(s + SESS_DESC_PHASE) == DESC_PROXY) { reached = 1; }
    store64(s + SESS_DESC_PHASE, DESC_NONE);
    store64(s + SESS_RX_OFF, 0);
    store64(s + SESS_RX_LEN, 0);
    if (msg != 0) { send_str(cfd, msg); }
    if (reached == 1) {
        send_str(cfd, "\r\n-- back at the agora --\r\n");
        session_after_descent(cfd, load64(s + SESS_DESC_OBS));
    }
    store64(s + SESS_MODE, MODE_COMMAND);
    send_prompt(cfd, load64(s + SESS_CURBOARD));
    return 0;
}

# Room in the client's output for a MUD read: the poll tx queue's free space
# (after compaction); under fork send_buf writes the socket itself, so always.
fn descent_tx_room(s): i64 {
    if (g_serve_mode != SERVE_POLL) { return SESS_TX_CAP; }
    return SESS_TX_CAP - (load64(s + SESS_TX_LEN) - load64(s + SESS_TX_OFF));
}

# Read the client into the receive buffer for the MUD: > 0 bytes, 0 nothing yet,
# -1 gone. Poll: the non-blocking session read. Fork: the socket is blocking, so
# the caller reads only after poll(2) said it is readable.
fn descent_client_read(s): i64 {
    if (g_serve_mode == SERVE_POLL) { return sess_recv_nonblock(s); }
    var n = sys_read(load64(s + SESS_FD), load64(s + SESS_RXBUF), RECV_BUF_BYTES);
    if (n > 0) { return n; }
    if (n == (0 - EWOULDBLOCK_ERR)) { return 0; }
    return 0 - 1;
}

# Move a visit forward once, never blocking. `crd` = the client may be read
# (under fork only when poll(2) said so; under poll always — its reads do not
# block), `mrd` likewise for the MUD. Returns 1 if the session must close (the
# client is gone or its output failed), 0 otherwise — including when the visit
# ended, in which case the session is back in MODE_COMMAND.
#
# Backpressure both ways: the client is read only when the MUD has taken
# everything read before (one receive buffer of pending bytes), and the MUD only
# when the client's output has room for a whole read — so a stalled MUD stops
# reading the client, and a client that stops reading stops the MUD's reads
# rather than overflowing its tx queue.
fn descent_pump(s, crd, mrd): i64 {
    var cfd = load64(s + SESS_FD);
    var mfd = load64(s + SESS_MUD_FD);
    var now = clock_now_ms();
    if (load64(s + SESS_DESC_PHASE) == DESC_CONNECTING) {
        var c = descent_connect_check(mfd);
        if (c == 0) {
            if (now < load64(s + SESS_DESC_DEADLINE)) { return 0; }
            c = 0 - 1;
        }
        if (c < 0) {
            g_descent_down_until = now + DESCENT_RETRY_MS;
            descent_leave(s, "\r\nThe Descent is not answering (operator may have it offline).\r\n");
            return 0;
        }
        store64(s + SESS_DESC_PHASE, DESC_PROXY);
        store64(s + SESS_DESC_LAST_MS, now);
        descent_arrived(cfd);
    }
    var rxbuf = load64(s + SESS_RXBUF);
    var obs = load64(s + SESS_DESC_OBS);
    var moved = 0;
    # client → MUD
    if (load64(s + SESS_RX_OFF) >= load64(s + SESS_RX_LEN)) {
        if (crd != 0) {
            var cn = descent_client_read(s);
            if (cn < 0) { return 1; }
            if (cn > 0) {
                tobs_feed(obs, TOB_C2S, rxbuf, cn);
                store64(s + SESS_RX_OFF, 0);
                store64(s + SESS_RX_LEN, cn);
            }
        }
    }
    var off = load64(s + SESS_RX_OFF);
    var len = load64(s + SESS_RX_LEN);
    if (off < len) {
        var w = descent_mud_write(mfd, rxbuf + off, len - off);
        if (w < 0) { descent_leave(s, 0); return 0; }
        if (w > 0) {
            moved = 1;
            off = off + w;
            if (off >= len) { off = 0; len = 0; }
            store64(s + SESS_RX_OFF, off);
            store64(s + SESS_RX_LEN, len);
        }
    }
    # MUD → client
    if (mrd != 0) {
        if (descent_tx_room(s) >= DESCENT_PROXY_BUF) {
            var buf[4096];                # DESCENT_PROXY_BUF
            var mn = descent_mud_read(mfd, &buf, DESCENT_PROXY_BUF);
            if (mn < 0) { descent_leave(s, 0); return 0; }
            if (mn > 0) {
                moved = 1;
                tobs_feed(obs, TOB_S2C, &buf, mn);
                if (send_buf(cfd, &buf, mn) != 0) { return 1; }
            }
        }
    }
    if (moved == 1) {
        store64(s + SESS_DESC_LAST_MS, now);
    } else {
        if (now - load64(s + SESS_DESC_LAST_MS) >= DESCENT_IDLE_MS) {
            descent_leave(s, "\r\n(idle — leaving the Descent)\r\n");
        }
    }
    return 0;
}

# The fork child's wait during a visit: poll(2) on the client socket (unless the
# MUD still owes us a write) and the MUD socket (for writes too while connecting
# or holding client bytes), up to a second, then one pump. Returns as the pump.
fn descent_fork_step(s): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return descent_pump(s, 1, 1);    # no fork on agnos; and 7 is SYS_OPEN there, not poll
    #endif
    var pfds[24];
    var nf = 0;
    var ci = 0 - 1;
    var pend = 0;
    if (load64(s + SESS_RX_OFF) < load64(s + SESS_RX_LEN)) { pend = 1; }
    if (pend == 0) { ci = nf; nf = poll_fd_put(&pfds, nf, load64(s + SESS_FD), POLL_IN); }
    var mev = POLL_IN;
    if (pend == 1) { mev = mev | POLL_OUT; }
    if (load64(s + SESS_DESC_PHASE) == DESC_CONNECTING) { mev = mev | POLL_OUT; }
    nf = poll_fd_put(&pfds, nf, load64(s + SESS_MUD_FD), mev);
    var si = 0 - 1;
    if (g_child_sigfd >= 0) { si = nf; nf = poll_fd_put(&pfds, nf, g_child_sigfd, POLL_IN); }
    syscall(7, &pfds, nf, POLL_WAIT_MAX_MS);
    if (si >= 0) {
        if ((load16((&pfds) + si * 8 + 6) & 0xFFFF) != 0) {
            if (shutdown_signal_pending(g_child_sigfd, g_shutdown_siginfo) == 1) {
                fork_child_goodbye(s);
                return 1;
            }
        }
    }
    var crd = 0;
    if (ci >= 0) { if ((load16((&pfds) + ci * 8 + 6) & 0xFFFF) != 0) { crd = 1; } }
    return descent_pump(s, crd, 1);
}

# 1.8.1 — back at the BBS from the Descent.
#  - (audit G2) the visit was activity: SESS_LAST_MS was not touched while the
#    player was in the MUD, so under poll the sweep reaped them the moment they
#    returned from any visit longer than SESS_IDLE_MS (60 s).
#  - (audit G4) the MUD negotiates its own ECHO (WILL ECHO around the passphrase,
#    then WONT ECHO) and agora never sees that exchange, so it kept echoing into a
#    client that had gone back to local echo. 1.8.1 reset agora's option state
#    and re-announced. 1.11.0 (ADR 0031) — that reset is gone: a client ignores DO
#    for an option it already has on, so the reset left agora believing NAWS and
#    LINEMODE were only requested, dropped every later window report (wrapping
#    stopped for good) and re-took echo from a LINEMODE client still in EDIT
#    (blind typing). `telnet_resync` adopts what the observer saw the client
#    agree to and negotiates only the differences.
fn session_after_descent(cfd, obs): i64 {
    var s = g_active_sess;
    store64(s + SESS_LAST_MS, clock_now_ms());
    var ts = load64(s + SESS_TS);
    telnet_resync(ts, obs);
    var tl = telnet_tx_len(ts);
    if (tl > 0) {
        send_buf(cfd, telnet_tx_buf(ts), tl);
        telnet_tx_consume(ts);
    }
    return 0;
}

# Read up to RECV_BUF_BYTES into session s's rxbuf WITHOUT blocking. Returns
# n>0 = bytes read, 0 = would-block (no data now), -1 = EOF/error (caller closes).
# agnos: sys_read on a socket fd is the BLOCKING adapter, so use sock_recv#49
# directly (inverted sense: >0 bytes / 0 would-block / -1 EOF). Linux: sys_read on
# the O_NONBLOCK'd fd (-EAGAIN = would-block). The split descent uses.
fn sess_recv_nonblock(s): i64 {
    var fd = load64(s + SESS_FD);
    var rxbuf = load64(s + SESS_RXBUF);
    #ifdef CYRIUS_TARGET_AGNOS
    var conn = _agnos_fd_conn(fd);
    var na = sys_sock_recv(conn, rxbuf, RECV_BUF_BYTES);
    if (na == 0) { return 0; }
    if (na < 0) { return 0 - 1; }
    return na;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = sys_read(fd, rxbuf, RECV_BUF_BYTES);
    if (n > 0) { return n; }
    if (n == 0) { return 0 - 1; }
    if (n == (0 - EWOULDBLOCK_ERR)) { return 0; }
    return 0 - 1;
    #endif
}

# 1.6.5 (audit L1) — the largest `--store` we accept, leaving headroom inside
# PATH_MAX_BYTES (512) for every suffix a path builder appends.
enum StoreLimit {
    STORE_PATH_MAX = 448;
}

enum PollRuntime {
    POLL_LINE_BUDGET = 1;      # 1.8.1 (H2) — counted lines per session per sweep
    POLL_MS      = 20;         # sweep cadence on agnos (no poll(2)); Linux waits on readiness
    POLL_WAIT_MAX_MS = 1000;   # 1.11.0 — the longest readiness wait (timers are re-checked)
    POLL_FDS_MAX = 130;        # 1.11.0 — listener + signalfd + a client and a MUD socket per slot
    POLL_IN      = 1;          # poll(2) events (Linux / macOS, cross-arch identical)
    POLL_OUT     = 4;
    SESS_IDLE_MS = 60000;      # general idle reap (mirrors RECV_TIMEOUT_SECS)
    CHAT_TICK_MS = 2000;       # chat live-tail flush cadence (CHAT_POLL_SECS)
}

# --- clean shutdown, SIGINT / SIGTERM (roadmap N1) ----------------------------
#
# Until 1.7.0 NEITHER serve loop could exit: both declared `var stop = 0;` and
# looped `while (stop == 0)` with nothing anywhere assigning `stop`. The server
# could only be killed — the poll model never drained its 64 slots and the fork
# model never reaped. The flags had been dead since the loops were written, and
# the gap appeared in no document until the 2026-07-26 sweep found it.
#
# The mechanism is a **signalfd**, not a handler. A handler would have to be
# async-signal-safe and, on Linux, needs the `rt_sigaction` `sa_restorer`
# trampoline that ADR 0007 rejected outright. A signalfd turns signal delivery
# into an ordinary readable fd, which is exactly the shape both loops already
# know how to consume — and it is the only form that works on agnos, whose
# `signal_ignore` is a no-op (no `rt_sigaction`) but which does implement
# `sigprocmask` (#17) and `signalfd` (#18). darshana's `tty_open_signalfd`
# is the in-ecosystem reference this follows.
#
# 1.8.0 (darshana 0.9.0 → 1.3.0) — why agora still does NOT call darshana's
# signalfd trio (`tty_open_signalfd` / `tty_read_signal` / `tty_close_signalfd`),
# re-checked against darshana's frozen 1.3.0 surface:
#   - Its AGNOS peer BLOCKS the signals before creating the fd, as its Linux
#     peer does. Under mirshi a blocked signal is never delivered through a
#     signalfd (darshana's own docstring says so, filed with mirshi), so
#     adopting it would arm a shutdown that can never fire on the one target
#     that always polls. `shutdown_signals_arm` skips the block there on purpose.
#   - Its exit mask, TTY_SIGMASK_EXIT, is HUP|INT|TERM. agora shuts down on
#     INT|TERM only; adding SIGHUP would change what a hangup does to a server.
#   - The defects the darshana bump was flagged for never reached agora: it
#     never called darshana's open (this code was always hand-rolled), and its
#     own failure path below already unblocks and returns exactly -1 — the two
#     things darshana 0.9.3 fixed. darshana 1.0.2's refinement (roll back only
#     the bits the call ADDED, so a second live signalfd is not deafened) does
#     not apply either: agora owns exactly one signalfd, and unblocking INT|TERM
#     unconditionally — here and in every fork child — is what guarantees an
#     operator can always kill a server or a session process, even one launched
#     with those signals already blocked.
#   - The child-inheritance hazard darshana 1.1.4 documents (a signalfd's block
#     survives fork AND execve) is handled by `shutdown_signals_child_reset`,
#     the first call in every fork child. agora never execs, and the SIGPIPE
#     SIG_IGN that children inherit across fork is wanted (they write sockets).

enum ShutdownSig {
    SIGINFO_BYTES  = 128;     # sizeof(struct signalfd_siginfo) — one read record
    SHUTDOWN_POLLIN = 1;      # poll(2) POLLIN (Linux/macOS, cross-arch identical)
    FORK_POLL_MS   = 500;     # fork parent: poll timeout; also the reap cadence
    FORK_GRACE_MS  = 5000;    # fork parent: how long to wait for children at exit
}

# The sigset_t bitmask for the signals agora shuts down on (SIGINT + SIGTERM).
#
# ⚠ THE BIT CONVENTION DIFFERS BY TARGET, and getting it wrong fails SILENTLY —
# the process arms cleanly, blocks the signals it named, and then simply never
# wakes, which reads as "clean shutdown is broken" rather than "the mask is
# wrong". Linux sigset_t numbers bits from ZERO (bit = signum - 1), so
# SIGINT(2)|SIGTERM(15) is bit1|bit14 = 0x4002. agnos numbers them from ONE
# (bit = signum), so the same two signals are bit2|bit15 = 0x8004. This is not
# a guess: darshana carries the identical split for HUP|INT|TERM —
# `TTY_SIGMASK_EXIT` is 0x4003 on Linux and 0x8006 on agnos (lib/darshana.cyr),
# and those two constants differ by exactly this one-bit shift.
fn shutdown_sigmask(): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 0x8004;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    return 0x4002;
    #endif
}

# Route SIGINT/SIGTERM to a signalfd. Returns the fd, or (0 - 1) if arming
# fails — in which case the caller serves exactly as it did before 1.7.0, with
# the default dispositions still in force. That degradation is deliberate:
# failing to arm clean shutdown is not a reason to refuse to serve.
#
# ⚠ BLOCKING IS REQUIRED ON LINUX AND WRONG ON AGNOS. The two kernels compute
# signalfd readiness with OPPOSITE senses:
#
#   Linux  — a signal must be BLOCKED or its default action (terminate) runs
#            first and the process is gone before it can read the fd. Blocking
#            is what diverts delivery into the queue the fd drains.
#   agnos  — mirshi computes `deliverable = pending AND NOT blocked`
#            (mirshi/src/children.cyr:163, consumed by the signalfd#18 path at
#            dispatch.cyr:959 and :1199), so a BLOCKED signal is exactly the one
#            the fd will never report. Blocking there would arm a shutdown that
#            can never fire. It is also unnecessary: `_do_kill`
#            (mirshi/src/intercept.cyr:509-524) only ORs a pending bit and there
#            is no default disposition that terminates the guest, so an
#            unblocked SIGTERM cannot kill us before we read it.
#
# Using one arm for both compiles cleanly and fails silently on whichever target
# you did not test — which, for agnos, is every target agora can actually run
# its smokes on.
#
# SFD_NONBLOCK so the polling read never parks; SFD_CLOEXEC so an exec'd child
# cannot inherit the fd (fork alone still inherits it — see
# `shutdown_signals_child_reset`).
fn shutdown_signals_arm(): i64 {
    var mask[8];
    var i = 0;
    while (i < 8) { store8(&mask + i, 0); i = i + 1; }
    store64(&mask, shutdown_sigmask());
    #ifndef CYRIUS_TARGET_AGNOS
    if (sys_sigprocmask(0, &mask, 0) < 0) { return 0 - 1; }   # 0 = SIG_BLOCK
    #endif
    var fd = sys_signalfd(0 - 1, &mask, SFD_NONBLOCK | SFD_CLOEXEC);
    #ifndef CYRIUS_TARGET_AGNOS
    # ⚠ If signalfd fails after the block succeeded we must UNBLOCK, or we leave
    # the process in a half-armed state: SIGINT and SIGTERM blocked with nothing
    # draining them, i.e. an unkillable server. That is strictly worse than the
    # pre-1.7.0 behaviour this function is supposed to degrade to.
    if (fd < 0) { sys_sigprocmask(1, &mask, 0); return 0 - 1; }   # 1 = SIG_UNBLOCK
    #endif
    return fd;
}

# Undo `shutdown_signals_arm` in a freshly forked child. MUST be called first
# thing in the fork-mode child branch.
#
# ⚠ WITHOUT THIS, EVERY CONNECTION CHILD IS UNKILLABLE. fork(2) inherits the
# thread's signal mask, so a child spawned after the parent armed shutdown
# starts life with SIGINT and SIGTERM blocked and no signalfd being read — an
# operator's `kill` on a stuck session does nothing at all. Measured before the
# fix: a child's `/proc/<pid>/status` showed `SigBlk: 0000000000004002`
# (precisely our mask) and it survived SIGTERM. Children serve untrusted clients
# and are exactly the processes an operator most needs to be able to kill.
#
# The inherited signalfd is closed too: SFD_CLOEXEC only covers exec, not fork,
# and a child holding a readable copy could consume a shutdown notification the
# parent is waiting for.
fn shutdown_signals_child_reset(sigfd): i64 {
    if (sigfd >= 0) { file_close(sigfd); }
    #ifndef CYRIUS_TARGET_AGNOS
    var mask[8];
    var i = 0;
    while (i < 8) { store8(&mask + i, 0); i = i + 1; }
    store64(&mask, shutdown_sigmask());
    sys_sigprocmask(1, &mask, 0);   # 1 = SIG_UNBLOCK — restore default disposition
    #endif
    return 0;
}

# 1.11.0 (ADR 0031) — set up a freshly forked connection child. Replaces, for
# connection children, the 1.7.0 `shutdown_signals_child_reset` (still used by
# the one-shot index child):
#   - the parent's signalfd is closed, as before;
#   - SIGINT / SIGTERM, which the child inherits BLOCKED, get a signalfd of the
#     child's own, which `handle_client` waits on beside the client socket — so
#     the child still ends on SIGTERM (1.7.0's point: children serve untrusted
#     clients and must stay killable), but it ends the way a poll session does
#     at shutdown: a goodbye, the door checkpoint, the MUD socket closed. If the
#     signalfd cannot be made, the signals are unblocked instead (1.7.0's
#     behaviour: the default action ends the child).
#   - PR_SET_PDEATHSIG = SIGTERM: a parent that dies — crashes, is SIGKILLed —
#     takes its children with it instead of leaving orphans nobody can count
#     (ADR 0007's open item). The getppid re-check closes the race where the
#     parent died between the fork and the prctl: then no signal will ever come,
#     so the child leaves at once.
# Returns the child's signalfd, or -1.
fn fork_child_arm(sigfd, ppid): i64 {
    if (sigfd >= 0) { file_close(sigfd); }
    var csig = 0 - 1;
    #ifndef CYRIUS_TARGET_AGNOS
    if (sigfd >= 0) {
        var mask[8];
        store64(&mask, shutdown_sigmask());
        csig = sys_signalfd(0 - 1, &mask, SFD_NONBLOCK | SFD_CLOEXEC);
        if (csig < 0) { sys_sigprocmask(1, &mask, 0); }   # 1 = SIG_UNBLOCK
    }
    #endif
    #ifdef CYRIUS_TARGET_LINUX
    sys_prctl(1, SIGTERM, 0, 0, 0);                         # 1 = PR_SET_PDEATHSIG
    if (sys_getppid() != ppid) { sys_exit(0); }
    #endif
    return csig;
}

# The fork child's wait between lines: poll(2) on the client socket and the
# child's signalfd, for as long as the recv timeout the session is under —
# CHAT_POLL_SECS in chat (the live-tail tick), RECV_TIMEOUT_SECS otherwise.
# Returns 1 when the client is readable (or hung up), 0 on the timeout, 2 when a
# shutdown signal arrived. Before 1.11.0 the child blocked in read(2) and the
# SO_RCVTIMEO timeout woke it; a signal could only kill it.
fn fork_child_wait(s): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;                    # no fork on agnos; and 7 is SYS_OPEN there, not poll
    #endif
    var pfds[16];
    var nf = poll_fd_put(&pfds, 0, load64(s + SESS_FD), POLL_IN);
    if (g_child_sigfd >= 0) { nf = poll_fd_put(&pfds, nf, g_child_sigfd, POLL_IN); }
    var ms = RECV_TIMEOUT_SECS * 1000;
    if (load64(s + SESS_MODE) == MODE_CHAT) { ms = CHAT_POLL_SECS * 1000; }
    var pr = syscall(7, &pfds, nf, ms);
    if (pr <= 0) { return 0; }
    if (nf == 2) {
        if ((load16((&pfds) + 14) & 0xFFFF) != 0) {
            if (shutdown_signal_pending(g_child_sigfd, g_shutdown_siginfo) == 1) { return 2; }
        }
    }
    if ((load16((&pfds) + 6) & 0xFFFF) != 0) { return 1; }
    return 0;
}

# A fork child told to stop (its parent's shutdown, or the parent's death via
# PR_SET_PDEATHSIG): say why, as serve_poll_shutdown does for a poll session.
# The caller's close path then checkpoints the door and closes the socket.
fn fork_child_goodbye(s): i64 {
    var cfd = load64(s + SESS_FD);
    if (load64(s + SESS_MODE) == MODE_DESCENT) {
        send_str(cfd, "\r\n(the agora is closing — leaving the Descent)\r\n");
    }
    send_str(cfd, "\r\n(server shutting down -- goodbye)\r\n");
    return 0;
}

# Has a shutdown signal arrived? Non-blocking; returns 1 if so, 0 otherwise.
# `infobuf` must be at least SIGINFO_BYTES. The record's contents are not
# inspected — both signals mean the same thing to us — but the read must still
# consume one, or the fd stays readable forever.
fn shutdown_signal_pending(sigfd, infobuf): i64 {
    if (sigfd < 0) { return 0; }
    var n = sys_read(sigfd, infobuf, SIGINFO_BYTES);
    if (n > 0) { return 1; }
    return 0;
}

# Retire every live session, then the listener. Poll mode owns all 64 slots in
# one process, so this is the only place they can be closed cleanly: tell each
# client why, flush what is queued, close the socket, release the slot (which
# frees the door state via ADR 0022's DD_FREE hook).
fn serve_poll_shutdown(sfd, sigfd): i64 {
    println("agora serve: shutdown signal — closing sessions");
    var i = 0;
    while (i < MAX_SESS) {
        var s = load64(g_sess_pool + i * 8);
        if (load64(s + SESS_ACTIVE) != 0) {
            var cfd = load64(s + SESS_FD);
            # sess_load sets g_active_sess, which is what send_str enqueues to
            # in poll mode — without it the notice would land on whichever
            # session happened to be dispatched last.
            sess_load(s);
            if (load64(s + SESS_MODE) == MODE_DESCENT) {
                send_str(cfd, "\r\n(the agora is closing — leaving the Descent)\r\n");
            }
            send_str(cfd, "\r\n(server shutting down -- goodbye)\r\n");
            session_drain(s);
            sess_save(s);
            session_door_checkpoint(s);      # 1.8.1 (D1) — keep in-game progress
            sock_close(cfd);
            session_release(s);
        }
        i = i + 1;
    }
    if (sigfd >= 0) { file_close(sigfd); }
    sock_close(sfd);
    println("agora serve: stopped");
    return 0;
}

# 1.11.0 (ADR 0031) — the poll model's wait: one poll(2) over the listener, the
# shutdown signalfd and every live session's socket (POLLIN, plus POLLOUT while
# its tx queue holds bytes the socket would not take), with a timeout of the
# next timer due — a chat session's live-tail tick or a session's idle reap — at
# most POLL_WAIT_MAX_MS. Until 1.11.0 the loop slept a fixed 20 ms per sweep: at
# most 50 sequential accepts a second, and 0-20 ms added to every command. The
# array is rebuilt each time (at most 2 + 2 x MAX_SESS entries, 8 bytes each):
# sessions come and go and change mode, and a rebuild needs no bookkeeping.
# What woke us does not matter: the sweep looks at everything anyway. Linux /
# macOS only — poll(2) is raw `syscall(7, …)` (no stdlib wrapper), as in the
# fork accept loop; agnos has none.
fn serve_poll_wait(sfd, sigfd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    sys_sleep_ms(POLL_MS);       # never called there (serve_poll paces agnos itself); 7 is SYS_OPEN on agnos
    return 0;
    #endif
    if (g_poll_fds == 0) { g_poll_fds = alloc(POLL_FDS_MAX * 8); }
    var fds = g_poll_fds;
    var nf = poll_fd_put(fds, 0, sfd, POLL_IN);
    if (sigfd >= 0) { nf = poll_fd_put(fds, nf, sigfd, POLL_IN); }
    var now = clock_now_ms();
    var wait = POLL_WAIT_MAX_MS;
    var i = 0;
    while (i < MAX_SESS) {
        var s = load64(g_sess_pool + i * 8);
        if (load64(s + SESS_ACTIVE) != 0) {
            var mode = load64(s + SESS_MODE);
            var ev = POLL_IN;
            var due = SESS_IDLE_MS - (now - load64(s + SESS_LAST_MS));
            if (mode == MODE_CHAT) {
                due = CHAT_TICK_MS - (now - load64(s + SESS_CHAT_TICK_MS));
            }
            if (mode == MODE_DESCENT) {
                # The client is read only when the MUD holds none of its bytes,
                # and the MUD only while the client's queue has room — waiting
                # on a socket the pump will not read would spin.
                var pend = 0;
                if (load64(s + SESS_RX_OFF) < load64(s + SESS_RX_LEN)) { pend = 1; ev = 0; }
                var mev = 0;
                if (descent_tx_room(s) >= DESCENT_PROXY_BUF) { mev = POLL_IN; }
                if (pend == 1) { mev = mev | POLL_OUT; }
                due = POLL_WAIT_MAX_MS;
                if (load64(s + SESS_DESC_PHASE) == DESC_CONNECTING) {
                    mev = mev | POLL_OUT;
                    due = load64(s + SESS_DESC_DEADLINE) - now;
                }
                if (mev != 0) { nf = poll_fd_put(fds, nf, load64(s + SESS_MUD_FD), mev); }
            }
            if (load64(s + SESS_TX_LEN) > load64(s + SESS_TX_OFF)) { ev = ev | POLL_OUT; }
            if (ev != 0) { nf = poll_fd_put(fds, nf, load64(s + SESS_FD), ev); }
            if (due < wait) { wait = due; }
        }
        i = i + 1;
    }
    if (wait < 0) { wait = 0; }
    syscall(7, fds, nf, wait);
    return 0;
}

# Append one pollfd { i32 fd; i16 events; i16 revents } at index `n`; returns n + 1.
fn poll_fd_put(fds, n, fd, ev): i64 {
    var p = fds + n * 8;
    store32(p, fd);
    store16(p + 4, ev);
    store16(p + 6, 0);
    return n + 1;
}

# 1.6.0 single-process poll multiplex: one process serves ALL connections. Each
# sweep drains pending accepts (non-blocking), then services every active slot —
# non-blocking recv → process_rx → non-blocking tx drain — swapping the active
# session's deep globals in/out (sess_load/sess_save) around each. Never blocks on
# any one client. agnos paces with sys_sleep_ms; Linux with the portable sleep_ms
# over O_NONBLOCK sockets (epoll is a later optimization).
fn serve_poll(sfd): i64 {
    session_pool_init();
    if (g_door_registry == 0) { door_registry_init(); }
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(sfd);
    #endif
    # N1: armed in cmd_serve_on, before the listener existed (see the note there).
    var sigfd = g_shutdown_sigfd;
    var siginfo = g_shutdown_siginfo;
    var stop = 0;
    while (stop == 0) {
        # 0) shutdown check, before any work: a signal that arrived during the
        # last sweep retires the server rather than starting another one.
        if (shutdown_signal_pending(sigfd, siginfo) == 1) { stop = 1; continue; }
        # 1) drain pending accepts
        var acc = 1;
        while (acc == 1) {
            var at, av = sock_accept(sfd);
            if (is_ok(at) == 0) { acc = 0; }
            else {
                var cfd = result_unwrap(at, av);
                #ifndef CYRIUS_TARGET_AGNOS
                sock_set_nonblocking(cfd);
                # 1.8.2 — as in handle_client: a drain that cannot finish in one
                # write must not have its remainder held by Nagle.
                sock_set_nodelay(cfd, 1);
                #endif
                var s = session_acquire(cfd);
                if (s == 0) {
                    # 1.6.2 — was 33, which is the byte count for an ASCII
                    # hyphen. The dash here is an em dash (U+2014, THREE bytes
                    # in UTF-8), so the literal is 35 bytes and the short count
                    # cut off exactly the trailing CRLF: the one message a
                    # client gets when the 64-slot pool is full arrived
                    # unterminated, and its next output ran on from there.
                    # Like the fork loop's cap refusal and the Descent's write to
                    # the MUD (descent_mud_write), this writes the socket directly — there
                    # is no session to enqueue into yet — so a send_buf-based
                    # audit misses it. (1.8.1: it used to call itself the only one.)
                    sys_write(cfd, "server full — try again shortly\r\n", 35);
                    sock_close(cfd);
                } else {
                    sess_load(s);
                    session_greet(s);
                    var gd = session_drain(s);
                    sess_save(s);
                    if (gd < 0) { sock_close(cfd); session_release(s); }
                }
            }
        }
        # 2) sweep active sessions
        var now = clock_now_ms();
        var parked = 0;
        var i = 0;
        while (i < MAX_SESS) {
            var s = load64(g_sess_pool + i * 8);
            if (load64(s + SESS_ACTIVE) != 0) {
                var cfd = load64(s + SESS_FD);
                sess_load(s);
                var close_it = 0;
                # 1.8.1 (audit H2) — a remainder parked by the line budget runs
                # before anything new is read; it IS this sweep's input.
                # 1.11.0 (ADR 0031) — a session in the Descent is pumped, never read as
                # lines: its receive buffer holds client bytes owed to the MUD.
                if (load64(s + SESS_MODE) == MODE_DESCENT) {
                    if (descent_pump(s, 1, 1) == 1) { close_it = 1; }
                } else {
                    var poff = load64(s + SESS_RX_OFF);
                    var n = 0;
                    if (poff < load64(s + SESS_RX_LEN)) { n = 0 - 2; }
                    else { n = sess_recv_nonblock(s); }
                    if (n == (0 - 2)) {
                        if (process_rx(s, poff, load64(s + SESS_RX_LEN), POLL_LINE_BUDGET) == 1) { close_it = 1; }
                    }
                    else { if (n > 0) {
                            # 1.6.4 (audit M3) — the idle timer is NOT refreshed here.
                            #
                            # It used to be, on ANY bytes arriving, which made the 64-slot
                            # pool trivially pinnable: `IAC NOP` (2 bytes) is consumed by
                            # the state machine with no response and no data byte, so 64
                            # connections sending one every 50 s held every slot forever
                            # at ~2 bytes/minute each — invisibly, since nothing was ever
                            # typed. Protocol chatter is not activity. `process_rx` now
                            # refreshes the timer only when a byte actually reaches the
                            # session as DATA, so a keepalive-only connection ages out
                            # like a silent one. (1.8.1: the chat reaper's g_chat_idle
                            # likewise resets in process_rx, on a kept byte only.)
                            if (process_rx(s, 0, n, POLL_LINE_BUDGET) == 1) { close_it = 1; }
                        }
                        else { if (n < 0) { close_it = 1; }
                            else {
                                # would-block: no input this sweep. Chat live-tail tick +
                                # idle reaping (fork mode gets these from the recv timeout).
                                if (load64(s + SESS_MODE) == MODE_CHAT) {
                                    if (now - load64(s + SESS_CHAT_TICK_MS) >= CHAT_TICK_MS) {
                                        store64(s + SESS_CHAT_TICK_MS, now);
                                        if (load64(s + SESS_LINE_POS) == 0) {
                                            if (g_chat_bot == 0) { chat_flush_tail(cfd); }
                                        }
                                        g_chat_idle = g_chat_idle + CHAT_POLL_SECS;
                                        if (g_chat_idle >= CHAT_IDLE_SECS) {
                                            send_str(cfd, "\r\n(idle — leaving chat)\r\n");
                                            close_it = 1;
                                        }
                                    }
                                } else {
                                    if (now - load64(s + SESS_LAST_MS) >= SESS_IDLE_MS) { close_it = 1; }
                                }
                            } } }
                }
                # 3) flush queued output
                if (close_it == 0) {
                    if (session_drain(s) < 0) { close_it = 1; }
                }
                sess_save(s);
                if (close_it == 1) {
                    session_door_checkpoint(s);  # 1.8.1 (D1) — a drop saves like `q`
                    session_drain(s);            # best-effort final flush (e.g. "bye")
                    sock_close(cfd);
                    session_release(s);
                } else {
                    # (Bytes a Descent session holds for the MUD are not a parked
                    # remainder: the wait watches the MUD socket for them.)
                    if (load64(s + SESS_MODE) != MODE_DESCENT) {
                        if (load64(s + SESS_RX_OFF) < load64(s + SESS_RX_LEN)) { parked = 1; }
                    }
                }
            }
            i = i + 1;
        }
        # 4) wait for the next thing to do — but not while a session has a parked
        # remainder (1.8.1, H2): the budget is for fairness between sessions,
        # not a rate limit, so a lone scripted client still runs at full speed.
        # 1.11.0 (ADR 0031) — on Linux a readiness wait (serve_poll_wait), not a
        # fixed 20 ms sleep; agnos has no poll(2) and keeps the paced sweep.
        if (parked == 0) {
            #ifdef CYRIUS_TARGET_AGNOS
            sys_sleep_ms(POLL_MS);
            #endif
            #ifndef CYRIUS_TARGET_AGNOS
            serve_poll_wait(sfd, sigfd);
            #endif
        }
    }
    return serve_poll_shutdown(sfd, sigfd);
}

# Send the connect greeting on session `s`: telnet option salvo, MOTD, first
# prompt. Extracted verbatim from handle_client's entry.
fn session_greet(s): i64 {
    var cfd = load64(s + SESS_FD);
    var ts  = load64(s + SESS_TS);
    # 1.8.1 (audit P5) — the greeting runs OUTSIDE any line dispatch, so nothing
    # reset the arena after its MOTD scratch: on a quiet poll server a flood of
    # connect-and-close clients filled the 512 KB arena, and every greeting
    # after that fell back to a bare 1 KB alloc() — never reclaimed.
    cmd_scratch_reset();
    # Open with the preferred-options salvo (IAC WILL ECHO / WILL SGA / DO NAWS /
    # DO TERMINAL_TYPE) before any application bytes flow.
    telnet_announce(ts);
    var tx_len_ann = telnet_tx_len(ts);
    if (tx_len_ann > 0) {
        send_buf(cfd, telnet_tx_buf(ts), tx_len_ann);
        telnet_tx_consume(ts);
    }
    # MOTD: operator file (--motd) if present, else the default render.
    if (g_motd_buf != 0) {
        send_buf(cfd, g_motd_buf, g_motd_len);
    } else {
        var motd = cmd_alloc(1024);
        var motd_len = render_motd(motd);
        send_buf(cfd, motd, motd_len);
    }
    send_prompt(cfd, load64(s + SESS_CURBOARD));
    store64(s + SESS_GREETED, 1);
    return 0;
}

# Handle an n<=0 read on session `s`. In MODE_CHAT an EWOULDBLOCK (the short
# CHAT_POLL_SECS timeout) is the live-tail tick, not a disconnect (ADR 0011):
# flush new transcript lines when the input line is empty, bound pure silence by
# CHAT_IDLE_SECS. Returns 1 = close the session, 0 = keep (chat tick). Deep chat
# globals must be sess_load'd by the caller first.
fn session_rx_idle(s, n): i64 {
    var cfd = load64(s + SESS_FD);
    var mode = load64(s + SESS_MODE);
    var line_pos = load64(s + SESS_LINE_POS);
    if (mode == MODE_CHAT) {
        if (n == (0 - EWOULDBLOCK_ERR)) {
            if (line_pos == 0) { if (g_chat_bot == 0) { chat_flush_tail(cfd); } }
            g_chat_idle = g_chat_idle + CHAT_POLL_SECS;
            if (g_chat_idle >= CHAT_IDLE_SECS) {
                send_str(cfd, "\r\n(idle — leaving chat)\r\n");
                return 1;
            }
            return 0;
        }
    }
    return 1;
}

# Erase from the session's input line: the last character (`all` 0 — BS, DEL,
# IAC EC) or the whole line (`all` 1 — IAC EL, RFC 854: "back to, but not
# including, the last CR LF"; the line buffer IS the text since then). A character
# is a whole UTF-8 sequence. While agora is echoing, each erased character is
# wiped from the screen with BS SP BS. Returns the new length, or -1 when the
# echo could not be sent (the caller closes, as for any failed send). An empty
# line is left alone, silently.
fn line_erase(cfd, ts, line, line_pos, all): i64 {
    var echo = 0;
    if (opt_us(ts, OPT_ECHO) != Q_NO) { echo = 1; }
    var going = 1;
    while (going == 1) {
        if (line_pos <= 0) { going = 0; continue; }
        line_pos = utf8_erase_last(line, line_pos);
        if (echo == 1) {
            if (send_buf(cfd, "\x08 \x08", 3) != 0) { return 0 - 1; }
        }
        if (all == 0) { going = 0; }
    }
    return line_pos;
}

# Process n bytes already sitting in session `s`'s rxbuf: telnet-decode byte by
# byte, accumulate lines, dispatch each complete line by mode. This is the exact
# byte-loop that used to live inline in handle_client — verbatim below. The
# shallow parse state (ts/line/mode/post/subject/board/last_cr/quit) rides in the
# session slot; loaded to locals here and saved back at exit so it survives across
# reads (poll multiplex) or across a blocking loop (fork). The deep session
# globals are swapped by the caller (sess_load/sess_save). Returns 1 iff the
# client asked to quit (quit flag set).
#
# 1.8.1 (audit H2) — runs bytes [start, n) and stops after `budget` counted
# lines (0 = no limit), parking the rest in SESS_RX_OFF / SESS_RX_LEN. Under
# poll every complete line in a 4 KB recv used to run before the sweep moved
# on, so one anonymous client pipelining `read 1` (585 per packet) or `login x`
# held every other session for seconds — 4 such clients put 2.5 s on a
# bystander's echo, 16 put 10 s. The serve_poll sweep passes POLL_LINE_BUDGET,
# so each session gets that many lines per pass, round-robin; the fork worker
# passes 0, since its process is its own.
fn process_rx(s, start, n, budget): i64 {
    var cfd = load64(s + SESS_FD);
    var rxbuf = load64(s + SESS_RXBUF);
    var ts = load64(s + SESS_TS);
    var line = load64(s + SESS_LINE);
    var line_pos = load64(s + SESS_LINE_POS);
    var post = load64(s + SESS_POST);
    var post_pos = load64(s + SESS_POST_POS);
    var subject = load64(s + SESS_SUBJECT);
    var subject_len = load64(s + SESS_SUBJECT_LEN);
    var current_board = load64(s + SESS_CURBOARD);
    var mode = load64(s + SESS_MODE);
    var last_cr = load64(s + SESS_LAST_CR);
    var quit = load64(s + SESS_QUIT);
    var lines = 0;
    var park = 0 - 1;
    var i = start;
    while (i < n) {
        if (load64(quit) != 0) { i = n; continue; }
        # 1.8.1 (audit H19) — a session whose output has failed (sticky, both
        # models) runs nothing more: quit, and the caller closes it.
        if (load64(s + SESS_TX_OVF) != 0) { store64(quit, 1); i = n; continue; }
        if (budget > 0) {
            if (lines >= budget) { park = i; i = n; continue; }
        }
        var b = load8(rxbuf + i) & 0xFF;
        var ev = telnet_feed(ts, b);
        # 1.10.0 — a subnegotiation may queue a reply (LINEMODE MODE / SLC), so it
        # is handled BEFORE the drain below. It used to run after, so its reply sat
        # in the buffer until the next byte — or for good, if the SB ended the recv.
        if (ev == EV_SB) {
            telnet_handle_sb(ts);
        }

        # Drain any IAC responses queued by the state machine
        # before processing the data byte — keeps on-wire order
        # matching RFC 854.
        # 1.6.3 (audit) — a failed send here is a DEAD PEER, and ignoring it was
        # an unauthenticated resource-exhaustion path. Fork mode writes with a
        # 60 s SO_SNDTIMEO (SEND_TIMEOUT_SECS): a client that stops reading fills
        # the socket buffer, every `sys_write` parks for the full timeout, and
        # because the return was discarded the loop simply moved to the NEXT
        # byte and parked again — one 4096-byte recv could pin a forked child
        # for hours at zero ongoing attacker cost, and children are unbounded.
        # In poll mode `sess_tx_enqueue` refuses an over-cap write and returns 1
        # WITHOUT copying, so the session went mute-but-open forever, holding a
        # slot: exactly the "slow-reader defense" its own comment claims but did
        # not implement. Setting quit and leaving the loop makes process_rx
        # return 1, which both serve models already turn into a close.
        var tx_len = telnet_tx_len(ts);
        if (tx_len > 0) {
            var txr = send_buf(cfd, telnet_tx_buf(ts), tx_len);
            telnet_tx_consume(ts);
            if (txr != 0) { store64(quit, 1); i = n; continue; }
        }

        # 1.10.0 — the line editor (RFC 854 EC / EL; BS and DEL from a client in
        # character mode — one in LINEMODE EDIT edits locally and never sends them).
        # Before 1.10.0 BS and DEL were only dropped (1.6.5), so a typo could not be
        # corrected at all; EC and EL were consumed and ignored.
        if (ev == EV_EC) {
            line_pos = line_erase(cfd, ts, line, line_pos, 0);
            if (line_pos < 0) { store64(quit, 1); i = n; continue; }
        }
        if (ev == EV_EL) {
            line_pos = line_erase(cfd, ts, line, line_pos, 1);
            if (line_pos < 0) { store64(quit, 1); i = n; continue; }
        }

        if (ev == EV_DATA) {
            var db = telnet_data_byte(ts) & 0xFF;
            var erase = 0;
            if (db == 8)   { erase = 1; }
            if (db == 127) { erase = 1; }
            if (erase == 1) {
                # A real keystroke: it refreshes the idle clock like any kept byte.
                store64(s + SESS_LAST_MS, clock_now_ms());
                g_chat_idle = 0;
                line_pos = line_erase(cfd, ts, line, line_pos, 0);
                if (line_pos < 0) { store64(quit, 1); i = n; continue; }
                i = i + 1;
                continue;
            }
            # M5-H input filter (widened at 1.6.4 / 1.6.5): drop C0 except
            # TAB/CR/LF, DEL and IAC silently before they reach the line
            # buffer or get echoed. See input_byte_ok for the reasoning.
            if (input_byte_ok(db) == 0) {
                i = i + 1;
                continue;
            }
            # 1.6.4 (audit M3) — THIS is what counts as activity: a byte that
            # survived the telnet layer AND the input filter. Protocol-only
            # traffic (IAC NOP, option negotiation, an unterminated
            # subnegotiation) cannot hold a slot. 1.8.1 (audit P9 / G11) — the
            # refresh used to sit ABOVE the filter, so a NUL every 50 s (dropped,
            # never echoed) pinned a slot exactly like the IAC NOP M3 closed; and
            # the chat reaper's counter was zeroed by the sweep on ANY recv. Both
            # now move only on a byte the session actually keeps.
            store64(s + SESS_LAST_MS, clock_now_ms());
            g_chat_idle = 0;
            # === EOL detection: CR is canonical; LF after CR is
            # silently absorbed (consumed-here, NOT passed on to
            # the printable-byte branch — would otherwise land at
            # line[0] and corrupt the next command); lone LF also
            # terminates (Unix clients). `eol == 1` means current
            # byte completed a line; `consumed == 1` means current
            # byte is the paired LF after CR — drop it entirely.
            var eol = 0;
            var consumed = 0;
            if (db == 13) { eol = 1; last_cr = 1; }
            else { if (db == 10) {
                    if (last_cr != 0) { last_cr = 0; consumed = 1; }
                    else              { eol = 1; }
                } else { last_cr = 0; } }

            if (consumed != 0) {
                i = i + 1;
                continue;
            }

            if (eol != 0) {
                send_str(cfd, "\r\n");
                # 1.6.2 — reclaim the per-command scratch arena. This is the one
                # point that dominates EVERY line dispatch below (command, door,
                # chat, login, posting) in BOTH serve models, since the fork
                # worker drives process_rx too. See cmd_alloc's header.
                cmd_scratch_reset();
                # 1.8.1 (H2) — a line that will run something counts against
                # the poll budget. Compose lines (subject / body) only append
                # to a buffer, so a pasted post is not throttled to one line
                # per sweep; the `.` that commits it follows a counted `post`.
                if (mode != MODE_POSTING) {
                    if (mode != MODE_POSTING_SUBJECT) { lines = lines + 1; }
                }
                # Mode-aware line dispatch.
                if (mode == MODE_COMMAND) {
                    mode = session_execute(cfd, line, line_pos, current_board, quit);
                    line_pos = 0;
                    # 1.11.0 (ADR 0031) — into the Descent: whatever else this
                    # recv holds was typed for the MUD (1.6.5, audit L4: a client
                    # that sends `descent\r\nnorth\r\n` in one segment meant
                    # `north` for the MUD). It stays in the receive buffer as the
                    # first bytes the pump forwards, and is not run here. The LF
                    # paired with this line's CR is the line ending, not input
                    # (1.8.1: the MUD used to get a stray empty command).
                    if (mode == MODE_DESCENT) {
                        var pend = i + 1;
                        if (db == 13) {
                            if (pend < n) { if ((load8(rxbuf + pend) & 0xFF) == 10) { pend = pend + 1; } }
                        }
                        if (pend < n) {
                            tobs_feed(load64(s + SESS_DESC_OBS), TOB_C2S, rxbuf + pend, n - pend);
                            park = pend;
                        }
                        last_cr = 0;
                        i = n;
                        continue;
                    }
                    if (mode == MODE_COMMAND) {
                        if (load64(quit) == 0) { send_prompt(cfd, current_board); }
                    }
                }
                else { if (mode == MODE_LOGIN_AWAIT_SIG) {
                        # M6-C: client sent `auth: <128-hex-sig>`.
                        # Parse + verify against the parked challenge.
                        # Working buffers come from cmd_alloc (the per-command
                        # arena, ADR 0021), which also avoids the cyrius
                        # `var buf[N]`-in-deep-nesting hazards flagged in
                        # CLAUDE.md.
                        #
                        # 0.7.0 audit M6 — explicit 30 s deadline. Even
                        # if the wire stayed warm (slowloris timeout
                        # never tripped), a parked challenge older than
                        # LOGIN_DEADLINE_MS is stale and must be rejected
                        # before any signature work happens.
                        if (g_login_started_ms > 0) {
                            if (clock_now_ms() - g_login_started_ms > LOGIN_DEADLINE_MS) {
                                send_str(cfd, "login failed (challenge timed out — retry 'login <handle>')\r\n");
                                store8(g_login_fp, 0);
                                store8(g_login_nonce, 0);
                                g_login_started_ms = 0;
                                line_pos = 0;
                                mode = MODE_COMMAND;
                                send_prompt(cfd, current_board);
                                i = i + 1; continue;
                            }
                        }
                        var sig_raw = cmd_alloc(ACCOUNT_SIG_BYTES);
                        var sig_len = parse_auth_sig(line, line_pos, sig_raw);
                        line_pos = 0;
                        if (sig_len != ACCOUNT_SIG_BYTES) {
                            send_str(cfd, "login failed (malformed auth)\r\n");
                            store8(g_login_fp, 0);
                            store8(g_login_nonce, 0);
                            mode = MODE_COMMAND;
                            send_prompt(cfd, current_board);
                            i = i + 1; continue;
                        }
                        var pk_buf = cmd_alloc(ACCOUNT_PK_BYTES);
                        if (account_lookup_pubkey(g_store_buf, g_login_fp, pk_buf) != 0) {
                            send_str(cfd, "login failed (pubkey lookup)\r\n");
                            store8(g_login_fp, 0);
                            store8(g_login_nonce, 0);
                            mode = MODE_COMMAND;
                            send_prompt(cfd, current_board);
                            i = i + 1; continue;
                        }
                        # Build challenge message = "agora-login:" + nonce_hex.
                        var verify_msg = cmd_alloc(LOGIN_MSG_LEN);
                        format_challenge_msg(g_login_nonce, verify_msg);
                        var ok = ed25519_verify(pk_buf, verify_msg, LOGIN_MSG_LEN, sig_raw);
                        # Single-use nonce: clear regardless of pass / fail.
                        store8(g_login_nonce, 0);
                        if (ok != 1) {
                            send_str(cfd, "login failed (signature)\r\n");
                            store8(g_login_fp, 0);
                            mode = MODE_COMMAND;
                            send_prompt(cfd, current_board);
                            i = i + 1; continue;
                        }
                        # Bind session. Copy g_login_fp → g_session_fp
                        # then resolve the handle from the bound fp.
                        memcpy(g_session_fp, g_login_fp, ACCOUNT_FP_BUF_BYTES);
                        store8(g_login_fp, 0);
                        var hlen = account_lookup_handle(g_store_buf, g_session_fp,
                          g_session_handle, ACCOUNT_HANDLE_BUF);
                        if (hlen <= 0) { store8(g_session_handle, 0); }
                        send_str(cfd, "welcome, ");
                        if (hlen > 0) { send_buf(cfd, g_session_handle, hlen); }
                        else          { send_str(cfd, "(no handle)"); }
                        send_str(cfd, "\r\n");
                        mode = MODE_COMMAND;
                        send_prompt(cfd, current_board);
                        i = i + 1; continue;
                    }
                    else { if (mode == MODE_DOOR) {
                            # 1.1.0: route the completed line to the active
                            # game. ctrl==1 means the game exited → save +
                            # back to the BBS prompt; else paint the next frame.
                            var dctrl = door_feed_line(cfd, line, line_pos);
                            line_pos = 0;
                            if (dctrl == 1) {
                                door_save_on_exit(cfd);
                                # 1.6.3 — save FIRST (it reads the state), then release.
                                door_state_free();
                                mode = MODE_COMMAND;
                                send_prompt(cfd, current_board);
                            } else {
                                door_send_frame(cfd);
                            }
                            i = i + 1; continue;
                        }
                        else { if (mode == MODE_CHAT) {
                                # 1.3.0 (ADR 0011): a completed line in chat is
                                # either a '/'-command or a message said to the room.
                                var clen = line_pos;
                                line_pos = 0;
                                var handled = 0;
                                if (clen > 0) {
                                    if ((load8(line) & 0xFF) == 47) {     # leading '/'
                                        handled = 1;
                                        var cc = chat_cmd_dispatch(cfd, line, clen);
                                        if (cc == 1) {
                                            # /leave — restore the command-mode recv
                                            # timeout, drop the channel, back to BBS.
                                            sock_set_recv_timeout(cfd, RECV_TIMEOUT_SECS, 0);
                                            store8(g_chat_channel, 0);
                                            g_chat_seen = 0;
                                            g_chat_bot = 0;
                                            mode = MODE_COMMAND;
                                            send_prompt(cfd, current_board);
                                        }
                                        if (cc == 2) { store64(quit, 1); }
                                    }
                                }
                                if (handled == 0) {
                                    if (g_chat_bot != 0) {
                                        # On the couch: this line goes only to the
                                        # active bot, never to the room. 'bye'
                                        # returns the user to the channel.
                                        if (clen > 0) {
                                            var bs = chat_bot_state();
                                            var bctrl = chat_bot_feed(line, clen);
                                            var bname = chat_bot_name();
                                            var bnl = strlen(bname);
                                            send_str(cfd, bname);
                                            # 1.10.1 — the reply wrapped under itself, after "NAME: ".
                                            # 1.11.1 — read through the bot's DD_REPLY.
                                            var brl[8];
                                            var bresp = chat_bot_reply(&brl);
                                            send_wrapped(cfd, bresp, load64(&brl), bnl, bnl, TW_RAW);
                                            send_str(cfd, "\r\n");
                                            if (bctrl == 1) {
                                                g_chat_bot = 0;
                                                send_str(cfd, "(back in #");
                                                send_str(cfd, g_chat_channel);
                                                send_str(cfd, ")\r\n");
                                            }
                                        }
                                    } else {
                                        # Ordinary line → sanitise + say to the room,
                                        # then flush so the speaker sees the canonical
                                        # "<handle> text" line (and any interleaved ones).
                                        if (clen > 0) {
                                            var tbuf = cmd_alloc(CHAT_MSG_MAX + 1);
                                            var tlen = chat_text_sanitize(line, clen, tbuf, CHAT_MSG_MAX);
                                            if (tlen > 0) {
                                                chat_say(g_store_buf, g_chat_channel, g_session_handle, tbuf, tlen);
                                            }
                                        }
                                        chat_flush_tail(cfd);
                                    }
                                }
                                i = i + 1; continue;
                            }
                            else { if (mode == MODE_POSTING_SUBJECT) {
                                    # M5-D: capture the typed Subject line, then
                                    # transition into MODE_POSTING for the body.
                                    # 1.6.5 (audit L2) — the wire Subject gets the same filter
                                    # the CLI has always applied (`header_text_buf_ok`).
                                    #
                                    # Belt AND braces, deliberately: the real work is done one
                                    # layer up by `input_byte_ok`, which now drops C0 and DEL
                                    # before a byte ever reaches this line buffer — verified, a
                                    # `sub<BEL>ject` arrives here already as `subject`, so this
                                    # branch does not fire today. It stays because it states the
                                    # header contract at the point the header is captured: if
                                    # the ingress filter is ever loosened (an opt-in raw-post
                                    # mode is a live idea in `input_byte_ok`'s own comment), the
                                    # Subject must not loosen with it. Refuses and stays in
                                    # MODE_POSTING_SUBJECT so the user can simply retype.
                                    if (header_text_buf_ok(line, line_pos) == 0) {
                                        send_str(cfd, "subject contains control bytes — retype it\r\n");
                                        line_pos = 0;
                                        i = i + 1; continue;
                                    }
                                    subject_len = line_pos;
                                    if (subject_len > SUBJECT_MAX_BYTES) {
                                        subject_len = SUBJECT_MAX_BYTES;
                                    }
                                    if (subject_len > 0) {
                                        memcpy(subject, line, subject_len);
                                    }
                                    store8(subject + subject_len, 0);
                                    line_pos = 0;
                                    send_str(cfd, "Compose post. End with '.' on a line by itself.\r\n");
                                    mode = MODE_POSTING;
                                }
                                else {
                                    # MODE_POSTING: '.' alone ends + commits.
                                    if (line_pos == 1) {
                                        if ((load8(line) & 0xFF) == 46) {
                                            session_finalize_post(cfd, current_board, subject, post, post_pos);
                                            post_pos = 0;
                                            store64(s + SESS_POST_FULL, 0);
                                            subject_len = 0;
                                            store8(subject, 0);
                                            line_pos = 0;
                                            mode = MODE_COMMAND;
                                            send_prompt(cfd, current_board);
                                            i = i + 1; continue;
                                        }
                                    }
                                    # Otherwise append line + CRLF to post body.
                                    # 1.8.1 (audit S12) — the first line that
                                    # does not fit CLOSES the body: it and every
                                    # later line are dropped, and the user is told
                                    # once. It used to drop only lines that did
                                    # not fit and keep appending shorter ones, so
                                    # a long paste lost a run of lines from the
                                    # middle and still answered "posted as #N".
                                    var pfull = load64(s + SESS_POST_FULL);
                                    if (pfull == 0) {
                                        if (post_pos + line_pos + 2 < POST_MAX_BYTES) {
                                            memcpy(post + post_pos, line, line_pos);
                                            post_pos = post_pos + line_pos;
                                            store8(post + post_pos, 13); post_pos = post_pos + 1;
                                            store8(post + post_pos, 10); post_pos = post_pos + 1;
                                        } else {
                                            store64(s + SESS_POST_FULL, 1);
                                            send_str(cfd, "(the post is full at 64 KB — later lines are not kept;");
                                            send_str(cfd, " '.' alone posts what fit)\r\n");
                                        }
                                    }
                                    line_pos = 0;
                                } } } } }
            } else {
                # === Printable byte: echo + append to line ===
                if (line_pos < LINE_BUF_CAP - 1) {
                    store8(line + line_pos, db);
                    line_pos = line_pos + 1;
                    # 1.6.3 (audit) — same as the IAC drain above: the echo is
                    # the other per-byte write, so a discarded failure here has
                    # the same unbounded shape.
                    #
                    # 1.6.5 (audit L3) — and only echo if the client has not
                    # REVOKED it. agora announces WILL ECHO at connect; a client
                    # that answers `IAC DONT ECHO` gets a correct `WONT ECHO`
                    # back and then, until now, kept being echoed at anyway —
                    # double characters for anyone doing their own local echo.
                    # The test is `!= Q_NO`, deliberately NOT `== Q_YES`: a peer
                    # that never answers our WILL sits in Q_WANTYES forever, and
                    # gating on Q_YES would kill echo for netcat, raw sockets and
                    # every scripted client — including agora's own smokes.
                    if (opt_us(ts, OPT_ECHO) != Q_NO) {
                        if (echo_byte(cfd, db) != 0) { store64(quit, 1); i = n; continue; }
                    }
                }
            }
        }
        i = i + 1;
    }
    store64(s + SESS_LINE_POS, line_pos);
    store64(s + SESS_POST_POS, post_pos);
    store64(s + SESS_SUBJECT_LEN, subject_len);
    store64(s + SESS_MODE, mode);
    store64(s + SESS_LAST_CR, last_cr);
    if (park >= 0) {
        store64(s + SESS_RX_OFF, park);
        store64(s + SESS_RX_LEN, n);
    } else {
        store64(s + SESS_RX_OFF, 0);
        store64(s + SESS_RX_LEN, 0);
    }
    if (load64(quit) != 0) { return 1; }
    return 0;
}

# Fork serve path: serve ONE connection to completion in THIS process — a fork
# child (Linux; agnos always polls). Uses a standalone session slot; the deep
# session globals ARE this connection (sess_load restores them from the slot each
# iteration, sess_save persists them, so process_rx / session_greet see exactly
# the globals the dispatch functions expect).
fn handle_client(cfd): i64 {
    # Slowloris defense: bound how long a quiet client can pin this worker. recv()
    # returns EWOULDBLOCK after the timeout (a clean disconnect, except the chat
    # live-tail tick); send() likewise can't park on a peer that stops draining.
    sock_set_recv_timeout(cfd, RECV_TIMEOUT_SECS, 0);
    sock_set_send_timeout(cfd, SEND_TIMEOUT_SECS, 0);
    # 1.8.2 — TCP_NODELAY, found by benches/serve-bench.py: a fork worker writes a
    # response as several small sends, and Nagle held each one after the first
    # until the client's (delayed, ~40 ms) ACK — every multi-part reply in the
    # default serve model cost ~41 ms, against ~2.6 ms of real work. A no-op
    # decline on agnos, which has no TCP options (and always polls anyway).
    sock_set_nodelay(cfd, 1);
    if (g_door_registry == 0) { door_registry_init(); }

    var s = session_alloc();
    session_reset(s, cfd);
    sess_load(s);
    session_greet(s);
    sess_save(s);

    var done = 0;
    while (done == 0) {
        sess_load(s);
        # 1.11.0 (ADR 0031) — a visit to the Descent: wait on both sockets, pump.
        if (load64(s + SESS_MODE) == MODE_DESCENT) {
            done = descent_fork_step(s);
            sess_save(s);
            continue;
        }
        # 1.11.0 — wait on the socket and the child's signalfd (fork_child_wait).
        var w = fork_child_wait(s);
        if (w == 2) {
            fork_child_goodbye(s);
            done = 1;
            sess_save(s);
            continue;
        }
        var n = 0 - EWOULDBLOCK_ERR;
        if (w == 1) { n = sys_read(cfd, load64(s + SESS_RXBUF), RECV_BUF_BYTES); }
        if (n <= 0) {
            done = session_rx_idle(s, n);
        } else {
            done = process_rx(s, 0, n, 0);
            # 1.8.1 (audit P4) — the 1.6.4 M3 rule, fork side: protocol chatter
            # is not activity. SO_RCVTIMEO restarts on ANY received byte, so an
            # IAC NOP every 20 s held a fork child forever while a silent one was
            # reaped at 60 s. SESS_LAST_MS moves only on a byte the session keeps
            # (process_rx), so judge idleness by it. Chat has its own reaper.
            if (done == 0) {
                if (load64(s + SESS_MODE) != MODE_CHAT) {
                    if (clock_now_ms() - load64(s + SESS_LAST_MS) >= SESS_IDLE_MS) { done = 1; }
                }
            }
        }
        sess_save(s);
    }
    session_door_checkpoint(s);    # 1.8.1 (D1) — the fork child's EOF / reap path
    sock_close(cfd);
    return 0;
}

# 1.11.0 — the fork parent's live children (MAX_SESS pids, 0 = free), so a clean
# shutdown can signal them. The table is as large as the connection cap, which is
# checked before every fork, so an add always finds room.
var g_fork_pids = 0;

# Remember child `pid`.
fn fork_pid_add(pid): i64 {
    if (g_fork_pids == 0) {
        g_fork_pids = alloc(MAX_SESS * 8);
        memset(g_fork_pids, 0, MAX_SESS * 8);
    }
    var i = 0;
    var placed = 0;
    while (i < MAX_SESS) {
        if (placed == 0) { if (load64(g_fork_pids + i * 8) == 0) { store64(g_fork_pids + i * 8, pid); placed = 1; } }
        i = i + 1;
    }
    return placed;
}

# Forget child `pid` (it was reaped).
fn fork_pid_drop(pid): i64 {
    if (g_fork_pids == 0) { return 0; }
    var i = 0;
    while (i < MAX_SESS) {
        if (load64(g_fork_pids + i * 8) == pid) { store64(g_fork_pids + i * 8, 0); }
        i = i + 1;
    }
    return 0;
}

# Send `sig` to every live child.
fn fork_pids_signal(sig): i64 {
    if (g_fork_pids == 0) { return 0; }
    var i = 0;
    while (i < MAX_SESS) {
        var p = load64(g_fork_pids + i * 8);
        if (p > 0) { sys_kill(p, sig); }
        i = i + 1;
    }
    return 0;
}

# Spin up the listener and run the accept loop. Returns 0 when the loop exits
# cleanly, 1 on bind/listen failure.
#
# 1.7.0 (roadmap N1, now CLOSED) — "exits cleanly" became reachable. Until then
# neither loop could end: both declared `var stop = 0;` and nothing anywhere
# assigned it, so the only way to stop agora was to kill it. Both models now
# route SIGINT/SIGTERM to a signalfd — poll reads it once per sweep and drains
# its 64 slots; the fork parent waits on poll(2) over {listener, signalfd},
# closes the listener and reaps children within a bounded grace window.
fn cmd_serve_on(port): i64 {
    # 1.11.0 — an unknown AGORA_SERVE is refused before anything is bound.
    g_serve_mode = serve_mode_from_env();
    if (g_serve_mode < 0) {
        var bad1 = "agora serve: AGORA_SERVE must be 'fork' or 'poll'";
        var bad2 = " (there is no separate epoll model: poll waits on readiness)\n";
        syscall(1, 2, bad1, strlen(bad1));
        syscall(1, 2, bad2, strlen(bad2));
        return 2;
    }
    println("agora serve: opening telnet listener");

    # 1.6.2 — ignore SIGPIPE before a single byte can be written.
    #
    # Every byte agora sends leaves through a flagsless `sys_write` (send_buf's
    # fork branch, session_drain's poll branch, and the Descent
    # proxy). A peer that closes mid-write makes the kernel raise SIGPIPE, whose
    # DEFAULT disposition terminates the process — no error return, no cleanup.
    # Under fork that cost one child; under the 1.6.0 poll multiplex it costs the
    # whole 64-session server, and poll is the ONLY model on agnos (no fork). That
    # is an unauthenticated remote kill from a client that just disconnects rudely.
    #
    # SIG_IGN converts it into an EPIPE (-32) return, which BOTH write paths
    # already treat correctly as "close this connection": send_buf returns 1 on
    # any `n <= 0` (the 1.4.4 T1 fix) and session_drain returns the negative errno,
    # which its callers test with `< 0`. EWOULDBLOCK keeps its own arm, so
    # a slow reader still just retries next sweep.
    #
    # Placed here — before the model dispatch — so it dominates every serve path:
    # poll, the fork parent (and its children, which inherit the disposition
    # across fork); agnos always polls. ADR 0007 rejected `sigaction`
    # because of the rt_sigaction `sa_restorer` trampoline; cyrius 6.4.51's
    # `signal_ignore` builds the 32-byte SIG_IGN act itself and needs no
    # trampoline, so that objection no longer applies. It is a no-op on agnos
    # and on Windows, so the call is portable.
    #
    # ⚠ 1.7.0 corrects the reason that used to be given here. This said agnos is
    # a no-op because "ring-3 has no signal delivery". That is not why, and it is
    # not true: agnos has `sigprocmask` (#17) and `signalfd` (#18), and N1's
    # clean shutdown uses both on that target. What agnos lacks is
    # `rt_sigaction` — the mechanism `signal_ignore` is built on — so SIG_IGN
    # specifically cannot be installed there. It needs no equivalent either:
    # agnos has no default disposition that terminates the guest (mirshi's
    # `_do_kill` only ORs a pending bit), so there is no SIGPIPE kill to defend
    # against. "No signal delivery" would have argued N1's agnos arm was
    # impossible; it is not.
    # The return is deliberately unchecked: a failure leaves the default
    # disposition, i.e. exactly today's behavior, and there is nothing better to
    # do about it than serve anyway.
    signal_ignore(SIGPIPE);

    # 1.7.0 (N1) — arm clean shutdown HERE, for the same reason SIGPIPE is armed
    # here: before the listener exists, so it dominates every serve path.
    #
    # ⚠ THIS PLACEMENT IS LOAD-BEARING, and getting it wrong produced an
    # intermittent failure rather than an obvious one. Arming inside `serve_poll`
    # (the first shape of this patch) left a real window: `cmd_serve_on` binds
    # and listens FIRST, so the port is already accepting while `serve_poll` is
    # still running `session_pool_init` + `door_registry_init`. A SIGTERM landing
    # in that window met the DEFAULT disposition and killed the process — smoke
    # 28 caught it as `poll/SIGTERM: exit -15` on roughly one run in three, while
    # passing standalone every time. Signals must be armed before the process can
    # be reached by anything that might signal it.
    g_shutdown_sigfd   = shutdown_signals_arm();
    g_shutdown_siginfo = alloc(SIGINFO_BYTES);

    # 1.9.0 — the handle index (account.cyr), and since 1.9.1 the reply index
    # (board.cyr, ADR 0027): each built once for a store that predates it, before
    # any `login` or `read` can need it. A failure only means logins scan `.users/`
    # and reads scan the board, as before. On Linux they run in a short-lived child:
    # the build is the parent's first use of the per-command arena and the
    # directory workspace, and every fork-mode connection would inherit both —
    # built in the parent, a connection child measured 64-68 KB PSS against
    # 54-66 KB built here (benches/serve-bench.py memory, interleaved, one disk).
    # A SIGTERM meanwhile stays pending on the signalfd and is honoured once the
    # loop starts. agnos always polls (one process), so it builds in place.
    #ifdef CYRIUS_TARGET_AGNOS
    account_index_prepare(g_store_buf);
    reply_index_prepare(g_store_buf);
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var ipid = sys_fork();
    if (ipid == 0) {
        shutdown_signals_child_reset(g_shutdown_sigfd);
        account_index_prepare(g_store_buf);
        reply_index_prepare(g_store_buf);
        sys_exit(0);
    }
    if (ipid > 0) { sys_waitpid(ipid, 0, 0); }
    else {
        account_index_prepare(g_store_buf);
        reply_index_prepare(g_store_buf);
    }
    #endif

    # 1.7.1 — cyrius 6.6.x value form: every Result producer below returns a
    # (tag, payload) register pair. A single-variable bind keeps the tag and
    # drops the payload, so each site binds both halves and passes both to
    # result_unwrap. The payload on the failing arms is the errno, now printed.
    var st, sv = tcp_socket();
    if (is_ok(st) == 0) {
        println("agora serve: tcp_socket() failed");
        print_num(sv);
        println("");
        return 1;
    }
    var sfd = result_unwrap(st, sv);

    sock_reuse(sfd);

    var bt, bv = sock_bind(sfd, INADDR_ANY(), port);
    if (is_ok(bt) == 0) {
        println("agora serve: sock_bind() failed");
        print_num(bv);
        println("");
        sock_close(sfd);
        return 1;
    }

    var lt, lv = sock_listen(sfd, LISTEN_BACKLOG);
    if (is_ok(lt) == 0) {
        println("agora serve: sock_listen() failed");
        print_num(lv);
        println("");
        sock_close(sfd);
        return 1;
    }

    println("agora serve: listening (port printed below)");
    print_num(port);
    println("");
    println("agora serve: waiting for connections (Ctrl+C to exit)");

    # 1.6.0: pick the serve model. agnos always polls (no fork); Linux honors
    # AGORA_SERVE ({fork,poll}), default fork (classic per-connection isolation).
    if (g_serve_mode == SERVE_POLL) {
        println("agora serve: model = poll (single-process multiplex)");
        return serve_poll(sfd);
    }
    println("agora serve: model = fork (classic per-connection)");

    # N1: arm clean shutdown for the fork parent too.
    #
    # The poll model can test the signalfd once per sweep because its loop never
    # blocks. This loop DOES block — in `sock_accept` — so a signalfd alone would
    # not be noticed until the next client connected, which on an idle server is
    # never. The parent therefore waits on BOTH fds with poll(2) and only calls
    # accept once the listener is actually readable.
    #
    # poll(2) is a raw `syscall(7)` because the stdlib exposes no wrapper (only
    # epoll) — the same call, with the same 8-byte pollfd layout, that
    # serve_poll_wait, the Descent's connect check and `lib/net.cyr`'s
    # `net_connect_sa_nb` make. It is
    # safe unguarded *here* only because this whole loop is fork-mode, which is
    # Linux-only: `serve_mode_from_env` returns SERVE_POLL on every agnos path.
    # The guard is kept anyway — 1.6.2 had to fix exactly this call being
    # unguarded in descent, where 7 is `SYS_OPEN` on agnos.
    #
    # If arming failed, `sigfd` is negative and we keep the original blocking
    # accept: no poll, no non-blocking listener, i.e. precisely the pre-1.7.0
    # loop. Degrading to the old behaviour beats refusing to serve. Arming
    # itself happened in cmd_serve_on, before the socket was created.
    var sigfd = g_shutdown_sigfd;
    var siginfo = g_shutdown_siginfo;
    var pfds = alloc(16);
    #ifndef CYRIUS_TARGET_AGNOS
    if (sigfd >= 0) { sock_set_nonblocking(sfd); }
    #endif

    # 1.8.1 (audit P4) — live connection children, so fork mode has the same
    # operator bound as poll (MAX_SESS). It had none: 200 idle connections made
    # 200 processes, and an anonymous client could keep adding them until
    # RLIMIT_NPROC — also starving every other process of the same user.
    var nchild = 0;
    var ppid = sys_getpid();     # 1.11.0 — what each child checks its parent against
    var stop = 0;
    while (stop == 0) {
        #ifndef CYRIUS_TARGET_AGNOS
        # ADR 0007: drain any zombies that accumulated since the last
        # accept. Non-blocking — exits the loop immediately when no
        # zombies are ready. Without this the process table fills as
        # children exit and the kernel keeps their exit-status entries
        # around indefinitely. (Fork model only — Linux. agnos always polls, so
        # this loop never runs there, and agnos has no WNOHANG.)
        var reap = 1;
        while (reap == 1) {
            var rpid = sys_waitpid(0 - 1, 0, WNOHANG);
            if (rpid <= 0) { reap = 0; }
            else {
                if (nchild > 0) { nchild = nchild - 1; }
                fork_pid_drop(rpid);
            }
        }
        #endif

        # Wait for either a connection or a shutdown signal. On timeout, loop
        # back so the zombie reap above runs on a regular cadence.
        #ifndef CYRIUS_TARGET_AGNOS
        if (sigfd >= 0) {
            store32(pfds + 0, sfd);   store16(pfds + 4,  SHUTDOWN_POLLIN); store16(pfds + 6,  0);
            store32(pfds + 8, sigfd); store16(pfds + 12, SHUTDOWN_POLLIN); store16(pfds + 14, 0);
            var pr = syscall(7, pfds, 2, FORK_POLL_MS);
            if (pr <= 0) { continue; }
            if ((load16(pfds + 14) & 0xFFFF) != 0) {
                if (shutdown_signal_pending(sigfd, siginfo) == 1) { stop = 1; continue; }
            }
            if ((load16(pfds + 6) & 0xFFFF) == 0) { continue; }
        }
        #endif

        var at, av = sock_accept(sfd);
        if (is_ok(at) == 0) {
            # Transient accept errors should not kill the loop. Since 1.7.0 this
            # arm also absorbs the EAGAIN that a non-blocking listener returns
            # when poll(2) reported it readable but another path consumed the
            # connection first — harmless, and the poll timeout paces the retry.
            continue;
        }
        var cfd = result_unwrap(at, av);

        # 1.6.6 — the agnos serial-accept arm that stood here is DELETED. It was
        # unreachable: `serve_mode_from_env` returns SERVE_POLL on every
        # agnos path — the default, an explicit "poll", AND an explicit "fork" —
        # so `cmd_serve_on` dispatches to serve_poll and returns long before this
        # loop. It had been dead since 1.6.0, and its comment still announced the
        # poll multiplex as pending work that the very same cut had shipped. The
        # agnos serial model is recorded where it belongs, in docs/adr/0023.
        #ifndef CYRIUS_TARGET_AGNOS
        if (nchild >= MAX_SESS) {
            sys_write(cfd, "server full — try again shortly\r\n", 35);
            sock_close(cfd);
            continue;
        }
        # ADR 0007: fork-per-accept. Each connection becomes its own
        # process; the kernel handles per-conn memory cleanup at child
        # exit (closes audit M1) and globals are per-process (closes
        # audit M2). Parent immediately closes the accepted cfd —
        # the child has its own fd via fork — and loops back to
        # accept the next connection.
        var pid = sys_fork();
        if (pid == 0) {
            # Child: drop the listening fd we inherited (a child crash
            # shouldn't leak the listener), serve the client, exit.
            #
            # 1.7.0 (N1) — fork(2) inherits the parent's blocked mask, so a child
            # that read no signalfd would run with SIGINT+SIGTERM blocked: an
            # operator's `kill` on a wedged session would do nothing. 1.7.0
            # unblocked them; 1.11.0 (ADR 0031) gives the child a signalfd of
            # its own instead (it leaves cleanly on SIGTERM) and PR_SET_PDEATHSIG
            # (it leaves when the parent dies) — fork_child_arm.
            g_child_sigfd = fork_child_arm(sigfd, ppid);
            sock_close(sfd);
            handle_client(cfd);
            sys_exit(0);
        }
        if (pid < 0) {
            # Fork failed (likely RLIMIT_NPROC). Close the cfd so
            # the client gets EOF, log to stderr, keep serving.
            sock_close(cfd);
            syscall(1, 2, "agora serve: fork failed (resource exhaustion?); connection dropped\n", 68);
            continue;
        }
        # Parent: child owns cfd now via fork; we drop our copy.
        nchild = nchild + 1;
        fork_pid_add(pid);
        sock_close(cfd);
        #endif
    }

    # N1 shutdown, fork parent. Close the listener FIRST so no further client can
    # connect, then give the children already serving a bounded window to finish
    # and be reaped. Bounded, not unbounded: a player parked in a door game would
    # otherwise hold the operator's shutdown open indefinitely.
    #
    # 1.11.0 (ADR 0031) — and the children are TOLD: each gets SIGTERM, which its
    # own signalfd turns into a goodbye, a door checkpoint and a clean close, the
    # way a poll session ends at shutdown. Until 1.11.0 they were not signalled,
    # finished on their own, and any still alive at the deadline were left running
    # as orphans. A child that cannot leave in time (a write parked on a stalled
    # client) still gets its PR_SET_PDEATHSIG SIGTERM when this process exits.
    println("agora serve: shutdown signal — closing listener");
    sock_close(sfd);
    if (sigfd >= 0) { file_close(sigfd); }
    fork_pids_signal(SIGTERM);
    #ifndef CYRIUS_TARGET_AGNOS
    var waited = 0;
    var live = 0;
    var draining = 1;
    while (draining == 1) {
        live = 0;
        var rp = 1;
        while (rp == 1) {
            var rpid2 = sys_waitpid(0 - 1, 0, WNOHANG);
            if (rpid2 > 0) { rp = 1; }
            else {
                # 0 = children exist but none has exited yet; <0 = none left.
                if (rpid2 == 0) { live = 1; }
                rp = 0;
            }
        }
        if (live == 0) { draining = 0; continue; }
        if (waited >= FORK_GRACE_MS) { draining = 0; continue; }
        sleep_ms(FORK_POLL_MS);
        waited = waited + FORK_POLL_MS;
    }
    if (live == 1) {
        println("agora serve: some sessions still active at the grace deadline; exiting anyway");
    }
    #endif
    println("agora serve: stopped");
    return 0;
}

# Load an operator-supplied MOTD file into the g_motd_* globals.
# Returns 0 on success, non-zero on any I/O error (with a stderr
# warning + fallback to the default render_motd path). The
# allocation lives for the process lifetime — set-once-at-startup;
# no per-connection re-read.
fn load_motd_file(path): i64 {
    var buf = alloc(MOTD_FILE_CAP);
    var n = file_read_all(path, buf, MOTD_FILE_CAP);
    if (n < 0) {
        println("agora serve: --motd path could not be read; using default MOTD");
        return 1;
    }
    if (n == 0) {
        println("agora serve: --motd file is empty; using default MOTD");
        return 1;
    }
    g_motd_buf = buf;
    g_motd_len = n;
    return 0;
}

# `agora serve [port] [--store DIR] [--motd FILE]`: parse the serve flags, then cmd_serve_on.
fn cmd_serve(): i64 {
    args_init();
    var n = argc();
    var port = DEFAULT_PORT;

    # Argv scan. Order-insensitive: a positive-integer positional
    # is taken as the port; --motd consumes the next arg as an MOTD
    # path; --store consumes the next arg as the post-storage root
    # used by the in-session command interpreter (M5-B).
    # 1.8.1 (audit S13) — a missing flag value returns 2 directly. It used to
    # set a `go = 0` flag and `continue`, but the loop's first statement was
    # `if (go == 0) { continue; }`, which never advanced `i`: `agora serve
    # --store` with no path spun at 100% CPU forever (the 2026-06-15 T1 shape).
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--motd") != 0) {
            if (i + 1 >= n) {
                println("agora serve: --motd requires a path argument");
                return 2;
            }
            load_motd_file(argv(i + 1));
            i = i + 2;
            continue;
        }
        if (streq(arg, "--store") != 0) {
            if (i + 1 >= n) {
                println("agora serve: --store requires a path argument");
                return 2;
            }
            # 1.6.5 (audit L1) — bound the store path ONCE, here, rather than
            # at each of the ~30 path builders. `board_path` memcpy's this
            # straight into a PATH_MAX_BYTES (512) buffer with no check, and
            # every storage path is built on top of it, so an over-long
            # `--store` overflowed. Operator error rather than an attack — but
            # since 1.6.2 the overflow lands inside the shared command arena
            # instead of an isolated bump allocation, so it can now corrupt
            # another buffer in the same command. The headroom covers the
            # longest suffix any builder appends: "/<board>" (33) + "/<id>.txt"
            # (~16), or "/.users/<fp16>/games/<name>.sav" (~45).
            var store_arg = argv(i + 1);
            if (strlen(store_arg) > STORE_PATH_MAX) {
                println("agora: --store path too long (max 448 bytes)");
                return 2;
            }
            g_store_buf = store_arg;
            i = i + 2;
            continue;
        }
        var p = atoi(arg);
        if (p > 0) { port = p; }
        i = i + 1;
    }

    return cmd_serve_on(port);
}

# Default post-storage root, used by cmd_post / cmd_list / cmd_read
# when --store is not passed. Cwd-relative per ADR 0002.
var DEFAULT_STORE = "./agora-data";
var DEFAULT_BOARD = "main";

# Walk argv looking for --store <path>. Returns the path cstring if
# found, else the supplied default.
fn parse_store(default_store): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--store") != 0) {
            if (i + 1 < n) {
                # 1.6.5 (audit L1) — same bound as the serve path. This helper
                # is the single --store parse for EVERY CLI verb (post / list /
                # read / keygen / register / whoami / worldread), so one check
                # here covers all of them; `cmd_serve` has its own because it
                # assigns g_store_buf directly. Over-long refuses rather than
                # truncating: a silently shortened store root would point at a
                # DIFFERENT directory, which is worse than an error.
                var sp = argv(i + 1);
                if (strlen(sp) > STORE_PATH_MAX) {
                    println("agora: --store path too long (max 448 bytes)");
                    sys_exit(2);
                }
                return sp;
            }
            return default_store;
        }
        i = i + 1;
    }
    return default_store;
}

# Walk argv looking for --board <name>. Returns the name cstring if
# found, else "main". M5-E: every CLI verb routes through this.
fn parse_board(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--board") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return DEFAULT_BOARD;
        }
        i = i + 1;
    }
    return DEFAULT_BOARD;
}

# Walk argv looking for the first non-flag positional after the verb.
# Skips any `--<flag> <value>` pair (so all our two-arg flags —
# `--store`, `--board`, `--subject`, `--motd`, `--reply-to`,
# `--key`, `--handle`, `--as` — don't shadow the positional).
# Returns 0 if no positional found.
fn first_positional_after_verb(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        # Two-char flag prefix '--'? skip arg + value.
        if (strlen(arg) >= 2) {
            if ((load8(arg) & 0xFF) == 45) {        # '-'
                if ((load8(arg + 1) & 0xFF) == 45) { # '--'
                    i = i + 2;
                    continue;
                }
            }
        }
        return arg;
    }
    return 0;
}

# k-th non-flag positional after the verb (0-based), skipping
# `--flag value` pairs. Returns 0 if absent. Used by the worldbench /
# worldread diagnostic verbs that take two positionals (game + count).
fn nth_positional(k): i64 {
    args_init();
    var n = argc();
    var i = 2;
    var seen = 0;
    var result = 0;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= n) { scanning = 0; continue; }
        var arg = argv(i);
        var is_flag = 0;
        if (strlen(arg) >= 2) {
            if ((load8(arg) & 0xFF) == 45) {
                if ((load8(arg + 1) & 0xFF) == 45) { is_flag = 1; }
            }
        }
        if (is_flag == 1) { i = i + 2; continue; }
        if (seen == k) { result = arg; scanning = 0; continue; }
        seen = seen + 1;
        i = i + 1;
    }
    return result;
}

# === 1.2.0 world-framework diagnostics (ADR 0010 § Phasing bite 1) ===
#
# `agora worldbench <game> <count> [--store X]` runs `count` flock'd
# world transactions (+1 each). `agora worldread <game> [--store X]`
# prints the world counter. Run many `worldbench` processes against one
# store concurrently, then `worldread` — a correct framework yields
# exactly (procs × count) with no lost updates (see 08-world-concurrency.sh).
fn cmd_worldbench(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var game = nth_positional(0);
    if (game == 0) { println("usage: agora worldbench <game> <count> [--store X]"); return 1; }
    var count_s = nth_positional(1);
    var count = 0;
    if (count_s != 0) { count = atoi(count_s); }
    var i = 0;
    while (i < count) {
        world_txn_add(store, game, 1);
        i = i + 1;
    }
    println("worldbench done");
    return 0;
}

# `agora worldread <game> [--store DIR]`: print the world-bench counter (the 08 smoke and serve-bench verify with it).
fn cmd_worldread(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var game = nth_positional(0);
    if (game == 0) { println("usage: agora worldread <game> [--store X]"); return 1; }
    var buf = alloc(8);
    var n = world_read(store, game, buf, 8);
    var v = 0;
    if (n == 8) { v = load64(buf); }
    fmt_int(v);
    println("");
    return 0;
}

# The `--subject <text>` CLI argument, or 0 if absent.
fn parse_subject_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--subject") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# M5-F: walk argv looking for --reply-to <id>. Returns the parsed
# parent ID (positive integer), or 0 if absent / unparseable.
fn parse_reply_to_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--reply-to") != 0) {
            if (i + 1 < n) {
                var v = atoi(argv(i + 1));
                if (v > 0) { return v; }
                return 0;
            }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# M6-E: --as <handle> for CLI-side authored posts. When given, the
# CLI loads the keyfile (default ~/.agora/key, override --key),
# derives the fingerprint, and validates that the handle is registered
# to that fingerprint in the store. Without --as the post would be
# anonymous, which board_can_post refuses under every policy (ADR 0006).
fn parse_as_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--as") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# `agora post [--subject "..."] [--as <handle>] [--key <path>]` —
# read stdin → write a new post → print assigned ID. Up to
# POST_MAX_BYTES (64 KB) of body. With --as, the post lands with a
# `From: <handle> <fp16>` header; without, it's anonymous.
fn cmd_post(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var board = parse_board();
    var subject = parse_subject_flag();
    # 0.7.0 audit H1 — reject CR/LF/NUL/ESC/other C0 in --subject.
    # The CLI is operator-trusted, but stored posts persist with
    # forged headers if injection is allowed (post_reply_to / post_from
    # would parse the injected lines as real headers on every later
    # read). Cheap to validate at entry; expensive to clean up at the
    # store layer after the fact.
    if (subject != 0) {
        if (header_text_cstr_ok(subject) == 0) {
            var sbm = "agora post: --subject contains control bytes (CR/LF/NUL/ESC or other C0";
            print(sbm, strlen(sbm));
            println(" — not allowed in header values)");
            return 2;
        }
    }
    var reply_to = parse_reply_to_flag();
    # M6-E: resolve identity. --as alone is insufficient — we need
    # the matching key to prove ownership of the handle.
    var as_handle = parse_as_flag();
    var from_handle = 0;
    var from_fp     = 0;
    if (as_handle != 0) {
        if (handle_valid(as_handle) == 0) {
            println("agora post: invalid --as handle");
            return 2;
        }
        var key_path = parse_key_flag(default_key_path());
        var fp_buf = alloc(ACCOUNT_FP_BUF_BYTES);
        if (keyfile_to_fingerprint(key_path, fp_buf) != 0) {
            println("agora post: --as requires a keyfile (run 'agora keygen' or pass --key <path>)");
            return 1;
        }
        # Verify handle ↔ key binding via the store registry.
        var resolved_fp = alloc(ACCOUNT_FP_BUF_BYTES);
        if (account_resolve_handle(store, as_handle, resolved_fp) != 1) {
            println("agora post: --as handle is not registered in this store");
            return 1;
        }
        if (streq(fp_buf, resolved_fp) == 0) {
            println("agora post: --as handle is registered to a different keyfile");
            return 1;
        }
        from_handle = as_handle;
        from_fp     = fp_buf;
    }
    # M5-E: validate the board name unless it's the default "main".
    #
    # 1.6.4 (audit M5) — this MOVED above the policy check below. `board_can_post`
    # assembles `<store>/<board>/.policy` and `.admins` and reads them, so with
    # the old ordering `--board ../../../../etc` reached the filesystem before
    # anything checked the name: the 0.7.0 audit fixed exactly this ordering for
    # `list` and `read`, and `post` had quietly re-opened it. Nothing between the
    # two depends on the policy result, so validating first is a pure reorder.
    if (streq(board, "main") == 0) {
        if (board_name_valid(board) == 0) {
            println("agora post: invalid --board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')");
            return 2;
        }
    }
    # M6-F: per-board policy check. board_can_post refuses EVERY anonymous post,
    # under every policy (ADR 0006: anon-read, auth-post), so a CLI post needs
    # --as. (1.8.1, audit H6 — this said `open` admitted anonymous CLI posts;
    # it never has since M6.)
    if (board_can_post(store, board, from_fp, from_handle) == 0) {
        if (from_fp == 0) {
            println("agora post: board policy requires authentication (rerun with --as <handle> --key <path>)");
        } else {
            println("agora post: board policy denies this post (admin-only or unregistered)");
        }
        return 1;
    }
    # M5-F: if --reply-to was given without --subject, auto-derive
    # `Re: <parent-subject>` so the CLI matches the wire-side reply
    # flow. Subject explicitly passed via --subject wins over the
    # derived one (operator can still override).
    if (reply_to > 0) {
        # 1.8.1 (audit storage I5) — the parent must exist, as on the wire.
        var pfbuf = alloc(POST_MAX_BYTES + 1024);
        var pflen = post_read(store, board, reply_to, pfbuf, POST_MAX_BYTES + 1024);
        if (pflen <= 0) {
            println("agora post: --reply-to names a post that does not exist on that board");
            return 1;
        }
        if (subject == 0) {
            if (pflen > 0) {
                var psub = alloc(SUBJECT_MAX_BYTES);
                var pslen = post_subject(pfbuf, pflen, psub, SUBJECT_MAX_BYTES);
                var dsub = alloc(SUBJECT_MAX_BYTES + 8);
                subject_reply_prefix(psub, pslen, dsub, SUBJECT_MAX_BYTES + 8);
                subject = dsub;
            }
        }
    }
    var body = alloc(POST_MAX_BYTES + 1);
    var total = 0;
    var rgo = 1;
    while (rgo == 1) {
        var n = sys_read(STDIN, body + total, POST_MAX_BYTES + 1 - total);
        if (n <= 0) { rgo = 0; continue; }
        total = total + n;
        if (total > POST_MAX_BYTES) { rgo = 0; }
    }
    if (total <= 0) {
        println("agora post: no input on stdin (pipe in post body)");
        return 1;
    }
    # 1.8.1 (audit S12) — refuse an over-long body instead of storing its first
    # 64 KB and exiting 0: the tail was lost without a word.
    if (total > POST_MAX_BYTES) {
        println("agora post: body exceeds 64 KB (POST_MAX_BYTES); nothing posted");
        return 1;
    }
    # 0.9.0 ABI (ADR 0008): PostHeaders struct.
    var ph = post_headers_new();
    post_headers_set_subject(ph, subject);
    if (reply_to > 0) { post_headers_set_reply_to(ph, reply_to); }
    if (from_handle != 0) { post_headers_set_from(ph, from_handle, from_fp); }
    var id = post_new(store, board, ph, body, total);
    if (id < 0) {
        println("agora post: failed to write post");
        return 1;
    }
    print_num(id);
    println("");
    return 0;
}

# `agora list` — print `<id>  <subject>` per post in the chosen board
# (default "main"). Subject is empty for headerless / no-Subject posts.
fn cmd_list(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var board = parse_board();
    # 0.7.0 audit H2 — validate --board to prevent path-traversal
    # (`--board "../../etc"` would resolve via board_path into the
    # parent of <store>). cmd_post already does this; cmd_list/cmd_read
    # missed it. Operator-side surface today; remote-disclosure surface
    # once any tool scripts agora against an untrusted board source.
    if (streq(board, "main") == 0) {
        if (board_name_valid(board) == 0) {
            println("agora list: invalid --board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')");
            return 2;
        }
    }
    var ids = alloc(DIRENT_ID_MAX * 8);
    var count = post_list(store, board, ids, DIRENT_ID_MAX);
    if (count == 0) {
        println("agora list: no posts");
        return 0;
    }
    var fbuf = alloc(POST_MAX_BYTES + 1024);
    var sbuf = alloc(SUBJECT_MAX_BYTES);
    var hbuf = alloc(ACCOUNT_HANDLE_BUF);
    var fpbuf = alloc(ACCOUNT_FP_BUF_BYTES);
    var i = 0;
    while (i < count) {
        var id = load64(ids + i * 8);
        print_num(id);
        sys_write(1, "  ", 2);
        var flen = post_read(store, board, id, fbuf, POST_MAX_BYTES + 1024);
        # M6-E: `[<handle>]` or `[anon]` before the subject.
        sys_write(1, "[", 1);
        if (flen > 0) {
            if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
                write_text(1, hbuf, strlen(hbuf));
            } else {
                sys_write(1, "anon", 4);
            }
        } else {
            sys_write(1, "anon", 4);
        }
        sys_write(1, "]  ", 3);
        if (flen > 0) {
            var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
            # 1.8.0 (ADR 0024) — stored text into the operator's terminal: sanitized.
            if (slen > 0) { write_text(1, sbuf, slen); }
        }
        println("");
        i = i + 1;
    }
    return 0;
}

# `agora read <id>` — print one post body to stdout. Subject is
# shown as a one-line prefix; headerless legacy posts skip the prefix.
fn cmd_read(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var board = parse_board();
    # 0.7.0 audit H2 — see cmd_list for rationale.
    if (streq(board, "main") == 0) {
        if (board_name_valid(board) == 0) {
            println("agora read: invalid --board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes, not 'main')");
            return 2;
        }
    }
    var id_arg = first_positional_after_verb();
    if (id_arg == 0) {
        println("agora read: missing post ID");
        return 2;
    }
    var id = atoi(id_arg);
    if (id <= 0) {
        println("agora read: invalid post ID");
        return 2;
    }
    var fbuf = alloc(POST_MAX_BYTES + 1024);
    var flen = post_read(store, board, id, fbuf, POST_MAX_BYTES + 1024);
    if (flen <= 0) {
        println("agora read: post not found");
        return 1;
    }
    var sbuf = alloc(SUBJECT_MAX_BYTES);
    var slen = post_subject(fbuf, flen, sbuf, SUBJECT_MAX_BYTES);
    # M6-E: `From: <handle> <fp16>` (or "From: anonymous") preface.
    var hbuf = alloc(ACCOUNT_HANDLE_BUF);
    var fpbuf = alloc(ACCOUNT_FP_BUF_BYTES);
    sys_write(1, "From: ", 6);
    # 1.8.0 (ADR 0024) — every stored field goes to the operator's terminal
    # through `write_text`: a post body is other people's text, and this printed
    # it raw (a CLI-authored body can hold any byte, ESC included).
    if (post_from(fbuf, flen, hbuf, ACCOUNT_HANDLE_BUF, fpbuf, ACCOUNT_FP_BUF_BYTES) == 1) {
        write_text(1, hbuf, strlen(hbuf));
        sys_write(1, " ", 1);
        write_text(1, fpbuf, strlen(fpbuf));
        sys_write(1, "\n", 1);
    } else {
        sys_write(1, "anonymous\n", 10);
    }
    if (slen > 0) {
        sys_write(1, "Subject: ", 9);
        write_text(1, sbuf, slen);
        sys_write(1, "\n", 1);
    }
    sys_write(1, "\n", 1);
    var body_off = post_body_offset(fbuf, flen);
    var body_len = flen - body_off;
    if (body_len > 0) {
        write_text(1, fbuf + body_off, body_len);
    }
    return 0;
}

# M6-D CLI helpers. parse_key_flag / parse_handle_flag mirror the
# parse_store / parse_subject_flag shape.
fn parse_key_flag(default_path): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--key") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return default_path;
        }
        i = i + 1;
    }
    return default_path;
}

# The `--handle <name>` CLI argument, or 0 if absent.
fn parse_handle_flag(): i64 {
    args_init();
    var n = argc();
    var i = 2;
    while (i < n) {
        var arg = argv(i);
        if (streq(arg, "--handle") != 0) {
            if (i + 1 < n) { return argv(i + 1); }
            return 0;
        }
        i = i + 1;
    }
    return 0;
}

# Default keyfile path: `$HOME/.agora/key` if HOME is set, else
# `./agora.key` in cwd. ADR 0006 § Specifics — the keyfile is the
# user's secret, kept under their home by default.
fn default_key_path(): i64 {
    var home = getenv("HOME");
    if (home == 0) { return "./agora.key"; }
    var hlen = strlen(home);
    var out = alloc(hlen + 16);
    memcpy(out, home, hlen);
    memcpy(out + hlen, "/.agora/key", 11);
    store8(out + hlen + 11, 0);
    return out;
}

# Ensure the parent directory of `path` exists (one-level mkdir).
# Used by cmd_keygen so the default `~/.agora/key` works without
# the operator pre-creating `~/.agora/`. EEXIST treated as success;
# leading-path-component absence still surfaces via the subsequent
# file_open in keyfile_generate.
fn ensure_parent_dir(path): i64 {
    var len = strlen(path);
    var i = len - 1;
    var sentinel = 0;
    while (i > 0) {
        if (sentinel == 0) {
            if ((load8(path + i) & 0xFF) == 47) {   # '/'
                sentinel = i;
                i = 0;
                continue;
            }
        }
        i = i - 1;
    }
    if (sentinel == 0) { return 0; }   # no parent (relative bare name)
    var parent = alloc(sentinel + 1);
    memcpy(parent, path, sentinel);
    store8(parent + sentinel, 0);
    return store_ensure(parent);
}

# `agora keygen [--key <path>]` — generate a fresh Ed25519 seed,
# write to `<path>` (default `~/.agora/key`) with mode 0o600,
# refuse to overwrite. Prints the resulting fingerprint.
fn cmd_keygen(): i64 {
    var path = parse_key_flag(default_key_path());
    ensure_parent_dir(path);
    if (keyfile_generate(path) != 0) {
        println("agora keygen: failed to write keyfile (path exists, or open/write/entropy error)");
        return 1;
    }
    var fp_buf = alloc(ACCOUNT_FP_BUF_BYTES);
    if (keyfile_to_fingerprint(path, fp_buf) != 0) {
        println("agora keygen: wrote keyfile but could not derive fingerprint");
        return 1;
    }
    sys_write(1, "wrote keyfile ", 14);
    sys_write(1, path, strlen(path));
    sys_write(1, " (fp ", 5);
    sys_write(1, fp_buf, ACCOUNT_FP_HEX_BYTES);
    sys_write(1, ")\n", 2);
    return 0;
}

# `agora register --handle <h> [--key <path>] [--store <path>]` —
# load the keyfile, derive the pubkey + fingerprint, refuse if the
# handle is invalid or already taken, register under the chosen
# store. The server-side handle lookup is O(n) (M6-B scan).
fn cmd_register(): i64 {
    var handle = parse_handle_flag();
    if (handle == 0) {
        println("agora register: --handle <handle> is required");
        return 2;
    }
    if (handle_valid(handle) == 0) {
        var hvm = "agora register: invalid handle (lowercase ASCII + digits + '-' / '_', 1-32 bytes,";
        print(hvm, strlen(hvm));
        println(" not anonymous/system/admin)");
        return 2;
    }
    var path = parse_key_flag(default_key_path());
    var store = parse_store(DEFAULT_STORE);

    var seed = alloc(ACCOUNT_SEED_BYTES);
    if (keyfile_load_seed(path, seed) != 0) {
        println("agora register: could not read keyfile (run 'agora keygen' first or pass --key <path>)");
        return 1;
    }
    var pk = alloc(ACCOUNT_PK_BYTES);
    seed_to_pk(seed, pk);

    # 1.8.1 (audit S8) — the check and the write happen under one lock.
    var rlk = account_register_lock(store);
    if (rlk < 0) {
        println("agora register: could not lock the user registry");
        return 1;
    }
    # 1.9.0 — a store that predates the handle index gets it here, under the
    # same lock, so the check below and the claim account_register writes agree.
    account_index_ensure(store);
    # Refuse if the handle is taken (different fp).
    var found_fp = alloc(ACCOUNT_FP_BUF_BYTES);
    if (account_resolve_handle(store, handle, found_fp) == 1) {
        # Compute our own fp; if same, idempotent re-register OK;
        # if different, handle is squatted by someone else.
        var our_fp = alloc(ACCOUNT_FP_BUF_BYTES);
        compute_fingerprint(pk, our_fp);
        if (streq(found_fp, our_fp) == 0) {
            store_lock_release(rlk);
            println("agora register: handle already registered to a different fingerprint");
            return 1;
        }
    }

    var fp_out = alloc(ACCOUNT_FP_BUF_BYTES);
    var regrc = account_register(store, pk, handle, fp_out);
    store_lock_release(rlk);
    if (regrc != 0) {
        println("agora register: write failed (mkdir / open / write error)");
        return 1;
    }
    sys_write(1, "registered ", 11);
    sys_write(1, handle, strlen(handle));
    sys_write(1, " ", 1);
    sys_write(1, fp_out, ACCOUNT_FP_HEX_BYTES);
    sys_write(1, "\n", 1);
    return 0;
}

# === Operator CLI: board policy + admins (1.9.2, ADR 0028) ===
#
# Operators edited `<board>/.policy` and `<board>/.admins` by hand (roadmap
# § 1.9.2, open since the 0.6.0 closeout). Both files keep their format; these
# verbs validate what they write, take the board lock, and replace the file with
# store_write_atomic — whole or not at all, never through a symlink.

# Print a NUL-terminated string (no newline) — the operator verbs' literals, so
# no length is ever counted by hand.
fn cli_put(s): i64 {
    print(s, strlen(s));
    return 0;
}

# Validate a CLI board argument ("main" or a valid board name); prints the error
# and returns 0 when it is not one.
fn cli_board_ok(verb, board): i64 {
    if (board == 0) { return 0; }
    if (streq(board, "main") != 0) { return 1; }
    if (board_name_valid(board) == 1) { return 1; }
    cli_put("agora ");
    print(verb, strlen(verb));
    println(": invalid board name (lowercase ASCII + digits + '-' / '_', 1-32 bytes)");
    return 0;
}

# The POLICY_* value a mode word names, or POLICY_INVALID.
fn policy_from_word(w): i64 {
    if (streq(w, "open")  != 0) { return POLICY_OPEN; }
    if (streq(w, "known") != 0) { return POLICY_KNOWN; }
    if (streq(w, "anon")  != 0) { return POLICY_ANON; }
    if (streq(w, "admin") != 0) { return POLICY_ADMIN; }
    return POLICY_INVALID;
}

# The mode word for a POLICY_* value (POLICY_INVALID → "invalid").
fn policy_word(pol): i64 {
    if (pol == POLICY_OPEN)  { return "open"; }
    if (pol == POLICY_KNOWN) { return "known"; }
    if (pol == POLICY_ANON)  { return "anon"; }
    if (pol == POLICY_ADMIN) { return "admin"; }
    return "invalid";
}

# `agora policy get <board>` / `agora policy set <board> <mode>`. Exit 0, 1 (no
# such board / write failed), 2 (usage).
fn cmd_policy(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var sub = nth_positional(0);
    var board = nth_positional(1);
    if (sub == 0) {
        println("agora policy: usage: policy get <board> | policy set <board> <open|known|anon|admin>");
        return 2;
    }
    if (cli_board_ok("policy", board) == 0) {
        if (board == 0) { println("agora policy: missing <board>"); }
        return 2;
    }
    var path = alloc(PATH_MAX_BYTES);
    board_policy_path(store, board, path);
    if (streq(sub, "get") != 0) {
        if (streq(board, "main") == 0) {
            if (board_exists(store, board) == 0) { println("agora policy: no such board"); return 1; }
        }
        var pol = board_policy_read(store, board);
        print(board, strlen(board));
        cli_put(": ");
        if (pol == POLICY_INVALID) {
            println("invalid (.policy unreadable or unrecognised: admin-only posting, members-only reading)");
            return 1;
        }
        var w = policy_word(pol);
        print(w, strlen(w));
        if (store_name_exists(path) == 0) { cli_put(" (default: no .policy)"); }
        println("");
        return 0;
    }
    if (streq(sub, "set") != 0) {
        var word = nth_positional(2);
        if (word == 0) { println("agora policy: usage: policy set <board> <open|known|anon|admin>"); return 2; }
        if (policy_from_word(word) == POLICY_INVALID) {
            println("agora policy: mode must be one of open, known, anon, admin");
            return 2;
        }
        if (board_ensure(store, board) != 0) { println("agora policy: could not create the board"); return 1; }
        var lk = store_lock_acquire(store, board);
        if (lk < 0) { println("agora policy: could not lock the board"); return 1; }
        var line = alloc(16);
        var wl = strlen(word);
        memcpy(line, word, wl);
        store8(line + wl, 10);
        var wr = store_write_atomic(path, line, wl + 1);
        store_lock_release(lk);
        if (wr != 0) { println("agora policy: write failed"); return 1; }
        print(board, strlen(board));
        cli_put(": ");
        println(word);
        return 0;
    }
    println("agora policy: usage: policy get <board> | policy set <board> <open|known|anon|admin>");
    return 2;
}

# Resolve an `agora admins` target — a fingerprint or a handle — into fp_out
# (ACCOUNT_FP_BUF_BYTES, "" when a handle is not registered) and handle_out
# (ACCOUNT_HANDLE_BUF, "" when a fingerprint has no handle). Returns 1, or 0 when
# `who` is neither.
fn admins_resolve(store, who, fp_out, handle_out): i64 {
    store8(fp_out, 0);
    store8(handle_out, 0);
    var wl = strlen(who);
    if (board_admins_is_fp(who, wl) == 1) {
        memcpy(fp_out, who, 16);
        store8(fp_out + 16, 0);
        account_lookup_handle(store, fp_out, handle_out, ACCOUNT_HANDLE_BUF);
        return 1;
    }
    if (handle_valid(who) == 0) { return 0; }
    memcpy(handle_out, who, wl);
    store8(handle_out + wl, 0);
    account_resolve_handle(store, who, fp_out);
    return 1;
}

# `agora admins list|add|rm <board> [<handle|fingerprint>]`. `add` writes the
# key's fingerprint ("<fp>  # <handle>"): rights follow the key (audit 1.8.1 I9).
# `rm` removes the fingerprint entry and any handle entry for the target. Exit 0,
# 1 (unknown handle / not an admin / write failed), 2 (usage).
fn cmd_admins(): i64 {
    var store = parse_store(DEFAULT_STORE);
    var sub = nth_positional(0);
    var board = nth_positional(1);
    if (sub == 0) {
        println("agora admins: usage: admins list <board> | admins add|rm <board> <handle|fingerprint>");
        return 2;
    }
    if (cli_board_ok("admins", board) == 0) {
        if (board == 0) { println("agora admins: missing <board>"); }
        return 2;
    }
    var path = alloc(PATH_MAX_BYTES);
    board_admins_path(store, board, path);
    var cap = BOARD_ADMINS_FILE_CAP;
    var buf = alloc(cap + 256);
    var ent = alloc(16);
    var hb = alloc(ACCOUNT_HANDLE_BUF);

    if (streq(sub, "list") != 0) {
        var n = store_read_all(path, buf, cap);
        if (n < 0) {
            if (store_read_missing(n) == 1) { println("(no .admins)"); return 0; }
            println("agora admins: .admins could not be read");
            return 1;
        }
        var ls = 0;
        var i = 0;
        while (i <= n) {
            var eol = 0;
            if (i == n) { eol = 1; } else { if ((load8(buf + i) & 0xFF) == 10) { eol = 1; } }
            if (eol == 1) {
                if (board_admins_line_entry(buf, ls, i, ent) == 1) {
                    var es = buf + load64(ent);
                    var el = load64(ent + 8);
                    sys_write(1, es, el);
                    if (board_admins_is_fp(es, el) == 1) {
                        var fpz = alloc(24);
                        memcpy(fpz, es, 16);
                        store8(fpz + 16, 0);
                        if (account_lookup_handle(store, fpz, hb, ACCOUNT_HANDLE_BUF) > 0) {
                            cli_put("  ");
                            print(hb, strlen(hb));
                        } else {
                            cli_put("  (no registered user)");
                        }
                    } else {
                        cli_put("  (by handle: a re-registered handle inherits it; prefer the fingerprint)");
                    }
                    println("");
                }
                ls = i + 1;
            }
            i = i + 1;
        }
        return 0;
    }

    var add = streq(sub, "add");
    var rm = streq(sub, "rm");
    if (add == 0) {
        if (rm == 0) {
            println("agora admins: usage: admins list <board> | admins add|rm <board> <handle|fingerprint>");
            return 2;
        }
    }
    var who = nth_positional(2);
    if (who == 0) { println("agora admins: missing <handle|fingerprint>"); return 2; }
    var fp = alloc(ACCOUNT_FP_BUF_BYTES);
    var handle = alloc(ACCOUNT_HANDLE_BUF);
    if (admins_resolve(store, who, fp, handle) == 0) {
        println("agora admins: not a handle or a 16-hex fingerprint");
        return 2;
    }
    if (add != 0) {
        if ((load8(fp) & 0xFF) == 0) {
            println("agora admins: unknown handle (register it first, or give the fingerprint)");
            return 1;
        }
    }
    if (board_ensure(store, board) != 0) { println("agora admins: could not create the board"); return 1; }
    var lk = store_lock_acquire(store, board);
    if (lk < 0) { println("agora admins: could not lock the board"); return 1; }
    var n2 = store_read_all(path, buf, cap);
    if (n2 < 0) {
        if (store_read_missing(n2) == 0) {
            store_lock_release(lk);
            println("agora admins: .admins could not be read");
            return 1;
        }
        n2 = 0;
    }
    if (n2 >= cap) {
        store_lock_release(lk);
        println("agora admins: .admins is over 1 MiB; edit it by hand");
        return 1;
    }
    var out = alloc(cap + 256);
    var on = 0;
    var hit = 0;
    var hl = strlen(handle);
    var ls2 = 0;
    var j = 0;
    while (j <= n2) {
        var eol2 = 0;
        if (j == n2) { eol2 = 1; } else { if ((load8(buf + j) & 0xFF) == 10) { eol2 = 1; } }
        if (eol2 == 1) {
            var keep = 1;
            if (board_admins_line_entry(buf, ls2, j, ent) == 1) {
                var es2 = buf + load64(ent);
                var el2 = load64(ent + 8);
                var hitln = 0;
                if (board_admins_is_fp(es2, el2) == 1) {
                    if ((load8(fp) & 0xFF) != 0) { if (memeq(es2, fp, 16) == 1) { hitln = 1; } }
                } else {
                    if (hl > 0) { if (el2 == hl) { if (memeq(es2, handle, hl) == 1) { hitln = 1; } } }
                }
                if (hitln == 1) {
                    hit = hit + 1;
                    if (rm != 0) { keep = 0; }
                }
            }
            if (keep == 1) {
                if (j > ls2) {
                    memcpy(out + on, buf + ls2, j - ls2);
                    on = on + (j - ls2);
                    store8(out + on, 10);
                    on = on + 1;
                }
            }
            ls2 = j + 1;
        }
        j = j + 1;
    }
    if (add != 0) {
        if (hit > 0) {
            store_lock_release(lk);
            println("already an admin");
            return 0;
        }
        memcpy(out + on, fp, 16);
        on = on + 16;
        if (hl > 0) {
            memcpy(out + on, "  # ", 4);
            on = on + 4;
            memcpy(out + on, handle, hl);
            on = on + hl;
        }
        store8(out + on, 10);
        on = on + 1;
    } else {
        if (hit == 0) {
            store_lock_release(lk);
            println("agora admins: not an admin of this board");
            return 1;
        }
    }
    var wr = store_write_atomic(path, out, on);
    store_lock_release(lk);
    if (wr != 0) { println("agora admins: write failed"); return 1; }
    if (add != 0) {
        cli_put("added ");
        print(fp, 16);
    } else {
        cli_put("removed ");
        fmt_int(hit);
        cli_put(" entr");
        if (hit == 1) { cli_put("y"); } else { cli_put("ies"); }
    }
    println("");
    return 0;
}

# `agora whoami [--key <path>] [--store <path>]` — decode the
# keyfile, derive the fingerprint, optionally look up the handle in
# the store. Prints `<handle?> <fp16>` or just `<fp16>`. Returns 1
# if the keyfile cannot be read.
fn cmd_whoami(): i64 {
    var path = parse_key_flag(default_key_path());
    var store = parse_store(DEFAULT_STORE);
    var fp_buf = alloc(ACCOUNT_FP_BUF_BYTES);
    if (keyfile_to_fingerprint(path, fp_buf) != 0) {
        println("agora whoami: no keyfile (run 'agora keygen' or pass --key <path>)");
        return 1;
    }
    var handle_buf = alloc(ACCOUNT_HANDLE_BUF);
    var hlen = account_lookup_handle(store, fp_buf, handle_buf, ACCOUNT_HANDLE_BUF);
    if (hlen > 0) {
        sys_write(1, handle_buf, hlen);
        sys_write(1, " ", 1);
    }
    sys_write(1, fp_buf, ACCOUNT_FP_HEX_BYTES);
    sys_write(1, "\n", 1);
    return 0;
}

# `agora version` / `--version`: "agora <VERSION>" (CYRIUS_PKG_VERSION, 1.8.2).
fn cmd_version(): i64 {
    print("agora ", 6);
    println(CYRIUS_PKG_VERSION);   # 1.8.2 — from VERSION (see print_banner)
    return 0;
}

# CLI entry: dispatch argv[1] to its verb; with no verb, print help.
fn main(): i64 {
    alloc_init();
    args_init();
    var n = argc();
    if (n < 2) {
        print_help();
        return 2;
    }
    var verb = argv(1);
    if (streq(verb, "help") != 0) { return print_help(); }
    if (streq(verb, "--help") != 0) { return print_help(); }
    if (streq(verb, "-h") != 0) { return print_help(); }
    if (streq(verb, "version") != 0) { return cmd_version(); }
    if (streq(verb, "--version") != 0) { return cmd_version(); }
    if (streq(verb, "serve") != 0) { return cmd_serve(); }
    if (streq(verb, "post") != 0) { return cmd_post(); }
    if (streq(verb, "list") != 0) { return cmd_list(); }
    if (streq(verb, "read") != 0) { return cmd_read(); }
    if (streq(verb, "whoami")   != 0) { return cmd_whoami(); }
    if (streq(verb, "keygen")   != 0) { return cmd_keygen(); }
    if (streq(verb, "register") != 0) { return cmd_register(); }
    if (streq(verb, "policy")   != 0) { return cmd_policy(); }
    if (streq(verb, "admins")   != 0) { return cmd_admins(); }
    if (streq(verb, "worldbench") != 0) { return cmd_worldbench(); }
    if (streq(verb, "worldread") != 0) { return cmd_worldread(); }
    println("agora: unknown command");
    print_help();
    return 2;
}

# 1.8.2 — tests/serve.tcyr includes this file to unit-test the serve loops, the
# session pool, the send path and the door glue (before 1.8.2 none of it could be
# tested: nothing could include main.cyr without running it). It defines
# AGORA_TEST, and the entry point below runs only when that is absent.
#ifndef AGORA_TEST
var exit_code = main();
# 1.6.2 — `sys_exit`, not a raw `syscall(60, ...)`. 60 is exit only on Linux
# x86_64; on agnos exit is 0 and 60 is `SYS_WINSIZE` (nullary, returns the
# framebuffer console grid), so the raw form made an agnos build query the
# console, discard the answer, and fall off the end of the program instead of
# terminating. `sys_exit` picks the right number per target and is what the
# fork child in cmd_serve_on's accept loop already used — these two top-level
# exits were the outlier.
sys_exit(exit_code);
#endif
