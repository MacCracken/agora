# decode_words.cyr — the Decode/Words 5-letter dictionaries (1.4.2, ADR 0018).
#
# Two lists, each one 5-byte-stride lowercase blob (no separators), so word i
# is just blob + i*5:
#
#   - the ANSWER POOL: a curated table of 532 common words; the secret is drawn
#     from it by index (decode_gen_words, and the Handler's decrypt lever). Its
#     order is part of the replay contract — a seeded game draws the same
#     secret only while index i names the same word — so it is never re-sorted.
#   - the GUESS DICTIONARY (1.12.0): every five-letter word in ENABLE, the
#     public-domain word list, plus every answer — 8,636 words, sorted, so
#     decode_guess_ok is a binary search. Until 1.12.0 the answer pool doubled
#     as the dictionary and most real words came back "not a word". Regenerate
#     it with scripts/gen-decode-guesses.py (which records the source and rule).
#
# Pure compile-time content, like ol_team_name / th_city_name / the
# Jabberwacky seed corpus — no runtime I/O, so the Words variant stays
# exercisable from the unit harness. Kept in its own module to keep
# src/decode.cyr (the engine) clean.

enum DecodeWords {
    WORD_COUNT  = 532;    # entries in the answer pool
    WORD_STRIDE = 5;     # bytes per word (== DW_LEN)
    GUESS_COUNT = 8636;  # entries in the guess dictionary (scripts/gen-decode-guesses.py)
}

# Number of words in the table (WORD_COUNT); decode_word's valid indexes are [0, count).
fn decode_word_count(): i64 {
    return WORD_COUNT;
}

# The packed blob: WORD_COUNT words x 5 bytes, no separators. One literal on
# purpose — decode_word(i) indexes it at i * 5, and Cyrius cannot join literals
# (each carries its own NUL), so the line is exempt from the length rule.
fn decode_word_blob(): i64 {
    return "";   #skip-lint
}

# Address of the i-th word (5 lowercase bytes, NOT NUL-terminated).
fn decode_word(i): i64 {
    return decode_word_blob() + i * WORD_STRIDE;
}

# === The guess dictionary (1.12.0) ===

# Number of words a guess may be (GUESS_COUNT).
fn decode_guess_count(): i64 {
    return GUESS_COUNT;
}

# The sorted guess blob: GUESS_COUNT words x 5 bytes, no separators. One literal
# for the same reason as decode_word_blob; written by scripts/gen-decode-guesses.py.
fn decode_guess_blob(): i64 {
    return "";   #skip-lint
}

# Compare 5 lowercase bytes a and b: (0 - 1) if a sorts first, 0 if equal, 1 if after. Pure.
fn decode_cmp5(a, b): i64 {
    var i = 0;
    while (i < WORD_STRIDE) {
        var x = load8(a + i) & 0xFF;
        var y = load8(b + i) & 0xFF;
        if (x < y) { return 0 - 1; }
        if (x > y) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 if the 5 lowercase bytes at `w` are a word a guess may be, else 0: a binary
# search of the sorted guess dictionary (13 probes at most). Pure.
fn decode_guess_ok(w): i64 {
    var blob = decode_guess_blob();
    var lo = 0;
    var hi = decode_guess_count();
    var found = 0;
    while (lo < hi) {
        var mid = (lo + hi) / 2;
        var c = decode_cmp5(blob + mid * WORD_STRIDE, w);
        if (c == 0) { found = 1; lo = hi; continue; }
        if (c < 0) { lo = mid + 1; }
        else       { hi = mid; }
    }
    return found;
}
