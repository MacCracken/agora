# src/descent.cyr — 1.4.0 Descent link (ADR 0017)
#
# Bridge a logged-in agora session into the sibling Yeoman's Descent MUD
# (../cyrius-yeomans-descent) over the shared telnet substrate. agora
# stays the BBS: this is a *gateway*, not an absorption of MUD semantics.
# The wire-proxy is the only coupling, so the two projects keep
# independent release cycles (roadmap § 1.4.0 "boundary discipline").
#
# Model: a TRANSPARENT TCP proxy. The MUD owns its own world loop; agora
# dials the operator-configured endpoint and shuttles bytes both ways
# until either side closes, then drops the citizen back at the BBS prompt.
# Because the shuttle is byte-transparent, the MUD's own telnet IAC
# negotiation (RFC 1143 WILL ECHO / SGA, passphrase echo suppression)
# flows through to the client verbatim — the MUD authenticates the player
# itself. Sigil identity hand-off across the link is DEFERRED (roadmap § Unscheduled;
# ADR 0017 § Decision): the MUD as built has no external-identity path, so a true
# hand-off needs an MUD-side protocol first.
#
# 1.11.0 (ADR 0031) — a visit is a SESSION STATE (main.cyr MODE_DESCENT), not a
# call that owns the process: until 1.11.0 `descent_run` blocked in its own
# poll(2) shuttle for the whole visit, freezing every other session of a poll
# server (and of agora on agnos, which always polls). This module now holds the
# non-blocking pieces — dial, connect check, one read, one write — and main.cyr's
# `descent_pump` moves bytes once per sweep (poll) or per wakeup (fork). The
# negotiation passing through is watched by telnet.cyr's observer, so the return
# can adopt the options the client actually holds.
#
# Endpoint is OPERATOR config only (<store>/.descent), never client-
# supplied, so there is no SSRF surface: a citizen cannot point the proxy
# at an arbitrary host.
#
# Split per CLAUDE.md "pure parsing is testable; socket I/O is wired":
#   - descent_parse_endpoint / descent_parse_ipv4 / descent_dec — pure,
#     unit-tested (t207+).
#   - descent_endpoint / descent_dial / descent_connect_check /
#     descent_mud_read / descent_mud_write — socket I/O, covered by the serve
#     suite (s11) and the smokes (20, 24, 37).

enum DescentConst {
    DESCENT_CFG_CAP    = 128;        # max bytes read from <store>/.descent
    DESCENT_PATH_CAP   = 512;        # <store>/.descent path buffer (cf PATH_MAX_BYTES)
    DESCENT_PROXY_BUF  = 4096;       # one read in either direction
    DESCENT_CONNECT_MS = 4000;       # connect deadline (Linux: polled; agnos: the kernel's own ~8 s)
    DESCENT_IDLE_MS    = 1800000;    # 30 min pure-silence bound (slowloris)
    DESCENT_DEC_MAX    = 16777216;   # overflow guard for the decimal parser
    # poll(2) revents bits (Linux, cross-arch identical): POLLOUT reports a
    # finished connect; POLLHUP|POLLERR (16|8 = 24) a failed one.
    DESCENT_POLLOUT    = 4;
    DESCENT_POLLDEAD   = 24;
    # EAGAIN. Named locally rather than reusing main.cyr's EWOULDBLOCK_ERR
    # because tests/agora.tcyr links descent.cyr WITHOUT main.cyr — a cross-file
    # constant reference builds in the binary and breaks the test harness.
    DESCENT_EAGAIN     = 11;
    DESCENT_RETRY_MS   = 30000;      # 1.8.1 — after a failed connect, answer "not answering" without dialling
    # 1.11.0 — a visit's phase (main.cyr SESS_DESC_PHASE).
    DESC_NONE          = 0;
    DESC_CONNECTING    = 1;          # a non-blocking connect is under way
    DESC_PROXY         = 2;          # connected: bytes move both ways
}

# 1.8.1 (audit P8) — wall-clock (ms) before which `descent` does not redial
# after a failed connect. Under poll each attempt blocked the WHOLE sweep for up
# to DESCENT_CONNECT_MS (4 s; ~8 s on agnos), so a dead or blackholed endpoint
# let one logged-in user stall every session 4 s per line. Process-wide. Since
# 1.11.0 a Linux connect no longer blocks at all; on agnos it still does (the
# kernel's connect is blocking), so the cooldown stays.
var g_descent_down_until = 0;

# Parse a non-negative decimal in buf[s, e). Returns the value, or (0-1)
# on an empty span, a non-digit, or overflow past DESCENT_DEC_MAX. Pure.
fn descent_dec(buf, s, e): i64 {
    if (s >= e) { return 0 - 1; }
    var v = 0;
    var i = s;
    var bad = 0;
    while (i < e) {
        var ch = load8(buf + i) & 0xFF;
        if (ch < 48) { bad = 1; i = e; }
        else { if (ch > 57) { bad = 1; i = e; }
            else {
                v = v * 10 + (ch - 48);
                if (v > DESCENT_DEC_MAX) { bad = 1; i = e; }
                else { i = i + 1; }
            } }
    }
    if (bad != 0) { return 0 - 1; }
    return v;
}

# Parse "A.B.C.D" in buf[s, e) into a packed network-byte-order uint32
# (A | B<<8 | C<<16 | D<<24 — the shape sockaddr_in / net_connect_nb want;
# 127.0.0.1 → 0x0100007F). Returns the packed addr, or (0-1) on a bad
# octet count, a non-numeric octet, or an octet > 255. Pure.
fn descent_parse_ipv4(buf, s, e): i64 {
    var count = 0;
    var seg = s;
    var i = s;
    var packed = 0;
    var bad = 0;
    var go = 1;
    while (go == 1) {
        var atend = 0;
        if (i >= e) { atend = 1; }
        var issep = 0;
        if (atend == 1) { issep = 1; }
        else { if ((load8(buf + i) & 0xFF) == 46) { issep = 1; } }   # '.'
        if (issep == 1) {
            var oc = descent_dec(buf, seg, i);
            if (oc < 0) { bad = 1; go = 0; }
            else { if (oc > 255) { bad = 1; go = 0; }
                else {
                    packed = packed | (oc << (count * 8));
                    count = count + 1;
                    seg = i + 1;
                    if (atend == 1) { go = 0; } else { i = i + 1; }
                } }
        } else { i = i + 1; }
    }
    if (bad != 0) { return 0 - 1; }
    if (count != 4) { return 0 - 1; }
    return packed;
}

# Parse an operator endpoint string buf[0, len) into a packed addr
# (*out_addr) + host-order port (*out_port). Accepts:
#   "A.B.C.D:PORT"  — explicit host
#   "PORT"          — bare port, host defaults to 127.0.0.1 (co-located MUD)
# Leading/trailing whitespace + CR/LF are trimmed. Returns 0 on success,
# 1 on any parse failure. Pure.
fn descent_parse_endpoint(buf, len, out_addr, out_port): i64 {
    var s = 0;
    var e = len;
    # trim leading whitespace
    var tl = 1;
    while (tl == 1) {
        if (s >= e) { tl = 0; }
        else {
            var lc = load8(buf + s) & 0xFF;
            if (lc == 32) { s = s + 1; } else { if (lc == 9) { s = s + 1; } else { tl = 0; } }
        }
    }
    # trim trailing whitespace + CR/LF
    var tr = 1;
    while (tr == 1) {
        if (e <= s) { tr = 0; }
        else {
            var rc = load8(buf + e - 1) & 0xFF;
            if (rc == 10) { e = e - 1; }
            else { if (rc == 13) { e = e - 1; }
                else { if (rc == 32) { e = e - 1; }
                    else { if (rc == 9) { e = e - 1; }
                        else { tr = 0; } } } }
        }
    }
    if (e <= s) { return 1; }
    # locate ':'
    var colon = 0 - 1;
    var ci = s;
    var fc = 1;
    while (fc == 1) {
        if (ci >= e) { fc = 0; }
        else { if ((load8(buf + ci) & 0xFF) == 58) { colon = ci; fc = 0; } else { ci = ci + 1; } }
    }
    var addr = 0x0100007F;       # 127.0.0.1 default (bare-port form)
    var pstart = s;
    if (colon >= 0) {
        var ip = descent_parse_ipv4(buf, s, colon);
        if (ip < 0) { return 1; }
        addr = ip;
        pstart = colon + 1;
    }
    var port = descent_dec(buf, pstart, e);
    if (port < 1) { return 1; }
    if (port > 65535) { return 1; }
    store64(out_addr, addr);
    store64(out_port, port);
    return 0;
}

# Build "<store>/.descent" into out (cstring). Returns the length.
fn descent_cfg_path(store, out): i64 {
    var sl = strlen(store);
    memcpy(out, store, sl);
    memcpy(out + sl, "/.descent", 9);
    store8(out + sl + 9, 0);
    return sl + 9;
}

# Read the operator's endpoint (<store>/.descent) into *ap (packed addr) and *pp
# (port). Returns 0, 1 when none is configured (no file, or empty), 2 when it does
# not parse. The scratch is per-command arena (1.8.1, audit G1).
fn descent_endpoint(store, ap, pp): i64 {
    var path = cmd_alloc(DESCENT_PATH_CAP);
    descent_cfg_path(store, path);
    var cfg = cmd_alloc(DESCENT_CFG_CAP + 1);
    var n = store_read_all(path, cfg, DESCENT_CFG_CAP);
    if (n <= 0) { return 1; }
    if (descent_parse_endpoint(cfg, n, ap, pp) != 0) { return 2; }
    return 0;
}

# Start a connection to the MUD. Returns the socket, with *statep set to
# DESC_PROXY (connected already) or DESC_CONNECTING (a non-blocking connect under
# way: descent_connect_check finishes it), or -1 if no connection could start.
#
# Linux: a non-blocking socket and the stdlib's `sock_connect`, which reports
# EINPROGRESS (as an Err) for a connect still in flight — no raw socket syscall.
# Until 1.11.0 this was `net_connect_nb`, which polls for up to 4 s INSIDE the
# call, i.e. inside the poll server's sweep. agnos has no non-blocking connect
# (`sock_connect` #47 polls for the SYN-ACK in the kernel, ~8 s), so it keeps
# the bounded blocking call; the redial cooldown bounds how often it can happen.
fn descent_dial(addr, port, statep): i64 {
    var st, sv = tcp_socket();
    if (is_ok(st) == 0) { return 0 - 1; }
    var mfd = result_unwrap(st, sv);
    #ifdef CYRIUS_TARGET_AGNOS
    if (net_connect_nb(mfd, addr, port, DESCENT_CONNECT_MS) != 0) { sock_close(mfd); return 0 - 1; }
    store64(statep, DESC_PROXY);
    return mfd;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    sock_set_nonblocking(mfd);
    var ct, cv = sock_connect(mfd, addr, port);
    if (is_ok(ct) == 1) { store64(statep, DESC_PROXY); return mfd; }
    if (cv == _NET_EINPROGRESS) { store64(statep, DESC_CONNECTING); return mfd; }
    sock_close(mfd);
    return 0 - 1;
    #endif
}

# Has the connect started by descent_dial finished? 1 = connected, 0 = in progress,
# -1 = failed (refused, unreachable, reset). A zero-timeout poll(2) for
# POLLOUT: a finished connect makes the socket writable, and a failed one also
# raises POLLERR / POLLHUP. Raw `syscall(7, …)` as in the poll serve loop (no
# stdlib wrapper; Linux / macOS only). agnos connects in descent_dial.
fn descent_connect_check(mfd): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    return 1;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var pfd[8];
    store32(&pfd, mfd);
    store16((&pfd) + 4, DESCENT_POLLOUT);
    store16((&pfd) + 6, 0);
    var pr = syscall(7, &pfd, 1, 0);
    if (pr < 0) { return 0 - 1; }
    if (pr == 0) { return 0; }
    var re = load16((&pfd) + 6) & 0xFFFF;
    if ((re & DESCENT_POLLDEAD) != 0) { return 0 - 1; }
    if ((re & DESCENT_POLLOUT) != 0) { return 1; }
    return 0;
    #endif
}

# One non-blocking read from the MUD: bytes read (> 0), 0 if nothing is waiting,
# -1 if the MUD closed or the socket failed. agnos reads with sock_recv #49,
# whose sense is inverted from Linux's (0 = nothing pending, < 0 = gone).
fn descent_mud_read(mfd, buf, cap): i64 {
    #ifdef CYRIUS_TARGET_AGNOS
    var an = sys_sock_recv(_agnos_fd_conn(mfd), buf, cap);
    if (an < 0) { return 0 - 1; }
    return an;
    #endif
    #ifndef CYRIUS_TARGET_AGNOS
    var n = sys_read(mfd, buf, cap);
    if (n > 0) { return n; }
    if (n == (0 - DESCENT_EAGAIN)) { return 0; }
    return 0 - 1;
    #endif
}

# One non-blocking write to the MUD: bytes written (possibly fewer than `len`, 0
# if the socket would block), or -1 if it failed. Never `send_buf`: in poll mode
# that enqueues to the active session's tx queue, which is the CLIENT's (the
# 1.6.2 bug that silently broke the gateway under poll — smoke 24). On agnos the
# send itself blocks (sock_send #48 has no non-blocking form); the MUD is the
# operator's own service.
fn descent_mud_write(mfd, buf, len): i64 {
    if (len <= 0) { return 0; }
    var n = sys_write(mfd, buf, len);
    if (n >= 0) { return n; }
    #ifndef CYRIUS_TARGET_AGNOS
    if (n == (0 - DESCENT_EAGAIN)) { return 0; }
    #endif
    return 0 - 1;
}
