# olympiad.cyr — the Olympiad: a Greco-Roman games-owner sim (1.3.6, ADR 0016).
#
# You are not the athlete — you are the OWNER (a dominus / lanista /
# circus-faction boss) who fields a STABLE of competitors across the
# Games and bets on every contest. Rome paying its debt to Greece:
# the Greek athletic Games and the Roman circus + arena under one roof.
#
# === The competition primitive (ADR 0016, the heart) ===
#
# Every event a games-owner stages is the SAME shape:
#
#     a field of competitors weighted by FORM
#       -> one draw picks the winner (and order)
#       -> the same weights book the bets
#
# A chariot race, a gladiatorial bout, a foot race, a regatta — they
# differ only in their field-builder and their flavour. So `compete()`
# is one engine; an EVENT is a thin descriptor (a field-builder + a form
# function + render text). Chariot racing ships first (1.3.6); gladiators
# / athletics / boat crews are added the same way 1.3.5 added three
# casino tables to one wager module. This is agora's signature pattern a
# third time: door PRNG -> wager -> COMPETITION.
#
# === The fairness split (extends ADR 0013) ===
#
# The rival FIELD is generated from the seeded door.cyr PRNG (replayable
# — a save replays the same season's opponents). The race WINNER comes from
# the wager draw (`wager_uniform`: since 1.12.1 the session's committed seed,
# drawn from the kernel CSPRNG and revealed afterwards, ADR 0033) — the one
# thing money rides on is the one thing a player cannot predict, yet can verify.
# Training shifts your WEIGHT; it never makes the result reconstructable.
# The pure weight->index map (`ol_pick_weighted`, the injected test seam)
# is split from the CSPRNG read, exactly as wager.cyr splits wager_pick.
#
# === Events (1.12.0) ===
#
# Four events share the primitive: the chariot race (1.3.6), and since 1.12.0
# the gladiatorial bout, the stadion foot race and the regatta. Each is one
# descriptor block (ol_events_init) — its words, its four stat labels, the
# weights its form puts on them, what a contest costs and pays, its venues and
# its competitors' names. The owner hires one competitor per event (the
# market), switches between them, and enters whichever suits the meet: the
# twelve-meet ladder is the owner's standing, shared by the whole stable, and
# a win in any event climbs it. The field grows with the meet, four entrants at
# the first and eight at the last.
#
# Deps resolved upstream in the main.cyr / test.cyr include chain:
#   door.cyr   — emit_*, door_key/door_parse_int, save_put/get_i64, imin/imax
#   wager.cyr  — wager_uniform (the committed draw), wager_audit, WAGER_* (bite 3)

# === Constants ===

# Owner / stable state block. Runtime-only fields (screen/sel/msg/scratch)
# are NOT serialized — a save restores the owner + stable, not mid-UI state.
enum OL {
    OL_SEED     = 0;     # field-generation seed (replayable rivals)
    OL_RNG      = 8;     # live seeded PRNG cell (rival field gen)
    OL_MODE     = 16;    # DOOR_PRACTICE / DOOR_SOLO
    OL_OVER     = 24;    # 0 play / 1 crowned (won) / 2 ruined (bankrupt)
    OL_DAY      = 32;    # current day
    OL_ACTIONS  = 40;    # training actions left today
    OL_MONEY    = 48;    # denarii on hand
    OL_TIER     = 56;    # season-ladder position (which meet)
    OL_CROWNS   = 64;    # championship crowns won (win-condition counter)
    OL_LASTDAY  = 72;    # UTC day the daily ration was last refilled (1.12.0, door_ration_take)
    OL_NCOMP    = 80;    # competitors in the stable
    OL_STABLE   = 88;    # ptr -> array of OL_NCOMP competitor blocks
    # runtime-only (not serialized):
    OL_SCREEN   = 96;
    OL_SEL      = 104;   # selected competitor index (UI cursor)
    OL_MSG      = 112;   # ptr -> 256-byte message buffer
    OL_FIELD    = 120;   # ptr -> scratch forms[] for the current event
    OL_ORDER    = 128;   # ptr -> scratch finishing-order[] for the last race
    OL_FCOMP    = 136;   # ptr -> the current race's field (CMP blocks; lane 0 = you)
    OL_FIELDN   = 144;   # entrants in the current field
    OL_PLACE    = 152;   # your finishing place in the last race (1-based; 0 none)
    OL_PURSE    = 160;   # your purse from the last race
    OL_BETLANE  = 168;   # lane you've wagered on this race (1-based; 0 = no bet)
    OL_BETSTAKE = 176;   # your stake on that lane
    OL_BETDELTA = 184;   # the resolved bet's signed gold delta (last race)
    OL_BETHAD   = 192;   # 1 if a wager was resolved in the last race
    OL_CROWNEV  = 200;   # the event the crown was won in (runtime; the run ends with it)
    OL_RLEFT    = 208;   # days of the daily ration left today — saved, after the stable (1.12.0)
    OL_SIZE     = 216;
}

# A competitor: a fixed i64 block. Stats are event-flavoured (a chariot
# team's are Speed/Stamina/Handling/Nerve); the primitive only ever reads
# the FORM the event computes from them, so other event types reuse the
# same slots with their own meaning.
enum CMP {
    CMP_TYPE    = 0;     # event type (EV_CHARIOT ...)
    CMP_SPEED   = 8;     # stat 0
    CMP_STAMINA = 16;    # stat 1
    CMP_HANDLE  = 24;    # stat 2
    CMP_NERVE   = 32;    # stat 3
    CMP_COND    = 40;    # condition / freshness, 0..100
    CMP_FACTION = 48;    # circus faction id (0..3)
    CMP_NAMEID  = 56;    # index into the team-name table
    CMP_SIZE    = 64;
}

enum OLEvent {
    EV_CHARIOT  = 0;     # 1.3.6: the circus chariot race
    EV_MUNUS    = 1;     # 1.12.0: the gladiatorial bout (a munus)
    EV_STADION  = 2;     # 1.12.0: the stadion, the foot race
    EV_REGATTA  = 3;     # 1.12.0: the boat crews' regatta
    OL_NEVENTS  = 4;     # events registered; every walk and every bound stops here
}

# The four Roman circus factions.
enum OLFaction {
    FAC_BLUE  = 0;
    FAC_GREEN = 1;
    FAC_RED   = 2;
    FAC_WHITE = 3;
}

enum OLScreen {
    OSCR_STABLE = 0;     # the owner's hub: roster + day/money/actions
    OSCR_OVER   = 1;     # game over (crowned or ruined)
    OSCR_RACE   = 2;     # the venue: the field + odds, start the contest
    OSCR_RESULT = 3;     # the finish order + your placing + purse
    OSCR_HIRE   = 4;     # the market: hire a competitor for an event you do not field (1.12.0)
}

enum OLEcon {
    OL_DAY_ACTIONS = 3;      # training actions granted per day
    OL_STABLE_MAX  = 8;      # roster ceiling
    OL_FIELD_MAX   = 8;      # entrants in a race field
    OL_STAT_CAP    = 25;     # per-stat ceiling
    OL_STAT_START  = 8;      # a fresh competitor's starting stat
    OL_TRAIN_GAIN  = 2;      # stat points per training session (pre-diminish)
    OL_TRAIN_COND  = 12;     # condition spent per hard training session
    OL_REST_COND   = 30;     # condition restored per rest
    OL_VIG_BPS     = 500;    # the book's house edge (5%), used by the wager UI (bite 3)
    OL_START_MONEY = 200;    # starting denarii
    OL_FIELD_BASE  = 4;      # entrants at the first meet (you + 3); ol_field_size grows it to 8
    OL_PURSE_WIN   = 100;    # 1st-place purse BASE — `ol_run_race` scales it by tier and event
    OL_PURSE_2ND   = 40;
    OL_PURSE_3RD   = 20;
    OL_BET_MIN     = 5;      # minimum wager at the book
    OL_MAX_TIER    = 12;     # meets on the ladder; winning the last takes the crown
}

# === Event descriptors (1.12.0, ADR 0016) ===
#
# ADR 0016's promise, kept: an event is a thin descriptor over the compete()
# primitive, not a new game. Each block below is one event's data — its words,
# its stat labels, the weights its form puts on the four stat slots, what a
# contest costs and pays, its venues and its competitors — and the engine, the
# book, the ladder and the save never ask which event they are running.
# Adding an event is its enum id, OL_NEVENTS, one block and two name tables.

enum OLEvd {
    EVD_NAME    = 0;     # cstring — the event in a sentence ("chariot race")
    EVD_ENTER   = 8;     # cstring — the hub's [E]nter word ("race")
    EVD_KIND    = 16;    # cstring — one competitor ("team")
    EVD_VENUE   = 24;    # cstring — the contest screen's banner ("THE HIPPODROME")
    EVD_START   = 32;    # cstring — what Enter does there ("loose the gates")
    EVD_STATS   = 40;    # cstring — the four short stat labels, '|'-separated
    EVD_LONG    = 48;    # cstring — the four long stat labels, '|'-separated
    EVD_W0      = 56;    # form weights on stat slots 0..3 (they sum to 8)
    EVD_W1      = 64;
    EVD_W2      = 72;
    EVD_W3      = 80;
    EVD_COST    = 88;    # condition one contest costs your competitor
    EVD_PURSE   = 96;    # purse, as a percentage of the base purse
    EVD_HIRE    = 104;   # denarii to hire one at the market
    EVD_FACTION = 112;   # 1 if its competitors carry a circus faction (the chariot race)
    EVD_MEET    = 120;   # fn(tier) -> cstring, the venue of each meet on the ladder
    EVD_CNAME   = 128;   # fn(id) -> cstring, competitor names (0 = yours, 1.. rivals)
    EVD_CROWN   = 136;   # cstring — the crown screen's banner
    EVD_GLORY1  = 144;   # cstring x 3 — the crown screen's lines
    EVD_GLORY2  = 152;
    EVD_GLORY3  = 160;
    EVD_SIZE    = 168;
}

var g_ol_evd = 0;        # the OL_NEVENTS descriptor blocks, built once per process

# Build the descriptor table (idempotent). main.cyr calls it with the door
# registry, once per process; ol_evd calls it too, so the unit harness needs
# no setup. The table comes from alloc() and lives as long as the process,
# like the registry.
fn ol_events_init(): i64 {
    if (g_ol_evd != 0) { return 0; }
    g_ol_evd = alloc(OL_NEVENTS * EVD_SIZE);
    memset(g_ol_evd, 0, OL_NEVENTS * EVD_SIZE);
    var d = g_ol_evd + EV_CHARIOT * EVD_SIZE;
    store64(d + EVD_NAME, "chariot race");      store64(d + EVD_ENTER, "race");
    store64(d + EVD_KIND, "team");              store64(d + EVD_VENUE, "THE HIPPODROME");
    store64(d + EVD_START, "loose the gates");
    store64(d + EVD_STATS, "Spd|Sta|Hnd|Nrv");  store64(d + EVD_LONG, "Speed|Stamina|Handling|Nerve");
    store64(d + EVD_W0, 2); store64(d + EVD_W1, 2); store64(d + EVD_W2, 2); store64(d + EVD_W3, 2);
    store64(d + EVD_COST, 20);  store64(d + EVD_PURSE, 100);  store64(d + EVD_HIRE, 150);
    store64(d + EVD_FACTION, 1);
    store64(d + EVD_MEET, &ol_meet_name);       store64(d + EVD_CNAME, &ol_team_name);
    store64(d + EVD_CROWN, "-- THE TETHRIPPON CROWN --");
    store64(d + EVD_GLORY1, "You take the Circus Maximus, and the olive crown with it.");
    store64(d + EVD_GLORY2, "From a Veii dirt track to the greatest course in the world --");
    store64(d + EVD_GLORY3, "your faction's name is sung across the empire.");

    d = g_ol_evd + EV_MUNUS * EVD_SIZE;
    store64(d + EVD_NAME, "gladiatorial bout"); store64(d + EVD_ENTER, "bout");
    store64(d + EVD_KIND, "gladiator");         store64(d + EVD_VENUE, "THE ARENA");
    store64(d + EVD_START, "sound the horn");
    store64(d + EVD_STATS, "Str|End|Skl|Crg");  store64(d + EVD_LONG, "Strength|Endurance|Skill|Courage");
    store64(d + EVD_W0, 2); store64(d + EVD_W1, 1); store64(d + EVD_W2, 3); store64(d + EVD_W3, 2);
    store64(d + EVD_COST, 35);  store64(d + EVD_PURSE, 130);  store64(d + EVD_HIRE, 180);
    store64(d + EVD_MEET, &ol_arena_name);      store64(d + EVD_CNAME, &ol_gladiator_name);
    store64(d + EVD_CROWN, "-- THE WOODEN SWORD --");
    store64(d + EVD_GLORY1, "You win the Flavian Amphitheatre, and the rudis: your gladiator walks free.");
    store64(d + EVD_GLORY2, "From the boards at Fidenae to the greatest arena in the world --");
    store64(d + EVD_GLORY3, "the crowd chants your name across the empire.");

    d = g_ol_evd + EV_STADION * EVD_SIZE;
    store64(d + EVD_NAME, "stadion");           store64(d + EVD_ENTER, "race");
    store64(d + EVD_KIND, "runner");            store64(d + EVD_VENUE, "THE STADIUM");
    store64(d + EVD_START, "drop the rope");
    store64(d + EVD_STATS, "Pac|Wnd|Srt|Grt");  store64(d + EVD_LONG, "Pace|Wind|Start|Grit");
    store64(d + EVD_W0, 4); store64(d + EVD_W1, 1); store64(d + EVD_W2, 2); store64(d + EVD_W3, 1);
    store64(d + EVD_COST, 12);  store64(d + EVD_PURSE, 70);   store64(d + EVD_HIRE, 90);
    store64(d + EVD_MEET, &ol_stadium_name);    store64(d + EVD_CNAME, &ol_runner_name);
    store64(d + EVD_CROWN, "-- THE OLIVE WREATH --");
    store64(d + EVD_GLORY1, "Your runner takes the stadion at Olympia, and the olive wreath with it.");
    store64(d + EVD_GLORY2, "From the practice track at Elis to the oldest race in the world --");
    store64(d + EVD_GLORY3, "the herald cries your name across the Greek world.");

    d = g_ol_evd + EV_REGATTA * EVD_SIZE;
    store64(d + EVD_NAME, "regatta");           store64(d + EVD_ENTER, "regatta");
    store64(d + EVD_KIND, "crew");              store64(d + EVD_VENUE, "THE HARBOUR");
    store64(d + EVD_START, "give the stroke");
    store64(d + EVD_STATS, "Oar|Sta|Hlm|Tim");  store64(d + EVD_LONG, "Oarpower|Stamina|Helm|Timing");
    store64(d + EVD_W0, 2); store64(d + EVD_W1, 3); store64(d + EVD_W2, 1); store64(d + EVD_W3, 2);
    store64(d + EVD_COST, 25);  store64(d + EVD_PURSE, 110);  store64(d + EVD_HIRE, 220);
    store64(d + EVD_MEET, &ol_harbour_name);    store64(d + EVD_CNAME, &ol_crew_name);
    store64(d + EVD_CROWN, "-- THE NAVAL CROWN --");
    store64(d + EVD_GLORY1, "Your crew takes the Naumachia of Augustus, and the naval crown with it.");
    store64(d + EVD_GLORY2, "From the Tiber at Ostia to the greatest water in the world --");
    store64(d + EVD_GLORY3, "your oarsmen's song is sung across the empire.");
    return 0;
}

# The descriptor block of event `ev`; an id outside [0, OL_NEVENTS) reads as the
# chariot race (the loader refuses such a save, so this is only a backstop).
fn ol_evd(ev): i64 {
    ol_events_init();
    if (idx_ok(ev, OL_NEVENTS) == 0) { ev = EV_CHARIOT; }
    return g_ol_evd + ev * EVD_SIZE;
}

# Append item `k` of the '|'-separated list `list` at buf+pos, within
# g_door_emit_cap like every door emitter (door.cyr; all-or-nothing, as
# emit_cstr); an index past the end appends nothing. Returns the new pos.
fn ol_emit_item(buf, pos, list, k): i64 {
    var i = 0;
    var item = 0;
    var start = 0 - 1;
    var n = 0;
    var c = load8(list) & 0xFF;
    while (c != 0) {
        if (c == 124) { item = item + 1; }
        else {
            if (item == k) {
                if (start < 0) { start = i; }
                n = n + 1;
            }
        }
        i = i + 1;
        c = load8(list + i) & 0xFF;
    }
    if (n == 0) { return pos; }
    if (pos + n > g_door_emit_cap) { return pos; }
    memcpy(buf + pos, list + start, n);
    return pos + n;
}

# The venue of meet `t` for event `ev` (its descriptor's name table).
fn ol_venue(ev, t): i64 {
    var fp = load64(ol_evd(ev) + EVD_MEET);
    return callptr(fp, t);
}

# Competitor name `id` for event `ev` (0 = the owner's own; rivals 1..).
fn ol_cname(ev, id): i64 {
    var fp = load64(ol_evd(ev) + EVD_CNAME);
    return callptr(fp, id);
}

# Entrants at meet `tier`: four at the first meet, growing to eight at the
# last (4 + 4*tier/11 — 4, 5 from the fourth meet, 6, 7, 8 at the Games' end).
# The roadmap's "a flat 4 entrants at every meet". Pure.
fn ol_field_size(tier): i64 {
    var t = iclamp(tier, 0, OL_MAX_TIER - 1);
    return OL_FIELD_BASE + (t * (OL_FIELD_MAX - OL_FIELD_BASE)) / (OL_MAX_TIER - 1);
}

# 1 if the stable already fields a competitor for event `ev`, else 0.
fn ol_fields_event(st, ev): i64 {
    var n = load64(st + OL_NCOMP);
    var i = 0;
    var found = 0;
    while (i < n) {
        if (load64(ol_comp(st, i) + CMP_TYPE) == ev) { found = 1; }
        i = i + 1;
    }
    return found;
}

# Hire a fresh competitor for event `ev` at the market: one per event, paid in
# denarii. Returns 0 hired (and selected) / 1 already fielded / 2 cannot afford
# / 3 no such event / 4 the stable is full.
fn ol_hire(st, ev): i64 {
    if (idx_ok(ev, OL_NEVENTS) == 0)          { return 3; }
    if (ol_fields_event(st, ev) == 1)         { return 1; }
    var n = load64(st + OL_NCOMP);
    if (n >= OL_STABLE_MAX)                   { return 4; }
    var cost = load64(ol_evd(ev) + EVD_HIRE);
    if (cost > load64(st + OL_MONEY))         { return 2; }
    store64(st + OL_MONEY, load64(st + OL_MONEY) - cost);
    ol_make_competitor(st, n, ev,
      OL_STAT_START, OL_STAT_START, OL_STAT_START, OL_STAT_START, 100, FAC_BLUE, 0);
    store64(st + OL_NCOMP, n + 1);
    store64(st + OL_SEL, n);
    return 0;
}

# === Competitor accessors + form ===

# Address of the i-th competitor block in the stable.
fn ol_comp(st, i): i64 {
    return load64(st + OL_STABLE) + i * CMP_SIZE;
}

# Write a fresh competitor into stable slot `i`.
fn ol_make_competitor(st, i, type, s0, s1, s2, s3, cond, faction, nameid): i64 {
    var c = ol_comp(st, i);
    store64(c + CMP_TYPE,    type);
    store64(c + CMP_SPEED,   s0);
    store64(c + CMP_STAMINA, s1);
    store64(c + CMP_HANDLE,  s2);
    store64(c + CMP_NERVE,   s3);
    store64(c + CMP_COND,    cond);
    store64(c + CMP_FACTION, faction);
    store64(c + CMP_NAMEID,  nameid);
    return 0;
}

# A competitor's FORM: its four stats weighted by its event (ol_events_init;
# the weights sum to 8, so the chariot's even 2/2/2/2 is the plain sum),
# halved, and scaled by condition. This is the weight the competition draw
# uses and the number the book prices odds from — training raises it,
# fatigue lowers it. Floored at 1 for any live competitor so it always has a
# (slim) chance. Pure.
fn ol_form(c): i64 {
    var d = ol_evd(load64(c + CMP_TYPE));
    var raw = (load64(d + EVD_W0) * load64(c + CMP_SPEED) + load64(d + EVD_W1) * load64(c + CMP_STAMINA)
      + load64(d + EVD_W2) * load64(c + CMP_HANDLE) + load64(d + EVD_W3) * load64(c + CMP_NERVE)) / 2;
    if (raw <= 0) { return 0; }
    var cond = load64(c + CMP_COND);
    if (cond < 0)   { cond = 0; }
    if (cond > 100) { cond = 100; }
    var form = (raw * cond) / 100;
    if (form < 1) { form = 1; }   # a live team is never a literal 0
    return form;
}

# === The compete() primitive (event-agnostic) ===

# Sum of the still-in forms (taken[i]!=0 excludes entrant i). taken may be
# 0 (null) to sum the whole field. Pure.
fn ol_field_total(forms, n, taken): i64 {
    var total = 0;
    var i = 0;
    while (i < n) {
        var skip = 0;
        if (taken != 0) {
            if ((load8(taken + i) & 0xFF) != 0) { skip = 1; }
        }
        if (skip == 0) { total = total + load64(forms + i * 8); }
        i = i + 1;
    }
    return total;
}

# PURE weight->entrant map (the injected test seam — wager.cyr's wager_pick
# shape, plus a `taken` mask for sequential draws). Walks the still-in
# entrants accumulating form until r < running-sum. `r` MUST be in
# [0, ol_field_total(forms,n,taken)); the caller (CSPRNG) guarantees it.
# A degenerate/residual r returns the last still-in entrant. taken may be 0.
fn ol_pick_weighted(forms, n, taken, r): i64 {
    var acc = 0;
    var i = 0;
    var pick = 0 - 1;
    var scanning = 1;
    while (scanning == 1) {
        if (i >= n) { scanning = 0; continue; }
        var skip = 0;
        if (taken != 0) {
            if ((load8(taken + i) & 0xFF) != 0) { skip = 1; }
        }
        if (skip == 0) {
            acc = acc + load64(forms + i * 8);
            if (r < acc) { pick = i; scanning = 0; }
        }
        if (scanning == 1) { i = i + 1; }
    }
    if (pick >= 0) { return pick; }
    # residual: the last still-in entrant
    var j = n - 1;
    var res = 0 - 1;
    var sc2 = 1;
    while (sc2 == 1) {
        if (j < 0) { sc2 = 0; continue; }
        var t = 0;
        if (taken != 0) {
            if ((load8(taken + j) & 0xFF) != 0) { t = 1; }
        }
        if (t == 0) { res = j; sc2 = 0; continue; }
        j = j - 1;
    }
    return res;
}

# Resolve a single WINNER over a field of n entrants weighted by form[].
# One wager draw (non-replayable). Returns the 0-based winner index, or
# (0-1) on a draw fault (caller refuses to settle the card).
fn ol_compete_winner(forms, n): i64 {
    var total = ol_field_total(forms, n, 0);
    if (total <= 0) { return 0; }
    var r = wager_uniform(total);
    if (r < 0) { return 0 - 1; }
    return ol_pick_weighted(forms, n, 0, r);
}

# Resolve a full finishing ORDER (for place/show + standings): a SEQUENTIAL
# weighted draw — pick a winner ∝ form from the wager draw (`wager_uniform`),
# remove, repeat. Writes 0-based entrant indices into out_order[0..n) (1st
# first). Returns 0, or (0-1) on a draw fault. Uses a working `taken` mask.
fn ol_compete_order(forms, n, out_order): i64 {
    var taken = cmd_alloc(n);
    var z = 0;
    while (z < n) { store8(taken + z, 0); z = z + 1; }
    var place = 0;
    var fault = 0;
    while (place < n) {
        var total = ol_field_total(forms, n, taken);
        var chosen = 0;
        if (total <= 0) {
            chosen = ol_pick_weighted(forms, n, taken, 0);   # remaining all-zero: index order
        } else {
            var r = wager_uniform(total);
            if (r < 0) { fault = 1; place = n; }
            else       { chosen = ol_pick_weighted(forms, n, taken, r); }
        }
        if (place < n) {
            store64(out_order + place * 8, chosen);
            store8(taken + chosen, 1);
            place = place + 1;
        }
    }
    if (fault == 1) { return 0 - 1; }
    return 0;
}

# Fair profit-odds for entrant `idx`, scaled ×100 (so 3:2 → 150, evens →
# 100, a 5:1 longshot → 500). Straight from the forms — the same weights
# that resolve the race price the book (ADR 0016). The house vig is layered
# on at settlement by the wager UI (bite 3), not here. Pure. 0 = can't win.
fn ol_fair_odds_x100(forms, n, idx): i64 {
    var w = load64(forms + idx * 8);
    if (w <= 0) { return 0; }
    var total = ol_field_total(forms, n, 0);
    return ((total - w) * 100) / w;
}

# === The daily-turn economy (train / rest) ===

# Train one stat of competitor `c`. Raises it toward OL_STAT_CAP (gains
# halve past two-thirds of the cap — diminishing returns) at a condition
# cost (fatigue). Returns the actual stat gain (0 if already capped, so
# the caller can message "already at their peak"). Pure stat math.
fn ol_train(c, stat_off): i64 {
    var cur = load64(c + stat_off);
    if (cur >= OL_STAT_CAP) { return 0; }
    var gain = OL_TRAIN_GAIN;
    if (cur >= (OL_STAT_CAP * 2) / 3) { gain = 1; }   # diminishing returns
    var next = cur + gain;
    if (next > OL_STAT_CAP) { next = OL_STAT_CAP; }
    store64(c + stat_off, next);
    var cond = load64(c + CMP_COND) - OL_TRAIN_COND;
    if (cond < 0) { cond = 0; }
    store64(c + CMP_COND, cond);
    return next - cur;
}

# Rest competitor `c`: restore condition toward 100. Pure.
fn ol_rest(c): i64 {
    var cond = load64(c + CMP_COND) + OL_REST_COND;
    if (cond > 100) { cond = 100; }
    store64(c + CMP_COND, cond);
    return 0;
}

# Spend one of the day's training actions. Returns 1 if an action was
# available (and consumes it), 0 if the day is already spent.
fn ol_spend_action(st): i64 {
    var a = load64(st + OL_ACTIONS);
    if (a <= 0) { return 0; }
    store64(st + OL_ACTIONS, a - 1);
    return 1;
}

# Advance to the next day: refill the action ration, bump the day counter.
# Pure; the `[N]ext-day` key gates it on the daily ration first (1.12.0, ADR
# 0032), so a Solo owner gets g_door_days of them per UTC day. Until 1.12.0
# the key refilled on demand and OL_LASTDAY was only round-tripped through the
# save (audit 1.8.1 I5).
fn ol_day_advance(st): i64 {
    store64(st + OL_DAY, load64(st + OL_DAY) + 1);
    store64(st + OL_ACTIONS, OL_DAY_ACTIONS);
    return 0;
}

# === Owner construction ===

# Set the status-line message: copies NUL-terminated s into OL_MSG, cut at 255 bytes.
fn ol_msg(st, s): i64 {
    var m = load64(st + OL_MSG);
    var n = strlen(s);
    if (n > 255) { n = 255; }
    memcpy(m, s, n);
    store8(m + n, 0);
    return 0;
}

# Build a new owner with a founding chariot team. Practice = ephemeral
# coin; Solo = a persistent stable (save lands in bite 3/4).
fn ol_new(seed, mode): i64 {
    var st = fl_alloc(OL_SIZE);
    memset(st, 0, OL_SIZE);
    store64(st + OL_SEED, seed);
    rng_seed(st + OL_RNG, seed);
    store64(st + OL_MODE, mode);
    store64(st + OL_OVER, 0);
    store64(st + OL_DAY, 1);
    store64(st + OL_ACTIONS, OL_DAY_ACTIONS);
    store64(st + OL_MONEY, OL_START_MONEY);
    store64(st + OL_TIER, 0);
    store64(st + OL_CROWNS, 0);
    store64(st + OL_LASTDAY, 0);
    # runtime scratch
    store64(st + OL_STABLE, fl_alloc(OL_STABLE_MAX * CMP_SIZE));
    store64(st + OL_SCREEN, OSCR_STABLE);
    store64(st + OL_SEL, 0);
    store64(st + OL_MSG, fl_alloc(256));
    store8(load64(st + OL_MSG), 0);
    store64(st + OL_FIELD, fl_alloc(OL_FIELD_MAX * 8));
    store64(st + OL_ORDER, fl_alloc(OL_FIELD_MAX * 8));
    store64(st + OL_FCOMP, fl_alloc(OL_FIELD_MAX * CMP_SIZE));
    store64(st + OL_FIELDN, 0);
    store64(st + OL_PLACE, 0);
    store64(st + OL_PURSE, 0);
    store64(st + OL_BETLANE, 0);
    store64(st + OL_BETSTAKE, 0);
    store64(st + OL_BETDELTA, 0);
    store64(st + OL_BETHAD, 0);
    # the founding team: a Blue-faction chariot, modest across the board
    store64(st + OL_NCOMP, 1);
    ol_make_competitor(st, 0, EV_CHARIOT,
      OL_STAT_START, OL_STAT_START, OL_STAT_START, OL_STAT_START,
      100, FAC_BLUE, 0);
    return st;
}

# 1.6.3 (ADR 0022) — release an Olympiad state and its five owned buffers.
# ol_new is the only state constructor (ol_load_parse builds on it), so every
# fl_alloc above is paired here exactly once. Olympiad is solo-only — no world.
fn ol_free(st): i64 {
    if (st == 0) { return 0; }
    fl_free(load64(st + OL_STABLE));
    fl_free(load64(st + OL_MSG));
    fl_free(load64(st + OL_FIELD));
    fl_free(load64(st + OL_ORDER));
    fl_free(load64(st + OL_FCOMP));
    fl_free(st);
    return 0;
}

# === Flavour name tables ===

# Display name of circus faction f (OLFaction); any unknown id reads as "White". Pure.
fn ol_faction_name(f): i64 {
    if (f == FAC_BLUE)  { return "Blue"; }
    if (f == FAC_GREEN) { return "Green"; }
    if (f == FAC_RED)   { return "Red"; }
    return "White";
}

# The ladder of meets (tier 0..OL_MAX_TIER-1), climbing in prestige from a
# provincial dirt track to the great Panhellenic sites and the Circus
# Maximus. Winning the last takes the tethrippon crown.
fn ol_meet_name(t): i64 {
    if (t == 0)  { return "the Veii dirt circuit"; }
    if (t == 1)  { return "the Ostia strand"; }
    if (t == 2)  { return "the Capua oval"; }
    if (t == 3)  { return "the Tarentum hippodrome"; }
    if (t == 4)  { return "the Syracuse course"; }
    if (t == 5)  { return "the Isthmian games at Corinth"; }
    if (t == 6)  { return "the Nemean ring"; }
    if (t == 7)  { return "the Pythian course at Delphi"; }
    if (t == 8)  { return "the Antioch hippodrome"; }
    if (t == 9)  { return "the Lageion of Alexandria"; }
    if (t == 10) { return "the hippodrome at Olympia"; }
    return "the Circus Maximus";
}

# A team's name by table index (your founding team is 0; rivals draw
# from the rest in bite 2).
fn ol_team_name(id): i64 {
    if (id == 0) { return "the Boreads"; }
    if (id == 1) { return "the Thessalian Grays"; }
    if (id == 2) { return "the Korinthian Bays"; }
    if (id == 3) { return "the Black of Thebes"; }
    if (id == 4) { return "the Sons of Notos"; }
    if (id == 5) { return "the Rhodian Suns"; }
    if (id == 6) { return "the Spartan Lash"; }
    return "the Wreck-makers";
}

