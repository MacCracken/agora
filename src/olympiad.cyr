# Crews (ships) by table index (yours is 0; rivals draw from the rest).
fn ol_crew_name(id): i64 {
    if (id == 0) { return "the Halcyon"; }
    if (id == 1) { return "the Paralos"; }
    if (id == 2) { return "the Salaminia"; }
    if (id == 3) { return "the Argo"; }
    if (id == 4) { return "the Isis of Alexandria"; }
    if (id == 5) { return "the Rhodian Dolphin"; }
