fn t67_board_policy_path_main(): i64 {
    var buf = alloc(PATH_MAX_BYTES);
    var len = board_policy_path("/var/agora", "main", buf);
    var expected = "/var/agora/.policy";
    var exp_len = strlen(expected);
    if (len != exp_len) {
