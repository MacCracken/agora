# tests/serve.tcyr — unit tests for src/main.cyr: the serve loops' building
# blocks, the session pool, the send path and the door glue.
#
# Until 1.8.2 none of this could be unit-tested: main.cyr ran its entry point
# on inclusion, so the module suite (tests/agora.tcyr) stopped at the modules
# main.cyr includes, and the serve layer was covered by the example smokes
# alone — N1 (1.7.0) and most of the 1.8.1 audit fixes shipped that way.
# main.cyr now runs `main()` only when AGORA_TEST is undefined.
#
# Each test drives the real functions over a real AF_UNIX socketpair — the
# session's fd is one end, the test holds the other — in a scratch store under
# /tmp that is removed at the end. Linux (x86_64, and aarch64 under qemu).
#
# Run with: cyrius test tests/serve.tcyr   (or a bare `cyrius test`)

#define AGORA_TEST
include "src/main.cyr"

var st_count = 0;
var st_fails = 0;

# Record a pass: count the test and print "PASS: <name>" to stdout.
fn st_pass(name): i64 {
    st_count = st_count + 1;
    syscall(1, 1, "PASS: ", 6);
    syscall(1, 1, name, strlen(name));
    syscall(1, 1, "\n", 1);
    return 0;
}

# Record a failure: count the test and the failure, and print
# "FAIL: <name> - <why>" to stderr.
fn st_fail(name, why): i64 {
    st_count = st_count + 1;
    st_fails = st_fails + 1;
    syscall(1, 2, "FAIL: ", 6);
    syscall(1, 2, name, strlen(name));
    syscall(1, 2, " - ", 3);
    syscall(1, 2, why, strlen(why));
    syscall(1, 2, "\n", 1);
    return 0;
}

# An AF_UNIX stream socketpair: fds into out[0] / out[1] (8 bytes each).
fn st_pair(out): i64 {
    var fds[8];
    var r = sys_socketpair(1, 1, 0, &fds);   # AF_UNIX, SOCK_STREAM
    if (r < 0) { return r; }
    store64(out, load32(&fds) & 0xFFFFFFFF);
    store64(out + 8, load32((&fds) + 4) & 0xFFFFFFFF);
    return 0;
}

# A fresh session slot on `fd`, made the active session (globals loaded).
fn st_session(fd): i64 {
    var s = session_alloc();
    session_reset(s, fd);
    sess_load(s);
    return s;
}

# Bind a session to an identity the way a successful login does (the slot's
# fp / handle buffers), without the challenge round.
fn st_login(s, fp, handle): i64 {
    memcpy(load64(s + SESS_SESSION_FP), fp, 16);
    store8(load64(s + SESS_SESSION_FP) + 16, 0);
    var hl = strlen(handle);
    memcpy(load64(s + SESS_SESSION_HANDLE), handle, hl);
    store8(load64(s + SESS_SESSION_HANDLE) + hl, 0);
    sess_load(s);
    return 0;
}

# Put `line` in the session's recv buffer and run it, as one sweep would:
# load, process_rx with `budget`, save. Returns process_rx's result.
fn st_feed(s, line, budget): i64 {
    var n = strlen(line);
    memcpy(load64(s + SESS_RXBUF), line, n);
    sess_load(s);
    var r = process_rx(s, 0, n, budget);
    sess_save(s);
    return r;
}

# Run the remainder the line budget parked, if any. Returns 1 if it ran.
fn st_resume(s, budget): i64 {
    var off = load64(s + SESS_RX_OFF);
    var len = load64(s + SESS_RX_LEN);
    if (off >= len) { return 0; }
    sess_load(s);
    process_rx(s, off, len, budget);
    sess_save(s);
    return 1;
}

# Occurrences of `needle` in the session's queued (unsent) output.
fn st_tx_count(s, needle): i64 {
    var tx = load64(s + SESS_TX);
    var len = load64(s + SESS_TX_LEN);
    var nl = strlen(needle);
    var c = 0;
    var i = load64(s + SESS_TX_OFF);
    while (i + nl <= len) {
        if (memeq(tx + i, needle, nl) == 1) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# Remove a scratch tree (files and directories) — test cleanup only.
fn st_rmtree(path): i64 {
    var n = store_dir_scan(path);
    if (n < 0) { xunlink(path); return 0; }
    var names = alloc(n * 8 + 8);
    var i = 0;
    while (i < n) {
        var nm = store_dir_name(i);
        var l = strlen(nm);
        var c = alloc(l + 1);
        memcpy(c, nm, l + 1);
        store64(names + i * 8, c);
        i = i + 1;
    }
    var plen = strlen(path);
    i = 0;
    while (i < n) {
        var e = load64(names + i * 8);
        var el = strlen(e);
        var full = alloc(plen + el + 2);
        memcpy(full, path, plen);
        store8(full + plen, 47);
        memcpy(full + plen + 1, e, el + 1);
        st_rmtree(full);
        i = i + 1;
    }
    sys_rmdir(path);
    return 0;
}

# s01 — the poll tx queue (1.8.1, audit M8 / 1.7.0 N3-B). An enqueue that would
# overflow first drains what the socket takes and compacts, so a command's
# output may exceed SESS_TX_CAP while the peer reads; a peer that reads NOTHING
# still overflows (sticky SESS_TX_OVF), and the bytes that did reach the socket
# arrive complete and in order.
fn s01_tx_queue_drain_compact_overflow(): i64 {
    var name = "s01_tx_queue_drain_compact_overflow";
    var fds = alloc(16);
    if (st_pair(fds) != 0) { st_fail(name, "socketpair"); return 1; }
    var a = load64(fds);
    var b = load64(fds + 8);
    sock_set_nonblocking(a);
    sock_set_nonblocking(b);
    g_serve_mode = SERVE_POLL;
    var s = st_session(a);
    var chunk = alloc(16384);
    var k = 0;
    var accepted = 0;
    var going = 1;
    while (going == 1) {
        if (k >= 400) { going = 0; continue; }
        memset(chunk, k & 0xFF, 16384);
        if (sess_tx_enqueue(s, chunk, 16384) != 0) { going = 0; continue; }
        accepted = accepted + 1;
        k = k + 1;
    }
    if (accepted <= SESS_TX_CAP / 16384) { st_fail(name, "no drain before overflow"); return 1; }
    if (k >= 400)                        { st_fail(name, "a non-reading peer never overflowed"); return 1; }
    if (load64(s + SESS_TX_OVF) != 1)    { st_fail(name, "overflow not sticky"); return 1; }
    if (sess_tx_enqueue(s, chunk, 1) != 1) { st_fail(name, "enqueue after overflow accepted"); return 1; }
    # Every byte the socket holds is chunk p / 16384, in order.
    var rb = alloc(65536);
    var pos = 0;
    var reading = 1;
    while (reading == 1) {
        var r = sys_read(b, rb, 65536);
        if (r <= 0) { reading = 0; continue; }
        var j = 0;
        while (j < r) {
            if ((load8(rb + j) & 0xFF) != ((pos + j) / 16384) & 0xFF) {
                st_fail(name, "socket bytes out of order");
                return 1;
            }
            j = j + 1;
        }
        pos = pos + r;
    }
    if (pos <= 0) { st_fail(name, "nothing reached the socket"); return 1; }
    file_close(a);
    file_close(b);
    st_pass(name);
    return 0;
}

# s02 — the per-sweep line budget (1.8.1, audit H2). Three pipelined commands
# with a budget of 1 run one per pass, the rest parked in the slot; with no
# budget (the fork worker) they all run at once.
fn s02_line_budget_parks_the_rest(): i64 {
    var name = "s02_line_budget_parks_the_rest";
    var fds = alloc(16);
    st_pair(fds);
    g_serve_mode = SERVE_POLL;
    var s = st_session(load64(fds));
    st_feed(s, "whoami\r\nwhoami\r\nwhoami\r\n", 1);
    if (st_tx_count(s, "anonymous") != 1) { st_fail(name, "budget 1 ran more than one line"); return 1; }
    if (load64(s + SESS_RX_OFF) >= load64(s + SESS_RX_LEN)) { st_fail(name, "nothing parked"); return 1; }
    var passes = 0;
    var going = 1;
    while (going == 1) {
        if (passes >= 10) { going = 0; continue; }
        var before = st_tx_count(s, "anonymous");
        if (st_resume(s, 1) == 0) { going = 0; continue; }
        if (st_tx_count(s, "anonymous") - before > 1) { st_fail(name, "a pass ran two lines"); return 1; }
        passes = passes + 1;
    }
    if (st_tx_count(s, "anonymous") != 3) { st_fail(name, "lines lost across passes"); return 1; }
    var s2 = st_session(load64(fds + 8));
    st_feed(s2, "whoami\r\nwhoami\r\nwhoami\r\n", 0);
    if (st_tx_count(s2, "anonymous") != 3)   { st_fail(name, "budget 0 did not run every line"); return 1; }
    if (load64(s2 + SESS_RX_LEN) != 0)       { st_fail(name, "budget 0 parked something"); return 1; }
    st_pass(name);
    return 0;
}

# s03 — compose lines do not count against the budget (1.8.1, H2): pasting a
# post must not crawl at one line per sweep. `post` is counted; the subject,
# the body and the `.` that commits it all run in the next single pass.
fn s03_compose_lines_not_counted(): i64 {
    var name = "s03_compose_lines_not_counted";
    var fds = alloc(16);
    st_pair(fds);
    g_serve_mode = SERVE_POLL;
    var s = st_session(load64(fds));
    st_login(s, "0123456789abcdef", "qix");
    st_feed(s, "post\r\nsubj\r\nline one\r\nline two\r\n.\r\n", 1);
    if (post_max_id(g_store_buf, "main") != 0) { st_fail(name, "post committed in the first pass"); return 1; }
    st_resume(s, 1);
    if (load64(s + SESS_RX_LEN) != 0)          { st_fail(name, "compose lines were budgeted"); return 1; }
    if (post_max_id(g_store_buf, "main") != 1) { st_fail(name, "post not committed"); return 1; }
    var fb = alloc(4096);
    var fl = post_read(g_store_buf, "main", 1, fb, 4096);
    var found = 0;
    var i = 0;
    while (i + 8 <= fl) {
        if (memeq(fb + i, "line two", 8) == 1) { found = 1; }
        i = i + 1;
    }
    if (found == 0) { st_fail(name, "body lost"); return 1; }
    st_pass(name);
    return 0;
}

# s04 — a failed fork-mode send is sticky (1.8.1, audit M10): later sends are
# refused at once instead of each waiting out SO_SNDTIMEO, and the session runs
# nothing more.
fn s04_fork_send_failure_is_sticky(): i64 {
    var name = "s04_fork_send_failure_is_sticky";
    signal_ignore(SIGPIPE);
    var fds = alloc(16);
    st_pair(fds);
    var a = load64(fds);
    file_close(load64(fds + 8));               # the peer is gone
    g_serve_mode = SERVE_FORK;
    var s = st_session(a);
    if (send_buf(a, "x", 1) != 1) {
        st_fail(name, "write to a dead peer succeeded");
        g_serve_mode = SERVE_POLL;
        return 1;
    }
    if (load64(s + SESS_TX_OVF) != 1) {
        st_fail(name, "failure not latched");
        g_serve_mode = SERVE_POLL;
        return 1;
    }
    # The latch, not the dead peer, must refuse what follows: a send to a HEALTHY
    # socket is refused too, and nothing reaches its far end.
    var ok2 = alloc(16);
    st_pair(ok2);
    sock_set_nonblocking(load64(ok2 + 8));
    if (send_buf(load64(ok2), "y", 1) != 1) {
        st_fail(name, "send after the latch not refused");
        g_serve_mode = SERVE_POLL;
        return 1;
    }
    var probe = alloc(8);
    if (sys_read(load64(ok2 + 8), probe, 8) > 0) {
        st_fail(name, "a byte was written after the latch");
        g_serve_mode = SERVE_POLL;
        return 1;
    }
    file_close(load64(ok2));
    file_close(load64(ok2 + 8));
    var q = st_feed(s, "whoami\r\n", 0);
    g_serve_mode = SERVE_POLL;
    if (q != 1) { st_fail(name, "session kept running after the latch"); return 1; }
    file_close(a);
    st_pass(name);
    return 0;
}

# s05 — door saves on close, and the play lock (1.8.1, audit M1). A session that
# ends without `q` is checkpointed like `q`; a second session under the same
# identity cannot open the same saved game until the first one is released, and
# then resumes exactly where the first left off.
fn s05_door_checkpoint_and_play_lock(): i64 {
    var name = "s05_door_checkpoint_and_play_lock";
    var fds = alloc(16);
    st_pair(fds);
    var fds2 = alloc(16);
    st_pair(fds2);
    g_serve_mode = SERVE_POLL;
    var fp = "fedcba9876543210";
    var s = st_session(load64(fds));
    st_login(s, fp, "pac");
    st_feed(s, "play port solo\r\n", 0);
    if (load64(s + SESS_MODE) != MODE_DOOR) { st_fail(name, "door did not open"); return 1; }
    st_feed(s, "n\r\n", 0);                    # next day: Day 2
    var s2 = st_session(load64(fds2));
    st_login(s2, fp, "pac");
    st_feed(s2, "play port solo\r\n", 0);
    if (st_tx_count(s2, "already playing") != 1) { st_fail(name, "second session not refused"); return 1; }
    session_door_checkpoint(s);                # the close path, before release
    if (door_save_exists(g_store_buf, fp, "port") != 1) { st_fail(name, "no checkpoint on close"); return 1; }
    session_release(s);
    st_feed(s2, "play port solo\r\n", 0);
    if (load64(s2 + SESS_MODE) != MODE_DOOR) { st_fail(name, "lock not released with the session"); return 1; }
    if (st_tx_count(s2, "Day 2/") < 1)       { st_fail(name, "progress not resumed"); return 1; }
    sess_load(s2);
    session_door_free(s2);
    st_pass(name);
    return 0;
}

# s06 — clean shutdown's signalfd (1.7.0, roadmap N1): arming routes SIGTERM to
# the signalfd instead of killing the process, the sweep's poll reads it as
# pending, and the fork child's reset unblocks it again. (Arming wrong — the
# 1.7.0 trap — kills this test process with the signal itself.)
fn s06_shutdown_signalfd(): i64 {
    var name = "s06_shutdown_signalfd";
    #ifndef CYRIUS_TARGET_AGNOS
    var sigfd = shutdown_signals_arm();
    if (sigfd < 0) { st_fail(name, "arm failed"); return 1; }
    sys_kill(sys_getpid(), SIGTERM);
    var info = alloc(SIGINFO_BYTES);
    var got = shutdown_signal_pending(sigfd, info);
    shutdown_signals_child_reset(sigfd);
    if (got != 1) { st_fail(name, "SIGTERM not seen on the signalfd"); return 1; }
    #endif
    st_pass(name);
    return 0;
}

# s07 — a SHORT fork-mode write is a failure (1.8.2). A blocking write returns
# short only when SO_SNDTIMEO expires after copying part of the buffer; until
# 1.8.2 that counted as success and the rest was retried, so a stalled client
# cost one full timeout more (on a zero-window TCP peer, several: 186 s measured
# where one 60 s timeout was meant). 1 MB into an AF_UNIX pair nobody reads, with
# a 1 s timeout: the write copies a send buffer's worth and times out. One
# timeout must latch; the pre-1.8.2 retry took two (~2 s).
fn s07_fork_short_write_fails(): i64 {
    var name = "s07_fork_short_write_fails";
    var fds = alloc(16);
    st_pair(fds);
    var a = load64(fds);
    sock_set_send_timeout(a, 1, 0);
    g_serve_mode = SERVE_FORK;
    var s = st_session(a);
    var big = alloc(1048576);
    var t0 = clock_now_ms();
    var rc = send_buf(a, big, 1048576);
    var dt = clock_now_ms() - t0;
    g_serve_mode = SERVE_POLL;
    file_close(a);
    file_close(load64(fds + 8));
    if (rc != 1) { st_fail(name, "a short write reported success"); return 1; }
    if (load64(s + SESS_TX_OVF) != 1) { st_fail(name, "the short write was not latched"); return 1; }
    if (dt >= 1800) { st_fail(name, "the short write was retried (a second send timeout)"); return 1; }
    st_pass(name);
    return 0;
}

# s08 — the line editor and the subnegotiation drain (1.10.0). BS and DEL erase a
# character — a whole UTF-8 one — and IAC EC / IAC EL a character / the line,
# each echoed as BS SP BS while agora echoes; before 1.10.0 BS / DEL were only
# dropped and EC / EL ignored. And a LINEMODE MODE request that ENDS a recv is
# answered in that recv: the reply used to be queued after the drain and sat
# there until the next byte arrived.
fn s08_line_editor_and_sb_reply(): i64 {
    var name = "s08_line_editor_and_sb_reply";
    var fds = alloc(16);
    st_pair(fds);
    var a = load64(fds);
    var s = st_session(a);
    opt_set_us(load64(s + SESS_TS), OPT_ECHO, Q_YES);
    var line = load64(s + SESS_LINE);
    st_feed(s, "abc\x08d\x7f", 0);
    if (load64(s + SESS_LINE_POS) != 2) { st_fail(name, "BS / DEL did not erase"); return 1; }
    if (memeq(line, "ab", 2) == 0)       { st_fail(name, "wrong line after BS / DEL"); return 1; }
    if (st_tx_count(s, "\x08 \x08") != 2) { st_fail(name, "erase not echoed"); return 1; }
    st_feed(s, "\xc3\xa9\x7f", 0);
    if (load64(s + SESS_LINE_POS) != 2) { st_fail(name, "half a UTF-8 character erased"); return 1; }
    st_feed(s, "\xff\xf7", 0);
    if (load64(s + SESS_LINE_POS) != 1) { st_fail(name, "IAC EC did not erase"); return 1; }
    st_feed(s, "xyz\xff\xf8", 0);
    if (load64(s + SESS_LINE_POS) != 0) { st_fail(name, "IAC EL did not clear the line"); return 1; }
    st_feed(s, "\xff\xfb\x22\xff\xfa\x22\x01\x03\xff\xf0", 0);
    if (st_tx_count(s, "\xff\xfa\x22\x01\x07\xff\xf0") != 1) {
        st_fail(name, "the MODE reply was not sent in the same recv");
        return 1;
    }
    file_close(a);
    file_close(load64(fds + 8));
    st_pass(name);
    return 0;
}

# Like st_feed, for `n` bytes that may include NUL (a NAWS subnegotiation).
fn st_feedn(s, buf, n): i64 {
    memcpy(load64(s + SESS_RXBUF), buf, n);
    sess_load(s);
    var r = process_rx(s, 0, n, 0);
    sess_save(s);
    return r;
}

# Empty the session's queued output.
fn st_tx_reset(s): i64 {
    store64(s + SESS_TX_LEN, 0);
    store64(s + SESS_TX_OFF, 0);
    return 0;
}

# The widest row, in display columns, of the session's queued output.
fn st_tx_widest(s): i64 {
    var tx = load64(s + SESS_TX);
    var len = load64(s + SESS_TX_LEN);
    var i = load64(s + SESS_TX_OFF);
    var ls = i;
    var w = 0;
    while (i <= len) {
        var at_end = 0;
        if (i == len) { at_end = 1; }
        else { if ((load8(tx + i) & 0xFF) == 10) { at_end = 1; } }
        if (at_end == 1) {
            var c = term_cols(tx, ls, i, 0);
            if (c > w) { w = c; }
            ls = i + 1;
        }
        i = i + 1;
    }
    return w;
}

# LFs in the session's queued output that do not follow a CR (NVT: none).
fn st_tx_bare_lf(s): i64 {
    var tx = load64(s + SESS_TX);
    var len = load64(s + SESS_TX_LEN);
    var i = load64(s + SESS_TX_OFF);
    var c = 0;
    while (i < len) {
        if ((load8(tx + i) & 0xFF) == 10) {
            if (i == 0) { c = c + 1; }
            else { if ((load8(tx + i - 1) & 0xFF) != 13) { c = c + 1; } }
        }
        i = i + 1;
    }
    return c;
}

# Agree NAWS and report a window `cols` x 24 over the wire (RFC 1073).
fn st_naws(s, cols): i64 {
    var nb[16];
    memcpy(&nb, "\xff\xfb\x1f\xff\xfa\x1f", 6);
    store8((&nb) + 6, 0);
    store8((&nb) + 7, cols);
    store8((&nb) + 8, 0);
    store8((&nb) + 9, 24);
    store8((&nb) + 10, 255);
    store8((&nb) + 11, 240);
    return st_feedn(s, &nb, 12);
}

# s09 — output wrapped to the NAWS window (1.10.1, ADR 0030). Without a
# reported width nothing changes; after `WILL NAWS` + a 30-column report, `read`,
# `list` and a door frame fit 29 columns (one is left free), the subject and
# indented lines hang, a URL stays whole; a resize to 60 takes effect on the next
# command, and `help` hangs at its description column.
fn s09_wrap_to_naws(): i64 {
    var name = "s09_wrap_to_naws";
    var fds = alloc(16);
    st_pair(fds);
    g_serve_mode = SERVE_POLL;
    var url = "https://example.com/a/long/path/that/must/stay/whole";
    var body = alloc(512);
    var bl = 0;
    var p1 = "the quick brown fox jumps over the lazy dog and keeps on running\n";
    var p2 = "    an indented line that runs on well past thirty columns \x1b[2J clear\n";
    memcpy(body, p1, strlen(p1));
    bl = strlen(p1);
    memcpy(body + bl, p2, strlen(p2));
    bl = bl + strlen(p2);
    memcpy(body + bl, url, strlen(url));
    bl = bl + strlen(url);
    store8(body + bl, 10);
    bl = bl + 1;
    var ph = post_headers_new();
    post_headers_set_subject(ph, "a subject long enough to need a second row");
    if (post_new(g_store_buf, "wrap", ph, body, bl) != 1) { st_fail(name, "post_new"); return 1; }
    var s = st_session(load64(fds));
    st_feed(s, "enter wrap\r\n", 0);

    st_tx_reset(s);
    st_feed(s, "read 1\r\n", 0);
    if (st_tx_count(s, "the quick brown fox jumps over the lazy dog and keeps on running") != 1) {
        st_fail(name, "without NAWS a line must go out whole");
        return 1;
    }

    st_naws(s, 30);
    if (telnet_term_cols(load64(s + SESS_TS)) != 30) { st_fail(name, "NAWS not taken"); return 1; }
    st_tx_reset(s);
    st_feed(s, "read 1\r\n", 0);
    if (st_tx_count(s, url) != 1)                   { st_fail(name, "the URL was cut"); return 1; }
    if (st_tx_count(s, "\r\n         ") < 1)        { st_fail(name, "the subject does not hang"); return 1; }
    # Exactly four spaces after a break: the indented line's own continuation rows.
    if (st_tx_count(s, "\r\n    ") - st_tx_count(s, "\r\n     ") < 2) {
        st_fail(name, "the indented line lost its indent");
        return 1;
    }
    if (st_tx_count(s, "\x1b") != 0)               { st_fail(name, "a wrapped body was not sanitized"); return 1; }
    if (st_tx_bare_lf(s) != 0)                      { st_fail(name, "a wrapped body sent a bare LF"); return 1; }
    # A thread's reply list wraps between ids, under the first one.
    var ph2 = post_headers_new();
    post_headers_set_subject(ph2, "parent");
    var parent = post_new(g_store_buf, "wrap", ph2, "p\n", 2);
    var r = 0;
    while (r < 12) {
        var phr = post_headers_new();
        post_headers_set_subject(phr, "re");
        post_headers_set_reply_to(phr, parent);
        post_new(g_store_buf, "wrap", phr, "r\n", 2);
        r = r + 1;
    }
    st_tx_reset(s);
    var rcmd[16];
    memcpy(&rcmd, "read ", 5);
    var rcl = 5 + fmt_int_buf(parent, (&rcmd) + 5);
    memcpy((&rcmd) + rcl, "\r\n", 2);
    st_feedn(s, &rcmd, rcl + 2);
    if (st_tx_count(s, "Replies: ") != 1)          { st_fail(name, "no reply list"); return 1; }
    if (st_tx_widest(s) > 29)                       { st_fail(name, "a reply-list row is wider than 29"); return 1; }
    if (st_tx_count(s, ",\r\n         ") < 1)     { st_fail(name, "the reply list does not hang"); return 1; }
    # At 29 columns (28 usable) an id lands exactly on the edge: its comma must
    # not push the row over.
    st_naws(s, 29);
    st_tx_reset(s);
    st_feedn(s, &rcmd, rcl + 2);
    if (st_tx_widest(s) > 28)                       { st_fail(name, "a reply-list comma overran the row"); return 1; }
    st_naws(s, 30);
    st_tx_reset(s);
    st_feed(s, "list\r\n", 0);
    if (st_tx_widest(s) > 29)                       { st_fail(name, "a list row is wider than 29"); return 1; }
    # "1  [anon]  " is 11 columns: a continuation row starts with exactly 11 spaces.
    if (st_tx_count(s, "\r\n           ") - st_tx_count(s, "\r\n            ") < 1) {
        st_fail(name, "the subject does not hang under itself in list");
        return 1;
    }
    st_tx_reset(s);
    st_feed(s, "play smuggler practice\r\n", 0);
    if (load64(s + SESS_MODE) != MODE_DOOR)         { st_fail(name, "door did not open"); return 1; }
    if (st_tx_widest(s) > 29)                       { st_fail(name, "a door frame row is wider than 29"); return 1; }
    sess_load(s);
    session_door_free(s);
    store64(s + SESS_MODE, MODE_COMMAND);

    # Chat: another speaker's long line, continuation rows after "<zax> ".
    st_login(s, "0123456789abcdef", "qix");
    st_feed(s, "chat wrapt\r\n", 0);
    if (load64(s + SESS_MODE) != MODE_CHAT)         { st_fail(name, "chat did not open"); return 1; }
    var said = "this line is far too long for a thirty column window";
    chat_say(g_store_buf, "wrapt", "zax", said, strlen(said));
    st_tx_reset(s);
    sess_load(s);
    chat_flush_tail(load64(fds));
    sess_save(s);
    if (st_tx_count(s, "<zax> this") != 1)          { st_fail(name, "the chat line was not sent"); return 1; }
    if (st_tx_widest(s) > 29)                       { st_fail(name, "a chat row is wider than 29"); return 1; }
    if (st_tx_count(s, "\r\n      ") - st_tx_count(s, "\r\n       ") < 1) {
        st_fail(name, "chat does not hang after the speaker");
        return 1;
    }
    store64(s + SESS_MODE, MODE_COMMAND);

    st_naws(s, 60);
    st_tx_reset(s);
    st_feed(s, "help\r\n", 0);
    var hw = st_tx_widest(s);
    if (hw > 59)                                    { st_fail(name, "help wider than 59 after a resize"); return 1; }
    if (hw < 40)                                    { st_fail(name, "the resize was not taken"); return 1; }
    # post, login, whoami, play, chat and descent wrap at 59: their continuation
    # rows start at exactly 18 spaces.
    if (st_tx_count(s, "\r\n                  ") - st_tx_count(s, "\r\n                   ") < 6) {
        st_fail(name, "help does not hang at its description column");
        return 1;
    }
    file_close(load64(fds));
    file_close(load64(fds + 8));
    st_pass(name);
    return 0;
}

# s10 — the greeting (render_motd, 1.10.1) is laid out for 80 columns: no line over 79
# display columns, its tagline intact, and the continuation indented like it.
fn s10_motd_80_columns(): i64 {
    var name = "s10_motd_80_columns";
    var buf = alloc(1024);
    var n = render_motd(buf);
    if (n <= 0) { st_fail(name, "render failed"); return 1; }
    var ls = 0;
    var i = 0;
    var widest = 0;
    while (i < n) {
        if ((load8(buf + i) & 0xFF) == 10) {
            var w = term_cols(buf, ls, i, 0);
            if (w > widest) { widest = w; }
            ls = i + 1;
        }
        i = i + 1;
    }
    if (widest > 79) { st_fail(name, "a greeting line is wider than 79 columns"); return 1; }
    var found = 0;
    i = 0;
    while (i + 16 <= n) {
        if (memeq(buf + i, "Descent MUD link", 16) == 1) { found = 1; }
        i = i + 1;
    }
    if (found == 0) { st_fail(name, "tagline cut"); return 1; }
    st_pass(name);
    return 0;
}

# Read whatever is waiting on `fd` into buf (up to cap), giving it `ms` to arrive.
fn st_recv_some(fd, buf, cap, ms): i64 {
    var pfd[8];
    store32(&pfd, fd);
    store16((&pfd) + 4, 1);
    store16((&pfd) + 6, 0);
    if (syscall(7, &pfd, 1, ms) <= 0) { return 0; }
    var n = sys_read(fd, buf, cap);
    if (n < 0) { return 0; }
    return n;
}

# s11 — the Descent as a session state (1.11.0, ADR 0031), poll model, against a
# loopback listener standing in for the MUD: `descent` returns MODE_DESCENT at
# once (it used to block for the whole visit), the bytes pipelined behind it
# reach the MUD first, the pump moves bytes both ways, a client whose queue is
# full stops the MUD reads, 30 minutes of silence ends the visit, and the MUD
# closing brings the session back to the prompt with its options resynced.
fn s11_descent_state(): i64 {
    var name = "s11_descent_state";
    g_serve_mode = SERVE_POLL;
    g_descent_down_until = 0;
    var lt, lv = tcp_socket();
    var lfd = result_unwrap(lt, lv);
    sock_reuse(lfd);
    var bt, bv = sock_bind(lfd, INADDR_LOOPBACK(), 34931);
    if (is_ok(bt) == 0) { st_fail(name, "bind the fake MUD"); return 1; }
    sock_listen(lfd, 4);
    var cfgp = alloc(512);
    descent_cfg_path(g_store_buf, cfgp);
    var cfd0 = file_open(cfgp, O_WRONLY | O_CREAT | O_TRUNC, 384);
    file_write(cfd0, "34931\n", 6);
    file_close(cfd0);
    var fds = alloc(16);
    st_pair(fds);
    sock_set_nonblocking(load64(fds));        # as serve_poll does at accept
    var s = st_session(load64(fds));
    st_login(s, "0123456789abcdef", "qix");
    opt_set_him(load64(s + SESS_TS), OPT_NAWS, Q_YES);
    store64(load64(s + SESS_TS) + TS_TERM_COLS, 80);
    st_tx_reset(s);
    st_feed(s, "descent\r\nnorth\r\n", 0);
    if (load64(s + SESS_MODE) != MODE_DESCENT) { st_fail(name, "descent did not return MODE_DESCENT"); return 1; }
    if (load64(s + SESS_RX_LEN) - load64(s + SESS_RX_OFF) != 7) {
        st_fail(name, "the pipelined `north` was not kept for the MUD");
        return 1;
    }
    var at, av = sock_accept(lfd);
    if (is_ok(at) == 0) { st_fail(name, "the dial never reached the fake MUD"); return 1; }
    var mpeer = result_unwrap(at, av);
    var i = 0;
    while (i < 50) {
        sess_load(s);
        descent_pump(s, 1, 1);
        sess_save(s);
        if (load64(s + SESS_DESC_PHASE) == DESC_PROXY) { i = 50; }
        sleep_ms(10);
        i = i + 1;
    }
    if (st_tx_count(s, "stepping through the portal") != 1) { st_fail(name, "no portal banner"); return 1; }
    var buf = alloc(8192);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    var got = st_recv_some(mpeer, buf, 8192, 500);
    if (got != 7) { st_fail(name, "the MUD did not get the pipelined line"); return 1; }
    if (memeq(buf, "north\r\n", 7) == 0) { st_fail(name, "wrong pipelined bytes"); return 1; }
    # MUD → client, watched by the observer (the MUD asks ECHO; the client agrees).
    file_write(mpeer, "room\r\n\xff\xfb\x01", 9);
    sleep_ms(20);
    st_tx_reset(s);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    if (st_tx_count(s, "room\r\n") != 1) { st_fail(name, "MUD bytes did not reach the client"); return 1; }
    # Client → MUD through the session socket.
    file_write(load64(fds + 8), "look\r\n\xff\xfd\x01", 9);
    sleep_ms(20);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    got = st_recv_some(mpeer, buf, 8192, 500);
    if (got != 9) { st_fail(name, "client bytes did not reach the MUD"); return 1; }
    # A client queue without room for a whole read: the MUD is not read.
    file_write(mpeer, "more", 4);
    sleep_ms(20);
    store64(s + SESS_TX_OFF, 0);
    store64(s + SESS_TX_LEN, SESS_TX_CAP - 100);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    if (load64(s + SESS_TX_LEN) != SESS_TX_CAP - 100) { st_fail(name, "read the MUD into a full queue"); return 1; }
    st_tx_reset(s);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    if (st_tx_count(s, "more") != 1) { st_fail(name, "the held MUD bytes never came"); return 1; }
    # The MUD hangs up: back at the prompt; ECHO (the MUD's) adopted, then
    # re-asked by agora for a character-mode client.
    file_close(mpeer);
    sleep_ms(20);
    st_tx_reset(s);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    if (load64(s + SESS_MODE) != MODE_COMMAND)  { st_fail(name, "not back in MODE_COMMAND"); return 1; }
    if (load64(s + SESS_MUD_FD) != (0 - 1))      { st_fail(name, "the MUD socket was kept"); return 1; }
    if (st_tx_count(s, "back at the agora") != 1) { st_fail(name, "no return line"); return 1; }
    if (opt_us(load64(s + SESS_TS), OPT_ECHO) != Q_YES) {
        st_fail(name, "the ECHO the client agreed was not adopted");
        return 1;
    }
    if (opt_him(load64(s + SESS_TS), OPT_NAWS) != Q_YES) { st_fail(name, "NAWS lost on return"); return 1; }
    if (telnet_term_cols(load64(s + SESS_TS)) != 80)     { st_fail(name, "the window lost on return"); return 1; }
    # 30 minutes of silence ends a visit.
    st_tx_reset(s);
    st_feed(s, "descent\r\n", 0);
    var at2, av2 = sock_accept(lfd);
    var mpeer2 = result_unwrap(at2, av2);
    store64(s + SESS_DESC_PHASE, DESC_PROXY);
    store64(s + SESS_DESC_LAST_MS, clock_now_ms() - DESCENT_IDLE_MS - 1);
    sess_load(s);
    descent_pump(s, 1, 1);
    sess_save(s);
    if (st_tx_count(s, "idle — leaving the Descent") != 1) {
        st_fail(name, "the silence bound did not end the visit");
        return 1;
    }
    if (load64(s + SESS_MODE) != MODE_COMMAND)  { st_fail(name, "idle: not back at the prompt"); return 1; }
    # A client gone mid-visit releases the MUD socket with the slot.
    st_feed(s, "descent\r\n", 0);
    var at3, av3 = sock_accept(lfd);
    var mpeer3 = result_unwrap(at3, av3);
    file_close(load64(fds + 8));
    sess_load(s);
    if (descent_pump(s, 1, 1) != 1) { st_fail(name, "a gone client did not close the session"); return 1; }
    session_release(s);
    if (load64(s + SESS_MUD_FD) != (0 - 1)) { st_fail(name, "release kept the MUD socket"); return 1; }
    if (st_recv_some(mpeer3, buf, 16, 500) != 0) { st_fail(name, "the MUD side was not closed"); return 1; }
    file_close(mpeer2);
    file_close(mpeer3);
    file_close(load64(fds));
    sock_close(lfd);
    xunlink(cfgp);
    st_pass(name);
    return 0;
}

# s12 — a fork connection child's lifecycle (1.11.0, ADR 0031). A forked child
# arms itself as cmd_serve_on's children do (the parent's signalfd, then
# fork_child_arm): SIGTERM must reach its OWN signalfd — the child then exits by
# choice (status 7), not killed by the signal — and its PR_SET_PDEATHSIG must be
# SIGTERM (status 8 otherwise). The parent's pid table signals what it holds and
# forgets a reaped child.
fn s12_fork_child_lifecycle(): i64 {
    var name = "s12_fork_child_lifecycle";
    var me = sys_getpid();
    var pid = sys_fork();
    if (pid == 0) {
        var armed = shutdown_signals_arm();
        var csig = fork_child_arm(armed, me);
        var pd[8];
        store64(&pd, 0);
        sys_prctl(2, &pd, 0, 0, 0);                    # PR_GET_PDEATHSIG
        if ((load64(&pd) & 0xFFFFFFFF) != SIGTERM) { sys_exit(8); }
        if (csig < 0) { sys_exit(9); }
        var pfd[8];
        store32(&pfd, csig);
        store16((&pfd) + 4, 1);
        store16((&pfd) + 6, 0);
        if (syscall(7, &pfd, 1, 5000) == 1) { sys_exit(7); }
        sys_exit(10);
    }
    fork_pid_add(pid);
    sleep_ms(200);
    fork_pids_signal(SIGTERM);
    var st[8];
    store64(&st, 0);
    sys_waitpid(pid, &st, 0);
    var status = load64(&st) & 0xFFFF;
    fork_pid_drop(pid);
    if ((status & 0x7F) != 0)        { st_fail(name, "the child was killed by the signal, not told"); return 1; }
    var code = (status >> 8) & 0xFF;
    if (code == 8)                   { st_fail(name, "PR_SET_PDEATHSIG is not SIGTERM"); return 1; }
    if (code != 7)                   { st_fail(name, "the child's signalfd did not see SIGTERM"); return 1; }
    var i = 0;
    while (i < MAX_SESS) {
        if (load64(g_fork_pids + i * 8) != 0) { st_fail(name, "a reaped child stayed in the table"); return 1; }
        i = i + 1;
    }
    st_pass(name);
    return 0;
}

# --- 1.11.1: the door registry, checked door by door -------------------------

var g_t_lines = 0;          # the input lines the conformance drive feeds every door

# Render door state `st` of descriptor `d` into buf as door_send_frame does;
# returns the frame length.
fn st_door_render(d, st, buf): i64 {
    g_door_emit_cap = DOOR_FRAME_CAP;
    var n = callptr(load64(d + DD_RENDER), st, buf, DOOR_FRAME_CAP);
    g_door_emit_cap = DOOR_EMIT_UNBOUNDED;
    return n;
}

# Build a state of game `g` the way the `play` launcher does: practice, or —
# for a game that forces it — universe with a fresh world in `world` and a
# session fingerprint. Returns the state.
fn st_door_build(g, d, world): i64 {
    var mode = DOOR_PRACTICE;
    if (load64(d + DD_MODE_POLICY) == DM_FORCE_UNIVERSE) { mode = DOOR_UNIVERSE; }
    var st = callptr(load64(d + DD_NEW), 12345, mode, load64(d + DD_DEF_DAYS));
    if (st == 0) { return 0; }
    if (load64(d + DD_START) != 0) { var sr = callptr(load64(d + DD_START), st); }
    if (mode == DOOR_UNIVERSE) {
        if (load64(d + DD_FP_OFF) != 0) { store64(st + load64(d + DD_FP_OFF) - 1, 0x0123456789ABCDEF); }
        door_world_fresh_into(g, world);
        store64(st + load64(d + DD_WORLD_OFF), world);
        if (load64(d + DD_ON_ENTRY) != 0) { var er = callptr(load64(d + DD_ON_ENTRY), st); }
    }
    return st;
}

# One drive of game `g`: build, render, feed every test line, render again, ask
# is-over / reply / score, round-trip a save, release. Returns 0, or a failure
# reason (cstring).
fn st_door_drive(g, d, world, buf, buf2): i64 {
    var st = st_door_build(g, d, world);
    if (st == 0) { return "DD_NEW returned 0"; }
    var n = st_door_render(d, st, buf);
    if (n <= 0) { return "DD_RENDER drew nothing"; }
    if (n > DOOR_FRAME_CAP) { return "DD_RENDER overran its cap"; }
    var li = 0;
    while (li < 5) {
        var line = load64(g_t_lines + li * 8);
        var fr = callptr(load64(d + DD_FEED), st, line, strlen(line));
        li = li + 1;
    }
    if (st_door_render(d, st, buf) <= 0) { return "DD_RENDER drew nothing after input"; }
    if (load64(d + DD_IS_OVER) != 0) {
        var ov = callptr(load64(d + DD_IS_OVER), st);
        if (ov < 0) { return "DD_IS_OVER < 0"; }
        if (ov > 1) { return "DD_IS_OVER > 1"; }
    }
    if (load64(d + DD_REPLY) != 0) {
        var rl[8];
        var rb = callptr(load64(d + DD_REPLY), st, &rl);
        if (rb == 0) { return "DD_REPLY gave no buffer"; }
        if (load64(&rl) <= 0) { return "DD_REPLY gave an empty reply"; }
    }
    if (load64(d + DD_SCORE) != 0) {
        var sc = callptr(load64(d + DD_SCORE), st);
        var rk = callptr(load64(d + DD_RANK), sc);
        if (rk == 0) { return "DD_RANK gave no label"; }
        if (strlen(rk) == 0) { return "DD_RANK gave an empty label"; }
    }
    if (load64(d + DD_SAVE_FMT) != 0) {
        var n1 = callptr(load64(d + DD_SAVE_FMT), st, buf, DOOR_SAVE_CAP);
        if (n1 <= 0) { return "DD_SAVE_FMT wrote nothing"; }
        var st2 = callptr(load64(d + DD_LOAD), buf, n1);
        if (st2 == 0) { return "DD_LOAD refused its own save"; }
        if (load64(d + DD_WORLD_BYTES) != 0) {
            if (load64(st + load64(d + DD_WORLD_OFF)) != 0) { store64(st2 + load64(d + DD_WORLD_OFF), world); }
        }
        var n2 = callptr(load64(d + DD_SAVE_FMT), st2, buf2, DOOR_SAVE_CAP);
        door_release_state(g, st2);
        if (n2 != n1) { return "a save did not survive DD_LOAD (length)"; }
        if (memeq(buf, buf2, n1) == 0) { return "a save did not survive DD_LOAD (bytes)"; }
    }
    door_release_state(g, st);
    return 0;
}

var g_t_vmbuf = 0;

# VmData (KB) of this process. Its read buffer is allocated once, so measuring
# does not itself move the bump heap.
fn st_vmdata(): i64 {
    if (g_t_vmbuf == 0) { g_t_vmbuf = alloc(4096); }
    var b = g_t_vmbuf;
    var n = file_read_all("/proc/self/status", b, 4095);
    var i = 0;
    var v = 0;
    while (i + 7 < n) {
        if (memeq(b + i, "VmData:", 7) == 1) {
            var j = i + 7;
            while (j < n) {
                var c = load8(b + j) & 0xFF;
                if (c >= 48) { if (c <= 57) { v = v * 10 + (c - 48); } }
                if (c == 10) { j = n; }
                j = j + 1;
            }
            i = n;
        }
        i = i + 1;
    }
    return v;
}

# s13 — the door registry, door by door (1.11.1, ADR 0020 / 0022). Descriptor
# slots resolve at run time, so until 1.11.1 a mis-wired slot showed only when a
# smoke happened to drive it. Every id up to GAME_LAST must be registered, under
# a name the parser finds, with the slots its capabilities imply (a save has a
# load, a leaderboard a rank, a Universe game its whole world set, a couch bot
# its reply); then each door is DRIVEN through its slots — render, five lines,
# is-over, reply, score / rank, a save round-tripped through its load — and
# driven 200 more times to prove it gives back everything it takes: neither the
# bump heap nor the process's data segment may grow (ADR 0022: a door state is
# freelist memory, released by its DD_FREE). Door #11 is checked by being added.
fn s13_registry_conformance(): i64 {
    var name = "s13_registry_conformance";
    g_t_lines = alloc(5 * 8);
    store64(g_t_lines, "?");
    store64(g_t_lines + 8, "1");
    store64(g_t_lines + 16, "n");
    store64(g_t_lines + 24, "x");
    store64(g_t_lines + 32, "help");
    var buf = alloc(DOOR_SAVE_CAP + DOOR_FRAME_CAP);
    var buf2 = alloc(DOOR_SAVE_CAP + DOOR_FRAME_CAP);
    var world = alloc(DOOR_WORLD_CAP);
    st_vmdata();
    var g = 1;
    while (g <= GAME_LAST) {
        var d = door_desc_for(g);
        if (d == 0) { st_fail(name, "a game id up to GAME_LAST is not registered"); return 1; }
        var nm = load64(d + DD_NAME);
        if (nm == 0) { st_fail(name, "a door has no DD_NAME"); return 1; }
        if (door_game_by_name(nm, 0) != g) { st_fail(name, nm); return 1; }
        if (load64(d + DD_SCORE) == 0) {
            if (door_game_by_name(nm, DD_SCORE) != GAME_NONE) {
                st_fail(name, "`scores` would accept a door with no leaderboard");
                return 1;
            }
        }
        if (load64(d + DD_RENDER) == 0) { st_fail(name, "a door has no DD_RENDER"); return 1; }
        if (load64(d + DD_FEED) == 0)   { st_fail(name, "a door has no DD_FEED"); return 1; }
        if (load64(d + DD_NEW) == 0)    { st_fail(name, "a door has no DD_NEW"); return 1; }
        if (load64(d + DD_FREE) == 0)   { st_fail(name, "a door has no DD_FREE (ADR 0022)"); return 1; }
        var hs = 0;
        if (load64(d + DD_SAVE_FMT) != 0) { hs = 1; }
        var hl = 0;
        if (load64(d + DD_LOAD) != 0) { hl = 1; }
        if (hs != hl) { st_fail(name, "a save without a load, or a load without a save"); return 1; }
        var hsc = 0;
        if (load64(d + DD_SCORE) != 0) { hsc = 1; }
        var hrk = 0;
        if (load64(d + DD_RANK) != 0) { hrk = 1; }
        if (hsc != hrk) { st_fail(name, "a score without a rank, or a rank without a score"); return 1; }
        var uni = 0;
        if ((load64(d + DD_FLAGS) & DF_UNIVERSE) != 0) { uni = 1; }
        var hw = 0;
        if (load64(d + DD_WORLD_BYTES) != 0) { hw = 1; }
        if (uni != hw) { st_fail(name, "DF_UNIVERSE and a world size disagree"); return 1; }
        if (uni == 1) {
            if (load64(d + DD_USLOT) == 0)       { st_fail(name, "a Universe door without DD_USLOT"); return 1; }
            if (load64(d + DD_WORLD_VALID) == 0) { st_fail(name, "a Universe door without DD_WORLD_VALID"); return 1; }
            if (load64(d + DD_WORLD_NEW) == 0)   { st_fail(name, "a Universe door without DD_WORLD_NEW"); return 1; }
            if (load64(d + DD_WORLD_OFF) <= 0) {
                st_fail(name, "a Universe door's world field at offset 0");
                return 1;
            }
            if (load64(d + DD_MSG) == 0)         { st_fail(name, "a Universe door without DD_MSG"); return 1; }
            if (load64(d + DD_BUSY) == 0)        { st_fail(name, "a Universe door without DD_BUSY"); return 1; }
            if (door_world_bytes(g) > DOOR_WORLD_CAP) {
                st_fail(name, "a world larger than the session buffer");
                return 1;
            }
            door_world_fresh_into(g, world);
            if (door_world_valid(g, world, door_world_bytes(g)) != 1) {
                st_fail(name, "a fresh world fails its validator");
                return 1;
            }
        } else {
            if (load64(d + DD_USLOT) != 0)      { st_fail(name, "a solo door with a Universe slot"); return 1; }
            if (load64(d + DD_ON_ENTRY) != 0)   { st_fail(name, "a solo door with an on-entry hook"); return 1; }
            if (load64(d + DD_WORLD_TICK) != 0) { st_fail(name, "a solo door with a world tick"); return 1; }
        }
        if (load64(d + DD_WORLD_TICK) != 0) {
            if (load64(d + DD_TICK_NS) <= 0) { st_fail(name, "a world tick without DD_TICK_NS"); return 1; }
        }
        var mp = load64(d + DD_MODE_POLICY);
        if (mp < DM_NORMAL)         { st_fail(name, "an unknown mode policy"); return 1; }
        if (mp > DM_FORCE_UNIVERSE) { st_fail(name, "an unknown mode policy"); return 1; }
        if (mp == DM_PRACTICE_ONLY) { if (hs == 1) { st_fail(name, "a practice-only door with a save"); return 1; } }
        if (mp == DM_FORCE_UNIVERSE) {
            if (uni == 0) { st_fail(name, "a forced-Universe door that is not one"); return 1; }
        }
        if (uni == 1) {
            if (mp == DM_PRACTICE_ONLY) { st_fail(name, "a Universe door limited to practice"); return 1; }
            if (mp == DM_NO_UNIVERSE)   { st_fail(name, "a Universe door that refuses universe"); return 1; }
        }
        if (load64(d + DD_COUCH_CMD) != 0) {
            if ((load8(load64(d + DD_COUCH_CMD)) & 0xFF) != 47) {
                st_fail(name, "a couch command without '/'");
                return 1;
            }
            if (load64(d + DD_COUCH_NAME) == 0) { st_fail(name, "a couch bot without DD_COUCH_NAME"); return 1; }
            if (load64(d + DD_COUCH_HELP) == 0) { st_fail(name, "a couch bot without DD_COUCH_HELP"); return 1; }
            if (load64(d + DD_COUCH_NOTE) == 0) { st_fail(name, "a couch bot without DD_COUCH_NOTE"); return 1; }
            if (load64(d + DD_REPLY) == 0)      { st_fail(name, "a couch bot without DD_REPLY"); return 1; }
        }
        # Drive it, then drive it 200 times more: nothing may stay behind.
        var why = st_door_drive(g, d, world, buf, buf2);
        if (why != 0) { st_fail(name, nm); st_fail(name, why); return 1; }
        var w = 0;
        while (w < 10) { cmd_scratch_reset(); st_door_drive(g, d, world, buf, buf2); w = w + 1; }
        var heap0 = _heap_ptr;
        var vm0 = st_vmdata();
        var fl0 = _fl_arena_pos;
        var c = 0;
        while (c < 200) { cmd_scratch_reset(); st_door_drive(g, d, world, buf, buf2); c = c + 1; }
        if (_heap_ptr != heap0) {
            st_fail(name, nm);
            st_fail(name, "a door drive took bump-heap memory (alloc, not fl_alloc)");
            return 1;
        }
        if (_fl_arena_pos != fl0) {
            st_fail(name, nm);
            st_fail(name, "a door drive kept freelist memory (a buffer its DD_FREE misses)");
            return 1;
        }
        if (st_vmdata() > vm0 + 8) {
            st_fail(name, nm);
            st_fail(name, "a door drive leaked: 200 drives grew the data segment");
            return 1;
        }
        g = g + 1;
    }
    st_pass(name);
    return 0;
}

var g_t_seen_world = 0 - 1;
var g_t_real_free = 0;
var g_t_world_off = 0;

# A door free that records what its state's world field holds, then frees as the
# door would. Installed by s14 in place of a Universe door's DD_FREE.
fn t_hostile_free(st): i64 {
    g_t_seen_world = load64(st + g_t_world_off);
    return callptr(g_t_real_free, st);
}

# s14 — ADR 0022's borrowed world pointer, enforced (1.11.1). A Universe door's
# state points at the SESSION's world snapshot, which it does not own; a DD_FREE
# that freed it would put an alloc() block on the freelist. Every release path —
# door_release_state, door_state_drop (quit), session_door_free (a disconnect) —
# must hand the door's free a state whose world field is already 0.
fn s14_world_pointer_guard(): i64 {
    var name = "s14_world_pointer_guard";
    var world = alloc(DOOR_WORLD_CAP);
    var g = 1;
    while (g <= GAME_LAST) {
        var d = door_desc_for(g);
        if (load64(d + DD_WORLD_BYTES) != 0) {
            g_t_real_free = load64(d + DD_FREE);
            g_t_world_off = load64(d + DD_WORLD_OFF);
            store64(d + DD_FREE, &t_hostile_free);
            var path = 0;
            while (path < 3) {
                var st = callptr(load64(d + DD_NEW), 7, DOOR_UNIVERSE, load64(d + DD_DEF_DAYS));
                store64(st + g_t_world_off, world);
                g_t_seen_world = 0 - 1;
                if (path == 0) { door_release_state(g, st); }
                if (path == 1) { g_door_game = g; g_door_state = st; door_state_drop(); }
                if (path == 2) {
                    var s = session_alloc();
                    store64(s + SESS_DOOR_GAME, g);
                    store64(s + SESS_DOOR_STATE, st);
                    session_door_free(s);
                }
                if (g_t_seen_world != 0) {
                    store64(d + DD_FREE, g_t_real_free);
                    st_fail(name, "a door's free was handed the session's world pointer");
                    return 1;
                }
                path = path + 1;
            }
            store64(d + DD_FREE, g_t_real_free);
        }
        g = g + 1;
    }
    st_pass(name);
    return 0;
}

# s15 — `serve --door-days` (1.12.0, ADR 0032): 0 to DOOR_DAYS_MAX in plain
# digits, and nothing else — a typo must be refused, not read as 0 (which would
# switch the ration off).
fn s15_door_days_flag(): i64 {
    var name = "s15_door_days_flag";
    if (serve_parse_days("0") != 0)        { st_fail(name, "0"); return 1; }
    if (serve_parse_days("10") != 10)      { st_fail(name, "10"); return 1; }
    if (serve_parse_days("1000") != 1000)  { st_fail(name, "1000"); return 1; }
    if (serve_parse_days("1001") >= 0)     { st_fail(name, "1001"); return 1; }
    if (serve_parse_days("12345") >= 0)    { st_fail(name, "five digits"); return 1; }
    if (serve_parse_days("") >= 0)         { st_fail(name, "empty"); return 1; }
    if (serve_parse_days("x") >= 0)        { st_fail(name, "a letter"); return 1; }
    if (serve_parse_days("3x") >= 0)       { st_fail(name, "a trailing letter"); return 1; }
    if (serve_parse_days("-1") >= 0)       { st_fail(name, "a sign"); return 1; }
    if (serve_parse_days(" 5") >= 0)       { st_fail(name, "a space"); return 1; }
    st_pass(name);
    return 0;
}

# Lines in the file at `path` (0 if it cannot be read).
fn st_file_lines(path, buf, cap): i64 {
    var n = store_read_all(path, buf, cap);
    if (n <= 0) { return 0; }
    var c = 0;
    var i = 0;
    while (i < n) {
        if ((load8(buf + i) & 0xFF) == 10) { c = c + 1; }
        i = i + 1;
    }
    return c;
}

# s16 — the wager audit trail (1.12.1, ADR 0033): a settled real-stakes wager
# becomes one W line with every draw; a Practice wager or an anonymous one
# none; a used seed's reveal is an R line written once, and every close path
# (session_door_checkpoint) writes it; `fair` shows the commitment, `fair
# reveal` the seed, and a bad client seed is refused.
fn s16_wager_audit_trail(): i64 {
    var name = "s16_wager_audit_trail";
    var fds = alloc(16);
    st_pair(fds);
    var s = st_session(load64(fds));
    st_login(s, "00112233aabbccdd", "qix");
    var ctx = g_wager_fair;
    if (ctx == 0) { st_fail(name, "no fairness context in the session"); return 1; }
    wager_fair_reset(ctx);
    var i = 0;
    while (i < 4) {
        memcpy(ctx + WF_CUR + i * 16, "0123456789abcdef", 16);
        memcpy(ctx + WF_NEXT + i * 16, "fedcba9876543210", 16);
        i = i + 1;
    }
    sha256(ctx + WF_CUR, 64, ctx + WF_CURC);
    sha256(ctx + WF_NEXT, 64, ctx + WF_NEXTC);
    memcpy(ctx + WF_CLIENT, "qix", 3);
    store64(ctx + WF_CLEN, 3);
    store64(ctx + WF_SEEDED, 1);
    var path = alloc(PATH_MAX_BYTES);
    wager_log_path(path);
    xunlink(path);
    var buf = alloc(8192);
    g_door_game = GAME_PORT;
    g_door_mode = DOOR_SOLO;
    wager_trace_begin();
    var r = wager_uniform(6);
    wager_audit(10, 1, r, 0 - 10, 90);
    door_wager_flush();
    if (st_file_lines(path, buf, 8192) != 1) { st_fail(name, "a solo wager is one W line"); return 1; }
    var want = "W\t";
    if (memeq(buf, want, 2) == 0) { st_fail(name, "W record"); return 1; }
    store8(buf + store_read_all(path, buf, 8192), 0);
    var head = "\tqix\tport\ta8ae6e6ee929abea3afcfc5258c8ccd6f85273e0d4626d26c7279f3250f77c8e\t";
    var tail = "\tqix\t0\t6:5\t10\t1\t5\t-10\t90\n";
    if (strstr(buf, head) < 0) { st_fail(name, "W fields"); return 1; }
    if (strstr(buf, tail) < 0) { st_fail(name, "W draws and amounts"); return 1; }
    g_door_mode = DOOR_PRACTICE;
    wager_audit(10, 1, r, 0 - 10, 80);
    door_wager_flush();
    if (load64(ctx + WF_PEND) != 0) { st_fail(name, "practice record left pending"); return 1; }
    if (st_file_lines(path, buf, 8192) != 1) { st_fail(name, "a practice wager was logged"); return 1; }
    g_door_mode = DOOR_SOLO;
    store8(g_session_handle, 0);
    wager_audit(10, 1, r, 0 - 10, 70);
    door_wager_flush();
    if (st_file_lines(path, buf, 8192) != 1) { st_fail(name, "an anonymous wager was logged"); return 1; }
    st_login(s, "00112233aabbccdd", "qix");     # (reloads the slot's globals: the door mode again)
    g_door_game = GAME_PORT;
    g_door_mode = DOOR_SOLO;
    wager_log_reveal(ctx);
    if (st_file_lines(path, buf, 8192) != 2) { st_fail(name, "the reveal is an R line"); return 1; }
    store8(buf + store_read_all(path, buf, 8192), 0);
    if (strstr(buf, "\t0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\tqix\t1\n") < 0) {
        st_fail(name, "R fields");
        return 1;
    }
    wager_log_reveal(ctx);
    if (st_file_lines(path, buf, 8192) != 2) { st_fail(name, "revealed twice"); return 1; }
    wager_trace_begin();
    r = wager_uniform(6);
    wager_audit(10, 1, r, 0 - 10, 60);
    door_wager_flush();
    if (st_file_lines(path, buf, 8192) != 3) { st_fail(name, "the second wager was not logged"); return 1; }
    sess_save(s);
    session_door_checkpoint(s);
    if (st_file_lines(path, buf, 8192) != 4) { st_fail(name, "a close path did not reveal"); return 1; }
    g_door_game = GAME_NONE;
    g_door_mode = DOOR_PRACTICE;
    sess_save(s);
    st_feed(s, "fair\r\n", 8);
    if (st_tx_count(s, "commitment  a8ae6e6ee929abea") != 1) { st_fail(name, "fair shows the commitment"); return 1; }
    st_feed(s, "fair reveal\r\n", 8);
    var rv = "the seed you bet on was:\r\n  0123456789abcdef";
    if (st_tx_count(s, rv) != 1) { st_fail(name, "fair reveal"); return 1; }
    st_feed(s, "fair seed bad:seed\r\n", 8);
    if (st_tx_count(s, "a client seed is 1-32") != 1) { st_fail(name, "a bad client seed taken"); return 1; }
    st_feed(s, "fairy\r\n", 8);
    if (st_tx_count(s, "unknown command") < 1) { st_fail(name, "fairy taken for fair"); return 1; }
    # the slot's next connection starts with new seeds, not this one's
    session_reset(s, load64(fds));
    if (load64(load64(s + SESS_FAIR) + WF_SEEDED) != 0) { st_fail(name, "a new connection kept the seed"); return 1; }
    xunlink(path);
    sock_close(load64(fds));
    sock_close(load64(fds + 8));
    st_pass(name);
    return 0;
}

# Entry point: make a per-pid scratch store under /tmp, register the doors,
# run s01..s16, remove the store, print the totals, and return 1 on any failure.
fn serve_tests(): i64 {
    alloc_init();
    syscall(1, 1, "agora serve-layer tests (src/main.cyr)\n", 39);
    var root = alloc(64);
    memcpy(root, "/tmp/agora-serve-tests-", 23);
    var pl = fmt_int_buf(sys_getpid(), root + 23);
    store8(root + 23 + pl, 0);
    store_ensure(root);
    g_store_buf = root;
    door_registry_init();

    s01_tx_queue_drain_compact_overflow();
    s02_line_budget_parks_the_rest();
    s03_compose_lines_not_counted();
    s04_fork_send_failure_is_sticky();
    s05_door_checkpoint_and_play_lock();
    s06_shutdown_signalfd();
    s07_fork_short_write_fails();
    s08_line_editor_and_sb_reply();
    s09_wrap_to_naws();
    s10_motd_80_columns();
    s11_descent_state();
    s12_fork_child_lifecycle();
    s13_registry_conformance();
    s14_world_pointer_guard();
    s15_door_days_flag();
    s16_wager_audit_trail();

    st_rmtree(root);
    syscall(1, 1, "tests: ", 7);
    fmt_int(st_count);
    syscall(1, 1, "  failures: ", 12);
    fmt_int(st_fails);
    syscall(1, 1, "\n", 1);
    if (st_fails > 0) { return 1; }
    return 0;
}

var st_rc = serve_tests();
sys_exit(st_rc);
